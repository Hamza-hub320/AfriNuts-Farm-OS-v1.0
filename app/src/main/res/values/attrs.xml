<?xml version="1.0" encoding="utf-8"?>
<resources>
    <declare-styleable name="GradientCardView">
        <attr name="cardTitle" format="string" />
        <attr name="cardSubtitle" format="string" />
        <attr name="cardIcon" format="reference" />
        <attr name="cardVariant" format="enum">
            <enum name="primary" value="0" />
            <enum name="accent" value="1" />
            <enum name="secondary" value="2" />
        </attr>
        <attr name="showInfoBadge" format="boolean" />
        <attr name="ctaText" format="string" />
    </declare-styleable>

    <declare-styleable name="CircularProgressView">
        <attr name="progressColor" format="color" />
        <attr name="backgroundColor" format="color" />
        <attr name="textColor" format="color" />
        <attr name="textSize" format="dimension" />
        <attr name="tabBackgroundDark" format="reference" />
    </declare-styleable>

    <declare-styleable name="Theme">
        <attr name="isLightTheme" format="boolean" />
    </declare-styleable>

    <!-- Theme attributes for automatic light/dark switching -->
    <attr name="cardBackgroundPrimary" format="reference" />
    <attr name="cardBackgroundAccent" format="reference" />
    <attr name="cardBackgroundSecondary" format="reference" />
    <attr name="iconBackgroundGlass" format="reference" />
    <attr name="tabBackground" format="reference" />
</resources>