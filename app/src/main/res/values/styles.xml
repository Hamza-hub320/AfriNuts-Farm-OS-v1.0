<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- ======================================== -->
    <!-- Base Application Theme -->
    <!-- ======================================== -->
    <style name="Theme.AfriNutsFarmOS" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Primary brand colors -->
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryVariant">@color/olive</item>
        <item name="colorOnPrimary">@color/warm_grey</item>

        <!-- Secondary brand colors -->
        <item name="colorSecondary">@color/accent</item>
        <item name="colorSecondaryVariant">@color/dark_orange</item>
        <item name="colorOnSecondary">@color/text_light</item>

        <!-- Background colors -->
        <item name="android:colorBackground">@color/background</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/text_dark</item>
        <item name="colorSurfaceVariant">@color/warm_grey</item>

        <!-- Status bar color -->
        <item name="android:statusBarColor">@color/primary</item>
        <item name="android:windowLightStatusBar">false</item>

        <!-- Text colors -->
        <item name="android:textColorPrimary">@color/text_dark</item>
        <item name="android:textColorSecondary">@color/navy</item>

        <!-- Button styling -->
        <item name="materialButtonStyle">@style/Widget.AfriNuts.Button</item>
        <item name="cardViewStyle">@style/Widget.AfriNuts.CardView</item>

        <!-- Default font -->
        <item name="android:fontFamily">sans-serif</item>

        <!-- Window background gradient -->
        <item name="android:windowBackground">@drawable/bg_app_gradient</item>

        <!-- Custom theme flag -->
        <item name="isLightTheme">true</item>

            <item name="buttonLiquidGlass">@drawable/bg_button_liquid_glass</item>
            <item name="buttonLiquidGlassPrimary">@drawable/bg_button_liquid_glass_primary</item>
            <item name="buttonLiquidGlassAccent">@drawable/bg_button_liquid_glass_accent</item>
            <item name="buttonLiquidGlassDanger">@drawable/bg_button_liquid_glass_danger</item>


        <!-- ======================================== -->
        <!-- CARD BACKGROUND ATTRIBUTES (LIGHT MODE) -->
        <!-- ======================================== -->
        <item name="cardBackgroundPrimary">@drawable/bg_card_primary</item>
        <item name="cardBackgroundAccent">@drawable/bg_card_accent</item>
        <item name="cardBackgroundSecondary">@drawable/bg_card_secondary</item>
        <item name="iconBackgroundGlass">@drawable/bg_icon_glass</item>
        <item name="tabBackground">@drawable/bg_glass_tabs</item>
        <!-- Inside Theme.AfriNutsFarmOS -->
        <item name="navbarIconColor">@android:color/white</item>
        <item name="navbarTextColor">@android:color/white</item>
        <item name="navbarBackground">@drawable/bg_navbar_glass</item>


    </style>

    <style name="ThemeOverlay.AfriNuts.GlassNavbar" parent="">
        <item name="android:textColor">?attr/colorSurface</item>
        <item name="colorControlNormal">?attr/colorSurface</item>
    </style>
    <!-- ======================================== -->
    <!-- BASE STYLES -->
    <!-- ======================================== -->

    <!-- Base Widget Style that Android/libraries expect -->
    <style name="Widget" />

    <!-- Base Text Style - all text styles inherit from this -->
    <style name="Text">
        <item name="android:textColor">@color/text_dark</item>
        <item name="android:textSize">16sp</item>
        <item name="android:lineSpacingExtra">4sp</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>

    <!-- Body Text Bold -->
    <style name="Text.Body.Bold" parent="Text.Body">
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Body Text Small Bold -->
    <style name="Text.Body.Small.Bold" parent="Text.Body.Small">
        <item name="android:textStyle">bold</item>
    </style>

    <!-- ======================================== -->
    <!-- TYPOGRAPHY SCALE (Modular Scale) -->
    <!-- ======================================== -->
    <!-- Using a modular scale ratio of 1.25 (major third) -->

    <!-- Display / Hero Text (Big numbers, titles) -->
    <style name="Text.Display" parent="Text">
        <item name="android:textSize">32sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">-0.02</item>
        <item name="android:lineSpacingExtra">8sp</item>
    </style>

    <style name="Text.Display.Small" parent="Text.Display">
        <item name="android:textSize">28sp</item>
    </style>

    <!-- Headings (Section titles) -->
    <style name="Text.H1" parent="Text">
        <item name="android:textSize">28sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">-0.01</item>
        <item name="android:lineSpacingExtra">6sp</item>
    </style>

    <style name="Text.H2" parent="Text">
        <item name="android:textSize">24sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">-0.01</item>
        <item name="android:lineSpacingExtra">6sp</item>
    </style>

    <style name="Text.H3" parent="Text">
        <item name="android:textSize">20sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:lineSpacingExtra">4sp</item>
    </style>

    <style name="Text.H4" parent="Text">
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:lineSpacingExtra">4sp</item>
    </style>

    <style name="Text.H5" parent="Text">
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:lineSpacingExtra">4sp</item>
    </style>

    <style name="Text.H6" parent="Text">
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:lineSpacingExtra">4sp</item>
    </style>

    <!-- Body Text (Readable content) -->
    <style name="Text.Body" parent="Text">
        <item name="android:textSize">16sp</item>
        <item name="android:lineSpacingExtra">6sp</item>
    </style>

    <style name="Text.Body.Small" parent="Text">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/navy</item>
        <item name="android:lineSpacingExtra">5sp</item>
    </style>

    <!-- Caption / Supporting Text (Helper text, dates) -->
    <style name="Text.Caption" parent="Text">
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/navy</item>
        <item name="android:lineSpacingExtra">4sp</item>
    </style>

    <style name="Text.Caption.Small" parent="Text.Caption">
        <item name="android:textSize">11sp</item>
        <item name="android:textColor">#94A3B8</item>
    </style>

    <!-- Overline / Meta Text (Category labels) -->
    <style name="Text.Overline" parent="Text">
        <item name="android:textSize">10sp</item>
        <item name="android:textColor">@color/navy</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.08</item>
        <item name="android:lineSpacingExtra">2sp</item>
    </style>

    <!-- Stats / Numbers (KPI values) -->
    <style name="Text.Stat" parent="Text">
        <item name="android:textSize">20sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/primary</item>
        <item name="android:lineSpacingExtra">2sp</item>
        <item name="android:letterSpacing">-0.02</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
    </style>

    <style name="Text.Stat.Large" parent="Text.Stat">
        <item name="android:textSize">22sp</item>
    </style>

    <style name="Text.Stat.Small" parent="Text.Stat">
        <item name="android:textSize">20sp</item>
        <item name="android:letterSpacing">-0.02</item>
    </style>

    <!-- Add this for very large numbers (like total trees) -->

    <!-- Label Text (Form labels, field names) -->
    <style name="Text.Label" parent="Text">
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/navy</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.02</item>
        <item name="android:lineSpacingExtra">4sp</item>
    </style>

    <style name="Text.Label.Small" parent="Text.Label">
        <item name="android:textSize">11sp</item>
    </style>

    <!-- Button Text -->
    <style name="Text.Button" parent="Text">
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0.03</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>
    <!-- ======================================== -->
    <!-- LIQUID GLASS BUTTON STYLES -->
    <!-- ======================================== -->

    <!-- Base Liquid Glass Button - NO background here, use drawable directly -->
    <style name="Widget.AfriNuts.Button.LiquidGlass" parent="Widget.MaterialComponents.Button">
        <item name="backgroundTint">@null</item>
        <item name="android:backgroundTint">@null</item>
        <item name="android:background">?attr/buttonLiquidGlass</item>

        <item name="android:textAppearance">@style/Text.Button</item>
        <item name="rippleColor">?attr/colorPrimary</item>
        <item name="cornerRadius">32dp</item>

        <item name="android:paddingLeft">12dp</item>
        <item name="android:paddingRight">12dp</item>
        <item name="android:paddingTop">8dp</item>
        <item name="android:paddingBottom">8dp</item>

        <item name="android:minHeight">40dp</item>
        <item name="android:elevation">0dp</item>

    </style>

    <style name="GlassMorphismDialogTheme" parent="Theme.MaterialComponents.Light.Dialog">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowMinWidthMajor">90%</item>
        <item name="android:windowMinWidthMinor">90%</item>
        <item name="colorSurface">?attr/colorSurface</item>
        <item name="colorOnSurface">?attr/colorOnSurface</item>
        <item name="colorPrimary">?attr/colorPrimary</item>
        <item name="colorSecondary">?attr/colorSecondary</item>
    </style>

    <!-- In res/values/styles.xml -->
    <style name="TextAppearance.TabCompact" parent="TextAppearance.MaterialComponents.Button">
        <item name="android:textSize">11sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0.01</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <!-- Primary Liquid Glass Button -->
    <style name="Widget.AfriNuts.Button.LiquidGlass.Primary"
        parent="Widget.AfriNuts.Button.LiquidGlass">
        <item name="android:textColor">?attr/colorSurface</item>
        <item name="android:background">?attr/buttonLiquidGlassPrimary</item>
    </style>

    <!-- Accent Liquid Glass Button -->
    <style name="Widget.AfriNuts.Button.LiquidGlass.Accent"
        parent="Widget.AfriNuts.Button.LiquidGlass">
        <item name="android:textColor">?attr/colorSecondary</item>
        <item name="android:background">?attr/buttonLiquidGlassAccent</item>
    </style>

    <!-- Danger Liquid Glass Button -->
    <style name="Widget.AfriNuts.Button.LiquidGlass.Danger"
        parent="Widget.AfriNuts.Button.LiquidGlass">
        <item name="android:textColor">@color/error</item>
        <item name="android:background">?attr/buttonLiquidGlassDanger</item>
    </style>
    <!-- ======================================== -->
    <!-- WIDGETS -->
    <!-- ======================================== -->

    <!-- Base Widget Style -->
    <style name="Widget.AfriNuts" />

    <!-- Button Style -->
    <style name="Widget.AfriNuts.Button" parent="Widget.MaterialComponents.Button">
        <item name="android:textAppearance">@style/Text.Button</item>
        <item name="rippleColor">@color/accent</item>
        <item name="cornerRadius">8dp</item>
        <item name="android:paddingLeft">12dp</item>
        <item name="android:paddingRight">12dp</item>
        <item name="android:paddingTop">8dp</item>
        <item name="android:paddingBottom">8dp</item>
        <item name="android:minHeight">40dp</item>
    </style>

    <!-- Outlined Button Style -->
    <style name="Widget.AfriNuts.Button.Outlined" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:textAppearance">@style/Text.Button</item>
        <item name="strokeColor">@color/primary</item>
        <item name="strokeWidth">1dp</item>
        <item name="rippleColor">@color/accent</item>
        <item name="cornerRadius">8dp</item>
        <item name="android:paddingLeft">16dp</item>
        <item name="android:paddingRight">16dp</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">12dp</item>
    </style>

    <!-- Small Button Style -->
    <style name="Widget.AfriNuts.Button.Small" parent="Widget.AfriNuts.Button">
        <item name="android:paddingLeft">12dp</item>
        <item name="android:paddingRight">12dp</item>
        <item name="android:paddingTop">6dp</item>
        <item name="android:paddingBottom">6dp</item>
        <item name="android:textSize">12sp</item>
        <item name="android:minHeight">32dp</item>
        <item name="cornerRadius">6dp</item>
    </style>

    <style name="Widget.AfriNuts.RadioButton" parent="Widget.MaterialComponents.CompoundButton.RadioButton">
        <item name="android:textAppearance">@style/Text.Body</item>
        <item name="android:textColor">@color/text_dark</item>
        <item name="android:buttonTint">@color/primary</item>
        <item name="android:minHeight">48dp</item>
    </style>

    <!-- CardView Style -->
    <style name="Widget.AfriNuts.CardView" parent="Widget.MaterialComponents.CardView">
        <item name="cardCornerRadius">12dp</item>
        <item name="cardElevation">2dp</item>
        <item name="cardBackgroundColor">@android:color/white</item>
        <item name="cardUseCompatPadding">true</item>
    </style>

    <!-- Progress Bar Style -->
    <style name="Widget.AfriNuts.ProgressBar" parent="Widget.AppCompat.ProgressBar.Horizontal">
        <item name="android:progressTint">@color/primary</item>
        <item name="android:progressBackgroundTint">@color/warm_grey</item>
        <item name="android:minHeight">6dp</item>
        <item name="android:maxHeight">6dp</item>
    </style>

    <!-- Chip Style -->
    <style name="Widget.AfriNuts.Chip" parent="Widget.MaterialComponents.Chip.Filter">
        <item name="android:textAppearance">@style/Text.Caption.Small</item>
        <item name="chipBackgroundColor">@color/warm_grey</item>
        <item name="chipStrokeColor">@color/primary</item>
        <item name="chipStrokeWidth">0dp</item>
        <item name="rippleColor">@color/accent</item>
        <item name="chipCornerRadius">11dp</item>
    </style>

    <!-- EditText Style -->
    <style name="Widget.AfriNuts.EditText" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="boxStrokeColor">@color/primary</item>
        <item name="boxStrokeWidth">1dp</item>
        <item name="boxStrokeWidthFocused">2dp</item>
        <item name="hintTextColor">@color/navy</item>
        <item name="android:textColorHint">@color/navy</item>
        <item name="colorControlActivated">@color/primary</item>
        <item name="colorControlHighlight">@color/accent</item>
    </style>

    <!-- Divider Style -->
    <style name="Widget.AfriNuts.Divider">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">1dp</item>
        <item name="android:background">@color/warm_grey</item>
    </style>

    <!-- Status Badge Style -->
    <style name="Widget.AfriNuts.StatusBadge">
        <item name="android:paddingLeft">8dp</item>
        <item name="android:paddingRight">8dp</item>
        <item name="android:paddingTop">3dp</item>
        <item name="android:paddingBottom">3dp</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@android:color/white</item>
        <item name="android:background">@drawable/status_background</item>
    </style>
    <!-- ======================================== -->
    <!-- GRADIENTS -->
    <!-- ======================================== -->

</resources>