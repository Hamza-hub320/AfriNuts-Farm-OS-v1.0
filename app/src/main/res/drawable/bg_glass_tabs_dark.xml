<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Dark Frosted Glass Base -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="24dp" />
            <solid android:color="#E81E293B" />
        </shape>
    </item>

    <!-- Brand Color Overlay (Subtle - Dark Mode) -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="24dp" />
            <gradient
                android:startColor="#307A9C2E"
                android:endColor="#20F05C1A"
                android:angle="135"
                android:type="linear" />
        </shape>
    </item>

    <!-- Subtle Light Reflection for Depth -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="24dp" />
            <gradient
                android:startColor="#20FFFFFF"
                android:centerColor="#10FFFFFF"
                android:endColor="#00FFFFFF"
                android:angle="135"
                android:type="linear" />
        </shape>
    </item>

    <!-- Soft Inner Glow -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="24dp" />
            <gradient
                android:startColor="#00FFFFFF"
                android:centerColor="#08FFFFFF"
                android:endColor="#00FFFFFF"
                android:angle="0"
                android:type="linear" />
        </shape>
    </item>

    <!-- Highlight Edge - Top (Subtle) -->
    <item android:top="1.5dp" android:left="1dp" android:right="1dp">
        <shape android:shape="rectangle">
            <corners android:radius="24dp" />
            <gradient
                android:startColor="#30FFFFFF"
                android:endColor="#00FFFFFF"
                android:angle="90" />
        </shape>
    </item>

    <!-- Soft Shadow Edge - Bottom -->
    <item android:bottom="1.5dp" android:left="1dp" android:right="1dp">
        <shape android:shape="rectangle">
            <corners android:radius="24dp" />
            <gradient
                android:startColor="#00FFFFFF"
                android:endColor="#20000000"
                android:angle="90" />
        </shape>
    </item>

    <!-- Crisp Border with Slight Brand Tint -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="24dp" />
            <stroke
                android:width="0.8dp"
                android:color="#407A9C2E" />
        </shape>
    </item>

</layer-list>