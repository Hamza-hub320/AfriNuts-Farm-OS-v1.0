<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Background Gradient -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="135"
                android:startColor="@color/gradient_bg_soft_start"
                android:endColor="@color/gradient_bg_soft_end"
                android:type="linear" />
            <corners android:radius="24dp" />
        </shape>
    </item>

    <!-- Glass Effect Overlay -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#20FFFFFF" />
            <corners android:radius="24dp" />
        </shape>
    </item>

    <!-- Subtle Border -->
    <item>
        <shape android:shape="rectangle">
            <stroke
                android:width="1dp"
                android:color="#30FFFFFF" />
            <corners android:radius="24dp" />
        </shape>
    </item>
</layer-list>