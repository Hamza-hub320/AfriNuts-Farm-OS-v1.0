<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Outer shadow for elevation -->
    <item android:bottom="-4dp" android:left="-4dp" android:right="-4dp" android:top="-4dp">
        <shape android:shape="rectangle">
            <corners android:radius="36dp" />
            <solid android:color="#15000000" />
        </shape>
    </item>

    <!-- Dark Liquid Glass Base - iOS style -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="36dp" />
            <solid android:color="#CC1C1C1E" />
        </shape>
    </item>

    <!-- Dark Glass Depth Gradient -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="36dp" />
            <gradient
                android:startColor="#15FFFFFF"
                android:centerColor="#08FFFFFF"
                android:endColor="#05FFFFFF"
                android:angle="135"
                android:type="linear" />
        </shape>
    </item>

    <!-- Frosted Glass Overlay -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="36dp" />
            <gradient
                android:startColor="#10FFFFFF"
                android:centerColor="#05FFFFFF"
                android:endColor="#15FFFFFF"
                android:angle="0"
                android:type="linear" />
        </shape>
    </item>

    <!-- Liquid Top Highlight - Subtle glass shine -->
    <item android:top="1.5dp" android:left="2dp" android:right="2dp">
        <shape android:shape="rectangle">
            <corners android:radius="36dp" />
            <gradient
                android:startColor="#25FFFFFF"
                android:centerColor="#08FFFFFF"
                android:endColor="#00FFFFFF"
                android:angle="90"
                android:type="linear" />
        </shape>
    </item>

    <!-- Soft Bottom Shadow -->
    <item android:bottom="1.5dp" android:left="2dp" android:right="2dp">
        <shape android:shape="rectangle">
            <corners android:radius="36dp" />
            <gradient
                android:startColor="#00FFFFFF"
                android:endColor="#20000000"
                android:angle="90"
                android:type="linear" />
        </shape>
    </item>

    <!-- Crisp Liquid Border -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="36dp" />
            <stroke
                android:width="0.8dp"
                android:color="#25FFFFFF" />
        </shape>
    </item>

    <!-- Subtle Inner Glow -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="36dp" />
            <stroke
                android:width="1dp"
                android:color="#08FFFFFF" />
        </shape>
    </item>

</layer-list>