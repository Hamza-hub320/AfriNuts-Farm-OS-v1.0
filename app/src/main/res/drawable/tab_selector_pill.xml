<?xml version="1.0" encoding="utf-8"?>
<!-- Tab pill: the pill is inset 4dp on all sides BY CONSTRUCTION, so it is
     vertically centred in the tab no matter how the TabLayout measures its
     strip. The TabLayout itself must have android:padding="0dp" — the inset
     below is the only margin. Selected pill carries a subtle green glow
     (a 2dp halo in primary at 25% alpha), like the wireframe. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <layer-list>
            <item android:top="2dp" android:bottom="2dp" android:left="2dp" android:right="2dp">
                <shape android:shape="rectangle">
                    <solid android:color="#400E6B3C" />
                    <corners android:radius="999dp" />
                </shape>
            </item>
            <item android:top="4dp" android:bottom="4dp" android:left="4dp" android:right="4dp">
                <shape android:shape="rectangle">
                    <solid android:color="@color/primary" />
                    <corners android:radius="999dp" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item android:state_pressed="true">
        <inset android:insetTop="4dp" android:insetBottom="4dp" android:insetLeft="4dp" android:insetRight="4dp">
            <shape android:shape="rectangle">
                <solid android:color="@color/primary_light" />
                <corners android:radius="999dp" />
            </shape>
        </inset>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <corners android:radius="999dp" />
        </shape>
    </item>
</selector>
