<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Outer Shadow for Elevation -->
    <item android:bottom="4dp" android:left="2dp" android:right="2dp" android:top="0dp">
        <shape android:shape="rectangle">
            <corners android:radius="20dp" />
            <gradient
                android:startColor="#30000000"
                android:centerColor="#20000000"
                android:endColor="#08000000"
                android:angle="90"
                android:type="linear" />
        </shape>
    </item>

    <!-- Base Solid Dark Glass -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="20dp" />
            <solid android:color="#F01C1C1E" />  <!-- 94% opacity -->
        </shape>
    </item>

    <!-- Secondary Green Tint Overlay (Subtle) -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="20dp" />
            <gradient
                android:startColor="#18B8E030"
                android:endColor="#08B8E030"
                android:angle="135"
                android:type="linear" />
        </shape>
    </item>

    <!-- Minimal Glass Reflection -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="20dp" />
            <gradient
                android:startColor="#08FFFFFF"
                android:centerColor="#03FFFFFF"
                android:endColor="#00FFFFFF"
                android:angle="135"
                android:type="linear" />
        </shape>
    </item>

    <!-- Soft Inner Glow -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="20dp" />
            <gradient
                android:startColor="#05FFFFFF"
                android:centerColor="#00FFFFFF"
                android:endColor="#00FFFFFF"
                android:angle="0"
                android:type="linear" />
        </shape>
    </item>

    <!-- Top Highlight Edge - Very Subtle -->
    <item android:top="1dp" android:left="1.5dp" android:right="1.5dp">
        <shape android:shape="rectangle">
            <corners android:radius="20dp" />
            <gradient
                android:startColor="#10FFFFFF"
                android:endColor="#00FFFFFF"
                android:angle="90" />
        </shape>
    </item>

    <!-- Bottom Shadow - Stronger -->
    <item android:bottom="2dp" android:left="1.5dp" android:right="1.5dp">
        <shape android:shape="rectangle">
            <corners android:radius="20dp" />
            <gradient
                android:startColor="#00FFFFFF"
                android:endColor="#40000000"
                android:angle="90" />
        </shape>
    </item>

    <!-- Subtle Border with Secondary Green Tint -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="20dp" />
            <stroke
                android:width="0.5dp"
                android:color="#25B8E030" />
        </shape>
    </item>

</layer-list>