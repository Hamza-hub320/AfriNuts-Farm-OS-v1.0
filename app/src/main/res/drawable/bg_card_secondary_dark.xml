<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Dark Glass Base -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="20dp" />
            <solid android:color="#E81E293B" />
        </shape>
    </item>

    <!-- Secondary Green Gradient Overlay -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="20dp" />
            <gradient
                android:startColor="#20B8E030"
                android:endColor="#207A9C2E"
                android:angle="135"
                android:type="linear" />
        </shape>
    </item>

    <!-- Subtle Green Reflection -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="20dp" />
            <gradient
                android:startColor="#20D4FF99"
                android:centerColor="#10D4FF99"
                android:endColor="#00D4FF99"
                android:angle="135"
                android:type="linear" />
        </shape>
    </item>

    <!-- Inner Glow -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="20dp" />
            <gradient
                android:startColor="#00FFFFFF"
                android:centerColor="#08D4FF99"
                android:endColor="#00FFFFFF"
                android:angle="0"
                android:type="linear" />
        </shape>
    </item>

    <!-- Highlight Edge - Top -->
    <item android:top="1.5dp" android:left="2dp" android:right="2dp">
        <shape android:shape="rectangle">
            <corners android:radius="20dp" />
            <gradient
                android:startColor="#30FFFFFF"
                android:endColor="#00FFFFFF"
                android:angle="90" />
        </shape>
    </item>

    <!-- Shadow Edge - Bottom -->
    <item android:bottom="1.5dp" android:left="2dp" android:right="2dp">
        <shape android:shape="rectangle">
            <corners android:radius="20dp" />
            <gradient
                android:startColor="#00FFFFFF"
                android:endColor="#20000000"
                android:angle="90" />
        </shape>
    </item>

    <!-- Border with Secondary Glow -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="20dp" />
            <stroke
                android:width="0.8dp"
                android:color="#60B8E030" />
        </shape>
    </item>

</layer-list>