<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Outer Shadow for Elevation -->
    <item android:bottom="4dp" android:left="2dp" android:right="2dp" android:top="0dp">
        <shape android:shape="rectangle">
            <corners android:radius="20dp" />
            <gradient
                android:startColor="#20000000"
                android:centerColor="#15000000"
                android:endColor="#05000000"
                android:angle="90"
                android:type="linear" />
        </shape>
    </item>

    <!-- Base Dark Glass -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="20dp" />
            <solid android:color="#CC1C1C1E" />
        </shape>
    </item>

    <!-- Warm accent tint overlay (very subtle) -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="20dp" />
            <gradient
                android:startColor="#15EA580C"
                android:endColor="#08EA580C"
                android:angle="135"
                android:type="linear" />
        </shape>
    </item>

    <!-- Subtle gradient depth -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="20dp" />
            <gradient
                android:startColor="#00FFFFFF"
                android:endColor="#08FFFFFF"
                android:angle="135"
                android:type="linear" />
        </shape>
    </item>

    <!-- Soft inner glow -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="20dp" />
            <gradient
                android:startColor="#05FFFFFF"
                android:centerColor="#00FFFFFF"
                android:endColor="#00FFFFFF"
                android:angle="0"
                android:type="linear" />
        </shape>
    </item>

    <!-- Top highlight edge -->
    <item android:top="1dp" android:left="1.5dp" android:right="1.5dp">
        <shape android:shape="rectangle">
            <corners android:radius="20dp" />
            <gradient
                android:startColor="#20FFFFFF"
                android:endColor="#00FFFFFF"
                android:angle="90" />
        </shape>
    </item>

    <!-- Bottom shadow -->
    <item android:bottom="2dp" android:left="1.5dp" android:right="1.5dp">
        <shape android:shape="rectangle">
            <corners android:radius="20dp" />
            <gradient
                android:startColor="#00FFFFFF"
                android:endColor="#15000000"
                android:angle="90" />
        </shape>
    </item>

    <!-- Subtle border with accent tint -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="20dp" />
            <stroke
                android:width="0.5dp"
                android:color="#30EA580C" />
        </shape>
    </item>

</layer-list>