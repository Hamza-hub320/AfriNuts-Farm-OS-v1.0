<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Base Gradient - Rich, vibrant colors -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="28dp" />
            <gradient
                android:startColor="#5A7411"
                android:endColor="#E04E00"
                android:angle="135"
                android:type="linear" />
        </shape>
    </item>

    <!-- Subtle Inner Glow - Adds dimension without fog -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="28dp" />
            <stroke
                android:width="2dp"
                android:color="#10FFFFFF" />
        </shape>
    </item>

    <!-- Light Edge - Just a hint of reflection -->
    <item android:top="1dp">
        <shape android:shape="rectangle">
            <corners android:radius="28dp" />
            <gradient
                android:startColor="#18FFFFFF"
                android:endColor="#00FFFFFF"
                android:angle="90" />
        </shape>
    </item>

    <!-- Crisp Outline -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="28dp" />
            <stroke
                android:width="0.5dp"
                android:color="#30FFFFFF" />
        </shape>
    </item>

</layer-list>