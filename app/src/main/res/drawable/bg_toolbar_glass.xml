<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Base Liquid Glass -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="28dp" />
            <solid android:color="#CC1C1C1E" />
        </shape>
    </item>

    <!-- Glass Depth Gradient -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="28dp" />
            <gradient
                android:startColor="#15FFFFFF"
                android:centerColor="#08FFFFFF"
                android:endColor="#00FFFFFF"
                android:angle="135"
                android:type="linear" />
        </shape>
    </item>

    <!-- Subtle Top Highlight -->
    <item android:top="1.5dp" android:left="2dp" android:right="2dp">
        <shape android:shape="rectangle">
            <corners android:radius="28dp" />
            <gradient
                android:startColor="#25FFFFFF"
                android:endColor="#00FFFFFF"
                android:angle="90" />
        </shape>
    </item>

    <!-- Soft Bottom Shadow -->
    <item android:bottom="1.5dp" android:left="2dp" android:right="2dp">
        <shape android:shape="rectangle">
            <corners android:radius="28dp" />
            <gradient
                android:startColor="#00FFFFFF"
                android:endColor="#20000000"
                android:angle="90" />
        </shape>
    </item>

    <!-- Crisp Border -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="28dp" />
            <stroke
                android:width="0.8dp"
                android:color="#30FFFFFF" />
        </shape>
    </item>

</layer-list>