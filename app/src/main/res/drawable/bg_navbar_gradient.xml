<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Base white card -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/white" />
            <corners android:radius="32dp" />
        </shape>
    </item>
    <!-- Overlay with subtle cashew gradient -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#0D5A7411"
                android:centerColor="#0DA0C800"
                android:endColor="#0DEA580C"
                android:angle="135"
                android:type="linear" />
            <corners android:radius="32dp" />
        </shape>
    </item>
</layer-list>