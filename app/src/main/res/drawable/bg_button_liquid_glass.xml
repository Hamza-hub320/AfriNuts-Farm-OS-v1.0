<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Glass Base -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="28dp" />
            <solid android:color="#E8FFFFFF" />
        </shape>
    </item>

    <!-- Glass Depth -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="28dp" />
            <gradient
                android:startColor="#20FFFFFF"
                android:endColor="#08FFFFFF"
                android:angle="135"
                android:type="linear" />
        </shape>
    </item>

    <!-- Light Reflection -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="28dp" />
            <gradient
                android:startColor="#40FFFFFF"
                android:centerColor="#15FFFFFF"
                android:endColor="#00FFFFFF"
                android:angle="135"
                android:type="linear" />
        </shape>
    </item>

    <!-- Highlight Edge -->
    <item android:top="1.5dp" android:left="2dp" android:right="2dp">
        <shape android:shape="rectangle">
            <corners android:radius="28dp" />
            <gradient
                android:startColor="#35FFFFFF"
                android:endColor="#00FFFFFF"
                android:angle="90" />
        </shape>
    </item>

    <!-- Shadow Edge -->
    <item android:bottom="1.5dp" android:left="2dp" android:right="2dp">
        <shape android:shape="rectangle">
            <corners android:radius="28dp" />
            <gradient
                android:startColor="#00FFFFFF"
                android:endColor="#15000000"
                android:angle="90" />
        </shape>
    </item>

    <!-- Border -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="28dp" />
            <stroke
                android:width="0.8dp"
                android:color="#40FFFFFF" />
        </shape>
    </item>

</layer-list>