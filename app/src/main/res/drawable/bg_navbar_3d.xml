<shape xmlns:android="http://schemas.android.com/apk/res/android">
    <corners android:radius="36dp"/>

    <!-- Subtle vertical gradient = lighting -->
    <gradient
        android:startColor="#FFFFFF"
        android:endColor="#F5F5F5"
        android:angle="270"/>

    <!-- Inner padding helps depth illusion -->
    <padding
        android:left="2dp"
        android:top="2dp"
        android:right="2dp"
        android:bottom="2dp"/>
</shape>