<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Base Liquid Glass - Solid Dark -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="28dp" />
            <solid android:color="#F01C1C1E" />  <!-- 94% opacity -->
        </shape>
    </item>

    <!-- Minimal Glass Reflection -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="28dp" />
            <gradient
                android:startColor="#08FFFFFF"
                android:centerColor="#03FFFFFF"
                android:endColor="#00FFFFFF"
                android:angle="135"
                android:type="linear" />
        </shape>
    </item>

    <!-- Top Highlight - Very subtle -->
    <item android:top="1dp" android:left="1dp" android:right="1dp">
        <shape android:shape="rectangle">
            <corners android:radius="28dp" />
            <gradient
                android:startColor="#10FFFFFF"
                android:endColor="#00FFFFFF"
                android:angle="90" />
        </shape>
    </item>

    <!-- Bottom Shadow - Stronger -->
    <item android:bottom="2dp" android:left="2dp" android:right="2dp">
        <shape android:shape="rectangle">
            <corners android:radius="28dp" />
            <gradient
                android:startColor="#00FFFFFF"
                android:endColor="#60000000"
                android:angle="90" />
        </shape>
    </item>

    <!-- Very Subtle Border -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="28dp" />
            <stroke
                android:width="0.5dp"
                android:color="#15FFFFFF" />
        </shape>
    </item>

</layer-list>