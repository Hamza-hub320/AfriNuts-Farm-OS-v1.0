<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardCornerRadius="20dp"
    app:cardElevation="4dp"
    android:background="@drawable/bg_card_primary"
    android:foreground="?android:attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true"
    style="@style/Widget.AfriNuts.CardView">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Worker Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="12dp">

            <FrameLayout
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_icon_glass"
                android:layout_marginEnd="12dp">

                <ImageView
                    android:id="@+id/tvWorkerIcon"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_person"
                    app:tint="@color/primary" />

            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvWorkerName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="John Doe"
                    style="@style/Text.H4"
                    android:textColor="@color/primary" />

                <TextView
                    android:id="@+id/tvWorkerStats"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="5 tasks • 3 completed"
                    style="@style/Text.Caption"
                    android:textColor="@color/navy" />

            </LinearLayout>

            <TextView
                android:id="@+id/tvCompletionRate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="75%"
                style="@style/Text.H5"
                android:textColor="@color/accent"
                android:background="@drawable/bg_icon_glass"
                android:paddingHorizontal="12dp"
                android:paddingVertical="4dp"
                app:cornerRadius="20dp" />

        </LinearLayout>

        <!-- Progress Bar -->
        <ProgressBar
            android:id="@+id/workerProgress"
            style="@style/Widget.AfriNuts.ProgressBar"
            android:layout_width="match_parent"
            android:layout_height="6dp"
            android:progress="75"
            android:max="100"
            android:progressTint="@color/accent"
            android:layout_marginBottom="12dp" />

        <!-- Task Type Chips -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/taskTypeContainer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal" />

        </HorizontalScrollView>

        <!-- Time Stats -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="@drawable/bg_card_secondary"
            android:padding="12dp"
            android:gravity="center_vertical"
            app:cardCornerRadius="16dp">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_timer"
                app:tint="@color/primary"
                android:layout_marginEnd="8dp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Total Time"
                style="@style/Text.Caption.Small"
                android:textColor="@color/navy" />

            <TextView
                android:id="@+id/tvTotalTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="2d 4h"
                style="@style/Text.Stat.Small"
                android:textColor="@color/primary"
                android:layout_marginEnd="16dp" />

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_timer_off"
                app:tint="@color/primary"
                android:layout_marginEnd="8dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Avg"
                style="@style/Text.Caption.Small"
                android:textColor="@color/navy"
                android:layout_marginEnd="4dp" />

            <TextView
                android:id="@+id/tvAvgTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="3h"
                style="@style/Text.Stat.Small"
                android:textColor="@color/accent" />

        </LinearLayout>

    </LinearLayout>

</androidx.cardview.widget.CardView>