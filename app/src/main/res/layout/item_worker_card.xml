<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    app:cardCornerRadius="24dp"
    app:cardElevation="2dp"
    android:background="?attr/cardBackgroundPrimary"
    android:foreground="?android:attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true"
    style="@style/Widget.AfriNuts.CardView">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp"
        android:background="?attr/cardBackgroundPrimary">

        <!-- Worker Header - Compact -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="8dp">

            <FrameLayout
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="?attr/iconBackgroundGlass"
                android:layout_marginEnd="10dp">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_person"
                    app:tint="?attr/colorPrimary" />

            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvWorkerName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="John Doe"
                    style="@style/Text.H5"
                    android:textSize="14sp"
                    android:textColor="?attr/colorPrimary" />

                <TextView
                    android:id="@+id/tvWorkerStats"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="5 tasks • 3 completed"
                    style="@style/Text.Caption.Small"
                    android:textSize="10sp"
                    android:textColor="?attr/colorOnSurface"
                    android:alpha="0.7" />

            </LinearLayout>

            <TextView
                android:id="@+id/tvCompletionRate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="75%"
                style="@style/Text.Label"
                android:textSize="12sp"
                android:textColor="?attr/colorSecondary"
                android:background="?attr/iconBackgroundGlass"
                android:paddingHorizontal="8dp"
                android:paddingVertical="2dp"
                app:cornerRadius="12dp" />

        </LinearLayout>

        <!-- Progress Bar - Compact -->
        <ProgressBar
            android:id="@+id/workerProgress"
            style="@style/Widget.AfriNuts.ProgressBar"
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:progress="75"
            android:max="100"
            android:progressTint="?attr/colorSecondary"
            android:progressBackgroundTint="?attr/colorSurfaceVariant"
            android:layout_marginBottom="8dp" />

        <!-- Task Type Chips - Compact -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/taskTypeContainer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal" />

        </HorizontalScrollView>

        <!-- Time Stats - Compact -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="?attr/cardBackgroundAccent"
            android:padding="8dp"
            android:gravity="center_vertical"
            app:cardCornerRadius="12dp">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_timer"
                app:tint="?attr/colorPrimary"
                android:layout_marginEnd="6dp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Total"
                style="@style/Text.Caption.Small"
                android:textSize="10sp"
                android:textColor="?attr/colorOnSurface"
                android:alpha="0.7" />

            <TextView
                android:id="@+id/tvTotalTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="2d 4h"
                style="@style/Text.Label"
                android:textSize="11sp"
                android:textColor="?attr/colorPrimary"
                android:layout_marginEnd="12dp" />

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_timer_off"
                app:tint="?attr/colorPrimary"
                android:layout_marginEnd="6dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Avg"
                style="@style/Text.Caption.Small"
                android:textSize="10sp"
                android:textColor="?attr/colorOnSurface"
                android:alpha="0.7"
                android:layout_marginEnd="4dp" />

            <TextView
                android:id="@+id/tvAvgTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="3h"
                style="@style/Text.Label"
                android:textSize="11sp"
                android:textColor="?attr/colorSecondary" />

        </LinearLayout>

    </LinearLayout>

</androidx.cardview.widget.CardView>