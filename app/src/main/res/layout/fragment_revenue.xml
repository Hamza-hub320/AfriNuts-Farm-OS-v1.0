<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background">

    <!-- Revenue summary pair -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="0dp"
        android:paddingEnd="0dp"
        android:paddingTop="14dp"
        android:paddingBottom="14dp">
        <androidx.cardview.widget.CardView
            android:layout_width="0dp" android:layout_height="wrap_content" android:minHeight="120dp" android:layout_weight="1.15" android:layout_marginEnd="6dp"
            app:cardCornerRadius="24dp" app:cardElevation="0dp" app:cardBackgroundColor="#0E6B3C">
            <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:gravity="center_vertical" android:padding="16dp" android:background="@drawable/bg_finance_summary_green">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Total revenue" android:textColor="#C7FFFFFF" android:textSize="13sp" android:fontFamily="@font/manrope_bold" />
                <TextView android:id="@+id/totalRevenueValue" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="0" android:textColor="#FFFFFF" android:textSize="25sp" android:maxLines="1" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="14sp" android:autoSizeMaxTextSize="25sp" android:autoSizeStepGranularity="1sp" android:fontFamily="@font/manrope_extrabold" />
                <TextView android:id="@+id/totalRevenueSubtitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="XAF · this season" android:textColor="#C7FFFFFF" android:textSize="12.5sp" android:fontFamily="@font/manrope_semibold" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>
        <androidx.cardview.widget.CardView
            android:layout_width="0dp" android:layout_height="wrap_content" android:minHeight="120dp" android:layout_weight="1" android:layout_marginStart="6dp"
            app:cardCornerRadius="24dp" app:cardElevation="0dp" app:cardBackgroundColor="#FFFFFF">
            <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:gravity="center_vertical" android:padding="16dp">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Total quantity" android:textColor="#59544C" android:textSize="13sp" android:fontFamily="@font/manrope_bold" />
                <TextView android:id="@+id/totalQuantityValue" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="0 kg" android:textColor="#1C1B1A" android:textSize="25sp" android:maxLines="1" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="14sp" android:autoSizeMaxTextSize="25sp" android:autoSizeStepGranularity="1sp" android:fontFamily="@font/manrope_extrabold" />
                <TextView android:id="@+id/totalQuantitySubtitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="RCN sold this season" android:textColor="#59544C" android:textSize="12.5sp" android:fontFamily="@font/manrope_semibold" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>
    </LinearLayout>

    <!-- Filter Chips - Updated for Processing Revenue -->
    <com.google.android.material.chip.ChipGroup
            android:id="@+id/filterChipGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="7dp"
            android:paddingVertical="0dp"
            app:singleSelection="true"
            app:selectionRequired="true"
            app:chipSpacingHorizontal="7dp"
            app:chipSpacingVertical="7dp">

            <com.google.android.material.chip.Chip
                android:id="@+id/chipAll"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="All"
                android:checked="true"
                style="@style/Widget.AfriNuts.FinanceChip" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipPremium"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Premium"
                style="@style/Widget.AfriNuts.FinanceChip" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipStandard"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Standard"
                style="@style/Widget.AfriNuts.FinanceChip" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipProcessing"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Processing"
                style="@style/Widget.AfriNuts.FinanceChip" />

        </com.google.android.material.chip.ChipGroup>

    <!-- Progress Bar -->
    <ProgressBar
        android:id="@+id/progressBar"
        style="@style/Widget.AfriNuts.ProgressBar"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_gravity="center"
        android:layout_marginTop="24dp"
        android:indeterminate="true"
        android:visibility="gone" />

    <!-- Empty State -->
    <LinearLayout
        android:id="@+id/emptyView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:layout_marginTop="48dp"
        android:visibility="gone">

        <FrameLayout
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:background="@drawable/bg_icon_sand">

            <ImageView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_attach_money"
                app:tint="?attr/colorOnSurface"
                android:alpha="0.5" />

        </FrameLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="No revenue records"
            style="@style/Text.H4"
            android:textSize="16sp"
            android:textColor="?attr/colorOnSurface"
            android:layout_marginTop="12dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tap + to record processing revenue"
            style="@style/Text.Caption"
            android:textSize="11sp"
            android:textColor="?attr/colorOnSurface"
            android:alpha="0.7"
            android:layout_marginTop="4dp" />

    </LinearLayout>

    <!-- RecyclerView -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingStart="0dp"
        android:paddingEnd="0dp"
        android:paddingTop="0dp"
        android:paddingBottom="20dp"
        android:clipToPadding="false"
        android:visibility="gone" />

</LinearLayout>
