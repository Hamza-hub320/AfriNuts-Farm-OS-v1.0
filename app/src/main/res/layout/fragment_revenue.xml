<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background">

    <!-- Summary Cards Row (2 columns) - Compact -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp"
        android:weightSum="2">

        <!-- Total Revenue Card -->
        <androidx.cardview.widget.CardView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            app:cardCornerRadius="20dp"
            app:cardElevation="2dp"
            style="@style/Widget.AfriNuts.CardView"
            android:background="@color/surface">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="12dp"
                android:background="@color/surface">

                <FrameLayout
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="@drawable/bg_icon_sand"
                    android:layout_marginBottom="4dp">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_attach_money"
                        app:tint="?attr/colorPrimary"
                        android:contentDescription="Revenue icon" />

                </FrameLayout>

                <TextView
                    android:id="@+id/totalRevenueValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0 XAF"
                    style="@style/Text.Stat"
                    android:textSize="16sp"
                    android:textColor="?attr/colorPrimary"
                    android:layout_marginTop="2dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Revenue"
                    style="@style/Text.Caption.Small"
                    android:textSize="10sp"
                    android:textColor="?attr/colorOnSurface"
                    android:alpha="0.7" />

            </LinearLayout>

        </androidx.cardview.widget.CardView>

        <!-- Total Quantity Sold Card -->
        <androidx.cardview.widget.CardView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            app:cardCornerRadius="20dp"
            app:cardElevation="2dp"
            style="@style/Widget.AfriNuts.CardView"
            android:background="@color/surface">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="12dp"
                android:background="@color/surface">

                <FrameLayout
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="@drawable/bg_icon_sand"
                    android:layout_marginBottom="4dp">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_inventory"
                        app:tint="@color/accent_ink"
                        android:contentDescription="Quantity icon" />

                </FrameLayout>

                <TextView
                    android:id="@+id/totalQuantityValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0 kg"
                    style="@style/Text.Stat"
                    android:textSize="16sp"
                    android:textColor="@color/accent_ink"
                    android:layout_marginTop="2dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Sold"
                    style="@style/Text.Caption.Small"
                    android:textSize="10sp"
                    android:textColor="?attr/colorOnSurface"
                    android:alpha="0.7" />

            </LinearLayout>

        </androidx.cardview.widget.CardView>

    </LinearLayout>

    <!-- Filter Chips - Updated for Processing Revenue -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:scrollbars="none"
        android:fadingEdgeLength="20dp"
        android:requiresFadingEdge="horizontal">

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/filterChipGroup"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="12dp"
            android:paddingVertical="2dp"
            app:singleSelection="true"
            app:selectionRequired="true"
            app:chipSpacing="6dp">

            <com.google.android.material.chip.Chip
                android:id="@+id/chipAll"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="All Sales"
                android:checked="true"
                app:chipIconTint="?attr/colorPrimary"
                style="@style/Widget.AfriNuts.Chip" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipPremium"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Premium"
                app:chipIcon="@drawable/ic_star"
                app:chipIconTint="@color/accent_ink"
                app:iconStartPadding="4dp"
                style="@style/Widget.AfriNuts.Chip" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipStandard"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Standard"
                app:chipIcon="@drawable/ic_check_circle"
                app:chipIconTint="?attr/colorPrimary"
                app:iconStartPadding="4dp"
                style="@style/Widget.AfriNuts.Chip" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipProcessing"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Processing"
                app:chipIcon="@drawable/ic_factory"
                app:chipIconTint="?attr/colorPrimaryVariant"
                app:iconStartPadding="4dp"
                style="@style/Widget.AfriNuts.Chip" />

        </com.google.android.material.chip.ChipGroup>

    </HorizontalScrollView>

    <!-- Progress Bar -->
    <ProgressBar
        android:id="@+id/progressBar"
        style="@style/Widget.AfriNuts.ProgressBar"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_gravity="center"
        android:layout_marginTop="24dp"
        android:indeterminate="true"
        android:visibility="gone" />

    <!-- Empty State -->
    <LinearLayout
        android:id="@+id/emptyView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:layout_marginTop="48dp"
        android:visibility="gone">

        <FrameLayout
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:background="@drawable/bg_icon_sand">

            <ImageView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_attach_money"
                app:tint="?attr/colorOnSurface"
                android:alpha="0.5" />

        </FrameLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="No revenue records"
            style="@style/Text.H4"
            android:textSize="16sp"
            android:textColor="?attr/colorOnSurface"
            android:layout_marginTop="12dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tap + to record processing revenue"
            style="@style/Text.Caption"
            android:textSize="11sp"
            android:textColor="?attr/colorOnSurface"
            android:alpha="0.7"
            android:layout_marginTop="4dp" />

    </LinearLayout>

    <!-- RecyclerView -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="6dp"
        android:clipToPadding="false"
        android:visibility="gone" />

    <!-- Spacer for bottom navigation -->
    <View
        android:layout_width="match_parent"
        android:layout_height="90dp" />

</LinearLayout>