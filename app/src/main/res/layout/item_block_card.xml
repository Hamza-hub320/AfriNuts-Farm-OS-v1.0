<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardView"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="6dp"
    style="@style/Widget.AfriNuts.CardView"
    app:cardCornerRadius="20dp"
    app:cardElevation="2dp"
    android:background="@color/surface">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp"
        android:background="@color/surface">

        <!-- Header with block name and status -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="8dp">

            <TextView
                android:id="@+id/blockNameText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Block A1"
                style="@style/Text.H5"
                android:textSize="18sp"
                android:textColor="?attr/colorPrimary" />

            <TextView
                android:id="@+id/statusText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/Widget.AfriNuts.StatusBadge"
                android:text="Planted"
                android:textSize="12sp"
                android:paddingHorizontal="8dp"
                android:paddingVertical="2dp" />

        </LinearLayout>

        <!-- Quick Stats - Compact -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="8dp"
            android:background="@color/surface"
            android:padding="6dp"
            app:cornerRadius="24dp">

            <FrameLayout
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:background="@drawable/bg_icon_sand"
                android:layout_marginEnd="8dp">

                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_park"
                    app:tint="?attr/colorPrimary" />

            </FrameLayout>

            <TextView
                android:id="@+id/statsText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Alive: 95 | Dead: 5"
                style="@style/Text.Caption"
                android:textSize="13sp"
                android:textColor="?attr/colorOnSurface" />

        </LinearLayout>

        <!-- Expandable Header -->
        <LinearLayout
            android:id="@+id/expandHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="2dp"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginBottom="4dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="View details"
                style="@style/Text.Caption"
                android:textSize="12sp"
                android:textColor="@color/accent_ink" />

            <FrameLayout
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:background="@drawable/bg_icon_sand">

                <ImageView
                    android:id="@+id/expandIcon"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_expand_more"
                    app:tint="@color/accent_ink" />

            </FrameLayout>

        </LinearLayout>

        <!-- Expandable Content -->
        <LinearLayout
            android:id="@+id/expandableContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            android:layout_marginTop="8dp">

            <!-- Planting Date -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="6dp"
                android:gravity="center_vertical"
                android:background="@color/surface"
                android:padding="6dp"
                app:cornerRadius="8dp">

                <FrameLayout
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:background="@drawable/bg_icon_sand"
                    android:layout_marginEnd="8dp">

                    <ImageView
                        android:layout_width="12dp"
                        android:layout_height="12dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_today"
                        app:tint="?attr/colorOnSurface"
                        android:alpha="0.7" />

                </FrameLayout>

                <TextView
                    android:layout_width="60dp"
                    android:layout_height="wrap_content"
                    android:text="Planted:"
                    style="@style/Text.Caption"
                    android:textSize="12sp"
                    android:textColor="?attr/colorOnSurface"
                    android:alpha="0.7" />

                <TextView
                    android:id="@+id/dateText"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Mar 15, 2024"
                    style="@style/Text.Caption"
                    android:textSize="12sp"
                    android:textColor="?attr/colorOnSurface" />

            </LinearLayout>

            <!-- Replacement Count -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="6dp"
                android:gravity="center_vertical"
                android:background="@color/surface"
                android:padding="6dp"
                app:cornerRadius="8dp">

                <FrameLayout
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:background="@drawable/bg_icon_sand"
                    android:layout_marginEnd="8dp">

                    <ImageView
                        android:layout_width="12dp"
                        android:layout_height="12dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_sync"
                        app:tint="?attr/colorOnSurface"
                        android:alpha="0.7" />

                </FrameLayout>

                <TextView
                    android:layout_width="60dp"
                    android:layout_height="wrap_content"
                    android:text="Replace:"
                    style="@style/Text.Caption"
                    android:textSize="12sp"
                    android:textColor="?attr/colorOnSurface"
                    android:alpha="0.7" />

                <TextView
                    android:id="@+id/replacementText"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="2 trees"
                    style="@style/Text.Caption"
                    android:textSize="12sp"
                    android:textColor="?attr/colorOnSurface" />

            </LinearLayout>

            <!-- Survival Rate - Compact -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="6dp"
                android:background="@color/surface"
                android:padding="8dp"
                app:cornerRadius="8dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="4dp">

                    <FrameLayout
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:background="@drawable/bg_icon_sand"
                        android:layout_marginEnd="8dp">

                        <ImageView
                            android:layout_width="12dp"
                            android:layout_height="12dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_trending_up"
                            app:tint="?attr/colorOnSurface"
                            android:alpha="0.7" />

                    </FrameLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Survival"
                        style="@style/Text.Caption"
                        android:textSize="12sp"
                        android:textColor="?attr/colorOnSurface"
                        android:alpha="0.7" />

                </LinearLayout>

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <ProgressBar
                        android:id="@+id/survivalProgress"
                        style="@style/Widget.AfriNuts.ProgressBar"
                        android:layout_width="match_parent"
                        android:layout_height="6dp"
                        android:progress="95"
                        android:max="100"
                        android:progressTint="?attr/colorPrimary"
                        android:progressBackgroundTint="?attr/colorSurfaceVariant" />

                    <TextView
                        android:id="@+id/survivalText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="95%"
                        style="@style/Text.Caption.Small"
                        android:textSize="11sp"
                        android:textColor="?attr/colorPrimary"
                        android:layout_gravity="end"
                        android:layout_marginTop="-8dp"
                        android:layout_marginEnd="2dp" />

                </FrameLayout>

            </LinearLayout>

            <!-- Notes - Compact -->
            <LinearLayout
                android:id="@+id/notesSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="4dp"
                android:background="@color/surface"
                android:padding="8dp"
                android:visibility="gone"
                app:cornerRadius="8dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="4dp">

                    <FrameLayout
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:background="@drawable/bg_icon_sand"
                        android:layout_marginEnd="8dp">

                        <ImageView
                            android:layout_width="12dp"
                            android:layout_height="12dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_note"
                            app:tint="?attr/colorPrimary" />

                    </FrameLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Notes"
                        style="@style/Text.Caption"
                        android:textSize="12sp"
                        android:textColor="?attr/colorPrimary" />

                </LinearLayout>

                <TextView
                    android:id="@+id/notesText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Sample notes here"
                    style="@style/Text.Caption"
                    android:textSize="12sp"
                    android:textColor="?attr/colorOnSurface" />

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</androidx.cardview.widget.CardView>