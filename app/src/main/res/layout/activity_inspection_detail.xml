<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?android:attr/colorBackground">

    <!-- Modern Glass Morphism Toolbar -->
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/surface"
        android:theme="@style/ThemeOverlay.AppCompat.Dark.ActionBar"
        android:elevation="0dp"
        android:translationZ="0dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="16dp"
        android:layout_gravity="center_horizontal">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">

            <ImageView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/ic_afrinuts_foreground"
                android:alpha="0.95"
                android:layout_marginEnd="12dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Inspection Details"
                android:textColor="?attr/colorOnSurface"
                android:textSize="18sp"
                android:textStyle="bold"
                android:letterSpacing="0.01" />

        </LinearLayout>

    </androidx.appcompat.widget.Toolbar>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="16dp"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Inspection ID -->
            <TextView
                android:id="@+id/tvInspectionId"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="INSP-ORG-2026-078"
                style="@style/Text.Caption.Small"
                android:textColor="?attr/colorOnSurface"
                android:alpha="0.5"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/tvSuperseded"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/status_suspended"
                android:textStyle="bold"
                android:layout_marginTop="4dp"
                android:visibility="gone" />

            <!-- Requirement Category -->
            <TextView
                android:id="@+id/tvRequirementCategory"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Field Inspection"
                style="@style/Text.H3"
                android:textColor="?attr/colorPrimary"
                android:layout_marginBottom="8dp" />

            <!-- Status Card -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp">

                <TextView
                    android:id="@+id/tvStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="8dp"
                    android:text="Pass"
                    android:textColor="@android:color/white"
                    android:textSize="14sp"
                    android:textStyle="bold" />

            </androidx.cardview.widget.CardView>

            <!-- Details Card -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="20dp"
                app:cardElevation="2dp"
                style="@style/Widget.AfriNuts.CardView">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:background="@color/surface">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Inspection Details"
                        style="@style/Text.H5"
                        android:textColor="?attr/colorPrimary"
                        android:layout_marginBottom="12dp" />

                    <!-- Certification -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="8dp">

                        <TextView
                            android:layout_width="120dp"
                            android:layout_height="wrap_content"
                            android:text="Certification"
                            style="@style/Text.Caption.Small"
                            android:textColor="?attr/colorOnSurface"
                            android:alpha="0.6" />

                        <TextView
                            android:id="@+id/tvCertification"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Organic (ECOCERT)"
                            style="@style/Text.Caption"
                            android:textColor="?attr/colorPrimary" />

                    </LinearLayout>

                    <!-- Inspection Type -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="8dp">

                        <TextView
                            android:layout_width="120dp"
                            android:layout_height="wrap_content"
                            android:text="Inspection Type"
                            style="@style/Text.Caption.Small"
                            android:textColor="?attr/colorOnSurface"
                            android:alpha="0.6" />

                        <TextView
                            android:id="@+id/tvInspectionType"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="External"
                            style="@style/Text.Caption"
                            android:textColor="?attr/colorOnSurface" />

                    </LinearLayout>

                    <!-- Inspection Date -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="8dp">

                        <TextView
                            android:layout_width="120dp"
                            android:layout_height="wrap_content"
                            android:text="Inspection Date"
                            style="@style/Text.Caption.Small"
                            android:textColor="?attr/colorOnSurface"
                            android:alpha="0.6" />

                        <TextView
                            android:id="@+id/tvInspectionDate"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Jul 12, 2026"
                            style="@style/Text.Caption"
                            android:textColor="?attr/colorOnSurface" />

                    </LinearLayout>

                    <!-- Inspector Name -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="8dp">

                        <TextView
                            android:layout_width="120dp"
                            android:layout_height="wrap_content"
                            android:text="Inspector"
                            style="@style/Text.Caption.Small"
                            android:textColor="?attr/colorOnSurface"
                            android:alpha="0.6" />

                        <TextView
                            android:id="@+id/tvInspectorName"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Jean Kouadio"
                            style="@style/Text.Caption"
                            android:textColor="?attr/colorOnSurface" />

                    </LinearLayout>

                    <!-- Inspector Body -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="8dp">

                        <TextView
                            android:layout_width="120dp"
                            android:layout_height="wrap_content"
                            android:text="Inspector Body"
                            style="@style/Text.Caption.Small"
                            android:textColor="?attr/colorOnSurface"
                            android:alpha="0.6" />

                        <TextView
                            android:id="@+id/tvInspectorBody"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="ECOCERT"
                            style="@style/Text.Caption"
                            android:textColor="?attr/colorOnSurface" />

                    </LinearLayout>

                    <!-- Remarks -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="8dp">

                        <TextView
                            android:layout_width="120dp"
                            android:layout_height="wrap_content"
                            android:text="Remarks"
                            style="@style/Text.Caption.Small"
                            android:textColor="?attr/colorOnSurface"
                            android:alpha="0.6" />

                        <TextView
                            android:id="@+id/tvRemarks"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="No issues found"
                            style="@style/Text.Caption"
                            android:textColor="?attr/colorOnSurface" />

                    </LinearLayout>

                    <!-- Report URL -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="8dp">

                        <TextView
                            android:layout_width="120dp"
                            android:layout_height="wrap_content"
                            android:text="Report"
                            style="@style/Text.Caption.Small"
                            android:textColor="?attr/colorOnSurface"
                            android:alpha="0.6" />

                        <TextView
                            android:id="@+id/tvReportUrl"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="https://.../inspection-2026-078.pdf"
                            style="@style/Text.Caption"
                            android:textColor="?attr/colorPrimary"
                            android:autoLink="web" />

                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="?attr/colorOnSurface"
                        android:alpha="0.1"
                        android:layout_marginVertical="12dp" />

                    <!-- Timestamps -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="4dp">

                        <TextView
                            android:layout_width="120dp"
                            android:layout_height="wrap_content"
                            android:text="Created"
                            style="@style/Text.Caption.Small"
                            android:textColor="?attr/colorOnSurface"
                            android:alpha="0.5" />

                        <TextView
                            android:id="@+id/tvCreatedAt"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Jul 18, 2026"
                            style="@style/Text.Caption.Small"
                            android:textColor="?attr/colorOnSurface"
                            android:alpha="0.5" />

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="4dp">

                        <TextView
                            android:layout_width="120dp"
                            android:layout_height="wrap_content"
                            android:text="Validated"
                            style="@style/Text.Caption.Small"
                            android:textColor="?attr/colorOnSurface"
                            android:alpha="0.5" />

                        <TextView
                            android:id="@+id/tvValidated"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="—"
                            style="@style/Text.Caption.Small"
                            android:textColor="?attr/colorOnSurface"
                            android:alpha="0.5" />

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="120dp"
                            android:layout_height="wrap_content"
                            android:text="Last Updated"
                            style="@style/Text.Caption.Small"
                            android:textColor="?attr/colorOnSurface"
                            android:alpha="0.5" />

                        <TextView
                            android:id="@+id/tvUpdatedAt"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Jul 18, 2026"
                            style="@style/Text.Caption.Small"
                            android:textColor="?attr/colorOnSurface"
                            android:alpha="0.5" />

                    </LinearLayout>

                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <!-- Corrective Actions Card -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardCorrectiveActions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:visibility="gone"
                app:cardCornerRadius="20dp"
                app:cardElevation="2dp"
                style="@style/Widget.AfriNuts.CardView">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:background="@color/surface">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="12dp">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/ic_warning"
                            app:tint="@color/accent_ink"
                            android:layout_marginEnd="8dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Corrective Actions"
                            style="@style/Text.H5"
                            android:textColor="@color/accent_ink" />

                        <TextView
                            android:id="@+id/tvActionsCount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="(2)"
                            style="@style/Text.Caption"
                            android:textColor="?attr/colorOnSurface"
                            android:alpha="0.6"
                            android:layout_marginStart="4dp" />

                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/actionsContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />

                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <!-- Photos Card -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardPhotos"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:visibility="gone"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                style="@style/Widget.AfriNuts.CardView">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:background="@color/surface">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Photos"
                        style="@style/Text.H5"
                        android:textColor="?attr/colorPrimary"
                        android:layout_marginBottom="12dp" />

                    <!-- Photo thumbnails will be added here -->
                    <LinearLayout
                        android:id="@+id/photosContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal" />

                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCorrect"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Correct this record"
                style="@style/Widget.AfriNuts.Button" />

        </LinearLayout>

    </ScrollView>

</LinearLayout>