<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_marginStart="20dp"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="20dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/toolbarBack"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_farm_action_circle"
                android:contentDescription="Back"
                android:padding="12dp"
                android:src="@drawable/ic_finance_back_chevron"
                app:tint="#1C1B1A" />

            <TextView
                android:id="@+id/toolbarTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="Users"
                android:textColor="#1C1B1A"
                android:textSize="17sp"
                android:fontFamily="@font/manrope_extrabold" />

            <ImageButton
                android:id="@+id/toolbarMore"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_farm_action_circle"
                android:contentDescription="More actions"
                android:padding="11dp"
                android:src="@drawable/ic_farm_more"
                app:tint="#1C1B1A" />
        </LinearLayout>

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/filterChipGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="20dp"
            android:layout_marginBottom="12dp"
            app:chipSpacingHorizontal="8dp"
            app:chipSpacingVertical="8dp"
            app:singleLine="false"
            app:singleSelection="true"
            app:selectionRequired="true">

            <com.google.android.material.chip.Chip
                android:id="@+id/chipAll"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:checked="true"
                android:text="All"
                style="@style/Widget.AfriNuts.Chip" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipOwners"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:text="Owners"
                style="@style/Widget.AfriNuts.Chip" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipManagers"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:text="Managers"
                style="@style/Widget.AfriNuts.Chip" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipWorkers"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:text="Workers"
                style="@style/Widget.AfriNuts.Chip" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipInvestors"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:text="Investors"
                style="@style/Widget.AfriNuts.Chip" />
        </com.google.android.material.chip.ChipGroup>

        <ProgressBar
            android:id="@+id/progressBar"
            style="@style/Widget.AfriNuts.ProgressBar"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_gravity="center"
            android:layout_marginTop="24dp"
            android:indeterminate="true"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/emptyView"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="No users yet"
                android:textColor="#1C1B1A"
                android:textSize="16sp"
                android:fontFamily="@font/manrope_extrabold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Add your first user"
                android:textColor="#59544C"
                android:textSize="14sp"
                android:fontFamily="@font/manrope" />
        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerView"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingStart="12dp"
            android:paddingTop="0dp"
            android:paddingEnd="12dp"
            android:paddingBottom="92dp" />
    </LinearLayout>

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabAddUser"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_gravity="bottom|end"
        android:layout_margin="20dp"
        android:contentDescription="Add user"
        android:src="@drawable/ic_add"
        app:backgroundTint="#0E6B3C"
        app:elevation="0dp"
        app:tint="@android:color/white" />
</FrameLayout>
