<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="16dp"
        android:layout_gravity="center_horizontal">

        <ImageView
            android:id="@+id/btnHeaderBack"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_gravity="start|center_vertical"
            android:background="@drawable/bg_detail_header_button"
            android:contentDescription="Back"
            android:padding="12dp"
            android:src="@drawable/ic_backward"
            app:tint="#1C1B1A" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:text="Bulk detail"
            android:textColor="#1C1B1A"
            android:textSize="17sp"
            android:fontFamily="@font/manrope_extrabold" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_gravity="end|center_vertical"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/btnHeaderShare"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_detail_header_button"
                android:contentDescription="Share"
                android:padding="12dp"
                android:src="@drawable/ic_share"
                app:tint="#1C1B1A" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDelete"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginStart="8dp"
                android:contentDescription="Delete"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:text=""
                app:backgroundTint="#FFFFFF"
                app:cornerRadius="22dp"
                app:icon="@drawable/ic_delete"
                app:iconSize="20dp"
                app:iconTint="#1C1B1A"
                app:strokeColor="#E9E1CF"
                app:strokeWidth="1dp" />
        </LinearLayout>
    </FrameLayout>

    <ScrollView
        android:id="@+id/masterDetailScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:layout_marginBottom="12dp"
                app:cardBackgroundColor="@color/surface"
                app:cardCornerRadius="28dp"
                app:cardElevation="0dp"
                style="@style/Widget.AfriNuts.CardView">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:id="@+id/tvMasterBatchNumber"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="#MB-20260709-614"
                        android:textColor="#1C1B1A"
                        android:textSize="22sp"
                        android:fontFamily="@font/manrope_extrabold"
                        android:maxLines="2"
                        android:ellipsize="end" />

                    <TextView
                        android:id="@+id/tvShipmentName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Omani Nuts Bulk"
                        android:textColor="#1C1B1A"
                        android:textSize="16sp"
                        android:fontFamily="@font/manrope_extrabold" />

                    <TextView
                        android:id="@+id/tvHeroSubtitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Omani Nuts · Jul 09, 2026"
                        android:textColor="#59544C"
                        android:textSize="14sp"
                        android:fontFamily="@font/manrope_medium" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:orientation="horizontal">

                <androidx.cardview.widget.CardView
                    android:layout_width="0dp"
                    android:layout_height="100dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="4dp"
                    app:cardBackgroundColor="#0E6B3C"
                    app:cardCornerRadius="24dp"
                    app:cardElevation="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center_vertical"
                        android:orientation="vertical"
                        android:padding="12dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Total Weight"
                            android:textColor="#C7E3D4"
                            android:textSize="12sp"
                            android:fontFamily="@font/manrope_bold" />

                        <TextView
                            android:id="@+id/tvTotalWeight"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="65,000 kg"
                            android:textColor="#FFFFFF"
                            android:textSize="18sp"
                            android:fontFamily="@font/manrope_extrabold"
                            android:maxLines="1"
                            android:ellipsize="end" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <androidx.cardview.widget.CardView
                    android:layout_width="0dp"
                    android:layout_height="100dp"
                    android:layout_weight="1"
                    android:layout_marginStart="4dp"
                    android:layout_marginEnd="4dp"
                    app:cardBackgroundColor="@color/surface"
                    app:cardCornerRadius="24dp"
                    app:cardElevation="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center_vertical"
                        android:orientation="vertical"
                        android:padding="12dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Total Batches"
                            android:textColor="#59544C"
                            android:textSize="12sp"
                            android:fontFamily="@font/manrope_bold" />

                        <TextView
                            android:id="@+id/tvTotalBatches"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="3 batches"
                            android:textColor="#1C1B1A"
                            android:textSize="18sp"
                            android:fontFamily="@font/manrope_extrabold"
                            android:maxLines="2"
                            android:ellipsize="end" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <androidx.cardview.widget.CardView
                    android:layout_width="0dp"
                    android:layout_height="100dp"
                    android:layout_weight="1"
                    android:layout_marginStart="4dp"
                    app:cardBackgroundColor="@color/surface"
                    app:cardCornerRadius="24dp"
                    app:cardElevation="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center_vertical"
                        android:orientation="vertical"
                        android:padding="12dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Grades"
                            android:textColor="#59544C"
                            android:textSize="12sp"
                            android:fontFamily="@font/manrope_bold" />

                        <TextView
                            android:id="@+id/tvGrades"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="Premium · Standard"
                            android:textColor="#1C1B1A"
                            android:textSize="16sp"
                            android:fontFamily="@font/manrope_extrabold"
                            android:maxLines="2"
                            android:ellipsize="end" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>
            </LinearLayout>

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardBackgroundColor="@color/surface"
                app:cardCornerRadius="24dp"
                app:cardElevation="0dp"
                style="@style/Widget.AfriNuts.CardView">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Shipment"
                        android:textColor="#1C1B1A"
                        android:textSize="16sp"
                        android:fontFamily="@font/manrope_extrabold"
                        android:layout_marginBottom="6dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:minHeight="42dp"
                        android:orientation="horizontal"
                        android:paddingVertical="8dp">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Buyer"
                            android:textColor="#59544C"
                            android:textSize="13sp"
                            android:fontFamily="@font/manrope_semibold" />
                        <TextView
                            android:id="@+id/tvBuyer"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1.3"
                            android:gravity="end"
                            android:text="Omani Nuts"
                            android:textColor="#1C1B1A"
                            android:textSize="14sp"
                            android:fontFamily="@font/manrope_bold" />
                    </LinearLayout>
                    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#E9E1CF" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:minHeight="42dp"
                        android:orientation="horizontal"
                        android:paddingVertical="8dp">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Destination"
                            android:textColor="#59544C"
                            android:textSize="13sp"
                            android:fontFamily="@font/manrope_semibold" />
                        <TextView
                            android:id="@+id/tvDestination"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1.3"
                            android:gravity="end"
                            android:text="Muscat, Oman"
                            android:textColor="#1C1B1A"
                            android:textSize="14sp"
                            android:fontFamily="@font/manrope_bold" />
                    </LinearLayout>
                    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#E9E1CF" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:minHeight="42dp"
                        android:orientation="horizontal"
                        android:paddingVertical="8dp">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Export date"
                            android:textColor="#59544C"
                            android:textSize="13sp"
                            android:fontFamily="@font/manrope_semibold" />
                        <TextView
                            android:id="@+id/tvExportDate"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1.3"
                            android:gravity="end"
                            android:text="Jul 09, 2026"
                            android:textColor="#1C1B1A"
                            android:textSize="14sp"
                            android:fontFamily="@font/manrope_bold" />
                    </LinearLayout>
                    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#E9E1CF" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:minHeight="42dp"
                        android:orientation="horizontal"
                        android:paddingVertical="8dp">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Certifications"
                            android:textColor="#59544C"
                            android:textSize="13sp"
                            android:fontFamily="@font/manrope_semibold" />
                        <TextView
                            android:id="@+id/tvCertifications"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1.3"
                            android:gravity="end"
                            android:text="—"
                            android:textColor="#1C1B1A"
                            android:textSize="14sp"
                            android:fontFamily="@font/manrope_bold" />
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardBackgroundColor="@color/surface"
                app:cardCornerRadius="24dp"
                app:cardElevation="0dp"
                style="@style/Widget.AfriNuts.CardView">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="6dp"
                        android:text="Batches"
                        android:textColor="#1C1B1A"
                        android:textSize="16sp"
                        android:fontFamily="@font/manrope_extrabold" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/recyclerViewBatches"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:nestedScrollingEnabled="false" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardBackgroundColor="@color/surface"
                app:cardCornerRadius="24dp"
                app:cardElevation="0dp"
                style="@style/Widget.AfriNuts.CardView">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Traceability"
                        android:textColor="#1C1B1A"
                        android:textSize="16sp"
                        android:fontFamily="@font/manrope_extrabold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Master traceability"
                        android:textColor="#59544C"
                        android:textSize="13sp"
                        android:fontFamily="@font/manrope_semibold" />

                    <TextView
                        android:id="@+id/tvTraceabilityUrl"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="afrinutsexport.com/trace/MB-20260709-614"
                        android:textColor="#0E6B3C"
                        android:textSize="14sp"
                        android:fontFamily="@font/manrope_bold"
                        android:autoLink="web"
                        android:linksClickable="true" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnGenerateQRSection"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="12dp"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:minHeight="0dp"
                        android:text="Generate QR"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp"
                        android:fontFamily="@font/manrope_bold"
                        app:backgroundTint="@color/primary"
                        app:cornerRadius="24dp"
                        app:icon="@drawable/ic_qr_code"
                        app:iconGravity="textStart"
                        app:iconTint="#FFFFFF" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnGenerateQR"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:minHeight="0dp"
                    android:text="Generate QR"
                    android:textColor="#1C1B1A"
                    android:textSize="14sp"
                    android:fontFamily="@font/manrope_extrabold"
                    app:backgroundTint="@color/primary_light"
                    app:cornerRadius="26dp"
                    app:icon="@drawable/ic_qr_code"
                    app:iconGravity="textStart"
                    app:iconTint="#1C1B1A" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnShare"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:minHeight="0dp"
                    android:text="Share"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:fontFamily="@font/manrope_extrabold"
                    app:backgroundTint="@color/primary"
                    app:cornerRadius="26dp"
                    app:icon="@drawable/ic_share"
                    app:iconGravity="textStart"
                    app:iconTint="#FFFFFF" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
