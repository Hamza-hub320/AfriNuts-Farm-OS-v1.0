<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/farmDetailHeader"
    android:layout_width="match_parent"
    android:layout_height="64dp"
    android:layout_marginStart="20dp"
    android:layout_marginTop="8dp"
    android:layout_marginEnd="20dp"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <ImageButton
        android:id="@+id/farmDetailBack"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="@drawable/bg_farm_action_circle"
        android:contentDescription="Back"
        android:padding="12dp"
        android:scaleType="center"
        android:src="@drawable/ic_finance_back_chevron"
        app:tint="#1C1B1A" />

    <TextView
        android:id="@+id/farmDetailTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:gravity="center"
        android:textColor="#1C1B1A"
        android:textSize="17sp"
        android:fontFamily="@font/manrope_extrabold" />

    <ImageButton
        android:id="@+id/farmDetailEdit"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginEnd="9dp"
        android:background="@drawable/bg_farm_action_circle"
        android:contentDescription="Edit record"
        android:padding="12dp"
        android:src="@drawable/ic_farm_edit"
        android:tint="#1C1B1A" />

    <ImageButton
        android:id="@+id/farmDetailMore"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="@drawable/bg_farm_action_circle"
        android:contentDescription="More actions"
        android:padding="11dp"
        android:src="@drawable/ic_farm_more"
        android:tint="#1C1B1A" />
</LinearLayout>
