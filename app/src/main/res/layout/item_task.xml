<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="6dp"
    app:cardCornerRadius="24dp"
    app:cardElevation="2dp"
    android:background="?attr/cardBackgroundPrimary"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp"
        android:background="?attr/cardBackgroundPrimary">

        <!-- Top Row: Icon + Title + Status -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="8dp">

            <!-- Icon Container - Smaller -->
            <FrameLayout
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginEnd="10dp"
                android:background="?attr/iconBackgroundGlass">

                <ImageView
                    android:id="@+id/tvTaskIcon"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_tractor"
                    app:tint="?attr/colorPrimary"
                    android:contentDescription="Task icon" />

            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvTaskTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Clear Block A1"
                    style="@style/Text.H6"
                    android:textSize="16sp"
                    android:textColor="?attr/colorPrimary"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvTaskScope"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Block A1"
                    style="@style/Text.Caption.Small"
                    android:textSize="12sp"
                    android:textColor="?attr/colorOnSurface"
                    android:alpha="0.7" />

            </LinearLayout>

            <!-- Status Badge - Smaller -->
            <TextView
                android:id="@+id/tvTaskStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/Widget.AfriNuts.StatusBadge"
                android:text="Pending"
                android:textSize="12sp"
                android:paddingHorizontal="8dp"
                android:paddingVertical="3dp"
                app:cornerRadius="12dp" />

        </LinearLayout>

        <!-- Description (if available) - Compact -->
        <TextView
            android:id="@+id/tvTaskDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Clear land for planting cashew trees"
            style="@style/Text.Caption"
            android:textSize="13sp"
            android:textColor="?attr/colorOnSurface"
            android:alpha="0.8"
            android:layout_marginBottom="8dp"
            android:maxLines="2"
            android:ellipsize="end"
            android:background="?attr/cardBackgroundAccent"
            android:padding="8dp" />

        <!-- Bottom Row: Due Date + Overdue Warning - Compact -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="?attr/cardBackgroundAccent"
            android:padding="8dp"
            app:cardCornerRadius="10dp">

            <!-- Due Date Section -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:src="@drawable/ic_today"
                    app:tint="?attr/colorPrimary"
                    android:layout_marginEnd="6dp"
                    android:contentDescription="Due date" />

                <TextView
                    android:id="@+id/tvDueDate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Due: Mar 15"
                    style="@style/Text.Caption.Small"
                    android:textSize="12sp"
                    android:textColor="?attr/colorOnSurface"
                    android:alpha="0.7" />

            </LinearLayout>

            <!-- Overdue Warning Section - Compact -->
            <LinearLayout
                android:id="@+id/overdueLayout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_warning"
                android:paddingHorizontal="6dp"
                android:paddingVertical="2dp"
                android:visibility="gone"
                app:cardCornerRadius="8dp">

                <ImageView
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:src="@drawable/ic_warning"
                    app:tint="@color/error"
                    android:layout_marginEnd="3dp"
                    android:contentDescription="Overdue warning" />

                <TextView
                    android:id="@+id/tvOverdueWarning"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Overdue"
                    style="@style/Text.Caption.Small"
                    android:textSize="11sp"
                    android:textColor="@color/error" />

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</androidx.cardview.widget.CardView>