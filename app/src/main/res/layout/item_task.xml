<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    app:cardCornerRadius="20dp"
    app:cardElevation="4dp"
    android:foreground="?android:attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true"
    android:background="@drawable/bg_card_primary">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Top Row: Icon + Title + Status -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="12dp">

            <!-- Icon Container with Gradient Background -->
            <FrameLayout
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginEnd="12dp"
                android:background="@drawable/bg_icon_container">

                <ImageView
                    android:id="@+id/tvTaskIcon"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_tractor"
                    app:tint="@color/primary"
                    android:contentDescription="Task icon" />

            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvTaskTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Clear Block A1"
                    style="@style/Text.H5"
                    android:textColor="@color/primary"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvTaskScope"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Block A1"
                    style="@style/Text.Caption"
                    android:textColor="@color/navy" />

            </LinearLayout>

            <!-- Status Badge with Dynamic Background -->
            <TextView
                android:id="@+id/tvTaskStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/Widget.AfriNuts.StatusBadge"
                android:text="Pending"
                android:textSize="12sp"
                android:paddingHorizontal="12dp"
                android:paddingVertical="6dp"
                app:cornerRadius="16dp" />

        </LinearLayout>

        <!-- Description (if available) with Rounded Background -->
        <TextView
            android:id="@+id/tvTaskDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Clear land for planting cashew trees"
            style="@style/Text.Body.Small"
            android:textColor="@color/text_dark"
            android:layout_marginBottom="12dp"
            android:maxLines="2"
            android:ellipsize="end"
            android:background="@drawable/bg_rounded_description"
            android:padding="10dp" />

        <!-- Bottom Row: Due Date + Overdue Warning - Modern Glass Style -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_glassy_overlay"
            android:padding="12dp"
            app:cardCornerRadius="12dp">

            <!-- Due Date Section -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/ic_today"
                    app:tint="@color/primary"
                    android:layout_marginEnd="8dp"
                    android:contentDescription="Due date" />

                <TextView
                    android:id="@+id/tvDueDate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Due: Mar 15, 2024"
                    style="@style/Text.Caption"
                    android:textColor="@color/navy" />

            </LinearLayout>

            <!-- Overdue Warning Section -->
            <LinearLayout
                android:id="@+id/overdueLayout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_warning"
                android:paddingHorizontal="8dp"
                android:paddingVertical="4dp"
                android:visibility="gone"
                app:cardCornerRadius="12dp">

                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:src="@drawable/ic_warning"
                    app:tint="@android:color/holo_red_dark"
                    android:layout_marginEnd="4dp"
                    android:contentDescription="Overdue warning" />

                <TextView
                    android:id="@+id/tvOverdueWarning"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Overdue"
                    style="@style/Text.Caption.Small"
                    android:textColor="@android:color/holo_red_dark" />

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</androidx.cardview.widget.CardView>