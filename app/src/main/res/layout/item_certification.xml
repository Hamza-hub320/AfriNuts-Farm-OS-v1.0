<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardView"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="4dp"
    app:cardBackgroundColor="@color/surface"
    app:cardCornerRadius="24dp"
    app:cardElevation="0dp"
    android:foreground="?android:attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <TextView
                android:id="@+id/tvCertificationName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Organic (ECOCERT)"
                android:textColor="@color/text_primary"
                android:textSize="17sp"
                android:fontFamily="@font/manrope_extrabold" />
            <ImageView
                android:id="@+id/ivStatusIcon"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginEnd="6dp"
                android:contentDescription="Status" />
            <TextView
                android:id="@+id/tvStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingHorizontal="10dp"
                android:paddingVertical="5dp"
                android:text="Audit Ready"
                android:textColor="@android:color/white"
                android:textSize="10sp"
                android:fontFamily="@font/manrope_extrabold" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvCertificationId"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="CERT-ORG-2026-001"
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            android:fontFamily="@font/manrope_semibold" />

        <TextView
            android:id="@+id/tvCertificationBody"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Issued by: ECOCERT"
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            android:fontFamily="@font/manrope_medium" />

        <TextView
            android:id="@+id/tvScope"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Farm operations, processing facility"
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            android:fontFamily="@font/manrope_medium" />

        <TextView
            android:id="@+id/tvStandards"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Standards: EU Organic Regulation"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            android:fontFamily="@font/manrope_medium" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="10dp"
            android:background="#E9E1CF" />

        <TextView
            android:id="@+id/tvDates"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Target: Aug 31, 2029"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            android:fontFamily="@font/manrope_bold" />
    </LinearLayout>
</androidx.cardview.widget.CardView>
