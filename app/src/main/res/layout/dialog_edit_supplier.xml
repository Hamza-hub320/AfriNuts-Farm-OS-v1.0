<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Edit Supplier"
            style="@style/Text.H4"
            android:textColor="?attr/colorPrimary"
            android:layout_marginBottom="16dp" />

        <!-- Supplier Name -->
        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.AfriNuts.EditText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Supplier Name"
                android:inputType="text" />

        </com.google.android.material.textfield.TextInputLayout>

        <!-- Supplier Type -->
        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.AfriNuts.EditText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:endIconMode="dropdown_menu">

            <com.google.android.material.textfield.MaterialAutoCompleteTextView
                android:id="@+id/etType"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Supplier Type"
                android:inputType="none" />

        </com.google.android.material.textfield.TextInputLayout>

        <!-- Contact Person -->
        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.AfriNuts.EditText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etContactPerson"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Contact Person / Farmer Name"
                android:inputType="text" />

        </com.google.android.material.textfield.TextInputLayout>

        <!-- Phone -->
        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.AfriNuts.EditText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etPhone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Phone"
                android:inputType="phone" />

        </com.google.android.material.textfield.TextInputLayout>

        <!-- Email -->
        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.AfriNuts.EditText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etEmail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Email"
                android:inputType="textEmailAddress" />

        </com.google.android.material.textfield.TextInputLayout>

        <!-- Location -->
        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.AfriNuts.EditText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etLocation"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Location"
                android:inputType="text" />

        </com.google.android.material.textfield.TextInputLayout>

        <!-- Registration Number -->
        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.AfriNuts.EditText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etRegistrationNumber"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Registration Number (cooperative)"
                android:inputType="text" />

        </com.google.android.material.textfield.TextInputLayout>

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="?attr/colorOnSurface"
            android:alpha="0.1"
            android:layout_marginVertical="12dp" />

        <!-- ✅ Cooperative linkage + Farmer ID -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Cooperative Linkage"
            style="@style/Text.H5"
            android:textColor="@color/accent_ink"
            android:layout_marginBottom="4dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Use these when this row is an individual farmer who belongs to a cooperative."
            style="@style/Text.Caption.Small"
            android:textColor="?attr/colorOnSurface"
            android:alpha="0.7"
            android:layout_marginBottom="12dp" />

        <!-- Cooperative Name -->
        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.AfriNuts.EditText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:boxBackgroundColor="?attr/colorSurface"
            app:boxCornerRadiusBottomEnd="12dp"
            app:boxCornerRadiusBottomStart="12dp"
            app:boxCornerRadiusTopEnd="12dp"
            app:boxCornerRadiusTopStart="12dp"
            app:boxStrokeColor="?attr/colorSecondary">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etCooperativeName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Cooperative name"
                android:inputType="text"
                android:textColor="?attr/colorOnSurface"
                android:textColorHint="?attr/colorOnSurface" />

        </com.google.android.material.textfield.TextInputLayout>

        <!-- Cooperative ID -->
        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.AfriNuts.EditText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:boxBackgroundColor="?attr/colorSurface"
            app:boxCornerRadiusBottomEnd="12dp"
            app:boxCornerRadiusBottomStart="12dp"
            app:boxCornerRadiusTopEnd="12dp"
            app:boxCornerRadiusTopStart="12dp"
            app:boxStrokeColor="?attr/colorSecondary">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etCooperativeId"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Cooperative ID / registration"
                android:inputType="text"
                android:textColor="?attr/colorOnSurface"
                android:textColorHint="?attr/colorOnSurface" />

        </com.google.android.material.textfield.TextInputLayout>

        <!-- Farmer ID -->
        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.AfriNuts.EditText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:boxBackgroundColor="?attr/colorSurface"
            app:boxCornerRadiusBottomEnd="12dp"
            app:boxCornerRadiusBottomStart="12dp"
            app:boxCornerRadiusTopEnd="12dp"
            app:boxCornerRadiusTopStart="12dp"
            app:boxStrokeColor="?attr/colorPrimary">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etFarmerIdNumber"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Farmer ID (national / member ID)"
                android:inputType="text"
                android:textColor="?attr/colorOnSurface"
                android:textColorHint="?attr/colorOnSurface" />

        </com.google.android.material.textfield.TextInputLayout>

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="?attr/colorOnSurface"
            android:alpha="0.1"
            android:layout_marginVertical="12dp" />

        <!-- Farmer Profile Section -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Farmer Profile"
            style="@style/Text.H5"
            android:textColor="@color/accent_ink"
            android:layout_marginBottom="12dp" />

        <!-- Years Farming -->
        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.AfriNuts.EditText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etYearsFarming"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Years Farming"
                android:inputType="number" />

        </com.google.android.material.textfield.TextInputLayout>

        <!-- Farm Size -->
        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.AfriNuts.EditText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etFarmSize"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Farm Size (hectares)"
                android:inputType="numberDecimal" />

        </com.google.android.material.textfield.TextInputLayout>

        <!-- Quote -->
        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.AfriNuts.EditText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etQuote"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Quote / Motto"
                android:inputType="text" />

        </com.google.android.material.textfield.TextInputLayout>

        <!-- Bio -->
        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.AfriNuts.EditText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etBio"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Bio / Description"
                android:inputType="textMultiLine"
                android:minLines="2" />

        </com.google.android.material.textfield.TextInputLayout>

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="?attr/colorOnSurface"
            android:alpha="0.1"
            android:layout_marginVertical="12dp" />

        <!-- Sustainability Practices -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Sustainability Practices"
            style="@style/Text.H5"
            android:textColor="@color/accent_ink"
            android:layout_marginBottom="12dp" />

        <!-- Firebreak Protection -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@color/surface"
            android:padding="12dp"
            android:layout_marginBottom="8dp"
            app:cornerRadius="12dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Firebreak Protection"
                style="@style/Text.Body"
                android:textColor="?attr/colorOnSurface" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/switchFirebreak"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="false" />

        </LinearLayout>

        <!-- Sustainable Harvesting -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@color/surface"
            android:padding="12dp"
            android:layout_marginBottom="8dp"
            app:cornerRadius="12dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Sustainable Harvesting"
                style="@style/Text.Body"
                android:textColor="?attr/colorOnSurface" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/switchSustainable"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="false" />

        </LinearLayout>

        <!-- No Child Labor -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@color/surface"
            android:padding="12dp"
            android:layout_marginBottom="12dp"
            app:cornerRadius="12dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="No Child Labor Policy"
                style="@style/Text.Body"
                android:textColor="?attr/colorOnSurface" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/switchChildLabor"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="false" />

        </LinearLayout>

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="?attr/colorOnSurface"
            android:alpha="0.1"
            android:layout_marginVertical="12dp" />

        <!-- ✅ Farmer Data Consent (granular) -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Farmer Data Consent"
            style="@style/Text.H5"
            android:textColor="@color/accent_ink"
            android:layout_marginBottom="4dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="A farmer can give consent to one, two, or all three. Unticked items are withheld from the Buyer Portal."
            style="@style/Text.Caption.Small"
            android:textColor="?attr/colorOnSurface"
            android:alpha="0.7"
            android:layout_marginBottom="12dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@color/surface"
            android:padding="12dp"
            android:layout_marginBottom="8dp"
            app:cornerRadius="12dp">

            <!-- Identity -->
            <CheckBox
                android:id="@+id/cbConsentIdentity"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:buttonTint="?attr/colorPrimary" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="My identity — my name may be shown to verified buyers in the Buyer Portal."
                style="@style/Text.Body"
                android:textColor="?attr/colorOnSurface"
                android:layout_marginStart="4dp"
                android:layout_marginBottom="2dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Mon identité — mon nom peut être montré aux acheteurs vérifiés dans le portail acheteur."
                style="@style/Text.Caption.Small"
                android:textColor="?attr/colorOnSurface"
                android:alpha="0.75"
                android:layout_marginStart="4dp"
                android:layout_marginBottom="12dp" />

            <!-- Precise location -->
            <CheckBox
                android:id="@+id/cbConsentLocation"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:buttonTint="?attr/colorPrimary" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="My precise location — the GPS coordinates of my farm may be shown to verified buyers in the Buyer Portal."
                style="@style/Text.Body"
                android:textColor="?attr/colorOnSurface"
                android:layout_marginStart="4dp"
                android:layout_marginBottom="2dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Ma localisation précise — les coordonnées GPS de ma ferme peuvent être montrées aux acheteurs vérifiés dans le portail acheteur."
                style="@style/Text.Caption.Small"
                android:textColor="?attr/colorOnSurface"
                android:alpha="0.75"
                android:layout_marginStart="4dp"
                android:layout_marginBottom="12dp" />

            <!-- Photo -->
            <CheckBox
                android:id="@+id/cbConsentPhoto"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:buttonTint="?attr/colorPrimary" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="My photo — my photo may be shown to verified buyers in the Buyer Portal."
                style="@style/Text.Body"
                android:textColor="?attr/colorOnSurface"
                android:layout_marginStart="4dp"
                android:layout_marginBottom="2dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Ma photo — ma photo peut être montrée aux acheteurs vérifiés dans le portail acheteur."
                style="@style/Text.Caption.Small"
                android:textColor="?attr/colorOnSurface"
                android:alpha="0.75"
                android:layout_marginStart="4dp" />

        </LinearLayout>

        <!-- ✅ Consent audit meta -->
        <LinearLayout
            android:id="@+id/layoutConsentMeta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@color/surface"
            android:padding="12dp"
            android:layout_marginBottom="12dp"
            android:visibility="gone"
            app:cornerRadius="12dp">

            <TextView
                android:id="@+id/tvConsentSignedBy"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text=""
                style="@style/Text.Caption.Small"
                android:textColor="?attr/colorOnSurface"
                android:alpha="0.75" />

            <TextView
                android:id="@+id/tvConsentDate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text=""
                style="@style/Text.Caption.Small"
                android:textColor="?attr/colorOnSurface"
                android:alpha="0.75"
                android:layout_marginTop="2dp" />

            <TextView
                android:id="@+id/tvConsentWithdrawn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text=""
                style="@style/Text.Caption.Small"
                android:textColor="@android:color/holo_red_dark"
                android:layout_marginTop="2dp"
                android:visibility="gone" />

        </LinearLayout>

        <!-- Notes -->
        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.AfriNuts.EditText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etNotes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Notes"
                android:inputType="textMultiLine"
                android:minLines="2" />

        </com.google.android.material.textfield.TextInputLayout>

        <!-- Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="end">

            <Button
                android:id="@+id/btnCancel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Cancel"
                style="@style/Widget.AfriNuts.Button.Outlined"
                android:layout_marginEnd="8dp" />

            <Button
                android:id="@+id/btnSave"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Save"
                style="@style/Widget.AfriNuts.Button"
                app:icon="@drawable/ic_save"
                app:iconGravity="textStart"
                app:iconTint="@android:color/white" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>