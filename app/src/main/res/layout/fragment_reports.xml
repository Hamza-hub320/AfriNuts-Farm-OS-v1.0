<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    app:cardCornerRadius="24dp">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="12dp"
        android:paddingTop="0dp"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="?attr/cardBackgroundAccent">

            <!-- Date Range Card - Compact -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                style="@style/Widget.AfriNuts.CardView"
                app:cardCornerRadius="24dp"
                app:cardElevation="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="12dp"
                    android:background="?attr/cardBackgroundAccent">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Date Range"
                        style="@style/Text.H6"
                        android:textSize="14sp"
                        android:textColor="?attr/colorPrimary"
                        android:layout_marginBottom="10dp" />

                    <com.google.android.material.button.MaterialButtonToggleGroup
                        android:id="@+id/toggleDateRange"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="10dp"
                        app:singleSelection="true">

                        <Button
                            android:id="@+id/btnAllTime"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="All Time"
                            android:checked="true"
                            style="@style/Widget.AfriNuts.Button.Outlined"
                            android:textSize="12sp"
                            app:cornerRadius="20dp" />

                        <Button
                            android:id="@+id/btnThisYear"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="This Year"
                            style="@style/Widget.AfriNuts.Button.Outlined"
                            android:textSize="12sp"
                            app:cornerRadius="20dp" />

                        <Button
                            android:id="@+id/btnThisMonth"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="This Month"
                            style="@style/Widget.AfriNuts.Button.Outlined"
                            android:textSize="12sp"
                            app:cornerRadius="20dp" />

                    </com.google.android.material.button.MaterialButtonToggleGroup>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <com.google.android.material.textfield.TextInputLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginEnd="4dp"
                            style="@style/Widget.AfriNuts.EditText"
                            app:boxBackgroundColor="?attr/colorSurface"
                            app:boxCornerRadiusBottomEnd="10dp"
                            app:boxCornerRadiusBottomStart="10dp"
                            app:boxCornerRadiusTopEnd="10dp"
                            app:boxCornerRadiusTopStart="10dp"
                            app:boxStrokeColor="?attr/colorPrimary">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etStartDate"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:hint="Start"
                                android:textSize="12sp"
                                android:focusable="false"
                                android:clickable="true"
                                android:drawableEnd="@drawable/ic_today" />

                        </com.google.android.material.textfield.TextInputLayout>

                        <com.google.android.material.textfield.TextInputLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="4dp"
                            style="@style/Widget.AfriNuts.EditText"
                            app:boxBackgroundColor="?attr/colorSurface"
                            app:boxCornerRadiusBottomEnd="10dp"
                            app:boxCornerRadiusBottomStart="10dp"
                            app:boxCornerRadiusTopEnd="10dp"
                            app:boxCornerRadiusTopStart="10dp"
                            app:boxStrokeColor="?attr/colorPrimary">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etEndDate"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:hint="End"
                                android:textSize="12sp"
                                android:focusable="false"
                                android:clickable="true"
                                android:drawableEnd="@drawable/ic_today" />

                        </com.google.android.material.textfield.TextInputLayout>

                    </LinearLayout>

                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <!-- Report Types Card - Compact -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                style="@style/Widget.AfriNuts.CardView"
                app:cardCornerRadius="24dp"
                app:cardElevation="2dp"
                android:background="?attr/cardBackgroundSecondary">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="12dp"
                    android:background="?attr/cardBackgroundAccent">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Report Types"
                        style="@style/Text.H6"
                        android:textSize="14sp"
                        android:textColor="?attr/colorSecondary"
                        android:layout_marginBottom="10dp" />

                    <!-- Farm Summary Report -->
                    <androidx.cardview.widget.CardView
                        android:id="@+id/cardFarmSummary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        style="@style/Widget.AfriNuts.CardView"
                        android:foreground="?android:attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true"
                        app:cardCornerRadius="24dp"
                        android:background="?attr/cardBackgroundSecondary">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:padding="10dp"
                            android:background="?attr/cardBackgroundSecondary">

                            <FrameLayout
                                android:layout_width="36dp"
                                android:layout_height="36dp"
                                android:background="?attr/iconBackgroundGlass"
                                android:layout_marginEnd="10dp">

                                <ImageView
                                    android:layout_width="18dp"
                                    android:layout_height="18dp"
                                    android:layout_gravity="center"
                                    android:src="@drawable/ic_farm"
                                    app:tint="?attr/colorPrimary" />

                            </FrameLayout>

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Farm Summary"
                                    style="@style/Text.H6"
                                    android:textSize="13sp"
                                    android:textColor="?attr/colorPrimary" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Overview &amp; stats"
                                    style="@style/Text.Caption"
                                    android:textSize="10sp"
                                    android:textColor="?attr/colorOnSurface"
                                    android:alpha="0.7" />

                            </LinearLayout>

                            <ImageView
                                android:layout_width="18dp"
                                android:layout_height="18dp"
                                android:src="@drawable/ic_arrow_forward"
                                app:tint="?attr/colorSecondary" />

                        </LinearLayout>

                    </androidx.cardview.widget.CardView>

                    <!-- Financial Statement -->
                    <androidx.cardview.widget.CardView
                        android:id="@+id/cardFinancialStatement"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        style="@style/Widget.AfriNuts.CardView"
                        android:foreground="?android:attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true"
                        app:cardCornerRadius="24dp"
                        android:background="?attr/cardBackgroundPrimary">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:padding="10dp"
                            android:background="?attr/cardBackgroundAccent">

                            <FrameLayout
                                android:layout_width="36dp"
                                android:layout_height="36dp"
                                android:background="?attr/iconBackgroundGlass"
                                android:layout_marginEnd="10dp">

                                <ImageView
                                    android:layout_width="18dp"
                                    android:layout_height="18dp"
                                    android:layout_gravity="center"
                                    android:src="@drawable/ic_attach_money"
                                    app:tint="?attr/colorPrimary" />

                            </FrameLayout>

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Financial"
                                    style="@style/Text.H6"
                                    android:textSize="13sp"
                                    android:textColor="?attr/colorPrimary" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Revenue &amp; expenses"
                                    style="@style/Text.Caption"
                                    android:textSize="10sp"
                                    android:textColor="?attr/colorOnSurface"
                                    android:alpha="0.7" />

                            </LinearLayout>

                            <ImageView
                                android:layout_width="18dp"
                                android:layout_height="18dp"
                                android:src="@drawable/ic_arrow_forward"
                                app:tint="?attr/colorSecondary" />

                        </LinearLayout>

                    </androidx.cardview.widget.CardView>

                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <!-- Dim Overlay (for loading state) -->
            <View
                android:id="@+id/dimOverlay"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="#80000000"
                android:visibility="gone" />

            <!-- Progress indicator - Compact -->
            <LinearLayout
                android:id="@+id/layoutProgress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:visibility="gone"
                android:padding="20dp"
                android:elevation="6dp"
                android:background="?attr/cardBackgroundPrimary"
                app:cardCornerRadius="16dp">

                <ProgressBar
                    android:id="@+id/progressBar"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    style="@style/Widget.AfriNuts.ProgressBar"
                    android:indeterminate="true" />

                <TextView
                    android:id="@+id/tvProgressMessage"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Generating..."
                    style="@style/Text.Caption"
                    android:textSize="12sp"
                    android:textColor="?attr/colorPrimary"
                    android:layout_marginTop="12dp" />

            </LinearLayout>

            <!-- Spacer for bottom navigation -->
            <View
                android:layout_width="match_parent"
                android:layout_height="40dp" />

        </LinearLayout>

    </ScrollView>

</LinearLayout>