<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:paddingTop="12dp"
        android:paddingBottom="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@color/background">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="DATE RANGE"
                android:textColor="#59544C"
                android:textSize="13sp"
                android:letterSpacing="0.08"
                android:fontFamily="@font/manrope_extrabold" />

            <LinearLayout
                android:id="@+id/toggleDateRange"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="14dp"
                android:background="@drawable/bg_report_range_track"
                android:padding="4dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/btnAllTime"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:text="All Time"
                    android:gravity="center"
                    android:textColor="#59544C"
                    android:textSize="13sp"
                    android:fontFamily="@font/manrope_bold"
                    android:clickable="true"
                    android:focusable="true" />

                <TextView
                    android:id="@+id/btnThisYear"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:text="This Year"
                    android:gravity="center"
                    android:textColor="#59544C"
                    android:textSize="13sp"
                    android:fontFamily="@font/manrope_bold"
                    android:clickable="true"
                    android:focusable="true" />

                <TextView
                    android:id="@+id/btnThisMonth"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:text="This Month"
                    android:gravity="center"
                    android:textColor="#59544C"
                    android:textSize="13sp"
                    android:fontFamily="@font/manrope_bold"
                    android:clickable="true"
                    android:focusable="true" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginEnd="6dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="6dp"
                        android:text="Start date"
                        android:textColor="#59544C"
                        android:textSize="13sp"
                        android:fontFamily="@font/manrope_bold" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        style="@style/Widget.AfriNuts.EditText"
                        app:boxBackgroundMode="outline"
                        app:boxBackgroundColor="@color/surface"
                        app:boxCornerRadiusBottomEnd="12dp"
                        app:boxCornerRadiusBottomStart="12dp"
                        app:boxCornerRadiusTopEnd="12dp"
                        app:boxCornerRadiusTopStart="12dp"
                        app:boxStrokeColor="@color/report_date_field_stroke"
                        app:boxStrokeWidth="1dp"
                        app:boxStrokeWidthFocused="1dp"
                        app:hintEnabled="false">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etStartDate"
                            android:layout_width="match_parent"
                            android:layout_height="56dp"
                            android:focusable="false"
                            android:clickable="true"
                            android:cursorVisible="false"
                            android:paddingStart="14dp"
                            android:paddingEnd="12dp"
                            android:hint=""
                            android:textSize="14sp"
                            android:textColor="#1C1B1A"
                            android:fontFamily="@font/manrope_bold"
                            android:drawableEnd="@drawable/ic_today"
                            android:drawableTint="#80601E" />
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="6dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="6dp"
                        android:text="End date"
                        android:textColor="#59544C"
                        android:textSize="13sp"
                        android:fontFamily="@font/manrope_bold" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        style="@style/Widget.AfriNuts.EditText"
                        app:boxBackgroundMode="outline"
                        app:boxBackgroundColor="@color/surface"
                        app:boxCornerRadiusBottomEnd="12dp"
                        app:boxCornerRadiusBottomStart="12dp"
                        app:boxCornerRadiusTopEnd="12dp"
                        app:boxCornerRadiusTopStart="12dp"
                        app:boxStrokeColor="@color/report_date_field_stroke"
                        app:boxStrokeWidth="1dp"
                        app:boxStrokeWidthFocused="1dp"
                        app:hintEnabled="false">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etEndDate"
                            android:layout_width="match_parent"
                            android:layout_height="56dp"
                            android:focusable="false"
                            android:clickable="true"
                            android:cursorVisible="false"
                            android:paddingStart="14dp"
                            android:paddingEnd="12dp"
                            android:hint=""
                            android:textSize="14sp"
                            android:textColor="#1C1B1A"
                            android:fontFamily="@font/manrope_bold"
                            android:drawableEnd="@drawable/ic_today"
                            android:drawableTint="#80601E" />
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:layout_marginBottom="8dp"
                android:text="REPORTS"
                android:textColor="#59544C"
                android:textSize="13sp"
                android:letterSpacing="0.08"
                android:fontFamily="@font/manrope_extrabold" />

            <androidx.cardview.widget.CardView
                android:id="@+id/cardFarmSummary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?android:attr/selectableItemBackground"
                app:cardBackgroundColor="@color/surface"
                app:cardCornerRadius="24dp"
                app:cardElevation="0dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="144dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="16dp">
                    <FrameLayout
                        android:layout_width="64dp"
                        android:layout_height="64dp"
                        android:layout_marginEnd="14dp"
                        android:background="@drawable/bg_report_farm_icon">
                        <ImageView
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_bar_chart"
                            app:tint="#0A5530" />
                    </FrameLayout>
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Farm Summary"
                            android:textColor="#1C1B1A"
                            android:textSize="18sp"
                            android:fontFamily="@font/manrope_extrabold" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Overview &amp; stats"
                            android:textColor="#0A5530"
                            android:textSize="14sp"
                            android:fontFamily="@font/manrope_bold" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="Blocks, suppliers, deliveries and quality grades for the chosen dates."
                            android:textColor="#59544C"
                            android:textSize="13sp"
                            android:fontFamily="@font/manrope_medium" />
                    </LinearLayout>
                    <FrameLayout
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:layout_gravity="top"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_block_chevron">
                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_arrow_forward"
                            app:tint="#59544C" />
                    </FrameLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:id="@+id/cardFinancialStatement"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?android:attr/selectableItemBackground"
                app:cardBackgroundColor="@color/surface"
                app:cardCornerRadius="24dp"
                app:cardElevation="0dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="144dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="16dp">
                    <FrameLayout
                        android:layout_width="64dp"
                        android:layout_height="64dp"
                        android:layout_marginEnd="14dp"
                        android:background="@drawable/bg_report_finance_icon">
                        <ImageView
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_nav_wallet"
                            app:tint="#80601E" />
                    </FrameLayout>
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Financial"
                            android:textColor="#1C1B1A"
                            android:textSize="18sp"
                            android:fontFamily="@font/manrope_extrabold" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Revenue &amp; expenses"
                            android:textColor="#0A5530"
                            android:textSize="14sp"
                            android:fontFamily="@font/manrope_bold" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="Season revenue, expenses and margin, broken down by category."
                            android:textColor="#59544C"
                            android:textSize="13sp"
                            android:fontFamily="@font/manrope_medium" />
                    </LinearLayout>
                    <FrameLayout
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:layout_gravity="top"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_block_chevron">
                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_arrow_forward"
                            app:tint="#59544C" />
                    </FrameLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:id="@+id/cardQualityReport"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?android:attr/selectableItemBackground"
                app:cardBackgroundColor="@color/surface"
                app:cardCornerRadius="24dp"
                app:cardElevation="0dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="144dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="16dp">
                    <FrameLayout
                        android:layout_width="64dp"
                        android:layout_height="64dp"
                        android:layout_marginEnd="14dp"
                        android:background="@drawable/bg_report_farm_icon">
                        <ImageView android:layout_width="28dp" android:layout_height="28dp"
                            android:layout_gravity="center" android:src="@drawable/ic_clipboard_check"
                            app:tint="#0A5530" />
                    </FrameLayout>
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Quality Report" android:textColor="#1C1B1A" android:textSize="18sp"
                            android:fontFamily="@font/manrope_extrabold" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:layout_marginTop="2dp" android:text="Grades &amp; lab results"
                            android:textColor="#0A5530" android:textSize="14sp" android:fontFamily="@font/manrope_bold" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:layout_marginTop="8dp" android:text="KOR, moisture and defective across batches for the chosen dates."
                            android:textColor="#59544C" android:textSize="13sp" android:fontFamily="@font/manrope_medium" />
                    </LinearLayout>
                    <FrameLayout android:layout_width="48dp" android:layout_height="48dp"
                        android:layout_gravity="top" android:layout_marginStart="8dp" android:background="@drawable/bg_block_chevron">
                        <ImageView android:layout_width="20dp" android:layout_height="20dp" android:layout_gravity="center"
                            android:src="@drawable/ic_arrow_forward" app:tint="#59544C" />
                    </FrameLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:id="@+id/cardTraceabilityReport"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?android:attr/selectableItemBackground"
                app:cardBackgroundColor="@color/surface"
                app:cardCornerRadius="24dp"
                app:cardElevation="0dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:minHeight="144dp" android:gravity="center_vertical" android:orientation="horizontal" android:padding="16dp">
                    <FrameLayout android:layout_width="64dp" android:layout_height="64dp" android:layout_marginEnd="14dp"
                        android:background="@drawable/bg_report_finance_icon">
                        <ImageView android:layout_width="28dp" android:layout_height="28dp" android:layout_gravity="center"
                            android:src="@drawable/ic_qr_code" app:tint="#80601E" />
                    </FrameLayout>
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Traceability Report"
                            android:textColor="#1C1B1A" android:textSize="18sp" android:fontFamily="@font/manrope_extrabold" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp"
                            android:text="Traced &amp; exported lots" android:textColor="#0A5530" android:textSize="14sp" android:fontFamily="@font/manrope_bold" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp"
                            android:text="Destinations, buyers and export dates for the chosen dates."
                            android:textColor="#59544C" android:textSize="13sp" android:fontFamily="@font/manrope_medium" />
                    </LinearLayout>
                    <FrameLayout android:layout_width="48dp" android:layout_height="48dp" android:layout_gravity="top"
                        android:layout_marginStart="8dp" android:background="@drawable/bg_block_chevron">
                        <ImageView android:layout_width="20dp" android:layout_height="20dp" android:layout_gravity="center"
                            android:src="@drawable/ic_arrow_forward" app:tint="#59544C" />
                    </FrameLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <View
                android:layout_width="match_parent"
                android:layout_height="40dp" />
        </LinearLayout>
    </ScrollView>

    <View
        android:id="@+id/dimOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#80000000"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/layoutProgress"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginHorizontal="24dp"
        android:orientation="vertical"
        android:gravity="center"
        android:visibility="gone"
        android:padding="20dp"
        android:elevation="6dp"
        android:background="@drawable/bg_report_progress_card">

        <ProgressBar
            android:id="@+id/progressBar"
            android:layout_width="36dp"
            android:layout_height="36dp"
            style="@style/Widget.AfriNuts.ProgressBar"
            android:indeterminate="true" />

        <TextView
            android:id="@+id/tvProgressMessage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Generating PDF..."
            android:textColor="@color/primary"
            android:textSize="14sp"
            android:fontFamily="@font/manrope_bold" />
    </LinearLayout>
</FrameLayout>
