<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:paddingStart="4dp" android:paddingEnd="4dp" android:paddingTop="12dp" android:paddingBottom="12dp" android:background="?android:attr/selectableItemBackground" android:clickable="true" android:focusable="true">
    <TextView android:id="@+id/tvWorkerAvatar" android:layout_width="46dp" android:layout_height="46dp" android:gravity="center" android:text="SK" android:textColor="#0A5530" android:textSize="14sp" android:fontFamily="sans-serif-black" android:background="@drawable/bg_supplier_avatar_green" />
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:layout_marginStart="12dp">
        <TextView android:id="@+id/tvWorkerName" android:layout_width="match_parent" android:layout_height="wrap_content" android:maxLines="1" android:ellipsize="end" android:text="Worker name" android:textColor="#1C1B1A" android:textSize="15.5sp" android:fontFamily="sans-serif-black" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="2dp">
            <View android:id="@+id/workerStatusDot" android:layout_width="7dp" android:layout_height="7dp" android:layout_marginEnd="5dp" android:background="@drawable/bg_supplier_avatar_green" />
            <TextView android:id="@+id/tvWorkerStats" android:layout_width="match_parent" android:layout_height="wrap_content" android:maxLines="1" android:ellipsize="end" android:text="Worker · assignment history" android:textColor="#59544C" android:textSize="13sp" android:fontFamily="sans-serif-medium" />
        </LinearLayout>
        <TextView android:id="@+id/tvCompletionRate" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="end" android:text="0" android:textColor="#1C1B1A" android:textSize="17sp" android:fontFamily="sans-serif-black" />
        <TextView android:id="@+id/tvActiveTasksLabel" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="end" android:text="Active tasks" android:textColor="#59544C" android:textSize="11.5sp" android:textStyle="bold" />
        <ProgressBar android:id="@+id/workerProgress" android:visibility="gone" android:layout_width="0dp" android:layout_height="0dp" />
        <TextView android:id="@+id/tvTotalTime" android:visibility="gone" android:layout_width="wrap_content" android:layout_height="wrap_content" />
        <TextView android:id="@+id/tvAvgTime" android:visibility="gone" android:layout_width="wrap_content" android:layout_height="wrap_content" />
        <LinearLayout android:id="@+id/taskTypeContainer" android:visibility="gone" android:layout_width="wrap_content" android:layout_height="wrap_content" />
    </LinearLayout>
</LinearLayout>
