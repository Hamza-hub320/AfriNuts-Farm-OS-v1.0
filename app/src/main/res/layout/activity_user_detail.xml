<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background">

    <LinearLayout
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_marginStart="20dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="20dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/toolbarBack"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_farm_action_circle"
            android:contentDescription="Back"
            android:padding="12dp"
            android:src="@drawable/ic_finance_back_chevron"
            app:tint="#1C1B1A" />

        <TextView
            android:id="@+id/toolbarTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="User details"
            android:textColor="#1C1B1A"
            android:textSize="17sp"
            android:fontFamily="@font/manrope_extrabold" />

        <ImageButton
            android:id="@+id/toolbarMore"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_farm_action_circle"
            android:contentDescription="More actions"
            android:padding="11dp"
            android:src="@drawable/ic_farm_more"
            app:tint="#1C1B1A" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="14dp"
            android:paddingEnd="20dp"
            android:paddingBottom="28dp">

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="28dp"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tvUserInitials"
                            android:layout_width="54dp"
                            android:layout_height="54dp"
                            android:layout_marginEnd="14dp"
                            android:background="@drawable/bg_icon_sand"
                            android:gravity="center"
                            android:text="SP"
                            android:textColor="#7A5F22"
                            android:textSize="16sp"
                            android:fontFamily="@font/manrope_extrabold" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tvUserName"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:ellipsize="end"
                                android:maxLines="2"
                                android:text="Sekou Hakim Peters"
                                android:textColor="#1C1B1A"
                                android:textSize="21sp"
                                android:fontFamily="@font/manrope_extrabold" />

                            <TextView
                                android:id="@+id/tvUserRole"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="3dp"
                                android:text="Manager"
                                android:textColor="#59544C"
                                android:textSize="13.5sp"
                                android:fontFamily="@font/manrope_semibold" />

                            <TextView
                                android:id="@+id/tvUserTitle"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="COO &amp; CFO"
                                android:textColor="#59544C"
                                android:textSize="13.5sp"
                                android:fontFamily="@font/manrope_semibold"
                                android:visibility="gone" />
                        </LinearLayout>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipUserStatus"
                            android:layout_width="wrap_content"
                            android:layout_height="36dp"
                            android:checkable="false"
                            android:text="Active"
                            android:textColor="#0A5530"
                            android:textSize="12.5sp"
                            android:fontFamily="@font/manrope_extrabold"
                            app:chipBackgroundColor="#E3F0E7"
                            app:chipCornerRadius="999dp"
                            app:chipIcon="@drawable/ic_check_circle"
                            app:chipIconTint="#0A5530"
                            app:chipMinHeight="36dp"
                            app:chipStrokeWidth="0dp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnDeactivate"
                            android:layout_width="wrap_content"
                            android:layout_height="40dp"
                            android:layout_marginStart="8dp"
                            app:backgroundTint="#F3EAD8"
                            app:strokeWidth="0dp"
                            app:cornerRadius="999dp"
                            app:elevation="0dp"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:minWidth="0dp"
                            android:paddingStart="18dp"
                            android:paddingEnd="18dp"
                            android:text="Deactivate"
                            android:textAllCaps="false"
                            android:textColor="#1C1B1A"
                            android:textSize="13sp"
                            android:fontFamily="@font/manrope_extrabold" />
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:orientation="horizontal">

                <androidx.cardview.widget.CardView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="5dp"
                    app:cardBackgroundColor="#0E6B3C"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="0dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="14dp" android:background="@drawable/bg_traceability_kpi_gradient">
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Role" android:textColor="#DCEDE3" android:textSize="12sp" android:fontFamily="@font/manrope_bold" />
                        <TextView android:id="@+id/tvAccessRole" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:maxLines="2" android:ellipsize="end" android:text="Manager" android:textColor="#FFFFFF" android:textSize="16.5sp" android:fontFamily="@font/manrope_extrabold" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <androidx.cardview.widget.CardView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="5dp"
                    android:layout_marginEnd="5dp"
                    app:cardBackgroundColor="#FFFFFF"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="0dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="14dp">
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Status" android:textColor="#59544C" android:textSize="12sp" android:fontFamily="@font/manrope_bold" />
                        <TextView android:id="@+id/tvAccessLevel" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:maxLines="1" android:ellipsize="end" android:text="Active" android:textColor="#1C1B1A" android:textSize="16.5sp" android:fontFamily="@font/manrope_extrabold" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <androidx.cardview.widget.CardView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="5dp"
                    app:cardBackgroundColor="#FFFFFF"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="0dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="14dp">
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Last login" android:textColor="#59544C" android:textSize="12sp" android:fontFamily="@font/manrope_bold" />
                        <TextView android:id="@+id/tvLastLogin" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:maxLines="2" android:ellipsize="end" android:text="Never" android:textColor="#1C1B1A" android:textSize="15sp" android:fontFamily="@font/manrope_extrabold" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>
            </LinearLayout>

            <androidx.cardview.widget.CardView
                android:id="@+id/layoutContactCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="24dp"
                app:cardElevation="0dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="20dp" android:paddingTop="18dp" android:paddingEnd="20dp" android:paddingBottom="18dp">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Contact" android:textColor="#1C1B1A" android:textSize="16sp" android:fontFamily="@font/manrope_extrabold" android:layout_marginBottom="8dp" />
                    <LinearLayout android:id="@+id/layoutEmail" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal" android:paddingTop="11dp" android:paddingBottom="11dp">
                        <TextView android:layout_width="72dp" android:layout_height="wrap_content" android:text="Email" android:textColor="#59544C" android:textSize="13sp" android:fontFamily="@font/manrope_bold" />
                        <TextView android:id="@+id/tvUserEmail" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="end" android:ellipsize="end" android:maxLines="2" android:text="sekou@example.com" android:textColor="#1C1B1A" android:textSize="14.5sp" android:fontFamily="@font/manrope_bold" />
                    </LinearLayout>
                    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#E9E1CF" />
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal" android:paddingTop="11dp" android:paddingBottom="11dp">
                        <TextView android:layout_width="72dp" android:layout_height="wrap_content" android:text="Phone" android:textColor="#59544C" android:textSize="13sp" android:fontFamily="@font/manrope_bold" />
                        <TextView android:id="@+id/tvUserPhone" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="end" android:ellipsize="end" android:maxLines="1" android:text="+225 07 08 09 10" android:textColor="#1C1B1A" android:textSize="14.5sp" android:fontFamily="@font/manrope_bold" />
                    </LinearLayout>
                    <LinearLayout android:id="@+id/layoutPin" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal" android:visibility="gone">
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="PIN sign-in" android:textColor="#59544C" android:textSize="13sp" android:fontFamily="@font/manrope_bold" />
                        <com.google.android.material.button.MaterialButton android:id="@+id/btnResetPin" android:layout_width="wrap_content" android:layout_height="40dp" android:backgroundTint="#F3EAD8" android:minWidth="0dp" android:paddingStart="14dp" android:paddingEnd="14dp" android:text="Reset PIN" android:textAllCaps="false" android:textColor="#1C1B1A" android:textSize="12sp" android:fontFamily="@font/manrope_extrabold" app:cornerRadius="999dp" app:elevation="0dp" android:insetTop="0dp" android:insetBottom="0dp" />
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:id="@+id/layoutProfileDetails"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="24dp"
                app:cardElevation="0dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="20dp" android:paddingTop="18dp" android:paddingEnd="20dp" android:paddingBottom="18dp">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="About" android:textColor="#1C1B1A" android:textSize="16sp" android:fontFamily="@font/manrope_extrabold" android:layout_marginBottom="8dp" />
                    <LinearLayout android:id="@+id/layoutCompany" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal" android:paddingTop="11dp" android:paddingBottom="11dp">
                        <TextView android:layout_width="72dp" android:layout_height="wrap_content" android:text="Company" android:textColor="#59544C" android:textSize="13sp" android:fontFamily="@font/manrope_bold" />
                        <TextView android:id="@+id/tvUserCompany" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="end" android:text="AfriNuts Export SARL" android:textColor="#1C1B1A" android:textSize="14.5sp" android:fontFamily="@font/manrope_bold" />
                    </LinearLayout>
                    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#E9E1CF" />
                    <LinearLayout android:id="@+id/layoutTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal" android:paddingTop="11dp" android:paddingBottom="11dp">
                        <TextView android:layout_width="72dp" android:layout_height="wrap_content" android:text="Title" android:textColor="#59544C" android:textSize="13sp" android:fontFamily="@font/manrope_bold" />
                        <TextView android:id="@+id/tvUserTitleDetail" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="end" android:text="COO &amp; CFO" android:textColor="#1C1B1A" android:textSize="14.5sp" android:fontFamily="@font/manrope_bold" />
                    </LinearLayout>
                    <LinearLayout android:id="@+id/layoutBio" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingTop="11dp">
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Bio" android:textColor="#59544C" android:textSize="13sp" android:fontFamily="@font/manrope_bold" />
                        <TextView android:id="@+id/tvUserBio" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="User biography" android:textColor="#3D3A35" android:textSize="14sp" android:fontFamily="@font/manrope_semibold" android:lineSpacingExtra="2dp" />
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnEdit"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginBottom="12dp"
                android:backgroundTint="#F3EAD8"
                android:minHeight="52dp"
                android:text="Edit"
                android:textAllCaps="false"
                android:textColor="#1C1B1A"
                android:textSize="15sp"
                android:fontFamily="@font/manrope_extrabold"
                app:cornerRadius="999dp"
                app:elevation="0dp"
                android:insetTop="0dp"
                android:insetBottom="0dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDelete"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:backgroundTint="#F8E4DD"
                android:minHeight="52dp"
                android:text="Delete user"
                android:textAllCaps="false"
                android:textColor="#B3402A"
                android:textSize="15sp"
                android:fontFamily="@font/manrope_extrabold"
                app:cornerRadius="999dp"
                app:elevation="0dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:visibility="gone" />

            <LinearLayout android:id="@+id/accountInfoHidden" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone">
                <TextView android:id="@+id/tvMemberSince" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                <TextView android:id="@+id/tvAuthMethod" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                <ProgressBar android:id="@+id/accessProgress" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                <TextView android:id="@+id/tvAccessDescription" android:layout_width="wrap_content" android:layout_height="wrap_content" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
