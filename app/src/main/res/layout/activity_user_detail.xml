<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background">

    <!-- Modern Glass Morphism Toolbar -->
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="?attr/cardBackgroundPrimary"
        android:theme="@style/ThemeOverlay.AppCompat.Dark.ActionBar"
        android:elevation="0dp"
        android:translationZ="0dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="16dp"
        android:layout_gravity="center_horizontal"
        android:outlineProvider="background"
        android:foreground="?android:attr/selectableItemBackgroundBorderless">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">

            <ImageView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/ic_afrinuts_foreground"
                android:alpha="0.95"
                android:layout_marginEnd="12dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="User Details"
                android:textColor="?attr/colorOnSurface"
                android:textSize="18sp"
                android:textStyle="bold"
                android:letterSpacing="0.01" />

        </LinearLayout>

    </androidx.appcompat.widget.Toolbar>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Profile Header Card -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="24dp"
                app:cardElevation="4dp"
                android:background="?attr/cardBackgroundPrimary"
                style="@style/Widget.AfriNuts.CardView">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="24dp"
                    android:gravity="center"
                    android:background="?attr/cardBackgroundPrimary">

                    <!-- Avatar with Initials -->
                    <FrameLayout
                        android:layout_width="96dp"
                        android:layout_height="96dp"
                        android:background="?attr/iconBackgroundGlass"
                        android:layout_marginBottom="12dp">

                        <TextView
                            android:id="@+id/tvUserInitials"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:text="JD"
                            android:textSize="36sp"
                            android:textStyle="bold"
                            android:textColor="?attr/colorPrimary"
                            android:includeFontPadding="false" />

                    </FrameLayout>

                    <TextView
                        android:id="@+id/tvUserName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="John Doe"
                        style="@style/Text.H2"
                        android:textColor="?attr/colorPrimary"
                        android:layout_marginBottom="4dp" />

                    <!-- ✅ Title (Job Title) -->
                    <TextView
                        android:id="@+id/tvUserTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="CTO"
                        style="@style/Text.Body"
                        android:textColor="?attr/colorSecondary"
                        android:layout_marginBottom="4dp"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/tvUserRole"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Owner"
                        style="@style/Text.H5"
                        android:textColor="?attr/colorPrimaryVariant"
                        android:layout_marginBottom="16dp" />

                    <!-- Status Chip -->
                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipUserStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Active"
                        style="@style/Widget.AfriNuts.Chip"
                        android:checked="true"
                        app:chipBackgroundColor="?attr/colorPrimary"
                        android:textColor="@android:color/white"
                        app:chipIcon="@drawable/ic_check_circle"
                        app:chipIconTint="@android:color/white" />

                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <!-- ✅ New: Profile Details Card (Bio, Company, Title) -->
            <androidx.cardview.widget.CardView
                android:id="@+id/layoutProfileDetails"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="24dp"
                app:cardElevation="4dp"
                android:background="?attr/cardBackgroundPrimary"
                style="@style/Widget.AfriNuts.CardView"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp"
                    android:background="?attr/cardBackgroundPrimary">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Profile"
                        style="@style/Text.H5"
                        android:textColor="?attr/colorPrimary"
                        android:layout_marginBottom="16dp" />

                    <!-- ✅ Company -->
                    <LinearLayout
                        android:id="@+id/layoutCompany"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="12dp"
                        android:visibility="gone">

                        <TextView
                            android:layout_width="100dp"
                            android:layout_height="wrap_content"
                            android:text="Company:"
                            style="@style/Text.Label"
                            android:textColor="?attr/colorOnSurface"
                            android:alpha="0.7" />

                        <TextView
                            android:id="@+id/tvUserCompany"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="AfriNuts Export"
                            style="@style/Text.Body"
                            android:textColor="?attr/colorOnSurface" />

                    </LinearLayout>

                    <!-- ✅ Title -->
                    <LinearLayout
                        android:id="@+id/layoutTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="12dp"
                        android:visibility="gone">

                        <TextView
                            android:layout_width="100dp"
                            android:layout_height="wrap_content"
                            android:text="Title:"
                            style="@style/Text.Label"
                            android:textColor="?attr/colorOnSurface"
                            android:alpha="0.7" />

                        <TextView
                            android:id="@+id/tvUserTitleDetail"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="CTO"
                            style="@style/Text.Body"
                            android:textColor="?attr/colorOnSurface" />

                    </LinearLayout>

                    <!-- ✅ Bio -->
                    <LinearLayout
                        android:id="@+id/layoutBio"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Bio:"
                            style="@style/Text.Label"
                            android:textColor="?attr/colorOnSurface"
                            android:alpha="0.7"
                            android:layout_marginBottom="8dp" />

                        <TextView
                            android:id="@+id/tvUserBio"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Bio text here"
                            style="@style/Text.Body"
                            android:textColor="?attr/colorOnSurface"
                            android:lineSpacingExtra="4dp" />

                    </LinearLayout>

                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <!-- Contact Information Card -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="24dp"
                app:cardElevation="4dp"
                android:background="?attr/cardBackgroundPrimary"
                style="@style/Widget.AfriNuts.CardView">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp"
                    android:background="?attr/cardBackgroundPrimary">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Contact Information"
                        style="@style/Text.H5"
                        android:textColor="?attr/colorPrimary"
                        android:layout_marginBottom="16dp" />

                    <!-- Phone -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="12dp"
                        android:padding="12dp"
                        android:background="?attr/cardBackgroundAccent"
                        app:cornerRadius="12dp">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/ic_phone"
                            app:tint="?attr/colorPrimary"
                            android:layout_marginEnd="12dp" />

                        <TextView
                            android:id="@+id/tvUserPhone"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="+225 07 89 45 67"
                            style="@style/Text.Body"
                            android:textColor="?attr/colorOnSurface" />

                        <Button
                            android:id="@+id/btnCall"
                            android:layout_width="wrap_content"
                            android:layout_height="36dp"
                            android:text="Call"
                            style="@style/Widget.AfriNuts.Button.Small"
                            android:backgroundTint="?attr/colorPrimary"
                            android:visibility="gone"
                            app:cornerRadius="18dp" />

                    </LinearLayout>

                    <!-- Email -->
                    <LinearLayout
                        android:id="@+id/layoutEmail"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="12dp"
                        android:visibility="visible"
                        android:padding="12dp"
                        android:background="?attr/cardBackgroundAccent"
                        app:cornerRadius="12dp">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/ic_email"
                            app:tint="?attr/colorPrimary"
                            android:layout_marginEnd="12dp" />

                        <TextView
                            android:id="@+id/tvUserEmail"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="john@afrinuts.com"
                            style="@style/Text.Body"
                            android:textColor="?attr/colorOnSurface" />

                        <Button
                            android:id="@+id/btnEmail"
                            android:layout_width="wrap_content"
                            android:layout_height="36dp"
                            android:text="Email"
                            style="@style/Widget.AfriNuts.Button.Small"
                            android:backgroundTint="?attr/colorPrimary"
                            android:visibility="gone"
                            app:cornerRadius="18dp" />

                    </LinearLayout>

                    <!-- PIN Indicator -->
                    <LinearLayout
                        android:id="@+id/layoutPin"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:visibility="gone"
                        android:padding="12dp"
                        android:background="?attr/cardBackgroundPrimary"
                        app:cornerRadius="12dp">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/ic_lock"
                            app:tint="?attr/colorPrimary"
                            android:layout_marginEnd="12dp" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="PIN Authentication"
                            style="@style/Text.Body"
                            android:textColor="?attr/colorOnSurface" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnResetPin"
                            android:layout_width="wrap_content"
                            android:layout_height="36dp"
                            android:text="Reset PIN"
                            style="@style/Widget.AfriNuts.Button.Small"
                            android:backgroundTint="?attr/colorSecondary"
                            app:cornerRadius="18dp" />

                    </LinearLayout>

                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <!-- Access Level Card -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="24dp"
                app:cardElevation="4dp"
                android:background="?attr/cardBackgroundAccent"
                style="@style/Widget.AfriNuts.CardView">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp"
                    android:background="?attr/cardBackgroundPrimary">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Access Level"
                        style="@style/Text.H5"
                        android:textColor="?attr/colorSecondary"
                        android:layout_marginBottom="16dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="12dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Role:"
                            style="@style/Text.Label"
                            android:textColor="?attr/colorOnSurface"
                            android:alpha="0.7" />

                        <TextView
                            android:id="@+id/tvAccessRole"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Owner"
                            style="@style/Text.Body"
                            android:textColor="?attr/colorSecondary" />

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="12dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Access Level:"
                            style="@style/Text.Label"
                            android:textColor="?attr/colorOnSurface"
                            android:alpha="0.7" />

                        <TextView
                            android:id="@+id/tvAccessLevel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="100 (Full Access)"
                            style="@style/Text.Body"
                            android:textColor="?attr/colorSecondary" />

                    </LinearLayout>

                    <ProgressBar
                        android:id="@+id/accessProgress"
                        style="@style/Widget.AfriNuts.ProgressBar"
                        android:layout_width="match_parent"
                        android:layout_height="8dp"
                        android:progress="100"
                        android:max="100" />

                    <TextView
                        android:id="@+id/tvAccessDescription"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Full access to all farm data and settings"
                        style="@style/Text.Caption"
                        android:textColor="?attr/colorOnSurface"
                        android:alpha="0.7"
                        android:layout_marginTop="12dp" />

                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <!-- Account Info Card -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="24dp"
                app:cardElevation="4dp"
                android:background="?attr/cardBackgroundPrimary"
                style="@style/Widget.AfriNuts.CardView">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp"
                    android:background="?attr/cardBackgroundPrimary">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Account Information"
                        style="@style/Text.H5"
                        android:textColor="?attr/colorPrimary"
                        android:layout_marginBottom="16dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="12dp">

                        <TextView
                            android:layout_width="120dp"
                            android:layout_height="wrap_content"
                            android:text="Member Since:"
                            style="@style/Text.Label"
                            android:textColor="?attr/colorOnSurface"
                            android:alpha="0.7" />

                        <TextView
                            android:id="@+id/tvMemberSince"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Jan 15, 2024"
                            style="@style/Text.Body"
                            android:textColor="?attr/colorOnSurface" />

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="12dp">

                        <TextView
                            android:layout_width="120dp"
                            android:layout_height="wrap_content"
                            android:text="Last Login:"
                            style="@style/Text.Label"
                            android:textColor="?attr/colorOnSurface"
                            android:alpha="0.7" />

                        <TextView
                            android:id="@+id/tvLastLogin"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Today, 08:30 AM"
                            style="@style/Text.Body"
                            android:textColor="?attr/colorOnSurface" />

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="120dp"
                            android:layout_height="wrap_content"
                            android:text="Auth Method:"
                            style="@style/Text.Label"
                            android:textColor="?attr/colorOnSurface"
                            android:alpha="0.7" />

                        <TextView
                            android:id="@+id/tvAuthMethod"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Password"
                            style="@style/Text.Body"
                            android:textColor="?attr/colorOnSurface" />

                    </LinearLayout>

                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <!-- Action Buttons -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_horizontal"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="16dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnEdit"
                    android:layout_width="0dp"
                    android:layout_height="46dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    android:text="Edit"
                    style="@style/Widget.AfriNuts.Button.LiquidGlass.Primary"
                    app:icon="@drawable/ic_edit"
                    app:iconGravity="textStart" />

                <Button
                    android:id="@+id/btnDeactivate"
                    android:layout_width="0dp"
                    android:layout_height="46dp"
                    android:layout_weight="1"
                    android:text="Deactivate"
                    style="@style/Widget.AfriNuts.Button.LiquidGlass.Danger"
                    app:icon="@drawable/ic_cancel"
                    app:iconGravity="textStart"
                    app:iconTint="@color/error" />

            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDelete"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:text="Delete User"
                style="@style/Widget.AfriNuts.Button.LiquidGlass.Danger"
                app:icon="@drawable/ic_delete"
                app:iconGravity="textStart"
                app:iconTint="@color/error"
                android:visibility="gone"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="16dp" />

        </LinearLayout>

    </ScrollView>

</LinearLayout>