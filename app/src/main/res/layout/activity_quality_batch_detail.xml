<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background">

    <include layout="@layout/view_farm_detail_header" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="false"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Batch identity hero: no person avatar for a batch record. -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardBackgroundColor="@color/surface"
                app:cardCornerRadius="28dp"
                app:cardElevation="0dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">
                    <TextView
                        android:id="@+id/tvBatchNumber"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="QB-2026-018"
                        android:textColor="#1C1B1A"
                        android:textSize="21sp"
                        android:fontFamily="@font/manrope_extrabold"
                        android:maxLines="2"
                        android:ellipsize="end" />
                    <TextView
                        android:id="@+id/tvBatchDate"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="Supplier · Cooperative · Nov 18, 2026"
                        android:textColor="#59544C"
                        android:textSize="13.5sp"
                        android:fontFamily="@font/manrope_semibold"
                        android:maxLines="1"
                        android:ellipsize="end" />
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">
                        <com.google.android.material.chip.Chip
                            android:id="@+id/tvGrade"
                            style="@style/Widget.AfriNuts.Chip"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Premium"
                            android:textColor="#0A5530"
                            app:chipBackgroundColor="#E3F0E7"
                            app:chipCornerRadius="999dp"
                            app:checkedIconVisible="false" />
                        <TextView
                            android:id="@+id/tvBatchType"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:background="@drawable/bg_quality_type_outline"
                            android:paddingHorizontal="12dp"
                            android:paddingVertical="6dp"
                            android:text="Kernel batch"
                            android:textColor="#3D3A35"
                            android:textSize="12sp"
                            android:fontFamily="@font/manrope_bold" />
                    </LinearLayout>
                    <TextView
                        android:id="@+id/tvQualityScore"
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:visibility="gone" />
                    <com.google.android.material.progressindicator.CircularProgressIndicator
                        android:id="@+id/qualityProgress"
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:visibility="gone" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Three lab stats from this batch. -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardKernelMetrics"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardBackgroundColor="@android:color/transparent"
                app:cardCornerRadius="0dp"
                app:cardElevation="0dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <androidx.cardview.widget.CardView
                        android:layout_width="0dp" android:layout_height="112dp" android:layout_weight="1" android:layout_marginEnd="5dp"
                        app:cardBackgroundColor="#0E6B3C" app:cardCornerRadius="20dp" app:cardElevation="0dp">
                        <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:gravity="center_vertical" android:padding="10dp">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Moisture" android:maxLines="1" android:singleLine="true" android:includeFontPadding="false" android:textColor="#C7FFFFFF" android:textSize="10sp" android:fontFamily="@font/manrope_bold" />
                            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:gravity="center_vertical" android:orientation="horizontal"><TextView android:id="@+id/tvMoistureValue" android:layout_width="wrap_content" android:layout_height="wrap_content"  android:text="8.2" android:textColor="#FFFFFF" android:textSize="16sp" android:fontFamily="@font/manrope_extrabold" /><TextView android:id="@+id/tvMoistureValueUnit" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="3dp" android:text="%" android:textColor="#FFFFFF" android:textSize="11sp" android:fontFamily="@font/manrope_bold" /></LinearLayout>
                        </LinearLayout>
                    </androidx.cardview.widget.CardView>
                    <androidx.cardview.widget.CardView
                        android:layout_width="0dp" android:layout_height="112dp" android:layout_weight="1" android:layout_marginHorizontal="5dp"
                        app:cardBackgroundColor="@color/surface" app:cardCornerRadius="20dp" app:cardElevation="0dp">
                        <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:gravity="center_vertical" android:padding="10dp">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Defective" android:maxLines="1" android:singleLine="true" android:includeFontPadding="false" android:textColor="#59544C" android:textSize="10sp" android:fontFamily="@font/manrope_bold" />
                            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:gravity="center_vertical" android:orientation="horizontal"><TextView android:id="@+id/tvDefectiveValue" android:layout_width="wrap_content" android:layout_height="wrap_content"  android:text="3.1" android:textColor="#1C1B1A" android:textSize="16sp" android:fontFamily="@font/manrope_extrabold" /><TextView android:id="@+id/tvDefectiveValueUnit" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="3dp" android:text="%" android:textColor="#59544C" android:textSize="11sp" android:fontFamily="@font/manrope_bold" /></LinearLayout>
                        </LinearLayout>
                    </androidx.cardview.widget.CardView>
                    <androidx.cardview.widget.CardView
                        android:layout_width="0dp" android:layout_height="112dp" android:layout_weight="1" android:layout_marginStart="5dp"
                        app:cardBackgroundColor="@color/surface" app:cardCornerRadius="20dp" app:cardElevation="0dp">
                        <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:gravity="center_vertical" android:padding="10dp">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Kernel" android:maxLines="1" android:singleLine="true" android:includeFontPadding="false" android:textColor="#59544C" android:textSize="10sp" android:fontFamily="@font/manrope_bold" />
                            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:gravity="center_vertical" android:orientation="horizontal"><TextView android:id="@+id/tvKernelValue" android:layout_width="wrap_content" android:layout_height="wrap_content"  android:text="52.4" android:textColor="#1C1B1A" android:textSize="16sp" android:fontFamily="@font/manrope_extrabold" /><TextView android:id="@+id/tvKernelValueUnit" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="3dp" android:text="%" android:textColor="#59544C" android:textSize="11sp" android:fontFamily="@font/manrope_bold" /></LinearLayout>
                        </LinearLayout>
                    </androidx.cardview.widget.CardView>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:id="@+id/cardRcnMetrics"
                android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />

            <!-- Supplier section -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp"
                app:cardBackgroundColor="@color/surface" app:cardCornerRadius="24dp" app:cardElevation="0dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingHorizontal="20dp" android:paddingVertical="18dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Supplier" android:textColor="#1C1B1A" android:textSize="16sp" android:fontFamily="@font/manrope_extrabold" />
                        <TextView android:id="@+id/tvSupplierSeeAll" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="See all" android:textColor="#0E6B3C" android:textSize="13.5sp" android:fontFamily="@font/manrope_extrabold" />
                    </LinearLayout>
                    <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginTop="10dp" android:background="#E9E1CF" />
                    <LinearLayout android:id="@+id/layoutSupplier" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:paddingVertical="11dp">
                            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Name" android:textColor="#59544C" android:textSize="13sp" android:fontFamily="@font/manrope_bold" />
                            <TextView android:id="@+id/tvSupplierName" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1.3" android:gravity="end" android:text="Salimata Keïta" android:textColor="#1C1B1A" android:textSize="14.5sp" android:fontFamily="@font/manrope_bold" />
                        </LinearLayout>
                        <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#E9E1CF" />
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:paddingVertical="11dp">
                            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Cooperative" android:textColor="#59544C" android:textSize="13sp" android:fontFamily="@font/manrope_bold" />
                            <TextView android:id="@+id/tvSourceType" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1.3" android:gravity="end" android:text="Gbélégban Cooperative" android:textColor="#1C1B1A" android:textSize="14.5sp" android:fontFamily="@font/manrope_bold" />
                        </LinearLayout>
                        <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#E9E1CF" />
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:paddingVertical="11dp">
                            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Village" android:textColor="#59544C" android:textSize="13sp" android:fontFamily="@font/manrope_bold" />
                            <TextView android:id="@+id/tvSupplierLocation" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1.3" android:gravity="end" android:text="—" android:textColor="#1C1B1A" android:textSize="14.5sp" android:fontFamily="@font/manrope_bold" />
                        </LinearLayout>
                        <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#E9E1CF" />
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:paddingVertical="11dp">
                            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Batches supplied" android:textColor="#59544C" android:textSize="13sp" android:fontFamily="@font/manrope_bold" />
                            <TextView android:id="@+id/tvSupplierBatchCount" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1.3" android:gravity="end" android:text="0" android:textColor="#1C1B1A" android:textSize="14.5sp" android:fontFamily="@font/manrope_bold" />
                        </LinearLayout>

                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Delivery section -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp"
                app:cardBackgroundColor="@color/surface" app:cardCornerRadius="24dp" app:cardElevation="0dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingHorizontal="20dp" android:paddingVertical="18dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Delivery" android:textColor="#1C1B1A" android:textSize="16sp" android:fontFamily="@font/manrope_extrabold" />
                    </LinearLayout>
                    <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginTop="10dp" android:background="#E9E1CF" />
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:paddingVertical="11dp">
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Batch number" android:textColor="#59544C" android:textSize="13sp" android:fontFamily="@font/manrope_bold" />
                        <TextView android:id="@+id/tvDeliveryBatch" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1.3" android:gravity="end" android:text="QB-2026-018" android:textColor="#1C1B1A" android:textSize="14.5sp" android:fontFamily="@font/manrope_bold" />
                    </LinearLayout>
                    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#E9E1CF" />
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:paddingVertical="11dp">
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Received" android:textColor="#59544C" android:textSize="13sp" android:fontFamily="@font/manrope_bold" />
                        <TextView android:id="@+id/tvDeliveryDate" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1.3" android:gravity="end" android:text="Nov 18, 2026" android:textColor="#1C1B1A" android:textSize="14.5sp" android:fontFamily="@font/manrope_bold" />
                    </LinearLayout>
                    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#E9E1CF" />
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:paddingVertical="11dp">
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Harvest date" android:textColor="#59544C" android:textSize="13sp" android:fontFamily="@font/manrope_bold" />
                        <TextView android:id="@+id/tvHarvestDate" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1.3" android:gravity="end" android:text="—" android:textColor="#1C1B1A" android:textSize="14.5sp" android:fontFamily="@font/manrope_bold" />
                    </LinearLayout>
                    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#E9E1CF" />
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:paddingVertical="11dp">
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Received at" android:textColor="#59544C" android:textSize="13sp" android:fontFamily="@font/manrope_bold" />
                        <TextView android:id="@+id/tvReceivedAt" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1.3" android:gravity="end" android:text="—" android:textColor="#1C1B1A" android:textSize="14.5sp" android:fontFamily="@font/manrope_bold" />
                    </LinearLayout>
                    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#E9E1CF" />
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:paddingVertical="11dp">
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Weight received" android:textColor="#59544C" android:textSize="13sp" android:fontFamily="@font/manrope_bold" />
                        <TextView android:id="@+id/tvWeightValue" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1.3" android:gravity="end" android:text="1,240 kg" android:textColor="#1C1B1A" android:textSize="14.5sp" android:fontFamily="@font/manrope_bold" />
                    </LinearLayout>
                    <TextView android:id="@+id/tvBatchTypeCompat" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Lab results section -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardTestResults"
                android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp"
                app:cardBackgroundColor="@color/surface" app:cardCornerRadius="24dp" app:cardElevation="0dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingHorizontal="20dp" android:paddingVertical="18dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Lab results" android:textColor="#1C1B1A" android:textSize="16sp" android:fontFamily="@font/manrope_extrabold" />
                    </LinearLayout>
                    <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginTop="10dp" android:background="#E9E1CF" />
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:paddingVertical="11dp">
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Nut count" android:textColor="#59544C" android:textSize="13sp" android:fontFamily="@font/manrope_bold" />
                        <TextView android:id="@+id/tvNutCountValue" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="end" android:text="176 / kg" android:textColor="#1C1B1A" android:textSize="14.5sp" android:fontFamily="@font/manrope_bold" />
                    </LinearLayout>
                    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#E9E1CF" />
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:paddingVertical="11dp">
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Quality score" android:textColor="#59544C" android:textSize="13sp" android:fontFamily="@font/manrope_bold" />
                        <TextView android:id="@+id/tvQualityScoreLab" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="end" android:text="92 / 100" android:textColor="#1C1B1A" android:textSize="14.5sp" android:fontFamily="@font/manrope_bold" />
                    </LinearLayout>
                    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#E9E1CF" />
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:paddingVertical="11dp">
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Aflatoxin" android:textColor="#59544C" android:textSize="13sp" android:fontFamily="@font/manrope_bold" />
                        <TextView android:id="@+id/tvAflatoxinValue" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="end" android:text="—" android:textColor="#1C1B1A" android:textSize="14.5sp" android:fontFamily="@font/manrope_bold" />
                    </LinearLayout>
                    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#E9E1CF" />
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:paddingVertical="11dp">
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Pesticide" android:textColor="#59544C" android:textSize="13sp" android:fontFamily="@font/manrope_bold" />
                        <TextView android:id="@+id/tvPesticideValue" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="end" android:text="—" android:textColor="#1C1B1A" android:textSize="14.5sp" android:fontFamily="@font/manrope_bold" />
                    </LinearLayout>
                    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#E9E1CF" />
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:paddingVertical="11dp">
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Heavy metals" android:textColor="#59544C" android:textSize="13sp" android:fontFamily="@font/manrope_bold" />
                        <TextView android:id="@+id/tvHeavyMetalsValue" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="end" android:text="—" android:textColor="#1C1B1A" android:textSize="14.5sp" android:fontFamily="@font/manrope_bold" />
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Optional existing content, retained when recorded. -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardNotes"
                android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp" android:visibility="gone"
                app:cardBackgroundColor="@color/surface" app:cardCornerRadius="24dp" app:cardElevation="0dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Notes" android:textColor="#1C1B1A" android:textSize="16sp" android:fontFamily="@font/manrope_extrabold" />
                    <TextView android:id="@+id/tvNotesValue" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:textColor="#3D3A35" android:textSize="14sp" android:fontFamily="@font/manrope_semibold" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>
            <androidx.cardview.widget.CardView
                android:id="@+id/layoutSustainability"
                android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp" android:visibility="gone"
                app:cardBackgroundColor="@color/surface" app:cardCornerRadius="24dp" app:cardElevation="0dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingHorizontal="20dp" android:paddingVertical="18dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Sustainability verification" android:textColor="#1C1B1A" android:textSize="16sp" android:fontFamily="@font/manrope_extrabold" />
                    <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginTop="10dp" android:background="#E9E1CF" />
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:paddingVertical="11dp"><TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Score" android:textColor="#59544C" android:textSize="13sp" android:fontFamily="@font/manrope_bold" /><TextView android:id="@+id/tvSustainabilityScore" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#1C1B1A" android:textSize="14.5sp" android:fontFamily="@font/manrope_bold" /></LinearLayout>
                    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#E9E1CF" />
