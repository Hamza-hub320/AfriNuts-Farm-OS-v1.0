<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="16dp"
    android:background="?android:attr/colorBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Header with Icon -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="24dp"
            android:background="?attr/cardBackgroundPrimary">

            <FrameLayout
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:background="?attr/iconBackgroundGlass"
                android:layout_marginEnd="16dp">

                <!-- Edge Effect -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_edge_effect"
                    android:alpha="0.3" />

                <!-- Glassy Overlay -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="?attr/iconBackgroundGlass"
                    android:alpha="0.4" />

                <!-- Inner Shadow -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_inner_shadow" />

                <ImageView
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_grade"
                    app:tint="?attr/colorPrimary" />

            </FrameLayout>

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Quality Batch"
                style="@style/Text.H2"
                android:textColor="?attr/colorPrimary" />

        </LinearLayout>

        <!-- Select Supplier -->
        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.AfriNuts.EditText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:endIconMode="dropdown_menu"
            app:endIconDrawable="@drawable/ic_arrow_drop_down"
            app:endIconTint="?attr/colorPrimary"
            app:boxBackgroundColor="?attr/colorSurface"
            app:boxCornerRadiusBottomEnd="12dp"
            app:boxCornerRadiusBottomStart="12dp"
            app:boxCornerRadiusTopEnd="12dp"
            app:boxCornerRadiusTopStart="12dp"
            app:boxStrokeColor="?attr/colorPrimary">

            <com.google.android.material.textfield.MaterialAutoCompleteTextView
                android:id="@+id/etSupplier"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Select Supplier"
                android:inputType="none"
                android:textColor="?attr/colorOnSurface"
                android:textColorHint="?attr/colorOnSurface" />

        </com.google.android.material.textfield.TextInputLayout>

        <!-- Select Delivery Batch -->
        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.AfriNuts.EditText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:endIconMode="dropdown_menu"
            app:endIconDrawable="@drawable/ic_arrow_drop_down"
            app:endIconTint="?attr/colorPrimary"
            app:boxBackgroundColor="?attr/colorSurface"
            app:boxCornerRadiusBottomEnd="12dp"
            app:boxCornerRadiusBottomStart="12dp"
            app:boxCornerRadiusTopEnd="12dp"
            app:boxCornerRadiusTopStart="12dp"
            app:boxStrokeColor="?attr/colorPrimary">

            <com.google.android.material.textfield.MaterialAutoCompleteTextView
                android:id="@+id/etDeliveryBatch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Select Supplier Delivery"
                android:inputType="none"
                android:textColor="?attr/colorOnSurface"
                android:textColorHint="?attr/colorOnSurface" />

        </com.google.android.material.textfield.TextInputLayout>

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="?attr/colorOnSurface"
            android:alpha="0.12"
            android:layout_marginVertical="12dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="8dp">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_info"
                app:tint="?attr/colorPrimary"
                android:layout_marginEnd="8dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Delivery Details (Auto-populated)"
                style="@style/Text.Label"
                android:textColor="?attr/colorPrimary" />

        </LinearLayout>

        <!-- Batch Number (Display) -->
        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.AfriNuts.EditText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:boxBackgroundColor="?attr/colorSurface"
            app:boxCornerRadiusBottomEnd="12dp"
            app:boxCornerRadiusBottomStart="12dp"
            app:boxCornerRadiusTopEnd="12dp"
            app:boxCornerRadiusTopStart="12dp"
            app:boxStrokeColor="?attr/colorPrimary">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etBatchNumberDisplay"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Batch Number"
                android:enabled="false"
                android:inputType="text"
                android:textColor="?attr/colorOnSurface"
                android:textColorHint="?attr/colorOnSurface" />

        </com.google.android.material.textfield.TextInputLayout>

        <!-- Processing Date (Display) -->
        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.AfriNuts.EditText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:boxBackgroundColor="?attr/colorSurface"
            app:boxCornerRadiusBottomEnd="12dp"
            app:boxCornerRadiusBottomStart="12dp"
            app:boxCornerRadiusTopEnd="12dp"
            app:boxCornerRadiusTopStart="12dp"
            app:boxStrokeColor="?attr/colorPrimary">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etProcessingDateDisplay"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Processing Date"
                android:enabled="false"
                android:inputType="text"
                android:textColor="?attr/colorOnSurface"
                android:textColorHint="?attr/colorOnSurface" />

        </com.google.android.material.textfield.TextInputLayout>

        <!-- Source Type (Display) -->
        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.AfriNuts.EditText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:boxBackgroundColor="?attr/colorSurface"
            app:boxCornerRadiusBottomEnd="12dp"
            app:boxCornerRadiusBottomStart="12dp"
            app:boxCornerRadiusTopEnd="12dp"
            app:boxCornerRadiusTopStart="12dp"
            app:boxStrokeColor="?attr/colorPrimary">

            <com.google.android.material.textfield.MaterialAutoCompleteTextView
                android:id="@+id/etSourceTypeDisplay"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Source Type"
                android:enabled="false"
                android:inputType="none"
                android:textColor="?attr/colorOnSurface"
                android:textColorHint="?attr/colorOnSurface" />

        </com.google.android.material.textfield.TextInputLayout>

        <!-- Batch Type (Display) -->
        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.AfriNuts.EditText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:boxBackgroundColor="?attr/colorSurface"
            app:boxCornerRadiusBottomEnd="12dp"
            app:boxCornerRadiusBottomStart="12dp"
            app:boxCornerRadiusTopEnd="12dp"
            app:boxCornerRadiusTopStart="12dp"
            app:boxStrokeColor="?attr/colorPrimary">

            <com.google.android.material.textfield.MaterialAutoCompleteTextView
                android:id="@+id/etBatchTypeDisplay"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Batch Type"
                android:enabled="false"
                android:inputType="none"
                android:textColor="?attr/colorOnSurface"
                android:textColorHint="?attr/colorOnSurface" />

        </com.google.android.material.textfield.TextInputLayout>

        <!-- Weight (Display) -->
        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.AfriNuts.EditText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:boxBackgroundColor="?attr/colorSurface"
            app:boxCornerRadiusBottomEnd="12dp"
            app:boxCornerRadiusBottomStart="12dp"
            app:boxCornerRadiusTopEnd="12dp"
            app:boxCornerRadiusTopStart="12dp"
            app:boxStrokeColor="?attr/colorPrimary">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etWeightKgDisplay"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Weight (kg)"
                android:enabled="false"
                android:inputType="numberDecimal"
                android:textColor="?attr/colorOnSurface"
                android:textColorHint="?attr/colorOnSurface" />

        </com.google.android.material.textfield.TextInputLayout>

        <!-- Quality Grade (Display) -->
        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.AfriNuts.EditText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:boxBackgroundColor="?attr/colorSurface"
            app:boxCornerRadiusBottomEnd="12dp"
            app:boxCornerRadiusBottomStart="12dp"
            app:boxCornerRadiusTopEnd="12dp"
            app:boxCornerRadiusTopStart="12dp"
            app:boxStrokeColor="?attr/colorPrimary">

            <com.google.android.material.textfield.MaterialAutoCompleteTextView
                android:id="@+id/etQualityGradeDisplay"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Quality Grade"
                android:enabled="false"
                android:inputType="none"
                android:textColor="?attr/colorOnSurface"
                android:textColorHint="?attr/colorOnSurface" />

        </com.google.android.material.textfield.TextInputLayout>

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="?attr/colorOnSurface"
            android:alpha="0.12"
            android:layout_marginVertical="12dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="8dp">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_labs"
                app:tint="?attr/colorPrimary"
                android:layout_marginEnd="8dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Quality Metrics (Enter values)"
                style="@style/Text.Label"
                android:textColor="?attr/colorPrimary" />

        </LinearLayout>

        <!-- Quality Metrics - 2 columns -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:weightSum="2">

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.AfriNuts.EditText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:layout_marginBottom="12dp"
                app:boxBackgroundColor="?attr/colorSurface"
                app:boxCornerRadiusBottomEnd="12dp"
                app:boxCornerRadiusBottomStart="12dp"
                app:boxCornerRadiusTopEnd="12dp"
                app:boxCornerRadiusTopStart="12dp"
                app:boxStrokeColor="?attr/colorPrimary">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etMoistureContent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Moisture %"
                    android:inputType="numberDecimal"
                    android:textColor="?attr/colorOnSurface"
                    android:textColorHint="?attr/colorOnSurface" />

            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.AfriNuts.EditText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:layout_marginBottom="12dp"
                app:boxBackgroundColor="?attr/colorSurface"
                app:boxCornerRadiusBottomEnd="12dp"
                app:boxCornerRadiusBottomStart="12dp"
                app:boxCornerRadiusTopEnd="12dp"
                app:boxCornerRadiusTopStart="12dp"
                app:boxStrokeColor="?attr/colorPrimary">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etNutCount"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Nut Count/kg"
                    android:inputType="number"
                    android:textColor="?attr/colorOnSurface"
                    android:textColorHint="?attr/colorOnSurface" />

            </com.google.android.material.textfield.TextInputLayout>

        </LinearLayout>

        <!-- More metrics - 2 columns -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:weightSum="2">

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.AfriNuts.EditText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:layout_marginBottom="12dp"
                app:boxBackgroundColor="?attr/colorSurface"
                app:boxCornerRadiusBottomEnd="12dp"
                app:boxCornerRadiusBottomStart="12dp"
                app:boxCornerRadiusTopEnd="12dp"
                app:boxCornerRadiusTopStart="12dp"
                app:boxStrokeColor="?attr/colorPrimary">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etDefectiveRate"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Defective %"
                    android:inputType="numberDecimal"
                    android:textColor="?attr/colorOnSurface"
                    android:textColorHint="?attr/colorOnSurface" />

            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.AfriNuts.EditText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:layout_marginBottom="12dp"
                app:boxBackgroundColor="?attr/colorSurface"
                app:boxCornerRadiusBottomEnd="12dp"
                app:boxCornerRadiusBottomStart="12dp"
                app:boxCornerRadiusTopEnd="12dp"
                app:boxCornerRadiusTopStart="12dp"
                app:boxStrokeColor="?attr/colorPrimary">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etKernelRatio"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Kernel Ratio %"
                    android:inputType="numberDecimal"
                    android:textColor="?attr/colorOnSurface"
                    android:textColorHint="?attr/colorOnSurface" />

            </com.google.android.material.textfield.TextInputLayout>

        </LinearLayout>

        <!-- Test Results Section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_science"
                app:tint="?attr/colorPrimary"
                android:layout_marginEnd="8dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Lab Test Results"
                style="@style/Text.Label"
                android:textColor="?attr/colorPrimary" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:weightSum="3">

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.AfriNuts.EditText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:layout_marginBottom="12dp"
                app:boxBackgroundColor="?attr/colorSurface"
                app:boxCornerRadiusBottomEnd="12dp"
                app:boxCornerRadiusBottomStart="12dp"
                app:boxCornerRadiusTopEnd="12dp"
                app:boxCornerRadiusTopStart="12dp"
                app:boxStrokeColor="?attr/colorPrimary">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etAflatoxin"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Aflatoxin"
                    android:inputType="numberDecimal"
                    android:textColor="?attr/colorOnSurface"
                    android:textColorHint="?attr/colorOnSurface" />

            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.AfriNuts.EditText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                android:layout_marginBottom="12dp"
                app:boxBackgroundColor="?attr/colorSurface"
                app:boxCornerRadiusBottomEnd="12dp"
                app:boxCornerRadiusBottomStart="12dp"
                app:boxCornerRadiusTopEnd="12dp"
                app:boxCornerRadiusTopStart="12dp"
                app:boxStrokeColor="?attr/colorPrimary">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etPesticideResidue"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Pesticide Residue"
                    android:inputType="numberDecimal"
                    android:textColor="?attr/colorOnSurface"
                    android:textColorHint="?attr/colorOnSurface" />

            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.AfriNuts.EditText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:layout_marginBottom="12dp"
                app:boxBackgroundColor="?attr/colorSurface"
                app:boxCornerRadiusBottomEnd="12dp"
                app:boxCornerRadiusBottomStart="12dp"
                app:boxCornerRadiusTopEnd="12dp"
                app:boxCornerRadiusTopStart="12dp"
                app:boxStrokeColor="?attr/colorPrimary">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etHeavyMetals"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Heavy Metals"
                    android:inputType="numberDecimal"
                    android:textColor="?attr/colorOnSurface"
                    android:textColorHint="?attr/colorOnSurface" />

            </com.google.android.material.textfield.TextInputLayout>

        </LinearLayout>

        <!-- Notes -->
        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.AfriNuts.EditText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:boxBackgroundColor="?attr/colorSurface"
            app:boxCornerRadiusBottomEnd="12dp"
            app:boxCornerRadiusBottomStart="12dp"
            app:boxCornerRadiusTopEnd="12dp"
            app:boxCornerRadiusTopStart="12dp"
            app:boxStrokeColor="?attr/colorPrimary">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etNotes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Notes"
                android:inputType="textMultiLine"
                android:minLines="2"
                android:textColor="?attr/colorOnSurface"
                android:textColorHint="?attr/colorOnSurface" />

        </com.google.android.material.textfield.TextInputLayout>

        <!-- Buttons - Liquid Glass Style -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="end"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp">

            <!-- Cancel Button - Outlined Liquid Glass -->
            <Button
                android:id="@+id/btnCancel"
                android:layout_width="wrap_content"
                android:layout_height="46dp"
                android:text="Cancel"
                style="@style/Widget.AfriNuts.Button.LiquidGlass.Accent"
                android:layout_marginEnd="12dp"
                android:minWidth="100dp"
                android:paddingStart="20dp"
                android:paddingEnd="20dp" />

            <!-- Save Button - Primary Liquid Glass -->
            <Button
                android:id="@+id/btnSave"
                android:layout_width="wrap_content"
                android:layout_height="46dp"
                android:text="Save Batch"
                style="@style/Widget.AfriNuts.Button.LiquidGlass.Primary"
                app:icon="@drawable/ic_save"
                app:iconGravity="textStart"
                app:iconPadding="12dp"
                android:minWidth="100dp"
                android:paddingStart="20dp"
                android:paddingEnd="20dp" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>