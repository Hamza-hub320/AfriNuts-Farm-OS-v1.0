<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background">

    <!-- SwipeRefreshLayout wrapper for pull-to-refresh -->
    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipeRefreshLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="12dp"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Overall Stats Card - Compact -->
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    style="@style/Widget.AfriNuts.CardView"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="2dp"
                    android:background="?attr/cardBackgroundPrimary">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="12dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Workforce"
                            style="@style/Text.H5"
                            android:textColor="?attr/colorPrimary"
                            android:layout_marginBottom="8dp" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:weightSum="3"
                            android:layout_marginBottom="8dp">

                            <!-- Total Workers -->
                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical"
                                android:gravity="center">

                                <FrameLayout
                                    android:layout_width="36dp"
                                    android:layout_height="36dp"
                                    android:background="?attr/iconBackgroundGlass"
                                    android:layout_marginBottom="4dp">

                                    <ImageView
                                        android:layout_width="18dp"
                                        android:layout_height="18dp"
                                        android:layout_gravity="center"
                                        android:src="@drawable/ic_people"
                                        app:tint="?attr/colorPrimary" />

                                </FrameLayout>

                                <TextView
                                    android:id="@+id/totalWorkersValue"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="0"
                                    style="@style/Text.Stat"
                                    android:textSize="20sp"
                                    android:textColor="?attr/colorPrimary" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Workers"
                                    style="@style/Text.Caption.Small"
                                    android:textSize="10sp"
                                    android:textColor="?attr/colorOnSurface"
                                    android:alpha="0.7" />

                            </LinearLayout>

                            <!-- Total Tasks -->
                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical"
                                android:gravity="center">

                                <FrameLayout
                                    android:layout_width="36dp"
                                    android:layout_height="36dp"
                                    android:background="?attr/iconBackgroundGlass"
                                    android:layout_marginBottom="4dp">

                                    <ImageView
                                        android:layout_width="18dp"
                                        android:layout_height="18dp"
                                        android:layout_gravity="center"
                                        android:src="@drawable/ic_task"
                                        app:tint="?attr/colorPrimary" />

                                </FrameLayout>

                                <TextView
                                    android:id="@+id/totalTasksValue"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="0"
                                    style="@style/Text.Stat"
                                    android:textSize="20sp"
                                    android:textColor="?attr/colorPrimary" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Tasks"
                                    style="@style/Text.Caption.Small"
                                    android:textSize="10sp"
                                    android:textColor="?attr/colorOnSurface"
                                    android:alpha="0.7" />

                            </LinearLayout>

                            <!-- Completion Rate -->
                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical"
                                android:gravity="center">

                                <FrameLayout
                                    android:layout_width="36dp"
                                    android:layout_height="36dp"
                                    android:background="?attr/iconBackgroundGlass"
                                    android:layout_marginBottom="4dp">

                                    <ImageView
                                        android:layout_width="18dp"
                                        android:layout_height="18dp"
                                        android:layout_gravity="center"
                                        android:src="@drawable/ic_check_circle"
                                        app:tint="?attr/colorSecondary" />

                                </FrameLayout>

                                <TextView
                                    android:id="@+id/completionRateValue"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="0%"
                                    style="@style/Text.Stat"
                                    android:textSize="20sp"
                                    android:textColor="?attr/colorSecondary" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Complete"
                                    style="@style/Text.Caption.Small"
                                    android:textSize="10sp"
                                    android:textColor="?attr/colorOnSurface"
                                    android:alpha="0.7" />

                            </LinearLayout>

                        </LinearLayout>

                        <!-- Average Time Card - Compact -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:background="?attr/cardBackgroundSecondary"
                            android:padding="10dp"
                            android:gravity="center_vertical"
                            app:cardCornerRadius="12dp">

                            <ImageView
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:src="@drawable/ic_timer"
                                app:tint="?attr/colorPrimary"
                                android:layout_marginEnd="8dp"
                                android:background="?attr/iconBackgroundGlass"
                                android:padding="2dp" />

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Avg. Completion Time"
                                style="@style/Text.Caption"
                                android:textSize="11sp"
                                android:textColor="?attr/colorOnSurface"
                                android:alpha="0.8" />

                            <TextView
                                android:id="@+id/avgTaskTimeValue"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="0h"
                                style="@style/Text.Label"
                                android:textSize="12sp"
                                android:textColor="?attr/colorPrimary" />

                        </LinearLayout>

                    </LinearLayout>

                </androidx.cardview.widget.CardView>

                <!-- Worker Performance List Title - Compact -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Worker Performance"
                    style="@style/Text.Caption"
                    android:textSize="12sp"
                    android:textColor="?attr/colorPrimary"
                    android:layout_marginBottom="8dp" />

                <!-- Progress Bar -->
                <ProgressBar
                    android:id="@+id/progressBar"
                    style="@style/Widget.AfriNuts.ProgressBar"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_gravity="center"
                    android:layout_marginTop="24dp"
                    android:indeterminate="true"
                    android:visibility="gone" />

                <!-- Empty State - Compact -->
                <LinearLayout
                    android:id="@+id/emptyView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:layout_marginTop="48dp"
                    android:visibility="gone">

                    <FrameLayout
                        android:layout_width="64dp"
                        android:layout_height="64dp"
                        android:background="?attr/iconBackgroundGlass">

                        <ImageView
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_people"
                            app:tint="?attr/colorOnSurface"
                            android:alpha="0.5" />

                    </FrameLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="No workers yet"
                        style="@style/Text.H4"
                        android:textSize="16sp"
                        android:textColor="?attr/colorOnSurface"
                        android:layout_marginTop="12dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Assign tasks to see performance"
                        style="@style/Text.Caption"
                        android:textSize="11sp"
                        android:textColor="?attr/colorOnSurface"
                        android:alpha="0.7"
                        android:layout_marginTop="4dp" />

                </LinearLayout>

                <!-- Worker Cards Container -->
                <LinearLayout
                    android:id="@+id/workerCardsContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

            </LinearLayout>

        </ScrollView>

    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

</LinearLayout>