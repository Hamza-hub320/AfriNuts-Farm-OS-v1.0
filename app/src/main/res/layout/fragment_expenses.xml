<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background">

    <!-- Expenses summary pair -->
    <LinearLayout
        android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal"
        android:paddingStart="20dp" android:paddingEnd="20dp" android:paddingTop="12dp" android:paddingBottom="14dp">
        <androidx.cardview.widget.CardView android:layout_width="0dp" android:layout_height="104dp" android:layout_weight="1.25" android:layout_marginEnd="8dp" app:cardCornerRadius="24dp" app:cardElevation="0dp" app:cardBackgroundColor="#0E6B3C">
            <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:gravity="center_vertical" android:padding="16dp">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Total expenses" android:textColor="#C7FFFFFF" android:textSize="13sp" android:fontFamily="@font/manrope_medium" />
                <TextView android:id="@+id/totalExpensesText" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="0 XAF" android:textColor="#FFFFFF" android:textSize="23sp" android:maxLines="1" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="14sp" android:autoSizeMaxTextSize="23sp" android:autoSizeStepGranularity="1sp" android:fontFamily="@font/manrope_extrabold" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>
        <androidx.cardview.widget.CardView android:layout_width="0dp" android:layout_height="104dp" android:layout_weight="1" android:layout_marginStart="8dp" app:cardCornerRadius="24dp" app:cardElevation="0dp" app:cardBackgroundColor="#FFFFFF">
            <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:gravity="center_vertical" android:padding="16dp">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Expenses recorded" android:textColor="#59544C" android:textSize="13sp" android:fontFamily="@font/manrope_medium" />
                <TextView android:id="@+id/expensesRecordedText" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="0" android:textColor="#1C1B1A" android:textSize="23sp" android:fontFamily="@font/manrope_extrabold" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>
    </LinearLayout>

    <!-- Filter Chips -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginBottom="16dp"
        android:scrollbars="none">

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/filterChipGroup"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:singleSelection="true"
            app:selectionRequired="true">

            <com.google.android.material.chip.Chip
                android:id="@+id/chipAll"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="All"
                android:checked="true"
                style="@style/Widget.AfriNuts.Chip" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipFarmWide"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Farm wide"
                style="@style/Widget.AfriNuts.Chip" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipByBlock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="By block"
                style="@style/Widget.AfriNuts.Chip" />

            <!-- ✅ New Procurement Chip -->
            <com.google.android.material.chip.Chip
                android:id="@+id/chipProcurement"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Procurement"
                app:chipIcon="@drawable/ic_shopping_cart"
                app:chipIconTint="@color/accent_ink"
                style="@style/Widget.AfriNuts.Chip" />

        </com.google.android.material.chip.ChipGroup>

    </HorizontalScrollView>

    <!-- Progress Bar -->
    <ProgressBar
        android:id="@+id/progressBar"
        style="@style/Widget.AfriNuts.ProgressBar"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="center"
        android:layout_marginTop="32dp"
        android:indeterminate="true"
        android:visibility="gone" />

    <!-- Empty State -->
    <LinearLayout
        android:id="@+id/emptyView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:layout_marginTop="64dp"
        android:visibility="gone">

        <FrameLayout
            android:layout_width="96dp"
            android:layout_height="96dp"
            android:background="@drawable/bg_icon_sand">

            <ImageView
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_attach_money"
                app:tint="?attr/colorOnSurface"
                android:alpha="0.5" />

        </FrameLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="No expenses yet"
            style="@style/Text.H3"
            android:textColor="?attr/colorOnSurface"
            android:layout_marginTop="16dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tap + to add your first expense"
            style="@style/Text.Body.Small"
            android:textColor="?attr/colorOnSurface"
            android:alpha="0.7"
            android:layout_marginTop="8dp" />

    </LinearLayout>

    <!-- RecyclerView -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="8dp"
        android:clipToPadding="false"
        android:visibility="gone" />

    <!-- Spacer for bottom navigation -->
    <View
        android:layout_width="match_parent"
        android:layout_height="90dp" />
</LinearLayout>