<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background">

    <!-- Total Expenses Card -->
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:layout_marginBottom="8dp"
        app:cardCornerRadius="24dp"
        app:cardElevation="4dp"
        style="@style/Widget.AfriNuts.CardView"
        android:background="?attr/cardBackgroundAccent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="20dp"
            android:background="?attr/cardBackgroundPrimary">

            <FrameLayout
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/iconBackgroundGlass"
                android:layout_marginEnd="12dp">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_attach_money"
                    app:tint="?attr/colorSecondary" />

            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Total Expenses"
                    style="@style/Text.H5"
                    android:textColor="?attr/colorOnSurface" />

                <TextView
                    android:id="@+id/totalExpensesText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0 XAF"
                    style="@style/Text.Stat"
                    android:textColor="?attr/colorSecondary"
                    android:layout_marginTop="4dp"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:autoSizeTextType="uniform"
                    android:autoSizeMinTextSize="14sp"
                    android:autoSizeMaxTextSize="28sp"
                    android:autoSizeStepGranularity="2sp" />

            </LinearLayout>

        </LinearLayout>

    </androidx.cardview.widget.CardView>

    <!-- Filter Chips -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginBottom="16dp"
        android:scrollbars="none">

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/filterChipGroup"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:singleSelection="true"
            app:selectionRequired="true">

            <com.google.android.material.chip.Chip
                android:id="@+id/chipAll"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="All"
                android:checked="true"
                style="@style/Widget.AfriNuts.Chip" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipFarmWide"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Farm-Wide"
                style="@style/Widget.AfriNuts.Chip" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipByBlock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Per Block"
                style="@style/Widget.AfriNuts.Chip" />

            <!-- ✅ New Procurement Chip -->
            <com.google.android.material.chip.Chip
                android:id="@+id/chipProcurement"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Procurement"
                app:chipIcon="@drawable/ic_shopping_cart"
                app:chipIconTint="?attr/colorSecondary"
                style="@style/Widget.AfriNuts.Chip" />

        </com.google.android.material.chip.ChipGroup>

    </HorizontalScrollView>

    <!-- Progress Bar -->
    <ProgressBar
        android:id="@+id/progressBar"
        style="@style/Widget.AfriNuts.ProgressBar"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="center"
        android:layout_marginTop="32dp"
        android:indeterminate="true"
        android:visibility="gone" />

    <!-- Empty State -->
    <LinearLayout
        android:id="@+id/emptyView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:layout_marginTop="64dp"
        android:visibility="gone">

        <FrameLayout
            android:layout_width="96dp"
            android:layout_height="96dp"
            android:background="?attr/iconBackgroundGlass">

            <ImageView
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_attach_money"
                app:tint="?attr/colorOnSurface"
                android:alpha="0.5" />

        </FrameLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="No expenses yet"
            style="@style/Text.H3"
            android:textColor="?attr/colorOnSurface"
            android:layout_marginTop="16dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tap + to add your first expense"
            style="@style/Text.Body.Small"
            android:textColor="?attr/colorOnSurface"
            android:alpha="0.7"
            android:layout_marginTop="8dp" />

    </LinearLayout>

    <!-- RecyclerView -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="8dp"
        android:clipToPadding="false"
        android:visibility="gone" />

    <!-- Spacer for bottom navigation -->
    <View
        android:layout_width="match_parent"
        android:layout_height="90dp" />
</LinearLayout>