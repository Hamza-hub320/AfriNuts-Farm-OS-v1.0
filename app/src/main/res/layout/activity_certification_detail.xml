<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?android:attr/colorBackground">

    <!-- Modern Glass Morphism Toolbar -->
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="?attr/cardBackgroundPrimary"
        android:theme="@style/ThemeOverlay.AppCompat.Dark.ActionBar"
        android:elevation="0dp"
        android:translationZ="0dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="16dp"
        android:layout_gravity="center_horizontal">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">

            <ImageView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/ic_afrinuts_foreground"
                android:alpha="0.95"
                android:layout_marginEnd="12dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Certification Details"
                android:textColor="?attr/colorOnSurface"
                android:textSize="18sp"
                android:textStyle="bold"
                android:letterSpacing="0.01" />

        </LinearLayout>

    </androidx.appcompat.widget.Toolbar>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="16dp"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Certification ID -->
            <TextView
                android:id="@+id/tvCertificationId"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CERT-ORG-2026-001"
                style="@style/Text.Caption.Small"
                android:textColor="?attr/colorOnSurface"
                android:alpha="0.5"
                android:layout_marginBottom="8dp" />

            <!-- Name -->
            <TextView
                android:id="@+id/tvCertificationName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Organic (ECOCERT)"
                style="@style/Text.H3"
                android:textColor="?attr/colorPrimary"
                android:layout_marginBottom="8dp" />

            <!-- Status Card -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp" >

                <TextView
                    android:id="@+id/tvStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="8dp"
                    android:text="Certified"
                    android:textColor="?attr/colorSurface"
                    android:textSize="14sp"
                    android:textStyle="bold" />

            </androidx.cardview.widget.CardView>

            <!-- Details Card -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="24dp"
                app:cardElevation="2dp"
                style="@style/Widget.AfriNuts.CardView">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:background="?attr/cardBackgroundPrimary">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Certification Details"
                        style="@style/Text.H5"
                        android:textColor="?attr/colorPrimary"
                        android:layout_marginBottom="12dp" />

                    <!-- Certification Body -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="8dp">

                        <TextView
                            android:layout_width="120dp"
                            android:layout_height="wrap_content"
                            android:text="Issuing Body"
                            style="@style/Text.Caption.Small"
                            android:textColor="?attr/colorOnSurface"
                            android:alpha="0.6" />

                        <TextView
                            android:id="@+id/tvCertificationBody"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="ECOCERT"
                            style="@style/Text.Caption"
                            android:textColor="?attr/colorOnSurface" />

                    </LinearLayout>

                    <!-- Scope -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="8dp">

                        <TextView
                            android:layout_width="120dp"
                            android:layout_height="wrap_content"
                            android:text="Scope"
                            style="@style/Text.Caption.Small"
                            android:textColor="?attr/colorOnSurface"
                            android:alpha="0.6" />

                        <TextView
                            android:id="@+id/tvScope"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Farm operations, processing facility"
                            style="@style/Text.Caption"
                            android:textColor="?attr/colorOnSurface" />

                    </LinearLayout>

                    <!-- Target Date -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="8dp">

                        <TextView
                            android:layout_width="120dp"
                            android:layout_height="wrap_content"
                            android:text="Target Date"
                            style="@style/Text.Caption.Small"
                            android:textColor="?attr/colorOnSurface"
                            android:alpha="0.6" />

                        <TextView
                            android:id="@+id/tvTargetDate"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Jun 30, 2027"
                            style="@style/Text.Caption"
                            android:textColor="?attr/colorOnSurface" />

                    </LinearLayout>

                    <!-- Approval Date -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="8dp">

                        <TextView
                            android:layout_width="120dp"
                            android:layout_height="wrap_content"
                            android:text="Approval Date"
                            style="@style/Text.Caption.Small"
                            android:textColor="?attr/colorOnSurface"
                            android:alpha="0.6" />

                        <TextView
                            android:id="@+id/tvApprovalDate"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Jul 15, 2027"
                            style="@style/Text.Caption"
                            android:textColor="?attr/colorOnSurface" />

                    </LinearLayout>

                    <!-- Expiry Date -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="8dp">

                        <TextView
                            android:layout_width="120dp"
                            android:layout_height="wrap_content"
                            android:text="Expiry Date"
                            style="@style/Text.Caption.Small"
                            android:textColor="?attr/colorOnSurface"
                            android:alpha="0.6" />

                        <TextView
                            android:id="@+id/tvExpiryDate"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Jul 14, 2028"
                            style="@style/Text.Caption"
                            android:textColor="?attr/colorOnSurface" />

                    </LinearLayout>

                    <!-- Standards -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="8dp">

                        <TextView
                            android:layout_width="120dp"
                            android:layout_height="wrap_content"
                            android:text="Standards"
                            style="@style/Text.Caption.Small"
                            android:textColor="?attr/colorOnSurface"
                            android:alpha="0.6" />

                        <TextView
                            android:id="@+id/tvStandards"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="EU Organic Regulation 2018/848, ECOCERT"
                            style="@style/Text.Caption"
                            android:textColor="?attr/colorPrimary" />

                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="?attr/colorOnSurface"
                        android:alpha="0.1"
                        android:layout_marginVertical="12dp" />

                    <!-- Audit Timestamps -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="4dp">

                        <TextView
                            android:layout_width="120dp"
                            android:layout_height="wrap_content"
                            android:text="Created"
                            style="@style/Text.Caption.Small"
                            android:textColor="?attr/colorOnSurface"
                            android:alpha="0.5" />

                        <TextView
                            android:id="@+id/tvCreatedAt"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Jul 17, 2026"
                            style="@style/Text.Caption.Small"
                            android:textColor="?attr/colorOnSurface"
                            android:alpha="0.5" />

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="120dp"
                            android:layout_height="wrap_content"
                            android:text="Last Updated"
                            style="@style/Text.Caption.Small"
                            android:textColor="?attr/colorOnSurface"
                            android:alpha="0.5" />

                        <TextView
                            android:id="@+id/tvUpdatedAt"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Jul 17, 2026"
                            style="@style/Text.Caption.Small"
                            android:textColor="?attr/colorOnSurface"
                            android:alpha="0.5" />

                    </LinearLayout>

                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <!-- Status History Card -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="24dp"
                app:cardElevation="2dp"
                style="@style/Widget.AfriNuts.CardView">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:background="?attr/cardBackgroundPrimary">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Status History"
                        style="@style/Text.H5"
                        android:textColor="?attr/colorPrimary"
                        android:layout_marginBottom="12dp" />

                    <TextView
                        android:id="@+id/tvStatusHistory"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="No status changes yet"
                        style="@style/Text.Caption"
                        android:textColor="?attr/colorOnSurface"
                        android:lineSpacingExtra="4dp" />

                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <!-- Related Records Card -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="24dp"
                app:cardElevation="2dp"
                style="@style/Widget.AfriNuts.CardView">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:background="?attr/cardBackgroundPrimary">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Related Records"
                        style="@style/Text.H5"
                        android:textColor="?attr/colorPrimary"
                        android:layout_marginBottom="12dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:weightSum="3">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:padding="8dp">

                            <TextView
                                android:id="@+id/tvAuditCount"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="0"
                                style="@style/Text.H3"
                                android:textColor="?attr/colorPrimary" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Audits"
                                style="@style/Text.Caption.Small"
                                android:textColor="?attr/colorOnSurface"
                                android:alpha="0.6" />

                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:padding="8dp">

                            <TextView
                                android:id="@+id/tvInspectionCount"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="0"
                                style="@style/Text.H3"
                                android:textColor="?attr/colorSecondary" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Inspections"
                                style="@style/Text.Caption.Small"
                                android:textColor="?attr/colorOnSurface"
                                android:alpha="0.6" />

                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:padding="8dp">

                            <TextView
                                android:id="@+id/tvDocumentCount"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="0"
                                style="@style/Text.H3"
                                android:textColor="?attr/colorPrimary" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Documents"
                                style="@style/Text.Caption.Small"
                                android:textColor="?attr/colorOnSurface"
                                android:alpha="0.6" />

                        </LinearLayout>

                    </LinearLayout>

                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <!-- Action Buttons -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="24dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnAddAudit"
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:text="Add Audit"
                    style="@style/Widget.AfriNuts.Button.LiquidGlass.Primary"
                    app:icon="@drawable/ic_add"
                    app:iconGravity="textStart"
                    android:layout_marginBottom="8dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnEdit"
                        android:layout_width="0dp"
                        android:layout_height="46dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="4dp"
                        android:text="Edit"
                        style="@style/Widget.AfriNuts.Button.LiquidGlass.Primary"
                        app:icon="@drawable/ic_edit"
                        app:iconGravity="textStart" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnDelete"
                        android:layout_width="0dp"
                        android:layout_height="46dp"
                        android:layout_weight="1"
                        android:layout_marginStart="4dp"
                        android:text="Delete"
                        style="@style/Widget.AfriNuts.Button.LiquidGlass.Danger"
                        app:icon="@drawable/ic_delete"
                        app:iconGravity="textStart" />

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

    </ScrollView>

</LinearLayout>