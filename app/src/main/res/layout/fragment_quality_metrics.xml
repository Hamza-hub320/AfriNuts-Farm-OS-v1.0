<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background">

    <!-- Quality KPIs: two columns followed by the full-width score card. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <androidx.cardview.widget.CardView
                android:layout_width="0dp" android:layout_height="76dp" android:layout_weight="1" android:layout_marginEnd="3dp"
                app:cardBackgroundColor="@color/surface" app:cardCornerRadius="20dp" app:cardElevation="0dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:gravity="center_vertical" android:paddingHorizontal="14dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Moisture" android:textColor="#59544C" android:textSize="12sp" android:fontFamily="@font/manrope_bold" />
                    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:gravity="center_vertical" android:orientation="horizontal">
                        <TextView android:id="@+id/avgMoistureValue" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0.0" android:textColor="#1C1B1A" android:textSize="21sp" android:fontFamily="@font/manrope_extrabold" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="4dp" android:layout_marginTop="3dp" android:text="%" android:textColor="#59544C" android:textSize="13sp" android:fontFamily="@font/manrope_bold" />
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>
            <androidx.cardview.widget.CardView
                android:layout_width="0dp" android:layout_height="76dp" android:layout_weight="1" android:layout_marginStart="3dp"
                app:cardBackgroundColor="@color/surface" app:cardCornerRadius="20dp" app:cardElevation="0dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:gravity="center_vertical" android:paddingHorizontal="14dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Defective" android:textColor="#59544C" android:textSize="12sp" android:fontFamily="@font/manrope_bold" />
                    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:gravity="center_vertical" android:orientation="horizontal">
                        <TextView android:id="@+id/avgDefectiveValue" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0.0" android:textColor="#1C1B1A" android:textSize="21sp" android:fontFamily="@font/manrope_extrabold" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="4dp" android:layout_marginTop="3dp" android:text="%" android:textColor="#59544C" android:textSize="13sp" android:fontFamily="@font/manrope_bold" />
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:orientation="horizontal">
            <androidx.cardview.widget.CardView
                android:layout_width="0dp" android:layout_height="76dp" android:layout_weight="1" android:layout_marginEnd="3dp"
                app:cardBackgroundColor="@color/surface" app:cardCornerRadius="20dp" app:cardElevation="0dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:gravity="center_vertical" android:paddingHorizontal="14dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Kernel" android:textColor="#59544C" android:textSize="12sp" android:fontFamily="@font/manrope_bold" />
                    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:gravity="center_vertical" android:orientation="horizontal">
                        <TextView android:id="@+id/avgKernelValue" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0.0" android:textColor="#1C1B1A" android:textSize="21sp" android:fontFamily="@font/manrope_extrabold" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="4dp" android:layout_marginTop="3dp" android:text="%" android:textColor="#59544C" android:textSize="13sp" android:fontFamily="@font/manrope_bold" />
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>
            <androidx.cardview.widget.CardView
                android:layout_width="0dp" android:layout_height="76dp" android:layout_weight="1" android:layout_marginStart="3dp"
                app:cardBackgroundColor="@color/surface" app:cardCornerRadius="20dp" app:cardElevation="0dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:gravity="center_vertical" android:paddingHorizontal="14dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Nut Count" android:textColor="#59544C" android:textSize="12sp" android:fontFamily="@font/manrope_bold" />
                    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:gravity="center_vertical" android:orientation="horizontal">
                        <TextView android:id="@+id/avgNutCountValue" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0" android:textColor="#1C1B1A" android:textSize="21sp" android:fontFamily="@font/manrope_extrabold" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="4dp" android:layout_marginTop="3dp" android:text="/kg" android:textColor="#59544C" android:textSize="13sp" android:fontFamily="@font/manrope_bold" />
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>
        </LinearLayout>

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent" android:layout_height="76dp" android:layout_marginTop="6dp"
            app:cardBackgroundColor="@color/surface" app:cardCornerRadius="20dp" app:cardElevation="0dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:gravity="center_vertical" android:paddingHorizontal="14dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Avg Quality Score" android:textColor="#59544C" android:textSize="12sp" android:fontFamily="@font/manrope_bold" />
                <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:gravity="center_vertical" android:orientation="horizontal">
                        <TextView android:id="@+id/avgQualityScoreValue" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0" android:textColor="#1C1B1A" android:textSize="21sp" android:fontFamily="@font/manrope_extrabold" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="4dp" android:layout_marginTop="3dp" android:text="/100" android:textColor="#59544C" android:textSize="13sp" android:fontFamily="@font/manrope_bold" />
                    </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>
    </LinearLayout>

    <!-- Grade chips stay in a single horizontally scrollable row. -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="0dp"
        android:layout_marginBottom="4dp"
        android:fillViewport="false"
        android:scrollbars="none">

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/filterChipGroup"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="2dp"
            android:paddingEnd="2dp"
            app:singleLine="true"
            app:selectionRequired="true"
            app:singleSelection="true"
            app:chipSpacingHorizontal="8dp">

            <com.google.android.material.chip.Chip
                android:id="@+id/chipAll"
                style="@style/Widget.AfriNuts.Chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="All" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipPremium"
                style="@style/Widget.AfriNuts.Chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Premium" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipStandard"
                style="@style/Widget.AfriNuts.Chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Standard" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipReject"
                style="@style/Widget.AfriNuts.Chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Reject" />
        </com.google.android.material.chip.ChipGroup>
    </HorizontalScrollView>

    <ProgressBar
        android:id="@+id/progressBar"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_gravity="center"
        android:layout_marginTop="24dp"
        style="@style/Widget.AfriNuts.ProgressBar"
        android:indeterminateTint="?attr/colorPrimary"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/emptyView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:layout_marginTop="32dp"
        android:visibility="gone">

        <FrameLayout
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:background="@drawable/bg_icon_sand"
            android:padding="8dp">
            <View android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/bg_edge_effect" android:alpha="0.3" />
            <View android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/surface" android:alpha="0.4" />
            <View android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/bg_inner_shadow" />
            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_inventory"
                app:tint="?attr/colorOnSurface"
                android:alpha="0.5"
                android:contentDescription="No batches" />
        </FrameLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="No quality batches"
            style="@style/Text.H4"
            android:textSize="18sp"
            android:textColor="?attr/colorOnSurface"
            android:layout_marginTop="12dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Add your first batch"
            style="@style/Text.Caption"
            android:textSize="13sp"
            android:textColor="?attr/colorOnSurface"
            android:alpha="0.7"
            android:layout_marginTop="4dp" />
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingTop="8dp"
        android:paddingBottom="20dp"
        android:clipToPadding="false"
        android:visibility="gone"
        android:background="@android:color/transparent" />

</LinearLayout>
