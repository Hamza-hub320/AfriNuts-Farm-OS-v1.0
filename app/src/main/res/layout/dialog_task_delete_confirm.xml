<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="4dp">

    <TextView
        android:id="@+id/tvDeleteTaskTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Delete task"
        android:textColor="#1C1B1A"
        android:textSize="20sp"
        android:fontFamily="@font/manrope_extrabold" />

    <TextView
        android:id="@+id/tvDeleteTaskMessage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="4dp"
        android:text="Are you sure you want to delete this task?"
        android:textColor="#59544C"
        android:textSize="14sp"
        android:fontFamily="@font/manrope_medium" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCancelDeleteTask"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:text="Cancel"
            android:textAllCaps="false" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnConfirmDeleteTask"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:text="Delete task"
            android:textAllCaps="false" />
    </LinearLayout>
</LinearLayout>
