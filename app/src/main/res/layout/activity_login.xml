<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Background Image with Overlay -->
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/bg_farm_field"
        android:scaleType="centerCrop"
        android:alpha="0.6" />

    <!-- Dark Overlay for better text contrast -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#66000000" />

    <!-- Your existing content -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:padding="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal">

            <!-- Logo with Gradient Background -->
            <FrameLayout
                android:layout_width="150dp"
                android:layout_height="150dp"
                android:layout_marginTop="40dp"
                android:layout_marginBottom="16dp">

                <ImageView
                    android:id="@+id/logoImage"
                    android:layout_width="130dp"
                    android:layout_height="130dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_logo_afrinuts_round"
                    android:alpha="0.95"
                    app:tint="@android:color/white" />

            </FrameLayout>

            <TextView
                android:id="@+id/appNameText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="AfriNuts Farm OS"
                style="@style/Text.H2"
                android:textColor="@android:color/white"
                android:layout_marginBottom="4dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Secure Farm Management"
                style="@style/Text.Body.Small"
                android:textColor="@android:color/white"
                android:alpha="0.9"
                android:layout_marginBottom="32dp" />

            <!-- Modern Login Card with Glass Morphism -->
            <androidx.cardview.widget.CardView
                android:id="@+id/loginCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                style="@style/Widget.AfriNuts.CardView"
                app:cardCornerRadius="24dp"
                app:cardElevation="8dp"
                android:background="@drawable/bg_card_glass">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="24dp"
                    android:background="@drawable/bg_card_accent">

                    <!-- User Selection Section -->
                    <TextView
                        android:id="@+id/tvSelectUser"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Select User"
                        style="@style/Text.H5"
                        android:textColor="@color/navy"
                        android:layout_marginBottom="16dp"
                        android:visibility="gone"
                        android:drawableStart="@drawable/ic_cloud_lock"
                        android:drawablePadding="8dp" />

                    <View
                        android:id="@+id/userSelectorDivider"
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        style="@style/Widget.AfriNuts.Divider"
                        android:layout_marginBottom="16dp"
                        android:visibility="gone"
                        android:background="#33FFFFFF" />

                    <!-- User Chips Container -->
                    <HorizontalScrollView
                        android:id="@+id/userScrollView"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="24dp"
                        android:visibility="gone"
                        android:scrollbars="none">

                        <LinearLayout
                            android:id="@+id/userChipsContainer"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal" />

                    </HorizontalScrollView>

                    <!-- Login Fields -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/layoutEmailPin"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp"
                        style="@style/Widget.AfriNuts.EditText"
                        app:endIconMode="clear_text"
                        app:boxBackgroundColor="@android:color/white"
                        app:boxStrokeColor="@color/primary">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etEmailPin"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="Email"
                            android:inputType="textEmailAddress" />

                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/layoutPassword"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="24dp"
                        style="@style/Widget.AfriNuts.EditText"
                        app:passwordToggleEnabled="true"
                        app:boxBackgroundColor="@android:color/white"
                        app:boxStrokeColor="@color/primary">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etPassword"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="Password"
                            android:inputType="textPassword" />

                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Login Button -->
                    <Button
                        android:id="@+id/btnLogin"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:text="Login"
                        style="@style/Widget.AfriNuts.Button"
                        android:backgroundTint="@color/primary"
                        android:layout_marginBottom="8dp"
                        app:icon="@drawable/ic_login"
                        app:iconGravity="textStart"
                        app:iconPadding="12dp" />

                    <!-- Forgot Credentials -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Forgot credentials? Contact farm owner"
                        style="@style/Text.Caption.Small"
                        android:textColor="@color/navy"
                        android:layout_gravity="center_horizontal"
                        android:padding="8dp" />

                </LinearLayout>

            </androidx.cardview.widget.CardView>

        </LinearLayout>

    </ScrollView>

</FrameLayout>