<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Background Image with Overlay - Only visible in light mode -->
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/bg_farm_field"
        android:scaleType="centerCrop"
        android:alpha="0.3" />

    <!-- Adaptive Overlay - changes with theme -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#66000000"/>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:padding="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal">

            <!-- Logo with Gradient Background -->
            <FrameLayout
                android:layout_width="120dp"
                android:layout_height="120dp"
                android:layout_marginTop="40dp"
                android:layout_marginBottom="16dp">

                <ImageView
                    android:id="@+id/logoImage"
                    android:layout_width="100dp"
                    android:layout_height="100dp"
                    android:layout_gravity="center"
                    android:textColor="?attr/colorOnSurface"
                    android:src="@drawable/ic_logo_afrinuts_round"
                    android:alpha="0.95" />

            </FrameLayout>

            <TextView
                android:id="@+id/appNameText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:drawableTint="?attr/colorOnSurface"
                android:text=" AfriNuts Farm OS"
                android:drawableStart="@drawable/ic_cloud_lock"
                style="@style/Text.H2"
                android:textColor="?attr/colorOnSurface"
                android:layout_marginBottom="4dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Secure Farm Management"
                style="@style/TextAppearance.AppCompat.Medium"
                android:textColor="?attr/colorOnSurface"
                android:textStyle="bold"
                android:alpha="0.8"
                android:layout_marginBottom="32dp" />

            <!-- Modern Login Card with Glass Morphism -->
            <androidx.cardview.widget.CardView
                android:id="@+id/loginCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                style="@style/Widget.AfriNuts.CardView"
                app:cardCornerRadius="24dp"
                app:cardElevation="8dp"
                android:background="?attr/cardBackgroundPrimary"
                app:cardBackgroundColor="@android:color/transparent"
                android:clipChildren="false"
                android:outlineProvider="background"
                android:foreground="?android:attr/selectableItemBackgroundBorderless">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="24dp"
                    android:background="?attr/cardBackgroundPrimary"
                    android:outlineProvider="background"
                    android:foreground="?android:attr/selectableItemBackgroundBorderless">

                    <!-- User Selection Section -->
                    <TextView
                        android:id="@+id/tvSelectUser"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Select User"
                        style="@style/Text.H5"
                        android:textColor="?attr/colorOnSurface"
                        android:layout_marginBottom="16dp"
                        android:visibility="gone"
                        android:drawableStart="@drawable/ic_people"
                        android:drawablePadding="8dp"
                        app:drawableTint="?attr/colorPrimary" />

                    <View
                        android:id="@+id/userSelectorDivider"
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        style="@style/Widget.AfriNuts.Divider"
                        android:layout_marginBottom="16dp"
                        android:visibility="gone" />

                    <!-- User Chips Container -->
                    <HorizontalScrollView
                        android:id="@+id/userScrollView"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="24dp"
                        android:visibility="gone"
                        android:scrollbars="none">

                        <LinearLayout
                            android:id="@+id/userChipsContainer"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal" />

                    </HorizontalScrollView>

                    <!-- Login Fields -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/layoutEmailPin"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp"
                        style="@style/Widget.AfriNuts.EditText"
                        app:endIconMode="clear_text">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etEmailPin"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="Email"
                            android:inputType="textEmailAddress" />

                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/layoutPassword"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="24dp"
                        style="@style/Widget.AfriNuts.EditText"
                        app:passwordToggleEnabled="true">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etPassword"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="Password"
                            android:inputType="textPassword" />

                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnLogin"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:text="Login"
                        style="@style/Widget.AfriNuts.Button.LiquidGlass.Primary"
                        android:layout_marginBottom="8dp"
                        app:icon="@drawable/ic_login"
                        android:textStyle="bold"
                        app:iconGravity="textStart"
                        app:iconPadding="12dp" />

                    <!-- Forgot Credentials -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Forgot credentials? Contact farm owner"
                        style="@style/Text.Caption.Small"
                        android:textColor="?attr/colorOnSurface"
                        android:alpha="0.6"
                        android:textStyle="bold"
                        android:layout_gravity="center_horizontal"
                        android:padding="8dp" />

                </LinearLayout>

            </androidx.cardview.widget.CardView>

        </LinearLayout>

    </ScrollView>

</FrameLayout>