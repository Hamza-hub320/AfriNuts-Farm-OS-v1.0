<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background"
    android:gravity="center_horizontal"
    android:padding="24dp">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal">

            <!-- Logo and App Name -->
            <ImageView
                android:id="@+id/logoImage"
                android:layout_width="120dp"
                android:layout_height="120dp"
                android:src="@drawable/ic_logo_afrinuts_round"
                android:layout_marginTop="60dp"
                android:layout_marginBottom="16dp" />

            <TextView
                android:id="@+id/appNameText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="AfriNuts Farm OS"
                style="@style/Text.H2"
                android:textColor="@color/primary"
                android:layout_marginBottom="8dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Secure Farm Management"
                style="@style/Text.Body.Small"
                android:layout_marginBottom="40dp" />

            <!-- Login Card -->
            <androidx.cardview.widget.CardView
                android:id="@+id/loginCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                style="@style/Widget.AfriNuts.CardView"
                app:cardElevation="8dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="24dp">

                    <!-- User Selection Section -->
                    <TextView
                        android:id="@+id/tvSelectUser"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Select User"
                        style="@style/Text.H5"
                        android:layout_marginBottom="16dp"
                        android:visibility="gone" />

                    <View
                        android:id="@+id/userSelectorDivider"
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        style="@style/Widget.AfriNuts.Divider"
                        android:layout_marginBottom="16dp"
                        android:visibility="gone" />

                    <HorizontalScrollView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="24dp"
                        android:visibility="gone"
                        android:id="@+id/userChipsContainer">

                        <LinearLayout
                            android:id="@+id/userChipsContainer"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal" />

                    </HorizontalScrollView>

                    <!-- Login Fields -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/layoutEmailPin"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp"
                        style="@style/Widget.AfriNuts.EditText"
                        app:endIconMode="clear_text">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etEmailPin"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="Email"
                            android:inputType="textEmailAddress" />

                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/layoutPassword"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="24dp"
                        style="@style/Widget.AfriNuts.EditText"
                        app:passwordToggleEnabled="true"
                        android:visibility="visible">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etPassword"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="Password"
                            android:inputType="textPassword" />

                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Login Button -->
                    <Button
                        android:id="@+id/btnLogin"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Login"
                        style="@style/Widget.AfriNuts.Button"
                        android:layout_marginBottom="8dp" />

                    <!-- Forgot PIN/Password (for future use) -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Forgot credentials? Contact farm owner"
                        style="@style/Text.Caption.Small"
                        android:layout_gravity="center_horizontal"
                        android:padding="8dp" />

                </LinearLayout>

            </androidx.cardview.widget.CardView>

        </LinearLayout>

    </ScrollView>

</LinearLayout>