<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <!-- Main Content -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingBottom="80dp"
        android:clipToPadding="false">

        <!-- Date Range Selector -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp"
            android:paddingBottom="8dp"
            android:scrollbars="none">

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/dateRangeChipGroup"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:singleSelection="true"
                app:selectionRequired="true">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipAllTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="All Time"
                    android:checked="true"
                    style="@style/Widget.AfriNuts.Chip" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipThisYear"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="This Year"
                    style="@style/Widget.AfriNuts.Chip" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipThisMonth"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="This Month"
                    style="@style/Widget.AfriNuts.Chip" />

            </com.google.android.material.chip.ChipGroup>

        </HorizontalScrollView>

        <!-- SwipeRefreshLayout wrapper for pull-to-refresh -->
        <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
            android:id="@+id/swipeRefreshLayout"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@android:color/transparent">

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="16dp"
                android:paddingTop="0dp"
                android:clipToPadding="false"
                android:fillViewport="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- Summary Card - Modern Glass (Accent) -->
                    <androidx.cardview.widget.CardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp"
                        style="@style/Widget.AfriNuts.CardView"
                        app:cardCornerRadius="20dp"
                        app:cardElevation="2dp"
                        android:background="@color/surface">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="20dp"
                            android:background="@color/surface">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Profit &amp; Loss Summary"
                                style="@style/Text.H5"
                                android:textColor="@color/accent_ink"
                                android:layout_marginBottom="16dp" />

                            <!-- Revenue Row -->
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:layout_marginBottom="12dp">

                                <LinearLayout
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:orientation="horizontal"
                                    android:gravity="center_vertical">

                                    <FrameLayout
                                        android:layout_width="32dp"
                                        android:layout_height="32dp"
                                        android:background="@drawable/bg_icon_sand"
                                        android:layout_marginEnd="8dp">

                                        <ImageView
                                            android:layout_width="16dp"
                                            android:layout_height="16dp"
                                            android:layout_gravity="center"
                                            android:src="@drawable/ic_attach_money"
                                            app:tint="@color/accent_ink" />

                                    </FrameLayout>

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="Total Revenue"
                                        style="@style/Text.Body"
                                        android:textColor="?attr/colorOnSurface" />

                                </LinearLayout>

                                <TextView
                                    android:id="@+id/totalRevenueValue"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="0 XAF"
                                    style="@style/Text.Stat.Small"
                                    android:textColor="@android:color/holo_green_dark" />

                            </LinearLayout>

                            <!-- Expenses Row -->
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginBottom="12dp">

                                <LinearLayout
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:orientation="horizontal"
                                    android:gravity="center_vertical">

                                    <FrameLayout
                                        android:layout_width="32dp"
                                        android:layout_height="32dp"
                                        android:background="@drawable/bg_icon_sand"
                                        android:layout_marginEnd="8dp">

                                        <ImageView
                                            android:layout_width="16dp"
                                            android:layout_height="16dp"
                                            android:layout_gravity="center"
                                            android:src="@drawable/ic_money_off"
                                            app:tint="?attr/colorOnSurface" />

                                    </FrameLayout>

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="Total Expenses"
                                        style="@style/Text.Body"
                                        android:textColor="?attr/colorOnSurface" />

                                </LinearLayout>

                                <TextView
                                    android:id="@+id/totalExpensesValue"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="0 XAF"
                                    style="@style/Text.Stat.Small"
                                    android:textColor="@android:color/holo_red_dark" />

                            </LinearLayout>

                            <!-- Divider -->
                            <View
                                android:layout_width="match_parent"
                                android:layout_height="1dp"
                                style="@style/Widget.AfriNuts.Divider"
                                android:layout_marginVertical="12dp" />

                            <!-- Net Profit Row -->
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginBottom="8dp">

                                <LinearLayout
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:orientation="horizontal"
                                    android:gravity="center_vertical">

                                    <FrameLayout
                                        android:layout_width="36dp"
                                        android:layout_height="36dp"
                                        android:background="@drawable/bg_icon_sand"
                                        android:layout_marginEnd="8dp">

                                        <ImageView
                                            android:layout_width="20dp"
                                            android:layout_height="20dp"
                                            android:layout_gravity="center"
                                            android:src="@drawable/ic_trending_up"
                                            app:tint="?attr/colorPrimary" />

                                    </FrameLayout>

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="Net Profit"
                                        style="@style/Text.H5"
                                        android:textColor="?attr/colorOnSurface" />

                                </LinearLayout>

                                <TextView
                                    android:id="@+id/netProfitValue"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="0 XAF"
                                    style="@style/Text.Stat"
                                    android:textColor="?attr/colorPrimary" />

                            </LinearLayout>

                            <!-- Profit Margin -->
                            <TextView
                                android:id="@+id/profitMarginValue"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="0% margin"
                                style="@style/Text.Caption"
                                android:textColor="?attr/colorOnSurface"
                                android:alpha="0.7"
                                android:layout_gravity="end" />

                        </LinearLayout>

                    </androidx.cardview.widget.CardView>

                    <!-- Per Unit Metrics Card -->
                    <androidx.cardview.widget.CardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp"
                        style="@style/Widget.AfriNuts.CardView"
                        app:cardCornerRadius="20dp"
                        app:cardElevation="2dp"
                        android:background="@color/surface">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="20dp"
                            android:background="@color/surface">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Per Unit Analysis"
                                style="@style/Text.H5"
                                android:textColor="?attr/colorPrimary"
                                android:layout_marginBottom="16dp" />

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:weightSum="3"
                                android:layout_marginBottom="12dp"
                                android:background="@color/surface">

                                <!-- Per Hectare -->
                                <LinearLayout
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:orientation="vertical"
                                    android:gravity="center"
                                    android:padding="8dp">

                                    <FrameLayout
                                        android:layout_width="48dp"
                                        android:layout_height="48dp"
                                        android:background="@drawable/bg_icon_sand"
                                        android:layout_marginBottom="8dp">

                                        <ImageView
                                            android:layout_width="24dp"
                                            android:layout_height="24dp"
                                            android:layout_gravity="center"
                                            android:src="@drawable/ic_straighten"
                                            app:tint="?attr/colorPrimary" />

                                    </FrameLayout>

                                    <TextView
                                        android:id="@+id/profitPerHectare"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="0"
                                        style="@style/Text.Stat.Small"
                                        android:textColor="?attr/colorPrimary" />

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="per Ha"
                                        style="@style/Text.Caption.Small"
                                        android:textColor="?attr/colorOnSurface"
                                        android:alpha="0.7" />

                                </LinearLayout>

                                <!-- Per Tree -->
                                <LinearLayout
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:orientation="vertical"
                                    android:gravity="center"
                                    android:padding="8dp">

                                    <FrameLayout
                                        android:layout_width="48dp"
                                        android:layout_height="48dp"
                                        android:background="@drawable/bg_icon_sand"
                                        android:layout_marginBottom="8dp">

                                        <ImageView
                                            android:layout_width="24dp"
                                            android:layout_height="24dp"
                                            android:layout_gravity="center"
                                            android:src="@drawable/ic_park"
                                            app:tint="?attr/colorPrimary" />

                                    </FrameLayout>

                                    <TextView
                                        android:id="@+id/profitPerTree"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="0"
                                        style="@style/Text.Stat.Small"
                                        android:textColor="?attr/colorPrimary"/>

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="per Tree"
                                        style="@style/Text.Caption.Small"
                                        android:textColor="?attr/colorOnSurface"
                                        android:alpha="0.7" />

                                </LinearLayout>

                                <!-- Margin -->
                                <LinearLayout
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:orientation="vertical"
                                    android:gravity="center"
                                    android:padding="8dp">

                                    <FrameLayout
                                        android:layout_width="48dp"
                                        android:layout_height="48dp"
                                        android:background="@drawable/bg_icon_sand"
                                        android:layout_marginBottom="8dp">

                                        <ImageView
                                            android:layout_width="24dp"
                                            android:layout_height="24dp"
                                            android:layout_gravity="center"
                                            android:src="@drawable/ic_trending_up"
                                            app:tint="@color/accent_ink" />

                                    </FrameLayout>

                                    <TextView
                                        android:id="@+id/marginPercent"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="0%"
                                        style="@style/Text.Stat.Small"
                                        android:textColor="@color/accent_ink" />

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="Margin"
                                        style="@style/Text.Caption.Small"
                                        android:textColor="?attr/colorOnSurface"
                                        android:alpha="0.7" />

                                </LinearLayout>

                            </LinearLayout>

                        </LinearLayout>

                    </androidx.cardview.widget.CardView>

                    <!-- Recent Transactions -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Recent Activity"
                        style="@style/Text.H5"
                        android:textColor="?attr/colorPrimary"
                        android:layout_marginBottom="12dp" />

                    <LinearLayout
                        android:id="@+id/recentTransactionsContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />

                    <!-- Progress Bar -->
                    <ProgressBar
                        android:id="@+id/progressBar"
                        style="@style/Widget.AfriNuts.ProgressBar"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:layout_gravity="center"
                        android:layout_marginTop="32dp"
                        android:visibility="gone" />

                    <!-- Empty State -->
                    <LinearLayout
                        android:id="@+id/emptyView"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:layout_marginTop="32dp"
                        android:visibility="gone">

                        <FrameLayout
                            android:layout_width="96dp"
                            android:layout_height="96dp"
                            android:background="@drawable/bg_icon_sand"
                            android:layout_marginBottom="16dp">

                            <ImageView
                                android:layout_width="48dp"
                                android:layout_height="48dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_inventory"
                                app:tint="?attr/colorOnSurface"
                                android:alpha="0.5" />

                        </FrameLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="No transactions found"
                            style="@style/Text.H3"
                            android:textColor="?attr/colorOnSurface"
                            android:alpha="0.7" />

                    </LinearLayout>

                    <!-- Spacer for bottom navigation -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="40dp" />

                </LinearLayout>

            </ScrollView>

        </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

    </LinearLayout>

    <!-- Compact dark pill navigation -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/bottomNavCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="20dp"
        app:cardBackgroundColor="@color/nav_pill_bg"
        app:cardCornerRadius="999dp"
        app:cardElevation="18dp"
        android:elevation="8dp"
        app:cardPreventCornerOverlap="false"
        app:cardUseCompatPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingVertical="4dp"
            android:paddingHorizontal="8dp"
            android:weightSum="4"
            android:background="@color/nav_pill_bg"
            >

            <!-- Home -->
            <LinearLayout
                android:id="@+id/navHome"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="8dp"
                android:clickable="true"
                android:focusable="true"
                android:background="?android:attr/selectableItemBackgroundBorderless">

                <FrameLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">

                    <ImageView
                        android:id="@+id/navHomeIcon"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_home"
                        android:textStyle="bold"
                        app:tint="?attr/navbarIconColor"  />

                    <!-- Active indicator dot -->
                    <View
                        android:layout_width="8dp"
                        android:layout_height="8dp"
                        android:background="@drawable/circle_green"
                        android:layout_gravity="top|end"
                        android:layout_marginTop="-2dp"
                        android:layout_marginEnd="-4dp"
                        android:visibility="gone" />

                </FrameLayout>

                <TextView
                    android:id="@+id/navHomeText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Home"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="?attr/navbarTextColor"
                    android:layout_marginTop="4dp"
                    android:alpha="0.8"
                    android:fontFamily="@font/manrope_medium" />

            </LinearLayout>

            <!-- Farm -->
            <LinearLayout
                android:id="@+id/navFarm"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="8dp"
                android:clickable="true"
                android:focusable="true"
                android:background="?android:attr/selectableItemBackgroundBorderless">

                <FrameLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">

                    <ImageView
                        android:id="@+id/navFarmIcon"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_tractor"
                        android:textStyle="bold"
                        app:tint="?attr/navbarIconColor" />

                    <View
                        android:layout_width="8dp"
                        android:layout_height="8dp"
                        android:background="@drawable/circle_green"
                        android:layout_gravity="top|end"
                        android:layout_marginTop="-2dp"
                        android:layout_marginEnd="-4dp"
                        android:visibility="gone" />

                </FrameLayout>

                <TextView
                    android:id="@+id/navFarmText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Farm"
                    android:textSize="11sp"
                    android:textColor="?attr/navbarTextColor"
                    android:layout_marginTop="4dp"
                    android:textStyle="bold"
                    android:alpha="0.8"
                    android:fontFamily="@font/manrope_medium" />

            </LinearLayout>

            <!-- Finance -->
            <LinearLayout
                android:id="@+id/navFinance"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="8dp"
                android:clickable="true"
                android:focusable="true"
                android:background="?android:attr/selectableItemBackgroundBorderless">

                <FrameLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">

                    <ImageView
                        android:id="@+id/navFinanceIcon"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:textStyle="bold"
                        android:src="@drawable/ic_attach_money"
                        app:tint="?attr/navbarIconColor" />

                    <View
                        android:layout_width="8dp"
                        android:layout_height="8dp"
                        android:background="@drawable/circle_green"
                        android:layout_gravity="top|end"
                        android:layout_marginTop="-2dp"
                        android:layout_marginEnd="-4dp"
                        android:visibility="gone" />

                </FrameLayout>

                <TextView
                    android:id="@+id/navFinanceText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Finance"
                    android:textSize="11sp"
                    android:textColor="?attr/navbarTextColor"
                    android:textStyle="bold"
                    android:layout_marginTop="4dp"
                    android:alpha="0.8"
                    android:fontFamily="@font/manrope_medium" />

            </LinearLayout>

            <!-- Analytics -->
            <LinearLayout
                android:id="@+id/navAnalytics"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="8dp"
                android:clickable="true"
                android:focusable="true"
                android:background="?android:attr/selectableItemBackgroundBorderless">

                <FrameLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">

                    <ImageView
                        android:id="@+id/navAnalyticsIcon"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:textStyle="bold"
                        android:src="@drawable/ic_finance_analytics"
                        app:tint="?attr/navbarIconColor" />

                    <View
                        android:layout_width="8dp"
                        android:layout_height="8dp"
                        android:background="@drawable/circle_green"
                        android:layout_gravity="top|end"
                        android:layout_marginTop="-2dp"
                        android:layout_marginEnd="-4dp"
                        android:visibility="gone" />

                </FrameLayout>

                <TextView
                    android:id="@+id/navAnalyticsText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Analytics"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="?attr/navbarTextColor"
                    android:layout_marginTop="4dp"
                    android:alpha="0.8"
                    android:fontFamily="@font/manrope_medium" />

            </LinearLayout>

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>
</FrameLayout>