<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Bulk QR Code Generation"
        style="@style/Text.H5"
        android:textColor="?attr/colorPrimary"
        android:layout_marginBottom="16dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Generate QR codes for multiple batches at once. Perfect for shipments and export documentation."
        style="@style/Text.Caption"
        android:textColor="?attr/colorOnSurface"
        android:alpha="0.7"
        android:layout_marginBottom="16dp" />

    <!-- Shipment Name -->
    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        style="@style/Widget.AfriNuts.EditText"
        app:boxBackgroundColor="?attr/colorSurface"
        app:boxCornerRadiusBottomEnd="12dp"
        app:boxCornerRadiusBottomStart="12dp"
        app:boxCornerRadiusTopEnd="12dp"
        app:boxCornerRadiusTopStart="12dp"
        app:boxStrokeColor="?attr/colorPrimary">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etShipmentName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Shipment Name"
            android:inputType="text"
            android:textColor="?attr/colorOnSurface"
            android:textColorHint="?attr/colorOnSurface" />

    </com.google.android.material.textfield.TextInputLayout>

    <!-- Select Batches Button -->
    <Button
        android:id="@+id/btnSelectBatches"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Select Batches"
        style="@style/Widget.AfriNuts.Button.Outlined"
        android:layout_marginBottom="8dp"
        app:icon="@drawable/ic_checklist"
        app:iconGravity="textStart" />

    <!-- Generate All Button -->
    <Button
        android:id="@+id/btnGenerateAll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Select All Batches"
        style="@style/Widget.AfriNuts.Button.Outlined"
        android:layout_marginBottom="16dp"
        app:icon="@drawable/ic_select_all"
        app:iconGravity="textStart" />

    <!-- Action Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="end">

        <Button
            android:id="@+id/btnCancel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Cancel"
            style="@style/Widget.AfriNuts.Button.Outlined"
            android:layout_marginEnd="8dp" />

        <Button
            android:id="@+id/btnGenerate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Generate PDF"
            style="@style/Widget.AfriNuts.Button"
            app:icon="@drawable/ic_pdf"
            app:iconGravity="textStart"
            app:iconTint="@android:color/white" />

    </LinearLayout>

</LinearLayout>