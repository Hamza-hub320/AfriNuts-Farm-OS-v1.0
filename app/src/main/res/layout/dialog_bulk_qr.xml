<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/background">

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="20dp">

        <FrameLayout
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginEnd="12dp"
            android:background="@drawable/bg_icon_sand">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_qr_code"
                app:tint="@color/primary" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginEnd="48dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Bulk QR Generation"
                style="@style/Text.H4"
                android:textColor="@color/primary" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Create shipment codes for selected batches"
                style="@style/Text.Caption.Small"
                android:textColor="@color/text_secondary"
                android:alpha="0.8" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Generate QR codes for multiple batches at once."
        style="@style/Text.Caption"
        android:textColor="?attr/colorOnSurface"
        android:alpha="0.7"
        android:layout_marginBottom="16dp" />

    <!-- Shipment Name -->
    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        style="@style/Widget.AfriNuts.EditText"
        app:boxBackgroundColor="@color/background"
        app:boxCornerRadiusBottomEnd="12dp"
        app:boxCornerRadiusBottomStart="12dp"
        app:boxCornerRadiusTopEnd="12dp"
        app:boxCornerRadiusTopStart="12dp"
        app:boxStrokeColor="?attr/colorPrimary">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etShipmentName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Shipment Name"
            android:inputType="text"
            android:textColor="?attr/colorOnSurface"
            android:textColorHint="?attr/colorOnSurface" />

    </com.google.android.material.textfield.TextInputLayout>

    <!-- Select Batches Button -->
    <Button
        android:id="@+id/btnSelectBatches"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Select Batches"
        style="@style/Widget.AfriNuts.Button.Outlined"
        android:layout_marginBottom="8dp"
        app:icon="@drawable/ic_checklist"
        app:iconGravity="textStart" />

    <!-- Generate All Button -->
    <Button
        android:id="@+id/btnGenerateAll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Select All Batches"
        style="@style/Widget.AfriNuts.Button.Outlined"
        android:layout_marginBottom="16dp"
        app:icon="@drawable/ic_select_all"
        app:iconGravity="textStart" />

    <!-- Action Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="end">

        <Button
            android:id="@+id/btnCancel"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:text="Cancel"
            style="@style/Widget.AfriNuts.Button.Outlined"
            android:textSize="15sp"
            android:fontFamily="@font/manrope_extrabold"
            android:layout_marginEnd="8dp"
            app:backgroundTint="#F3EAD8"
            app:strokeColor="#E9E1CF" />

        <Button
            android:id="@+id/btnGenerate"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:text="Generate PDF"
            style="@style/Widget.AfriNuts.Button"
            android:textSize="15sp"
            android:fontFamily="@font/manrope_extrabold"
            app:icon="@drawable/ic_pdf"
            app:iconGravity="textStart"
            app:iconTint="@android:color/white" />

    </LinearLayout>

</LinearLayout>
</ScrollView>
