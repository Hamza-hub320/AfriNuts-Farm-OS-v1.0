<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:paddingBottom="80dp"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

           <!-- Location Card - Glass Morphism -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardCornerRadius="20dp"
                app:cardElevation="2dp"
                android:background="@drawable/bg_card_selector_accent"
                style="@style/Widget.AfriNuts.CardView"
                android:clipChildren="false"
                android:outlineProvider="background"
                android:foreground="?android:attr/selectableItemBackgroundBorderless">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="12dp"
                    android:gravity="center"
                    android:background="@color/surface">

                    <FrameLayout
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@drawable/bg_icon_sand"
                        android:layout_marginBottom="4dp">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_location"
                            app:tint="@color/accent_ink" />

                    </FrameLayout>

                    <TextView
                        android:id="@+id/tvLocation"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        style="@style/Text.H3"
                        android:text="Odienné, Côte d'Ivoire"
                        android:textColor="@color/accent_ink"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/tvLastUpdated"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        style="@style/Text.Caption.Small"
                        android:text="Updated: "
                        android:textColor="?attr/colorOnSurface"
                        android:layout_marginTop="2dp"
                        android:visibility="gone" />

                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <!-- Current Weather Card - Glass Morphism with Gradient -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="20dp"
                app:cardElevation="2dp"
                android:background="@drawable/bg_card_selector"
                style="@style/Widget.AfriNuts.CardView"
                android:clipChildren="false"
                android:outlineProvider="background"
                android:foreground="?android:attr/selectableItemBackgroundBorderless">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="24dp"
                    android:gravity="center"
                    android:background="@color/surface"
                    android:outlineProvider="background"
                    android:foreground="?android:attr/selectableItemBackgroundBorderless">

                    <FrameLayout
                        android:layout_width="96dp"
                        android:layout_height="96dp"
                        android:background="@drawable/bg_icon_sand"
                        android:layout_marginBottom="12dp">

                        <ImageView
                            android:id="@+id/ivWeatherIcon"
                            android:layout_width="56dp"
                            android:layout_height="56dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_wb_sunny"
                            app:tint="@color/accent_ink"
                            android:contentDescription="Weather icon" />

                    </FrameLayout>

                    <TextView
                        android:id="@+id/tvTemp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        style="@style/Text.Stat.Large"
                        android:text="32°C"
                        android:textColor="?attr/colorPrimary" />

                    <TextView
                        android:id="@+id/tvCondition"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        style="@style/Text.H4"
                        android:text="Sunny"
                        android:textColor="@color/accent_ink"
                        android:layout_marginBottom="20dp" />

                    <!-- Weather Details Grid - Modern Card Layout -->
                    <androidx.cardview.widget.CardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:cardCornerRadius="20dp"
                        android:padding="8dp"
                        android:background="@drawable/bg_card_selector_secondary"
                        android:clipChildren="false"
                        android:outlineProvider="background"
                        android:foreground="?android:attr/selectableItemBackgroundBorderless">

                        <GridLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:columnCount="2"
                            android:rowCount="2"
                            android:background="@color/surface">

                            <!-- Feels Like -->
                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_columnWeight="1"
                                android:orientation="vertical"
                                android:gravity="center"
                                android:padding="16dp">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Feels Like"
                                    style="@style/Text.Caption"
                                    android:textColor="?attr/colorOnSurface" />

                                <TextView
                                    android:id="@+id/tvFeelsLike"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="35°C"
                                    style="@style/Text.H4"
                                    android:textColor="?attr/colorPrimary"
                                    android:layout_marginTop="4dp" />

                            </LinearLayout>

                            <!-- Humidity -->
                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_columnWeight="1"
                                android:orientation="vertical"
                                android:gravity="center"
                                android:padding="16dp">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Humidity"
                                    style="@style/Text.Caption"
                                    android:textColor="?attr/colorOnSurface" />

                                <TextView
                                    android:id="@+id/tvHumidity"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="45%"
                                    style="@style/Text.H4"
                                    android:textColor="?attr/colorPrimary"
                                    android:layout_marginTop="4dp" />

                            </LinearLayout>

                            <!-- Wind -->
                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_columnWeight="1"
                                android:orientation="vertical"
                                android:gravity="center"
                                android:padding="16dp">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Wind"
                                    style="@style/Text.Caption"
                                    android:textColor="?attr/colorOnSurface" />

                                <TextView
                                    android:id="@+id/tvWind"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="12 km/h"
                                    style="@style/Text.H4"
                                    android:textColor="?attr/colorPrimary"
                                    android:layout_marginTop="4dp" />

                            </LinearLayout>

                            <!-- UV Index -->
                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_columnWeight="1"
                                android:orientation="vertical"
                                android:gravity="center"
                                android:padding="16dp">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="UV Index"
                                    style="@style/Text.Caption"
                                    android:textColor="?attr/colorOnSurface" />

                                <TextView
                                    android:id="@+id/tvUvIndex"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="5"
                                    style="@style/Text.H4"
                                    android:textColor="?attr/colorPrimary"
                                    android:layout_marginTop="4dp" />

                            </LinearLayout>

                        </GridLayout>

                    </androidx.cardview.widget.CardView>

                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <!-- Sunrise/Sunset Card - Glass Morphism -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="20dp"
                app:cardElevation="2dp"
                android:background="@drawable/bg_card_selector_secondary"
                style="@style/Widget.AfriNuts.CardView"
                android:clipChildren="false"
                android:outlineProvider="background"
                android:foreground="?android:attr/selectableItemBackgroundBorderless">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="20dp"
                    android:background="@color/surface"
                    android:outlineProvider="background"
                    android:foreground="?android:attr/selectableItemBackgroundBorderless">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center">

                        <FrameLayout
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:background="@drawable/bg_icon_sand"
                            android:layout_marginBottom="8dp">

                            <ImageView
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_wb_sunny"
                                app:tint="@color/accent_ink"
                                android:contentDescription="Sunrise icon" />

                        </FrameLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Sunrise"
                            style="@style/Text.Caption"
                            android:textColor="?attr/colorOnSurface" />

                        <TextView
                            android:id="@+id/tvSunrise"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="06:15"
                            style="@style/Text.H4"
                            android:textColor="?attr/colorPrimary"
                            android:layout_marginTop="4dp" />

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center">

                        <FrameLayout
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:background="@drawable/bg_icon_sand"
                            android:layout_marginBottom="8dp">

                            <ImageView
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_wb_sunny"
                                app:tint="@color/accent_ink"
                                android:contentDescription="Sunset icon" />

                        </FrameLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Sunset"
                            style="@style/Text.Caption"
                            android:textColor="?attr/colorOnSurface" />

                        <TextView
                            android:id="@+id/tvSunset"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="18:30"
                            style="@style/Text.H4"
                            android:textColor="?attr/colorPrimary"
                            android:layout_marginTop="4dp" />

                    </LinearLayout>

                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <!-- Farm Advice Card -->
            <androidx.cardview.widget.CardView
                android:id="@+id/adviceCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="20dp"
                app:cardElevation="2dp"
                android:background="@drawable/bg_card_selector_accent"
                style="@style/Widget.AfriNuts.CardView"
                android:clipChildren="false"
                android:outlineProvider="background"
                android:foreground="?android:attr/selectableItemBackgroundBorderless">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="20dp"
                    android:background="@color/surface"
                    android:outlineProvider="background"
                    android:foreground="?android:attr/selectableItemBackgroundBorderless">

                    <FrameLayout
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:background="@drawable/bg_icon_sand"
                        android:layout_marginEnd="12dp">

                        <ImageView
                            android:id="@+id/adviceIcon"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_park"
                            app:tint="@color/accent_ink"
                            android:contentDescription="Farm advice icon" />

                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Farm Advice"
                            style="@style/Text.H5"
                            android:textColor="?attr/colorPrimary"
                            android:layout_marginBottom="4dp" />

                        <TextView
                            android:id="@+id/tvFarmAdvice"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Good conditions for planting"
                            style="@style/Text.Body"
                            android:textColor="?attr/colorOnSurface" />

                    </LinearLayout>

                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <!-- Forecast Title -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="3-Day Forecast"
                style="@style/Text.H5"
                android:textColor="?attr/colorPrimary"
                android:layout_marginBottom="12dp" />

            <!-- Forecast Container -->
            <LinearLayout
                android:id="@+id/forecastContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <!-- Spacer for bottom navigation -->
            <View
                android:layout_width="match_parent"
                android:layout_height="40dp" />

        </LinearLayout>

    </ScrollView>

    <!-- Compact dark pill navigation -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/bottomNavCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="20dp"
        app:cardBackgroundColor="@color/nav_pill_bg"
        app:cardCornerRadius="999dp"
        app:cardElevation="18dp"
        android:elevation="8dp"
        app:cardPreventCornerOverlap="false"
        app:cardUseCompatPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingVertical="4dp"
            android:paddingHorizontal="8dp"
            android:weightSum="4"
            android:background="@color/nav_pill_bg"
            >

            <!-- Home -->
            <LinearLayout
                android:id="@+id/navHome"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="8dp"
                android:clickable="true"
                android:focusable="true"
                android:background="?android:attr/selectableItemBackgroundBorderless">

                <FrameLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">

                    <ImageView
                        android:id="@+id/navHomeIcon"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_home"
                        android:textStyle="bold"
                        app:tint="?attr/navbarIconColor"  />

                    <!-- Active indicator dot -->
                    <View
                        android:layout_width="8dp"
                        android:layout_height="8dp"
                        android:background="@drawable/circle_green"
                        android:layout_gravity="top|end"
                        android:layout_marginTop="-2dp"
                        android:layout_marginEnd="-4dp"
                        android:visibility="gone" />

                </FrameLayout>

                <TextView
                    android:id="@+id/navHomeText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Home"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="?attr/navbarTextColor"
                    android:layout_marginTop="4dp"
                    android:alpha="0.8"
                    android:fontFamily="@font/manrope_medium" />

            </LinearLayout>

            <!-- Farm -->
            <LinearLayout
                android:id="@+id/navFarm"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="8dp"
                android:clickable="true"
                android:focusable="true"
                android:background="?android:attr/selectableItemBackgroundBorderless">

                <FrameLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">

                    <ImageView
                        android:id="@+id/navFarmIcon"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_tractor"
                        android:textStyle="bold"
                        app:tint="?attr/navbarIconColor" />

                    <View
                        android:layout_width="8dp"
                        android:layout_height="8dp"
                        android:background="@drawable/circle_green"
                        android:layout_gravity="top|end"
                        android:layout_marginTop="-2dp"
                        android:layout_marginEnd="-4dp"
                        android:visibility="gone" />

                </FrameLayout>

                <TextView
                    android:id="@+id/navFarmText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Farm"
                    android:textSize="11sp"
                    android:textColor="?attr/navbarTextColor"
                    android:layout_marginTop="4dp"
                    android:textStyle="bold"
                    android:alpha="0.8"
                    android:fontFamily="@font/manrope_medium" />

            </LinearLayout>

            <!-- Finance -->
            <LinearLayout
                android:id="@+id/navFinance"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="8dp"
                android:clickable="true"
                android:focusable="true"
                android:background="?android:attr/selectableItemBackgroundBorderless">

                <FrameLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">

                    <ImageView
                        android:id="@+id/navFinanceIcon"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:textStyle="bold"
                        android:src="@drawable/ic_attach_money"
                        app:tint="?attr/navbarIconColor" />

                    <View
                        android:layout_width="8dp"
                        android:layout_height="8dp"
                        android:background="@drawable/circle_green"
                        android:layout_gravity="top|end"
                        android:layout_marginTop="-2dp"
                        android:layout_marginEnd="-4dp"
                        android:visibility="gone" />

                </FrameLayout>

                <TextView
                    android:id="@+id/navFinanceText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Finance"
                    android:textSize="11sp"
                    android:textColor="?attr/navbarTextColor"
                    android:textStyle="bold"
                    android:layout_marginTop="4dp"
                    android:alpha="0.8"
                    android:fontFamily="@font/manrope_medium" />

            </LinearLayout>

            <!-- Analytics -->
            <LinearLayout
                android:id="@+id/navAnalytics"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="8dp"
                android:clickable="true"
                android:focusable="true"
                android:background="?android:attr/selectableItemBackgroundBorderless">

                <FrameLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">

                    <ImageView
                        android:id="@+id/navAnalyticsIcon"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:textStyle="bold"
                        android:src="@drawable/ic_finance_analytics"
                        app:tint="?attr/navbarIconColor" />

                    <View
                        android:layout_width="8dp"
                        android:layout_height="8dp"
                        android:background="@drawable/circle_green"
                        android:layout_gravity="top|end"
                        android:layout_marginTop="-2dp"
                        android:layout_marginEnd="-4dp"
                        android:visibility="gone" />

                </FrameLayout>

                <TextView
                    android:id="@+id/navAnalyticsText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Analytics"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="?attr/navbarTextColor"
                    android:layout_marginTop="4dp"
                    android:alpha="0.8"
                    android:fontFamily="@font/manrope_medium" />

            </LinearLayout>

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>
</FrameLayout>