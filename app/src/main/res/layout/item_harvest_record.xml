<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:padding="12dp"
    android:background="@color/surface"
    android:layout_marginBottom="8dp"
    app:cornerRadius="24dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tvHarvestDate"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Apr 14, 2027"
                style="@style/Text.Body"
                android:textColor="?attr/colorOnSurface" />

            <TextView
                android:id="@+id/tvHarvestQuantity"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="1,000 kg"
                style="@style/Text.H6"
                android:textColor="?attr/colorPrimary" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="4dp">

            <TextView
                android:id="@+id/tvHarvestGrade"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Premium"
                style="@style/Text.Caption"
                android:textColor="@color/accent_ink"
                android:background="@color/surface"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingTop="2dp"
                android:paddingBottom="2dp"
                app:cornerRadius="4dp" />

            <TextView
                android:id="@+id/tvHarvestNotes"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="2"
                android:text="2027 harvest"
                style="@style/Text.Caption"
                android:textColor="?attr/colorOnSurface"
                android:alpha="0.6"
                android:ellipsize="end"
                android:maxLines="1" />

        </LinearLayout>

    </LinearLayout>

    <ImageView
        android:id="@+id/btnEditRecord"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:src="@drawable/ic_edit"
        app:tint="?attr/colorPrimary"
        android:background="@drawable/bg_icon_sand"
        android:padding="6dp"
        android:clickable="true"
        android:focusable="true" />

</LinearLayout>