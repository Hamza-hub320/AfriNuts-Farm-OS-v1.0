<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background">

    <!-- Modern Glass Morphism Toolbar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="12dp"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <ImageButton
            android:id="@+id/farmDetailBack"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_farm_action_circle"
            android:src="@drawable/ic_finance_back_chevron"
            android:contentDescription="Back"
            android:padding="12dp"
            app:tint="#1C1B1A" />
        <TextView
            android:id="@+id/farmDetailTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Details"
            android:textColor="#1C1B1A"
            android:textSize="17sp"
            android:fontFamily="@font/manrope_extrabold" />
        <ImageButton
            android:id="@+id/farmDetailEdit"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginEnd="9dp"
            android:background="@drawable/bg_farm_action_circle"
            android:src="@drawable/ic_edit"
            android:contentDescription="Edit"
            android:padding="12dp"
            app:tint="#1C1B1A" />
        <ImageButton
            android:id="@+id/farmDetailMore"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_farm_action_circle"
            android:src="@drawable/ic_more_horiz"
            android:contentDescription="More actions"
            android:padding="12dp"
            app:tint="#1C1B1A" />
    </LinearLayout>



    <ScrollView
        android:id="@+id/expenseDetailScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingStart="20dp"
        android:paddingTop="18dp"
        android:paddingEnd="20dp"
        android:paddingBottom="24dp"
        android:clipToPadding="false"
        android:fillViewport="true">

        <LinearLayout
            android:id="@+id/expenseDetailContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView android:id="@+id/tvFinanceAmountDisplay" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
            <TextView android:id="@+id/tvFinanceDateDisplay" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
            <TextView android:id="@+id/tvFinanceSourceDisplay" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />

            <!-- Category Header Card - Modern Glass -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardCornerRadius="28dp"
                app:cardElevation="0dp"
                android:background="@color/surface"
                style="@style/Widget.AfriNuts.CardView">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="20dp"
                    android:background="@color/surface">

                    <FrameLayout
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:background="@drawable/bg_icon_sand"
                        android:layout_marginEnd="16dp">

                        <!-- Edge Effect -->
                        <View
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@drawable/bg_edge_effect"
                            android:alpha="0.3" />

                        <!-- Glassy Overlay -->
                        <View
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@color/surface"
                            android:alpha="0.4" />

                        <!-- Inner Shadow -->
                        <View
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@drawable/bg_inner_shadow" />

                        <ImageView
                            android:id="@+id/tvCategoryIcon"
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_attach_money"
                            app:tint="@color/accent_ink"
                            android:contentDescription="Category icon" />

                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvCategoryName"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Land Clearing"
                            style="@style/Text.H3"
                            android:textColor="@color/accent_ink" />

                        <TextView
                            android:id="@+id/tvBlockInfo"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Farm-Wide"
                            style="@style/Text.Body.Small"
                            android:textColor="?attr/colorOnSurface"
                            android:alpha="0.7"
                            android:layout_marginTop="4dp" />

                    </LinearLayout>

                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <!-- Photos Card - Modern Glass -->
            <androidx.cardview.widget.CardView
                android:id="@+id/expensePhotosCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                style="@style/Widget.AfriNuts.CardView"
                app:cardCornerRadius="24dp"
                app:cardElevation="0dp"
                android:background="@color/surface"
                android:foreground="?android:attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true">


                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="16dp"
                    android:id="@+id/btnPhotoGallery"
                    android:background="@color/surface">

                    <FrameLayout
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:background="@drawable/bg_icon_sand"
                        android:layout_marginEnd="16dp">

                        <!-- Edge Effect -->
                        <View
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@drawable/bg_edge_effect"
                            android:alpha="0.3" />

                        <!-- Glassy Overlay -->
                        <View
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@color/surface"
                            android:alpha="0.4" />

                        <!-- Inner Shadow -->
                        <View
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@drawable/bg_inner_shadow" />

                        <ImageView
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_photo"
                            app:tint="@color/accent_ink" />

                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Photos"
                            style="@style/Text.H5"
                            android:textColor="@color/accent_ink" />

                        <TextView
                            android:id="@+id/tvPhotoCount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0 photos"
                            style="@style/Text.Caption"
                            android:textColor="?attr/colorOnSurface"
                            android:alpha="0.7" />

                    </LinearLayout>

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_arrow_forward"
                        app:tint="@color/accent_ink" />

                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <!-- Procurement Info -->
            <TextView
                android:id="@+id/tvProcurementInfo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:padding="12dp"
                android:background="@color/surface"
                style="@style/Text.Body"
                android:textColor="@color/accent_ink"
                android:visibility="gone" />

            <!-- Details Card - Modern Glass -->
            <androidx.cardview.widget.CardView
                android:id="@+id/expenseDetailsCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardCornerRadius="24dp"
                app:cardElevation="0dp"
                android:background="@color/surface"
                style="@style/Widget.AfriNuts.CardView">

                <LinearLayout
                    android:id="@+id/expenseDetailsBody"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp"
                    android:background="@color/surface">

                    <TextView
                        android:id="@+id/expenseDetailsHeading"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Details"
                        android:textColor="#1C1B1A"
                        android:textSize="16sp"
                        android:fontFamily="@font/manrope_extrabold"
                        android:layout_marginBottom="8dp" />

                    <!-- Amount Field -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp"
                        style="@style/Widget.AfriNuts.EditText"
                        app:boxBackgroundColor="@android:color/transparent">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etAmount"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="Amount (XAF)"
                            android:inputType="numberDecimal"
                            android:enabled="false"
                            android:textColor="?attr/colorOnSurface"
                            android:textColorHint="?attr/colorOnSurface" />

                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Date Field -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp"
                        style="@style/Widget.AfriNuts.EditText"
                        app:endIconMode="custom"
                        app:endIconDrawable="@drawable/ic_today"
                        app:endIconTint="@color/accent_ink"
                        app:boxBackgroundColor="@android:color/transparent">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etDate"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="Date"
                            android:focusable="false"
                            android:clickable="true"
                            android:enabled="false"
                            android:textColor="?attr/colorOnSurface"
                            android:textColorHint="?attr/colorOnSurface" />

                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Block Selector (Edit Mode Only) -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/layoutBlockSelector"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp"
                        android:visibility="gone"
                        style="@style/Widget.AfriNuts.EditText"
                        android:hint="Select Block"
                        app:boxBackgroundColor="@android:color/transparent"
                        app:endIconMode="dropdown_menu"
                        app:endIconDrawable="@drawable/ic_arrow_drop_down"
                        app:endIconTint="@color/accent_ink">

                        <com.google.android.material.textfield.MaterialAutoCompleteTextView
                            android:id="@+id/tvBlockSelector"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Farm-Wide"
                            android:focusable="false"
                            android:clickable="true"
                            android:textColor="?attr/colorOnSurface"
                            android:textColorHint="?attr/colorOnSurface" />

                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Description Field -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        style="@style/Widget.AfriNuts.EditText"
                        app:boxBackgroundColor="@android:color/transparent">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etDescription"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="Description"
                            android:inputType="textMultiLine"
                            android:minLines="3"
                            android:enabled="false"
                            android:background="@drawable/bg_rounded_description"
                            android:textColor="?attr/colorOnSurface"
                            android:textColorHint="?attr/colorOnSurface" />

                    </com.google.android.material.textfield.TextInputLayout>

                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <!-- Edit Mode Fields - Glass Morphism Card -->
            <androidx.cardview.widget.CardView
                android:id="@+id/layoutEditFields"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="20dp"
                app:cardElevation="2dp"
                android:background="@color/surface"
                style="@style/Widget.AfriNuts.CardView">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp"
                    android:background="@color/surface">

                    <!-- Section Header -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="16dp">

                        <FrameLayout
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:background="@drawable/bg_icon_sand"
                            android:layout_marginEnd="12dp">

                            <ImageView
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_edit"
                                app:tint="?attr/colorPrimary" />

                        </FrameLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Edit Expense"
                            style="@style/Text.H4"
                            android:textColor="?attr/colorPrimary" />

                    </LinearLayout>

                    <!-- Procurement Section (Edit Mode) -->
                    <LinearLayout
                        android:id="@+id/layoutProcurementSection"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="gone"
                        android:layout_marginBottom="12dp">

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:background="?attr/colorOnSurface"
                            android:alpha="0.1"
                            android:layout_marginVertical="8dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Procurement Details"
                            style="@style/Text.H5"
                            android:textColor="@color/accent_ink"
                            android:layout_marginBottom="12dp" />

                        <!-- Supplier Selector -->
                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/layoutSupplierSelector"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="12dp"
                            style="@style/Widget.AfriNuts.EditText"
                            app:endIconMode="dropdown_menu"
                            app:endIconDrawable="@drawable/ic_arrow_drop_down"
                            app:endIconTint="@color/accent_ink"
                            app:boxBackgroundColor="?attr/colorSurface"
                            app:boxCornerRadiusBottomEnd="12dp"
                            app:boxCornerRadiusBottomStart="12dp"
                            app:boxCornerRadiusTopEnd="12dp"
                            app:boxCornerRadiusTopStart="12dp"
                            app:boxStrokeColor="?attr/colorSecondary">

                            <com.google.android.material.textfield.MaterialAutoCompleteTextView
                                android:id="@+id/etSupplier"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:hint="Select Supplier"
                                android:inputType="none"
                                android:textColor="?attr/colorOnSurface"
                                android:textColorHint="?attr/colorOnSurface" />

                        </com.google.android.material.textfield.TextInputLayout>

                        <!-- Batch Selector -->
                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/layoutBatchSelector"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="12dp"
                            style="@style/Widget.AfriNuts.EditText"
                            app:endIconMode="dropdown_menu"
                            app:endIconDrawable="@drawable/ic_arrow_drop_down"
                            app:endIconTint="@color/accent_ink"
                            app:boxBackgroundColor="?attr/colorSurface"
                            app:boxCornerRadiusBottomEnd="12dp"
                            app:boxCornerRadiusBottomStart="12dp"
                            app:boxCornerRadiusTopEnd="12dp"
                            app:boxCornerRadiusTopStart="12dp"
                            app:boxStrokeColor="?attr/colorSecondary">

                            <com.google.android.material.textfield.MaterialAutoCompleteTextView
                                android:id="@+id/etBatch"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:hint="Select Batch"
                                android:inputType="none"
                                android:textColor="?attr/colorOnSurface"
                                android:textColorHint="?attr/colorOnSurface" />

                        </com.google.android.material.textfield.TextInputLayout>

                    </LinearLayout>

                    <!-- Amount Edit -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        style="@style/Widget.AfriNuts.EditText"
                        app:boxBackgroundColor="?attr/colorSurface"
                        app:boxCornerRadiusBottomEnd="12dp"
                        app:boxCornerRadiusBottomStart="12dp"
                        app:boxCornerRadiusTopEnd="12dp"
                        app:boxCornerRadiusTopStart="12dp"
                        app:boxStrokeColor="?attr/colorPrimary">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etAmountEdit"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="Amount (XAF)"
                            android:inputType="numberDecimal"
                            android:textColor="?attr/colorOnSurface"
                            android:textColorHint="?attr/colorOnSurface" />

                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Date Edit -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        style="@style/Widget.AfriNuts.EditText"
                        app:endIconMode="custom"
                        app:endIconDrawable="@drawable/ic_today"
                        app:endIconTint="@color/accent_ink"
                        app:boxBackgroundColor="?attr/colorSurface"
                        app:boxCornerRadiusBottomEnd="12dp"
                        app:boxCornerRadiusBottomStart="12dp"
                        app:boxCornerRadiusTopEnd="12dp"
                        app:boxCornerRadiusTopStart="12dp"
                        app:boxStrokeColor="?attr/colorSecondary">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etDateEdit"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="Date"
                            android:focusable="false"
                            android:clickable="true"
                            android:textColor="?attr/colorOnSurface"
                            android:textColorHint="?attr/colorOnSurface" />

                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Block Selector Edit -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/layoutBlockSelectorEdit"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:visibility="gone"
                        style="@style/Widget.AfriNuts.EditText"
                        android:hint="Select Block"
                        app:endIconMode="dropdown_menu"
                        app:endIconDrawable="@drawable/ic_arrow_drop_down"
                        app:endIconTint="@color/accent_ink"
                        app:boxBackgroundColor="?attr/colorSurface"
                        app:boxCornerRadiusBottomEnd="12dp"
                        app:boxCornerRadiusBottomStart="12dp"
                        app:boxCornerRadiusTopEnd="12dp"
                        app:boxCornerRadiusTopStart="12dp"
                        app:boxStrokeColor="?attr/colorSecondary">

                        <com.google.android.material.textfield.MaterialAutoCompleteTextView
                            android:id="@+id/tvBlockSelectorEdit"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Farm-Wide"
                            android:focusable="false"
                            android:clickable="true"
                            android:textColor="?attr/colorOnSurface"
                            android:textColorHint="?attr/colorOnSurface" />

                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Description Edit -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        style="@style/Widget.AfriNuts.EditText"
                        app:boxBackgroundColor="?attr/colorSurface"
                        app:boxCornerRadiusBottomEnd="12dp"
                        app:boxCornerRadiusBottomStart="12dp"
                        app:boxCornerRadiusTopEnd="12dp"
                        app:boxCornerRadiusTopStart="12dp"
                        app:boxStrokeColor="?attr/colorPrimary">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etDescriptionEdit"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="Description"
                            android:inputType="textMultiLine"
                            android:minLines="3"
                            android:textColor="?attr/colorOnSurface"
                            android:textColorHint="?attr/colorOnSurface" />

                    </com.google.android.material.textfield.TextInputLayout>

                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <!-- Action Buttons - Liquid Glass Style -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_horizontal"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="24dp">

                <!-- Edit Button - Accent -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnEdit"
                    android:layout_width="0dp"
                    android:layout_height="46dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    android:text="Edit"
                    style="@style/Widget.AfriNuts.Button"
                    app:icon="@drawable/ic_edit"
                    app:iconGravity="textStart" />

                <!-- Save Button - Primary -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSave"
                    android:layout_width="0dp"
                    android:layout_height="46dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    android:text="Save"
                    style="@style/Widget.AfriNuts.Button"
                    app:icon="@drawable/ic_save"
                    app:iconGravity="textStart"
                    android:visibility="gone" />

                <!-- Delete Button - Danger -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnDelete"
                    android:layout_width="0dp"
                    android:layout_height="46dp"
                    android:layout_weight="1"
                    android:text="Delete"
                    style="@style/Widget.AfriNuts.Button.Danger"
                    app:icon="@drawable/ic_delete"
                    app:iconGravity="textStart"
                    app:iconTint="@color/error" />

            </LinearLayout>

        </LinearLayout>

    </ScrollView>

    <!-- Floating Action Button for quick edit -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabEdit"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="16dp"
        android:src="@drawable/ic_edit"
        android:contentDescription="Edit expense"
        app:backgroundTint="@color/primary"
        app:tint="@android:color/white" />

</LinearLayout>
