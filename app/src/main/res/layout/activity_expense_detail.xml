<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?android:attr/colorBackground">

    <!-- Modern Glass Morphism Toolbar -->
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="?attr/cardBackgroundPrimary"
        android:theme="@style/ThemeOverlay.AppCompat.Dark.ActionBar"
        android:elevation="0dp"
        android:translationZ="0dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="16dp"
        android:layout_gravity="center_horizontal">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">

            <ImageView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/ic_afrinuts_foreground"
                android:alpha="0.95"
                android:layout_marginEnd="12dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Expense Details"
                android:textColor="?attr/colorOnSurface"
                android:textSize="18sp"
                android:textStyle="bold"
                android:letterSpacing="0.01" />

        </LinearLayout>

    </androidx.appcompat.widget.Toolbar>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="16dp"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Category Header Card - Modern Glass -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="24dp"
                app:cardElevation="4dp"
                android:background="?attr/cardBackgroundAccent"
                style="@style/Widget.AfriNuts.CardView">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="20dp"
                    android:background="?attr/cardBackgroundPrimary">

                    <FrameLayout
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:background="?attr/iconBackgroundGlass"
                        android:layout_marginEnd="16dp">

                        <!-- Edge Effect -->
                        <View
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@drawable/bg_edge_effect"
                            android:alpha="0.3" />

                        <!-- Glassy Overlay -->
                        <View
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@drawable/bg_glassy_overlay"
                            android:alpha="0.4" />

                        <!-- Inner Shadow -->
                        <View
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@drawable/bg_inner_shadow" />

                        <ImageView
                            android:id="@+id/tvCategoryIcon"
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_attach_money"
                            app:tint="?attr/colorSecondary"
                            android:contentDescription="Category icon" />

                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvCategoryName"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Land Clearing"
                            style="@style/Text.H3"
                            android:textColor="?attr/colorSecondary" />

                        <TextView
                            android:id="@+id/tvBlockInfo"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Farm-Wide"
                            style="@style/Text.Body.Small"
                            android:textColor="?attr/colorOnSurface"
                            android:alpha="0.7"
                            android:layout_marginTop="4dp" />

                    </LinearLayout>

                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <!-- Photos Card - Modern Glass -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                style="@style/Widget.AfriNuts.CardView"
                app:cardCornerRadius="24dp"
                app:cardElevation="4dp"
                android:background="?attr/cardBackgroundAccent"
                android:foreground="?android:attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true">


                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="16dp"
                    android:id="@+id/btnPhotoGallery"
                    android:background="?attr/cardBackgroundPrimary">

                    <FrameLayout
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:background="?attr/iconBackgroundGlass"
                        android:layout_marginEnd="16dp">

                        <!-- Edge Effect -->
                        <View
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@drawable/bg_edge_effect"
                            android:alpha="0.3" />

                        <!-- Glassy Overlay -->
                        <View
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@drawable/bg_glassy_overlay"
                            android:alpha="0.4" />

                        <!-- Inner Shadow -->
                        <View
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@drawable/bg_inner_shadow" />

                        <ImageView
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_photo"
                            app:tint="?attr/colorSecondary" />

                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Photos"
                            style="@style/Text.H5"
                            android:textColor="?attr/colorSecondary" />

                        <TextView
                            android:id="@+id/tvPhotoCount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0 photos"
                            style="@style/Text.Caption"
                            android:textColor="?attr/colorOnSurface"
                            android:alpha="0.7" />

                    </LinearLayout>

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_arrow_forward"
                        app:tint="?attr/colorSecondary" />

                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <!-- Procurement Info -->
            <TextView
                android:id="@+id/tvProcurementInfo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:padding="12dp"
                android:background="?attr/cardBackgroundSecondary"
                style="@style/Text.Body"
                android:textColor="?attr/colorSecondary"
                android:visibility="gone" />

            <!-- Details Card - Modern Glass -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="24dp"
                app:cardElevation="4dp"
                android:background="?attr/cardBackgroundPrimary"
                style="@style/Widget.AfriNuts.CardView">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp"
                    android:background="?attr/cardBackgroundPrimary">

                    <!-- Amount Field -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp"
                        style="@style/Widget.AfriNuts.EditText"
                        app:boxBackgroundColor="@android:color/transparent">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etAmount"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="Amount (XAF)"
                            android:inputType="numberDecimal"
                            android:enabled="false"
                            android:textColor="?attr/colorOnSurface"
                            android:textColorHint="?attr/colorOnSurface" />

                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Date Field -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp"
                        style="@style/Widget.AfriNuts.EditText"
                        app:endIconMode="custom"
                        app:endIconDrawable="@drawable/ic_today"
                        app:endIconTint="?attr/colorSecondary"
                        app:boxBackgroundColor="@android:color/transparent">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etDate"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="Date"
                            android:focusable="false"
                            android:clickable="true"
                            android:enabled="false"
                            android:textColor="?attr/colorOnSurface"
                            android:textColorHint="?attr/colorOnSurface" />

                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Block Selector (Edit Mode Only) -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/layoutBlockSelector"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp"
                        android:visibility="gone"
                        style="@style/Widget.AfriNuts.EditText"
                        android:hint="Select Block"
                        app:boxBackgroundColor="@android:color/transparent"
                        app:endIconMode="dropdown_menu"
                        app:endIconDrawable="@drawable/ic_arrow_drop_down"
                        app:endIconTint="?attr/colorSecondary">

                        <com.google.android.material.textfield.MaterialAutoCompleteTextView
                            android:id="@+id/tvBlockSelector"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Farm-Wide"
                            android:focusable="false"
                            android:clickable="true"
                            android:textColor="?attr/colorOnSurface"
                            android:textColorHint="?attr/colorOnSurface" />

                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Description Field -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        style="@style/Widget.AfriNuts.EditText"
                        app:boxBackgroundColor="@android:color/transparent">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etDescription"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="Description"
                            android:inputType="textMultiLine"
                            android:minLines="3"
                            android:enabled="false"
                            android:background="@drawable/bg_rounded_description"
                            android:textColor="?attr/colorOnSurface"
                            android:textColorHint="?attr/colorOnSurface" />

                    </com.google.android.material.textfield.TextInputLayout>

                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <!-- Edit Mode Fields - Glass Morphism Card -->
            <androidx.cardview.widget.CardView
                android:id="@+id/layoutEditFields"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="24dp"
                app:cardElevation="4dp"
                android:background="?attr/cardBackgroundPrimary"
                style="@style/Widget.AfriNuts.CardView">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp"
                    android:background="?attr/cardBackgroundPrimary">

                    <!-- Section Header -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="16dp">

                        <FrameLayout
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:background="?attr/iconBackgroundGlass"
                            android:layout_marginEnd="12dp">

                            <ImageView
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_edit"
                                app:tint="?attr/colorPrimary" />

                        </FrameLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Edit Expense"
                            style="@style/Text.H4"
                            android:textColor="?attr/colorPrimary" />

                    </LinearLayout>

                    <!-- Procurement Section (Edit Mode) -->
                    <LinearLayout
                        android:id="@+id/layoutProcurementSection"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="gone"
                        android:layout_marginBottom="12dp">

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:background="?attr/colorOnSurface"
                            android:alpha="0.1"
                            android:layout_marginVertical="8dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Procurement Details"
                            style="@style/Text.H5"
                            android:textColor="?attr/colorSecondary"
                            android:layout_marginBottom="12dp" />

                        <!-- Supplier Selector -->
                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/layoutSupplierSelector"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="12dp"
                            style="@style/Widget.AfriNuts.EditText"
                            app:endIconMode="dropdown_menu"
                            app:endIconDrawable="@drawable/ic_arrow_drop_down"
                            app:endIconTint="?attr/colorSecondary"
                            app:boxBackgroundColor="?attr/colorSurface"
                            app:boxCornerRadiusBottomEnd="12dp"
                            app:boxCornerRadiusBottomStart="12dp"
                            app:boxCornerRadiusTopEnd="12dp"
                            app:boxCornerRadiusTopStart="12dp"
                            app:boxStrokeColor="?attr/colorSecondary">

                            <com.google.android.material.textfield.MaterialAutoCompleteTextView
                                android:id="@+id/etSupplier"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:hint="Select Supplier"
                                android:inputType="none"
                                android:textColor="?attr/colorOnSurface"
                                android:textColorHint="?attr/colorOnSurface" />

                        </com.google.android.material.textfield.TextInputLayout>

                        <!-- Batch Selector -->
                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/layoutBatchSelector"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="12dp"
                            style="@style/Widget.AfriNuts.EditText"
                            app:endIconMode="dropdown_menu"
                            app:endIconDrawable="@drawable/ic_arrow_drop_down"
                            app:endIconTint="?attr/colorSecondary"
                            app:boxBackgroundColor="?attr/colorSurface"
                            app:boxCornerRadiusBottomEnd="12dp"
                            app:boxCornerRadiusBottomStart="12dp"
                            app:boxCornerRadiusTopEnd="12dp"
                            app:boxCornerRadiusTopStart="12dp"
                            app:boxStrokeColor="?attr/colorSecondary">

                            <com.google.android.material.textfield.MaterialAutoCompleteTextView
                                android:id="@+id/etBatch"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:hint="Select Batch"
                                android:inputType="none"
                                android:textColor="?attr/colorOnSurface"
                                android:textColorHint="?attr/colorOnSurface" />

                        </com.google.android.material.textfield.TextInputLayout>

                    </LinearLayout>

                    <!-- Amount Edit -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        style="@style/Widget.AfriNuts.EditText"
                        app:boxBackgroundColor="?attr/colorSurface"
                        app:boxCornerRadiusBottomEnd="12dp"
                        app:boxCornerRadiusBottomStart="12dp"
                        app:boxCornerRadiusTopEnd="12dp"
                        app:boxCornerRadiusTopStart="12dp"
                        app:boxStrokeColor="?attr/colorPrimary">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etAmountEdit"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="Amount (XAF)"
                            android:inputType="numberDecimal"
                            android:textColor="?attr/colorOnSurface"
                            android:textColorHint="?attr/colorOnSurface" />

                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Date Edit -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        style="@style/Widget.AfriNuts.EditText"
                        app:endIconMode="custom"
                        app:endIconDrawable="@drawable/ic_today"
                        app:endIconTint="?attr/colorSecondary"
                        app:boxBackgroundColor="?attr/colorSurface"
                        app:boxCornerRadiusBottomEnd="12dp"
                        app:boxCornerRadiusBottomStart="12dp"
                        app:boxCornerRadiusTopEnd="12dp"
                        app:boxCornerRadiusTopStart="12dp"
                        app:boxStrokeColor="?attr/colorSecondary">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etDateEdit"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="Date"
                            android:focusable="false"
                            android:clickable="true"
                            android:textColor="?attr/colorOnSurface"
                            android:textColorHint="?attr/colorOnSurface" />

                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Block Selector Edit -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/layoutBlockSelectorEdit"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:visibility="gone"
                        style="@style/Widget.AfriNuts.EditText"
                        android:hint="Select Block"
                        app:endIconMode="dropdown_menu"
                        app:endIconDrawable="@drawable/ic_arrow_drop_down"
                        app:endIconTint="?attr/colorSecondary"
                        app:boxBackgroundColor="?attr/colorSurface"
                        app:boxCornerRadiusBottomEnd="12dp"
                        app:boxCornerRadiusBottomStart="12dp"
                        app:boxCornerRadiusTopEnd="12dp"
                        app:boxCornerRadiusTopStart="12dp"
                        app:boxStrokeColor="?attr/colorSecondary">

                        <com.google.android.material.textfield.MaterialAutoCompleteTextView
                            android:id="@+id/tvBlockSelectorEdit"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Farm-Wide"
                            android:focusable="false"
                            android:clickable="true"
                            android:textColor="?attr/colorOnSurface"
                            android:textColorHint="?attr/colorOnSurface" />

                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Description Edit -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        style="@style/Widget.AfriNuts.EditText"
                        app:boxBackgroundColor="?attr/colorSurface"
                        app:boxCornerRadiusBottomEnd="12dp"
                        app:boxCornerRadiusBottomStart="12dp"
                        app:boxCornerRadiusTopEnd="12dp"
                        app:boxCornerRadiusTopStart="12dp"
                        app:boxStrokeColor="?attr/colorPrimary">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etDescriptionEdit"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="Description"
                            android:inputType="textMultiLine"
                            android:minLines="3"
                            android:textColor="?attr/colorOnSurface"
                            android:textColorHint="?attr/colorOnSurface" />

                    </com.google.android.material.textfield.TextInputLayout>

                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <!-- Action Buttons - Liquid Glass Style -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_horizontal"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="24dp">

                <!-- Edit Button - Accent -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnEdit"
                    android:layout_width="0dp"
                    android:layout_height="46dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    android:text="Edit"
                    style="@style/Widget.AfriNuts.Button.LiquidGlass.Primary"
                    app:icon="@drawable/ic_edit"
                    app:iconGravity="textStart" />

                <!-- Save Button - Primary -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSave"
                    android:layout_width="0dp"
                    android:layout_height="46dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    android:text="Save"
                    style="@style/Widget.AfriNuts.Button.LiquidGlass.Primary"
                    app:icon="@drawable/ic_save"
                    app:iconGravity="textStart"
                    android:visibility="gone" />

                <!-- Delete Button - Danger -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnDelete"
                    android:layout_width="0dp"
                    android:layout_height="46dp"
                    android:layout_weight="1"
                    android:text="Delete"
                    style="@style/Widget.AfriNuts.Button.LiquidGlass.Danger"
                    app:icon="@drawable/ic_delete"
                    app:iconGravity="textStart"
                    app:iconTint="@color/error" />

            </LinearLayout>

        </LinearLayout>

    </ScrollView>

    <!-- Floating Action Button for quick edit -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabEdit"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="16dp"
        android:src="@drawable/ic_edit"
        android:contentDescription="Edit expense"
        app:backgroundTint="?attr/colorSecondary"
        app:tint="@android:color/white" />

</LinearLayout>