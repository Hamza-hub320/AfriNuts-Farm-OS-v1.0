<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <!-- Main Content Container -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="12dp"
        android:paddingBottom="72dp">

        <!-- Tab Layout - Compact -->
        <com.google.android.material.tabs.TabLayout
            android:id="@+id/tabLayout"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:background="@drawable/bg_tabs_container"
            app:tabIndicatorColor="@android:color/transparent"
            app:tabIndicatorHeight="0dp"
            app:tabSelectedTextColor="@android:color/white"
            app:tabTextColor="?attr/colorOnSurface"
            app:tabPaddingTop="4dp"
            app:tabPaddingBottom="4dp"
            app:tabMode="fixed"
            app:tabGravity="fill"
            app:cardCornerRadius="20dp"
            app:cardElevation="0dp"
            android:elevation="1dp"
            android:layout_marginBottom="4dp"
            app:tabRippleColor="#1A5A7411"
            app:tabBackground="@drawable/tab_selector_pill"
            app:tabTextAppearance="@style/TextAppearance.TabCompact"
            app:tabMinWidth="60dp"
            app:tabMaxWidth="120dp"
            app:tabPaddingStart="8dp"
            app:tabPaddingEnd="8dp" />

        <!-- ViewPager2 - content will scroll under the padding -->
        <androidx.viewpager2.widget.ViewPager2
            android:id="@+id/viewPager"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:padding="4dp"
            android:clipToPadding="false"
            android:paddingBottom="100dp"
            android:visibility="visible" />

        <!-- Spacer for bottom navigation -->
        <View
            android:layout_width="match_parent"
            android:layout_height="80dp" />

    </LinearLayout>

    <!-- Green primary action -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabAdd"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="126dp"
        android:src="@drawable/ic_add_business"
        android:contentDescription="Add"
        app:backgroundTint="@color/primary"
        app:tint="@android:color/white"
        app:rippleColor="@color/primary_light"
        app:elevation="4dp"
        app:fabSize="normal" />

    <!-- Compact dark pill navigation -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/bottomNavCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="20dp"
        app:cardBackgroundColor="@color/nav_pill_bg"
        app:cardCornerRadius="999dp"
        app:cardElevation="2dp"
        android:elevation="8dp"
        app:cardPreventCornerOverlap="false"
        app:cardUseCompatPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingVertical="4dp"
            android:paddingHorizontal="8dp"
            android:weightSum="5"
            android:background="@color/nav_pill_bg"
            >

            <!-- Home -->
            <LinearLayout
                android:id="@+id/navHome"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="8dp"
                android:clickable="true"
                android:focusable="true"
                android:background="?android:attr/selectableItemBackgroundBorderless">

                <FrameLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">

                    <ImageView
                        android:id="@+id/navHomeIcon"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_nav_home"
                        android:textStyle="bold"
                        app:tint="?attr/navbarIconColor"  />

                    <!-- Active indicator dot -->
                    <View
                        android:layout_width="8dp"
                        android:layout_height="8dp"
                        android:background="@drawable/circle_green"
                        android:layout_gravity="top|end"
                        android:layout_marginTop="-2dp"
                        android:layout_marginEnd="-4dp"
                        android:visibility="gone" />

                </FrameLayout>

                <TextView
                    android:id="@+id/navHomeText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Home"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="?attr/navbarTextColor"
                    android:layout_marginTop="4dp"
                    android:alpha="0.8"
                    android:fontFamily="@font/manrope_medium" />

            </LinearLayout>

            <!-- Farm -->
            <LinearLayout
                android:id="@+id/navFarm"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="8dp"
                android:clickable="true"
                android:focusable="true"
                android:background="?android:attr/selectableItemBackgroundBorderless">

                <FrameLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">

                    <ImageView
                        android:id="@+id/navFarmIcon"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_nav_sprout"
                        android:textStyle="bold"
                        app:tint="?attr/navbarIconColor" />

                    <View
                        android:layout_width="8dp"
                        android:layout_height="8dp"
                        android:background="@drawable/circle_green"
                        android:layout_gravity="top|end"
                        android:layout_marginTop="-2dp"
                        android:layout_marginEnd="-4dp"
                        android:visibility="gone" />

                </FrameLayout>

                <TextView
                    android:id="@+id/navFarmText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Farm"
                    android:textSize="11sp"
                    android:textColor="?attr/navbarTextColor"
                    android:layout_marginTop="4dp"
                    android:textStyle="bold"
                    android:alpha="0.8"
                    android:fontFamily="@font/manrope_medium" />

            </LinearLayout>

            <!-- Finance -->
            <LinearLayout
                android:id="@+id/navFinance"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="8dp"
                android:clickable="true"
                android:focusable="true"
                android:background="?android:attr/selectableItemBackgroundBorderless">

                <FrameLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">

                    <ImageView
                        android:id="@+id/navFinanceIcon"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:textStyle="bold"
                        android:src="@drawable/ic_nav_wallet"
                        app:tint="?attr/navbarIconColor" />

                    <View
                        android:layout_width="8dp"
                        android:layout_height="8dp"
                        android:background="@drawable/circle_green"
                        android:layout_gravity="top|end"
                        android:layout_marginTop="-2dp"
                        android:layout_marginEnd="-4dp"
                        android:visibility="gone" />

                </FrameLayout>

                <TextView
                    android:id="@+id/navFinanceText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Finance"
                    android:textSize="11sp"
                    android:textColor="?attr/navbarTextColor"
                    android:textStyle="bold"
                    android:layout_marginTop="4dp"
                    android:alpha="0.8"
                    android:fontFamily="@font/manrope_medium" />

            </LinearLayout>

            <!-- Analytics -->
            <LinearLayout
                android:id="@+id/navAnalytics"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="8dp"
                android:clickable="true"
                android:focusable="true"
                android:background="?android:attr/selectableItemBackgroundBorderless">

                <FrameLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">

                    <ImageView
                        android:id="@+id/navAnalyticsIcon"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:textStyle="bold"
                        android:src="@drawable/ic_nav_analytics"
                        app:tint="?attr/navbarIconColor" />

                    <View
                        android:layout_width="8dp"
                        android:layout_height="8dp"
                        android:background="@drawable/circle_green"
                        android:layout_gravity="top|end"
                        android:layout_marginTop="-2dp"
                        android:layout_marginEnd="-4dp"
                        android:visibility="gone" />

                </FrameLayout>

                <TextView
                    android:id="@+id/navAnalyticsText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Analytics"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="?attr/navbarTextColor"
                    android:layout_marginTop="4dp"
                    android:alpha="0.8"
                    android:fontFamily="@font/manrope_medium" />

            </LinearLayout>

            <!-- Compliance (NEW) -->
            <LinearLayout
                android:id="@+id/navCompliance"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true"
                android:padding="4dp">

                <ImageView
                    android:id="@+id/navComplianceIcon"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_nav_shield_check"
                    app:tint="?attr/navbarIconColor" />

                <TextView
                    android:id="@+id/navComplianceText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Compliance"
                    android:textSize="10sp"
                    android:textColor="?attr/navbarIconColor"
                    android:layout_marginTop="2dp" />

                <View
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:background="@drawable/circle_green"
                    android:layout_gravity="top|end"
                    android:layout_marginTop="-2dp"
                    android:layout_marginEnd="-4dp"
                    android:visibility="gone" />

            </LinearLayout>

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>
</FrameLayout>