<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingVertical="8dp"
    android:background="@android:color/transparent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/tvFinding"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Minor non-conformance"
            android:textColor="#1C1B1A"
            android:textSize="14.5sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvFindingStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp"
            android:text="OPEN"
            android:textSize="10.5sp"
            android:textStyle="bold"
            android:textColor="@android:color/white"
            android:background="@drawable/bg_status_finding_open"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?android:attr/selectableItemBackground" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvCorrectiveAction"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Corrective action: Implement corrective measures"
        android:textColor="#59544C"
        android:textSize="13sp"
        android:layout_marginTop="4dp" />
</LinearLayout>
