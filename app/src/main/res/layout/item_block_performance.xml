<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    style="@style/Widget.AfriNuts.CardView"
    android:layout_marginBottom="8dp"
    app:cardCornerRadius="20dp"
    app:cardElevation="2dp"
    android:foreground="?android:attr/selectableItemBackground"
    app:cardBackgroundColor="?attr/colorSurface"
    android:background="?attr/colorSurface">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp"
        android:background="@color/surface">

        <!-- Header Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="8dp">

            <!-- Rank with Glass Container -->
            <FrameLayout
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/bg_icon_sand"
                android:layout_marginEnd="12dp">

                <ImageView
                    android:id="@+id/ivRank"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_trophy_gold"
                    android:contentDescription="Rank" />

            </FrameLayout>

            <TextView
                android:id="@+id/tvBlockName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Block A1"
                style="@style/Text.H6"
                android:textSize="14sp"
                android:textColor="?attr/colorPrimary" />

            <ImageView
                android:id="@+id/ivTrend"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_trending_up"
                app:tint="?attr/colorSecondary" />

        </LinearLayout>

        <!-- Survival Rate -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="8dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Survival:"
                style="@style/Text.Caption"
                android:textSize="11sp"
                android:textColor="?attr/colorOnSurface"
                android:alpha="0.7" />

            <TextView
                android:id="@+id/tvSurvivalRate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="95%"
                style="@style/Text.Body.Small"
                android:textSize="12sp"
                android:textColor="?attr/colorPrimary"
                android:layout_marginEnd="12dp" />

            <ProgressBar
                android:id="@+id/progressSurvival"
                style="@style/Widget.AfriNuts.ProgressBar"
                android:layout_width="80dp"
                android:layout_height="4dp"
                android:progress="95"
                android:max="100"
                android:progressTint="?attr/colorPrimary"
                android:progressBackgroundTint="?attr/colorSurfaceVariant" />

        </LinearLayout>

        <!-- Profit -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Profit:"
                style="@style/Text.Caption"
                android:textSize="11sp"
                android:textColor="?attr/colorOnSurface"
                android:alpha="0.7" />

            <TextView
                android:id="@+id/tvProfit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="125k XAF"
                style="@style/Text.Body.Small"
                android:textSize="12sp"
                android:textColor="?attr/colorPrimary"
                android:layout_marginEnd="8dp" />

            <TextView
                android:id="@+id/tvProfitMargin"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="15%"
                style="@style/Text.Caption.Small"
                android:textSize="10sp"
                android:textColor="?attr/colorSecondary" />

        </LinearLayout>

    </LinearLayout>

</androidx.cardview.widget.CardView>