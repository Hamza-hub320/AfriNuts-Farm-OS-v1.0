<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/masterDetailScroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@drawable/bg_finance_tablet_panel"
    android:clipChildren="true"
    android:clipToOutline="true"
    android:clipToPadding="true"
    android:paddingBottom="8dp">

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="@color/surface"
        app:cardCornerRadius="28dp"
        app:cardElevation="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:id="@+id/tvMasterBatchNumber"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/manrope_extrabold"
                android:maxLines="1"
                android:ellipsize="end"
                android:textColor="#1C1B1A"
                android:textSize="28sp" />

            <TextView
                android:id="@+id/tvShipmentName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="@font/manrope_extrabold"
                android:textColor="#1C1B1A"
                android:textSize="17sp" />

            <TextView
                android:id="@+id/tvHeroSubtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="@font/manrope_medium"
                android:textColor="#68635B"
                android:textSize="15sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="horizontal">

                <androidx.cardview.widget.CardView
                    android:layout_width="0dp"
                    android:layout_height="120dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    app:cardBackgroundColor="#0E6B3C"
                    app:cardCornerRadius="22dp"
                    app:cardElevation="0dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center_vertical"
                        android:orientation="vertical"
                        android:padding="14dp">
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Total Weight"
                            android:textColor="#C7E3D4"
                            android:textSize="13sp"
                            android:fontFamily="@font/manrope_bold" />
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">
                            <TextView
                                android:id="@+id/tvTotalWeight"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:includeFontPadding="true"
                                android:textColor="#FFFFFF"
                                android:textSize="25sp"
                                android:fontFamily="@font/manrope_extrabold" />
                            <TextView
                                android:id="@+id/tvTotalWeightUnit"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="5dp"
                                android:text="kg"
                                android:textColor="#C7E3D4"
                                android:textSize="15sp"
                                android:fontFamily="@font/manrope_bold" />
                        </LinearLayout>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <androidx.cardview.widget.CardView
                    android:layout_width="0dp"
                    android:layout_height="120dp"
                    android:layout_marginHorizontal="6dp"
                    android:layout_weight="1"
                    app:cardBackgroundColor="#F5F0E6"
                    app:cardCornerRadius="22dp"
                    app:cardElevation="0dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center_vertical"
                        android:orientation="vertical"
                        android:padding="14dp">
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Total Batches"
                            android:textColor="#68635B"
                            android:textSize="13sp"
                            android:fontFamily="@font/manrope_bold" />
                        <TextView
                            android:id="@+id/tvTotalBatches"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:includeFontPadding="true"
                            android:textColor="#1C1B1A"
                            android:textSize="25sp"
                            android:fontFamily="@font/manrope_extrabold" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <androidx.cardview.widget.CardView
                    android:layout_width="0dp"
                    android:layout_height="120dp"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    app:cardBackgroundColor="#F5F0E6"
                    app:cardCornerRadius="22dp"
                    app:cardElevation="0dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center_vertical"
                        android:orientation="vertical"
                        android:padding="14dp">
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Grades"
                            android:textColor="#68635B"
                            android:textSize="13sp"
                            android:fontFamily="@font/manrope_bold" />
                        <TextView
                            android:id="@+id/tvGrades"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:includeFontPadding="true"
                            android:maxLines="2"
                            android:ellipsize="end"
                            android:textColor="#1C1B1A"
                            android:textSize="15sp"
                            android:fontFamily="@font/manrope_extrabold" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="4dp"
                android:text="Shipment"
                android:textColor="#1C1B1A"
                android:textSize="17sp"
                android:fontFamily="@font/manrope_extrabold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:minHeight="44dp"
                android:orientation="horizontal">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Buyer" android:textColor="#59544C" android:textSize="14sp" android:fontFamily="@font/manrope_semibold" />
                <TextView android:id="@+id/tvBuyer" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1.4" android:gravity="end" android:textColor="#1C1B1A" android:textSize="15sp" android:fontFamily="@font/manrope_bold" />
            </LinearLayout>
            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#E9E1CF" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:minHeight="44dp"
                android:orientation="horizontal">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Destination" android:textColor="#59544C" android:textSize="14sp" android:fontFamily="@font/manrope_semibold" />
                <TextView android:id="@+id/tvDestination" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1.4" android:gravity="end" android:textColor="#1C1B1A" android:textSize="15sp" android:fontFamily="@font/manrope_bold" />
            </LinearLayout>
            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#E9E1CF" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:minHeight="44dp"
                android:orientation="horizontal">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Export date" android:textColor="#59544C" android:textSize="14sp" android:fontFamily="@font/manrope_semibold" />
                <TextView android:id="@+id/tvExportDate" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1.4" android:gravity="end" android:textColor="#1C1B1A" android:textSize="15sp" android:fontFamily="@font/manrope_bold" />
            </LinearLayout>
            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#E9E1CF" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:minHeight="44dp"
                android:orientation="horizontal">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Certifications" android:textColor="#59544C" android:textSize="14sp" android:fontFamily="@font/manrope_semibold" />
                <TextView android:id="@+id/tvCertifications" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1.4" android:gravity="end" android:textColor="#1C1B1A" android:textSize="15sp" android:fontFamily="@font/manrope_bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Batches" android:textColor="#1C1B1A" android:textSize="17sp" android:fontFamily="@font/manrope_extrabold" />
                <TextView android:id="@+id/tvLinkedBatchCount" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#68635B" android:textSize="14sp" android:fontFamily="@font/manrope_semibold" />
            </LinearLayout>
            <LinearLayout
                android:id="@+id/layoutMasterBatches"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="Traceability"
                android:textColor="#1C1B1A"
                android:textSize="17sp"
                android:fontFamily="@font/manrope_extrabold" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="Master traceability" android:textColor="#59544C" android:textSize="14sp" android:fontFamily="@font/manrope_semibold" />
            <TextView
                android:id="@+id/tvTraceabilityUrl"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:autoLink="web"
                android:linksClickable="true"
                android:textColor="#0E6B3C"
                android:textColorLink="#0E6B3C"
                android:textSize="15sp"
                android:fontFamily="@font/manrope_bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="horizontal">
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnGenerateQRBottom"
                    android:layout_width="wrap_content"
                    android:layout_height="58dp"
                    android:layout_marginEnd="6dp"
                    android:paddingStart="24dp"
                    android:paddingEnd="24dp"
                    android:fontFamily="@font/manrope_extrabold"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:minHeight="0dp"
                    android:text="Generate QR"
                    android:textColor="#1C1B1A"
                    android:textSize="15sp"
                    app:backgroundTint="#F3EAD8"
                    app:cornerRadius="29dp" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnShare"
                    android:layout_width="wrap_content"
                    android:layout_height="58dp"
                    android:layout_marginStart="6dp"
                    android:paddingStart="24dp"
                    android:paddingEnd="24dp"
                    android:fontFamily="@font/manrope_extrabold"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:minHeight="0dp"
                    android:text="Share"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    app:backgroundTint="#0E6B3C"
                    app:cornerRadius="29dp" />
            </LinearLayout>
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDelete"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:layout_marginTop="10dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minHeight="0dp"
                android:text="Delete"
                android:textColor="#B83A24"
                android:textSize="15sp"
                android:fontFamily="@font/manrope_extrabold"
                app:backgroundTint="#F9E5E0"
                app:cornerRadius="29dp" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>
</ScrollView>
