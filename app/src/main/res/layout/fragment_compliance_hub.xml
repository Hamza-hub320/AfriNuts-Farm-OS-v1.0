<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="16dp">

            <FrameLayout
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/iconBackgroundGlass"
                android:layout_marginEnd="12dp">

                <ImageView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_certified"
                    app:tint="?attr/colorPrimary" />

            </FrameLayout>

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Compliance Hub"
                style="@style/Text.H3"
                android:textColor="?attr/colorPrimary" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAddCertification"
                android:layout_width="wrap_content"
                android:layout_height="46dp"
                android:text="Add"
                style="@style/Widget.AfriNuts.Button.LiquidGlass.Primary"
                app:icon="@drawable/ic_add"
                app:iconGravity="textStart"
                app:iconPadding="8dp"
                android:paddingStart="12dp"
                android:paddingEnd="12dp" />

        </LinearLayout>

        <!-- Progress Bar -->
        <ProgressBar
            android:id="@+id/progressBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="32dp"
            android:visibility="gone" />

        <!-- Stats Grid -->
        <GridLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:columnCount="2"
            android:rowCount="2"
            android:layout_marginBottom="16dp">

            <!-- Total Certifications -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardTotal"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_margin="4dp"
                app:cardCornerRadius="24dp"
                app:cardElevation="2dp"
                style="@style/Widget.AfriNuts.CardView"
                android:foreground="?android:attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:gravity="center"
                    android:background="?attr/cardBackgroundPrimary">

                    <TextView
                        android:id="@+id/tvTotalCertifications"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0"
                        style="@style/Text.H2"
                        android:textColor="?attr/colorPrimary" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Total"
                        style="@style/Text.Caption"
                        android:textColor="?attr/colorOnSurface"
                        android:alpha="0.6" />

                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <!-- Active Certifications -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardActive"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_margin="4dp"
                app:cardCornerRadius="24dp"
                app:cardElevation="2dp"
                style="@style/Widget.AfriNuts.CardView"
                android:foreground="?android:attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:gravity="center"
                    android:background="?attr/cardBackgroundPrimary">

                    <TextView
                        android:id="@+id/tvActiveCertifications"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0"
                        style="@style/Text.H2"
                        android:textColor="?attr/colorSecondary" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Active"
                        style="@style/Text.Caption"
                        android:textColor="?attr/colorOnSurface"
                        android:alpha="0.6" />

                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <!-- Expiring Soon -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardExpiring"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_margin="4dp"
                app:cardCornerRadius="24dp"
                app:cardElevation="2dp"
                style="@style/Widget.AfriNuts.CardView"
                android:foreground="?android:attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:gravity="center"
                    android:background="?attr/cardBackgroundPrimary">

                    <TextView
                        android:id="@+id/tvExpiringCertifications"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0"
                        style="@style/Text.H2"
                        android:textColor="#FF9800" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Expiring Soon"
                        style="@style/Text.Caption"
                        android:textColor="?attr/colorOnSurface"
                        android:alpha="0.6" />

                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <!-- Expired -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardExpired"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_margin="4dp"
                app:cardCornerRadius="24dp"
                app:cardElevation="2dp"
                style="@style/Widget.AfriNuts.CardView"
                android:foreground="?android:attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:gravity="center"
                    android:background="?attr/cardBackgroundPrimary">

                    <TextView
                        android:id="@+id/tvExpiredCertifications"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0"
                        style="@style/Text.H2"
                        android:textColor="#F44336" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Expired"
                        style="@style/Text.Caption"
                        android:textColor="?attr/colorOnSurface"
                        android:alpha="0.6" />

                </LinearLayout>

            </androidx.cardview.widget.CardView>

        </GridLayout>

        <!-- Expiring Soon Section -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Expiring Soon"
            style="@style/Text.H5"
            android:textColor="?attr/colorPrimary"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="12dp" />

        <!-- Empty State -->
        <LinearLayout
            android:id="@+id/emptyView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="32dp"
            android:visibility="gone">

            <ImageView
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:src="@drawable/ic_certified"
                app:tint="?attr/colorOnSurface"
                android:alpha="0.3"
                android:layout_marginBottom="12dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="No Expiring Certifications"
                style="@style/Text.H6"
                android:textColor="?attr/colorOnSurface"
                android:alpha="0.6" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="All certifications are up to date"
                style="@style/Text.Caption"
                android:textColor="?attr/colorOnSurface"
                android:alpha="0.4"
                android:layout_marginTop="4dp" />

        </LinearLayout>

        <!-- RecyclerView for expiring certifications -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:nestedScrollingEnabled="false"
            android:padding="4dp" />

    </LinearLayout>

</ScrollView>