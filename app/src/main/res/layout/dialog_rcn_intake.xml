<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:tools="http://schemas.android.com/tools"
    android:background="@color/background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="20dp">

            <FrameLayout
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/iconBackgroundGlass"
                android:layout_marginEnd="12dp">
                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_inventory"
                    app:tint="?attr/colorPrimary" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="RCN Intake"
                    style="@style/Text.H4"
                    android:textColor="?attr/colorPrimary" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Quality inspection of a purchased raw cashew batch"
                    style="@style/Text.Caption.Small"
                    android:textColor="?attr/colorOnSurface"
                    android:alpha="0.7" />
            </LinearLayout>
        </LinearLayout>

        <!-- 1. Supplier + batch selection -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:cardCornerRadius="20dp"
            app:cardElevation="2dp"
            android:background="?attr/cardBackgroundPrimary">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp"
                    style="@style/Widget.AfriNuts.EditText"
                    app:endIconMode="dropdown_menu">
                    <com.google.android.material.textfield.MaterialAutoCompleteTextView
                        android:id="@+id/etSupplier"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Supplier *"
                        android:inputType="none" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    style="@style/Widget.AfriNuts.EditText"
                    app:endIconMode="dropdown_menu">
                    <com.google.android.material.textfield.MaterialAutoCompleteTextView
                        android:id="@+id/etDeliveryBatch"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Batch to inspect *"
                        android:inputType="none" />
                </com.google.android.material.textfield.TextInputLayout>

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- 2. Read-only batch summary (single block, no processing date) -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:cardCornerRadius="20dp"
            app:cardElevation="2dp"
            android:background="?attr/cardBackgroundSecondary">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Batch Summary"
                    style="@style/Text.H6"
                    android:textColor="?attr/colorOnSurface"
                    android:alpha="0.7"
                    android:layout_marginBottom="8dp" />

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    style="@style/Widget.AfriNuts.EditText">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etBatchNumberDisplay"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Batch number" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    style="@style/Widget.AfriNuts.EditText">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etWeightKgDisplay"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Weight (kg)" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    style="@style/Widget.AfriNuts.EditText">
                    <com.google.android.material.textfield.MaterialAutoCompleteTextView
                        android:id="@+id/etSourceTypeDisplay"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Source type"
                        android:inputType="none" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    style="@style/Widget.AfriNuts.EditText">
                    <com.google.android.material.textfield.MaterialAutoCompleteTextView
                        android:id="@+id/etBatchTypeDisplay"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Batch type"
                        android:inputType="none" />
                </com.google.android.material.textfield.TextInputLayout>

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- 3. Inspection details (editable) -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:cardCornerRadius="20dp"
            app:cardElevation="2dp"
            android:background="?attr/cardBackgroundPrimary">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Inspection"
                    style="@style/Text.H6"
                    android:textColor="?attr/colorPrimary"
                    android:layout_marginBottom="12dp" />

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp"
                    style="@style/Widget.AfriNuts.EditText"
                    app:endIconMode="custom"
                    app:endIconDrawable="@drawable/ic_today">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etInspectionDate"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Inspection date *"
                        android:focusable="false"
                        android:clickable="true" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    style="@style/Widget.AfriNuts.EditText">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etInspectedBy"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Inspected by *"
                        android:inputType="textPersonName" />
                </com.google.android.material.textfield.TextInputLayout>

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- 4. Quality metrics (unchanged) -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:cardCornerRadius="24dp"
            app:cardElevation="2dp"
            android:background="?attr/cardBackgroundPrimary">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Quality Metrics"
                    style="@style/Text.H5"
                    android:textColor="?attr/colorPrimary"
                    android:layout_marginBottom="12dp" />
                <!-- KOR sample weight -->
                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp"
                    style="@style/Widget.AfriNuts.EditText"
                    app:helperText="Draw and mix a 1 kg sample from several bags, then weigh it. Typically 1000 g.">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etKorSampleGrams"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="KOR sample weight (g) *"
                        android:inputType="numberDecimal" />

                </com.google.android.material.textfield.TextInputLayout>

                <!-- KOR sound kernel weight -->
                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp"
                    style="@style/Widget.AfriNuts.EditText"
                    app:helperText="Shell the sample, discard broken/bad kernels, weigh the sound kernels. Typically 249–278 g.">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etKorKernelGrams"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Sound kernel weight (g) *"
                        android:inputType="numberDecimal" />

                </com.google.android.material.textfield.TextInputLayout>

                <!-- Computed KOR (read-only) -->
                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp"
                    style="@style/Widget.AfriNuts.EditText"
                    app:helperText="Computed: sound kernel ÷ sample × 1000. Typical 249–278 g/kg.">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etKorComputed"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="KOR (g/kg) — computed"
                        android:focusable="false"
                        android:clickable="false" />

                </com.google.android.material.textfield.TextInputLayout>

                <!-- Derived equivalents -->
                <TextView
                    android:id="@+id/tvKorEquivalents"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    style="@style/Text.Caption.Small"
                    android:textColor="?attr/colorOnSurface"
                    android:alpha="0.7"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="10dp"
                    android:visibility="gone"
                    tools:text="≈ 43.9 lbs / 80 kg bag  ·  24.9%" />
                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp"
                    style="@style/Widget.AfriNuts.EditText">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etMoisture"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Moisture content (%) *"
                        android:inputType="numberDecimal" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    style="@style/Widget.AfriNuts.EditText">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etNutCount"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Nut count (per kg) *"
                        android:inputType="number" />
                </com.google.android.material.textfield.TextInputLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Defects"
                    style="@style/Text.H6"
                    android:textColor="?attr/colorPrimary"
                    android:layout_marginBottom="8dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:weightSum="2">

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginEnd="6dp"
                        style="@style/Widget.AfriNuts.EditText">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etMouldy"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="Mouldy %"
                            android:inputType="numberDecimal" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="6dp"
                        style="@style/Widget.AfriNuts.EditText">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etImmature"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="Immature %"
                            android:inputType="numberDecimal" />
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="10dp"
                    android:weightSum="2">

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginEnd="6dp"
                        style="@style/Widget.AfriNuts.EditText">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etInsectDamaged"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="Insect damaged %"
                            android:inputType="numberDecimal" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="6dp"
                        style="@style/Widget.AfriNuts.EditText">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etShrivelled"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="Shrivelled %"
                            android:inputType="numberDecimal" />
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    style="@style/Widget.AfriNuts.EditText">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etForeignMatter"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Foreign matter %"
                        android:inputType="numberDecimal" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    style="@style/Widget.AfriNuts.EditText"
                    app:endIconMode="dropdown_menu">
                    <com.google.android.material.textfield.MaterialAutoCompleteTextView
                        android:id="@+id/etDryingMethod"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Drying method"
                        android:inputType="none" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- 5. Computed result -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:cardCornerRadius="24dp"
            app:cardElevation="2dp"
            android:background="?attr/cardBackgroundAccent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Computed Result"
                    style="@style/Text.H5"
                    android:textColor="?attr/colorSecondary"
                    android:layout_marginBottom="12dp" />

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp"
                    style="@style/Widget.AfriNuts.EditText"
                    app:helperText="Sum of the four defect rates (auto)">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etDefectiveTotal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Total defective %" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp"
                    style="@style/Widget.AfriNuts.EditText"
                    app:helperText="Computed from metrics — not editable">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etComputedGrade"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Grade" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    style="@style/Widget.AfriNuts.EditText">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etComputedScore"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="RCN quality score" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Notes -->
        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            style="@style/Widget.AfriNuts.EditText">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etNotes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Notes (optional)"
                android:inputType="textMultiLine"
                android:minLines="2" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="end">

            <Button
                android:id="@+id/btnCancel"
                android:layout_width="wrap_content"
                android:layout_height="46dp"
                android:text="Cancel"
                style="@style/Widget.AfriNuts.Button.LiquidGlass.Accent"
                android:layout_marginEnd="12dp" />

            <Button
                android:id="@+id/btnSave"
                android:layout_width="wrap_content"
                android:layout_height="46dp"
                android:text="Record Intake"
                style="@style/Widget.AfriNuts.Button.LiquidGlass.Primary"
                app:icon="@drawable/ic_save"
                app:iconGravity="textStart" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>