<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Create Master Traceability"
            style="@style/Text.H5"
            android:textColor="?attr/colorPrimary"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Combine multiple batches into a single master traceability record for bulk shipments."
            style="@style/Text.Caption"
            android:textColor="?attr/colorOnSurface"
            android:alpha="0.7"
            android:layout_marginBottom="16dp" />

        <!-- Shipment Name -->
        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            style="@style/Widget.AfriNuts.EditText"
            app:boxBackgroundColor="?attr/colorSurface">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etShipmentName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Shipment Name *"
                android:inputType="text" />

        </com.google.android.material.textfield.TextInputLayout>

        <!-- Buyer -->
        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            style="@style/Widget.AfriNuts.EditText"
            app:boxBackgroundColor="?attr/colorSurface">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etBuyer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Buyer *"
                android:inputType="text" />

        </com.google.android.material.textfield.TextInputLayout>

        <!-- Destination -->
        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            style="@style/Widget.AfriNuts.EditText"
            app:boxBackgroundColor="?attr/colorSurface">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etDestination"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Destination *"
                android:inputType="text" />

        </com.google.android.material.textfield.TextInputLayout>

        <!-- Export Date -->
        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            style="@style/Widget.AfriNuts.EditText"
            app:endIconMode="custom"
            app:endIconDrawable="@drawable/ic_today"
            app:boxBackgroundColor="?attr/colorSurface">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etExportDate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Export Date"
                android:focusable="false"
                android:clickable="true" />

        </com.google.android.material.textfield.TextInputLayout>

        <!-- Select Batches -->
        <Button
            android:id="@+id/btnSelectBatches"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Select Batches (0 selected)"
            style="@style/Widget.AfriNuts.Button.Outlined"
            android:layout_marginBottom="16dp"
            app:icon="@drawable/ic_checklist"
            app:iconGravity="textStart" />

        <!-- Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="end">

            <Button
                android:id="@+id/btnCancel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Cancel"
                style="@style/Widget.AfriNuts.Button.Outlined"
                android:layout_marginEnd="8dp" />

            <Button
                android:id="@+id/btnCreateMaster"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Create Master"
                style="@style/Widget.AfriNuts.Button"
                app:icon="@drawable/ic_add"
                app:iconGravity="textStart"
                app:iconTint="@android:color/white" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>