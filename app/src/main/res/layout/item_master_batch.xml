<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?android:attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true"
    android:orientation="vertical"
    android:paddingTop="10dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvMasterChildBatchNumber"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="#AFN-COOP-CONV-260710-4A76"
            android:textColor="#1C1B1A"
            android:textSize="15sp"
            android:fontFamily="@font/manrope_extrabold" />

        <ImageView
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_icon_sand"
            android:contentDescription="Open batch"
            android:padding="9dp"
            android:src="@drawable/ic_arrow_forward"
            app:tint="#59544C" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="7dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvMasterChildGrade"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_revenue_premium_badge"
            android:paddingHorizontal="8dp"
            android:paddingVertical="3dp"
            android:text="PREMIUM"
            android:textColor="#0A5530"
            android:textSize="10sp"
            android:fontFamily="@font/manrope_extrabold" />

        <TextView
            android:id="@+id/tvMasterChildWeightDate"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:text="10,000 kg · Jun 28, 2026"
            android:textColor="#59544C"
            android:textSize="12sp"
            android:fontFamily="@font/manrope_semibold" />
    </LinearLayout>

    <View
        android:id="@+id/masterChildDivider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="10dp"
        android:background="#E9E1CF" />
</LinearLayout>
