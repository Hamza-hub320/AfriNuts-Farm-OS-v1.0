<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp">

    <ImageView
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:src="@drawable/ic_logo_afrinuts_round"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="16dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="AfriNuts Farm OS"
        style="@style/Text.H2"
        android:textColor="@color/primary"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="8dp" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="16dp">

        <TextView
            android:id="@+id/tvVersionValue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Version 2.0"
            style="@style/Text.Caption"
            android:layout_marginEnd="8dp" />

        <TextView
            android:id="@+id/tvBuildValue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="(Build 1)"
            style="@style/Text.Caption"
            android:textColor="@color/navy" />

    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/warm_grey"
        android:layout_marginVertical="16dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="© 2026 AfriNuts Export"
        style="@style/Text.Body.Small"
        android:layout_marginBottom="4dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Odienné, Côte d'Ivoire"
        style="@style/Text.Body.Small"
        android:layout_marginBottom="16dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="A complete farm management system for cashew plantations."
        style="@style/Text.Body.Small"
        android:layout_marginBottom="16dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Features:"
        style="@style/Text.Label"
        android:layout_marginBottom="8dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginBottom="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="• 35-hectare block management"
            style="@style/Text.Caption" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="• Expense and revenue tracking"
            style="@style/Text.Caption" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="• Task assignment and worker tracking"
            style="@style/Text.Caption" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="• Photo documentation"
            style="@style/Text.Caption" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="• PDF reports"
            style="@style/Text.Caption" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="• Multi-user support"
            style="@style/Text.Caption" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="• Cloud sync"
            style="@style/Text.Caption" />

    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="For support: support@afrinuts.com"
        style="@style/Text.Caption"
        android:textColor="@color/primary"
        android:layout_marginTop="8dp" />

</LinearLayout>