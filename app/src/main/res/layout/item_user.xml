<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="8dp"
    android:layout_marginTop="4dp"
    android:layout_marginEnd="8dp"
    android:layout_marginBottom="4dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?android:attr/selectableItemBackground"
    app:cardBackgroundColor="#FFFFFF"
    app:cardCornerRadius="24dp"
    app:cardElevation="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingTop="14dp"
        android:paddingEnd="16dp"
        android:paddingBottom="14dp">

        <TextView
            android:id="@+id/userInitials"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:background="@drawable/bg_icon_sand"
            android:gravity="center"
            android:text="HS"
            android:textColor="#0A5530"
            android:textSize="14sp"
            android:fontFamily="@font/manrope_extrabold" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/userName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Hamza Sangare"
                android:textColor="#1C1B1A"
                android:textSize="15.5sp"
                android:fontFamily="@font/manrope_extrabold" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/roleIcon"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:layout_marginEnd="6dp"
                    android:contentDescription=""
                    android:src="@drawable/ic_star"
                    app:tint="#8A857B" />

                <TextView
                    android:id="@+id/userRole"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="Owner / CEO"
                    android:textColor="#59544C"
                    android:textSize="13sp"
                    android:fontFamily="@font/manrope_semibold" />
            </LinearLayout>
        </LinearLayout>

        <ImageView
            android:id="@+id/userStatus"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_marginStart="12dp"
            android:contentDescription="Active"
            android:src="@drawable/ic_check_circle"
            app:tint="#0E6B3C" />

        <ImageView android:id="@+id/userAvatar" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone" />
        <TextView android:id="@+id/userPhone" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone" />
        <TextView android:id="@+id/userEmail" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone" />
    </LinearLayout>
</androidx.cardview.widget.CardView>
