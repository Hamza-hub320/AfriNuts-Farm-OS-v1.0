<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="#FCF9F1" android:paddingTop="14dp">
    <com.google.android.material.textfield.TextInputLayout android:id="@+id/layoutBlockSearch" style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginBottom="14dp" app:boxBackgroundColor="#FFFFFF" app:boxCornerRadiusTopStart="24dp" app:boxCornerRadiusTopEnd="24dp" app:boxCornerRadiusBottomStart="24dp" app:boxCornerRadiusBottomEnd="24dp" app:boxStrokeColor="#E9E1CF" app:hintEnabled="false" app:startIconDrawable="@drawable/ic_search" app:startIconTint="#6B675F">
        <com.google.android.material.textfield.TextInputEditText android:id="@+id/etBlockSearch" android:layout_width="match_parent" android:layout_height="match_parent" android:hint="Search blocks" android:singleLine="true" android:textColor="#1C1B1A" android:textColorHint="#59544C" android:textSize="14sp" />
    </com.google.android.material.textfield.TextInputLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginBottom="14dp">
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1.15" android:layout_marginEnd="6dp" android:background="@drawable/bg_farm_summary_green" android:orientation="vertical" android:padding="16dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Total blocks" android:textColor="#D2FFFFFF" android:textSize="13sp" android:textStyle="bold" />
            <TextView android:id="@+id/totalBlocksSummary" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0" android:textColor="#FFFFFF" android:textSize="30sp" android:fontFamily="@font/manrope_extrabold" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Across all rows" android:textColor="#BFFFFFFF" android:textSize="12sp" />
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="6dp" android:background="@drawable/bg_farm_summary_white" android:orientation="vertical" android:padding="16dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Average survival" android:textColor="#59544C" android:textSize="13sp" android:textStyle="bold" />
            <TextView android:id="@+id/averageSurvivalSummary" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="—%" android:textColor="#1C1B1A" android:textSize="30sp" android:fontFamily="@font/manrope_extrabold" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Planted blocks" android:textColor="#59544C" android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>
    <HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content" android:scrollbars="none" android:layout_marginBottom="8dp">
        <com.google.android.material.chip.ChipGroup android:id="@+id/blockFilterGroup" android:layout_width="wrap_content" android:layout_height="wrap_content" app:singleSelection="true" app:selectionRequired="true">
            <com.google.android.material.chip.Chip android:id="@+id/chipBlockAll" style="@style/Widget.AfriNuts.Chip" android:layout_width="wrap_content" android:layout_height="wrap_content" android:checked="true" android:text="All" />
            <com.google.android.material.chip.Chip android:id="@+id/chipBlockPlanted" style="@style/Widget.AfriNuts.Chip" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Planted" />
            <com.google.android.material.chip.Chip android:id="@+id/chipBlockNotPlanted" style="@style/Widget.AfriNuts.Chip" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Not planted" />
            <com.google.android.material.chip.Chip android:id="@+id/chipBlockAttention" style="@style/Widget.AfriNuts.Chip" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Attention" />
        </com.google.android.material.chip.ChipGroup>
    </HorizontalScrollView>
    <ProgressBar android:id="@+id/progressBar" style="@style/Widget.AfriNuts.ProgressBar" android:layout_width="40dp" android:layout_height="40dp" android:layout_gravity="center" android:visibility="gone" />
    <LinearLayout android:id="@+id/emptyView" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:orientation="vertical" android:gravity="center" android:visibility="gone">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="No blocks found" android:textColor="#1C1B1A" android:textSize="18sp" android:textStyle="bold" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Add your first block" android:textColor="#59544C" android:textSize="14sp" android:layout_marginTop="6dp" />
    </LinearLayout>
    <androidx.recyclerview.widget.RecyclerView android:id="@+id/recyclerView" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:clipToPadding="false" android:paddingBottom="100dp" />
    <LinearLayout android:id="@+id/summaryLayout" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
</LinearLayout>
