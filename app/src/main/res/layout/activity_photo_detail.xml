<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background">

    <!-- Toolbar -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/primary"
        app:titleTextColor="@android:color/white"
        app:navigationIconTint="@android:color/white" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Full Photo -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                style="@style/Widget.AfriNuts.CardView"
                app:cardElevation="2dp">

                <ImageView
                    android:id="@+id/ivFullPhoto"
                    android:layout_width="match_parent"
                    android:layout_height="300dp"
                    android:scaleType="centerCrop"
                    android:src="@drawable/ic_photo_placeholder"
                    android:contentDescription="Full photo" />

            </androidx.cardview.widget.CardView>

            <!-- Photo Info Card -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                style="@style/Widget.AfriNuts.CardView"
                app:cardElevation="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <!-- Caption -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Caption"
                        style="@style/Text.Label"
                        android:layout_marginBottom="4dp" />

                    <TextView
                        android:id="@+id/tvCaption"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="No caption"
                        style="@style/Text.Body"
                        android:layout_marginBottom="16dp" />

                    <!-- Date Taken -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Date Taken"
                        style="@style/Text.Label"
                        android:layout_marginBottom="4dp" />

                    <TextView
                        android:id="@+id/tvDate"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Mar 15, 2024"
                        style="@style/Text.Body"
                        android:layout_marginBottom="16dp" />

                    <!-- Location -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Location"
                        style="@style/Text.Label"
                        android:layout_marginBottom="4dp" />

                    <TextView
                        android:id="@+id/tvLocation"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="📍 Location not available"
                        style="@style/Text.Body"
                        android:layout_marginBottom="16dp" />

                    <!-- Type -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Type"
                        style="@style/Text.Label"
                        android:layout_marginBottom="4dp" />

                    <TextView
                        android:id="@+id/tvType"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Block Photo"
                        style="@style/Text.Body" />

                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <!-- Action Buttons -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_horizontal"
                android:layout_marginBottom="16dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnEditCaption"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    android:text="Edit Caption"
                    style="@style/Widget.AfriNuts.Button"
                    android:backgroundTint="@color/accent"
                    app:icon="@drawable/ic_edit"
                    app:iconGravity="textStart"
                    app:iconTint="@android:color/white" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnShare"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Share"
                    style="@style/Widget.AfriNuts.Button"
                    android:backgroundTint="@color/primary"
                    app:icon="@drawable/ic_share"
                    app:iconGravity="textStart"
                    app:iconTint="@android:color/white" />

            </LinearLayout>

            <!-- Delete Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDelete"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Delete Photo"
                style="@style/Widget.AfriNuts.Button.Outlined"
                android:backgroundTint="@android:color/holo_red_dark"
                android:textColor="@android:color/holo_red_dark"
                app:icon="@drawable/ic_delete"
                app:iconGravity="textStart"
                app:iconTint="@android:color/holo_red_dark" />

        </LinearLayout>

    </ScrollView>

</LinearLayout>