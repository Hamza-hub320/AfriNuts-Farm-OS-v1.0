<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    style="@style/Widget.AfriNuts.CardView"
    app:cardCornerRadius="20dp"
    app:cardElevation="2dp"
    android:background="@color/surface">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        android:background="@color/surface">

        <!-- Row 1: Type + Outcome -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="8dp">

            <TextView
                android:id="@+id/tvInspectionType"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="FOOD_SAFETY"
                style="@style/Text.H6"
                android:textColor="?attr/colorSecondary" />

            <TextView
                android:id="@+id/tvOutcome"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="PASS"
                style="@style/Text.Caption.Small"
                android:textColor="?attr/colorPrimary"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Row 2: Findings -->
        <TextView
            android:id="@+id/tvFindings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Findings summary"
            style="@style/Text.Caption"
            android:textColor="?attr/colorOnSurface"
            android:alpha="0.85"
            android:maxLines="3"
            android:ellipsize="end"
            android:layout_marginBottom="8dp" />

        <!-- Row 3: Inspector + Date -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="12dp">

            <ImageView
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:src="@drawable/ic_person"
                app:tint="?attr/colorOnSurface"
                android:alpha="0.6"
                android:layout_marginEnd="4dp"
                android:contentDescription="Inspector" />

            <TextView
                android:id="@+id/tvInspector"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Inspector name"
                style="@style/Text.Caption.Small"
                android:textColor="?attr/colorOnSurface"
                android:alpha="0.7" />

            <ImageView
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:src="@drawable/ic_today"
                app:tint="?attr/colorOnSurface"
                android:alpha="0.6"
                android:layout_marginEnd="4dp"
                android:contentDescription="Date" />

            <TextView
                android:id="@+id/tvDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Jan 01, 2026"
                style="@style/Text.Caption.Small"
                android:textColor="?attr/colorOnSurface"
                android:alpha="0.6" />
        </LinearLayout>

        <!-- Row 4: Dispute action -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="end">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDisputeInspection"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:text="Dispute"
                style="@style/Widget.AfriNuts.Button.Small"
                android:backgroundTint="?attr/colorPrimaryVariant"
                android:textColor="@android:color/white"
                android:textSize="11sp"
                android:textAllCaps="false"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minHeight="0dp"
                android:minWidth="0dp"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                app:cornerRadius="15dp" />
        </LinearLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView>