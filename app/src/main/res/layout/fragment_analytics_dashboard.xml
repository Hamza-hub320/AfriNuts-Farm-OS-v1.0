<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background">

    <!-- Modern Tab Layout - Compact -->
    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tabLayout"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="?attr/tabBackground"
        app:tabIndicatorColor="?attr/colorPrimary"
        app:tabSelectedTextColor="?attr/colorPrimary"
        app:tabTextColor="?attr/colorOnSurface"
        app:tabMode="fixed"
        app:tabGravity="fill"
        app:tabRippleColor="?attr/colorPrimary"
        app:tabIndicatorFullWidth="false"
        app:tabTextAppearance="@style/Text.Caption"
        android:elevation="0dp"
        app:tabIndicatorHeight="3dp">

        <com.google.android.material.tabs.TabItem
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Yield" />

        <com.google.android.material.tabs.TabItem
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Trends" />

        <com.google.android.material.tabs.TabItem
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Blocks" />

        <com.google.android.material.tabs.TabItem
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Forecast" />

    </com.google.android.material.tabs.TabLayout>

    <!-- Progress Bar -->
    <ProgressBar
        android:id="@+id/progressBar"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_gravity="center"
        android:layout_marginTop="24dp"
        style="@style/Widget.AfriNuts.ProgressBar"
        android:indeterminate="true"
        android:visibility="gone" />

    <!-- Empty State - Compact -->
    <LinearLayout
        android:id="@+id/emptyView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:visibility="gone"
        android:layout_marginTop="48dp">

        <FrameLayout
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:background="?attr/iconBackgroundGlass"
            android:layout_marginBottom="12dp">

            <ImageView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_trending_up"
                app:tint="?attr/colorOnSurface"
                android:alpha="0.5" />

        </FrameLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="No analytics data"
            style="@style/Text.H4"
            android:textSize="16sp"
            android:textColor="?attr/colorOnSurface" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Add blocks and harvest data"
            style="@style/Text.Caption"
            android:textSize="11sp"
            android:textColor="?attr/colorOnSurface"
            android:alpha="0.7"
            android:layout_marginTop="4dp" />

    </LinearLayout>

    <!-- Content Container -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="12dp"
        android:paddingTop="0dp"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Yield Tab Content -->
            <LinearLayout
                android:id="@+id/contentYield"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="visible">

                <!-- Current Year Prediction Card - Compact -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/cardCurrentYear"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    style="@style/Widget.AfriNuts.CardView"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="2dp"
                    android:background="?attr/cardBackgroundAccent">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="12dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Current Year"
                            style="@style/Text.Caption"
                            android:textSize="12sp"
                            android:textColor="?attr/colorSecondary"
                            android:layout_marginBottom="8dp" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginBottom="12dp">

                            <FrameLayout
                                android:layout_width="44dp"
                                android:layout_height="44dp"
                                android:background="?attr/iconBackgroundGlass"
                                android:layout_marginEnd="12dp">

                                <TextView
                                    android:id="@+id/tvCurrentYear"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_gravity="center"
                                    android:text="2026"
                                    style="@style/Text.H4"
                                    android:textSize="18sp"
                                    android:textColor="?attr/colorSecondary" />

                            </FrameLayout>

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:id="@+id/tvPredictedYield"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="45,000 kg"
                                    style="@style/Text.Body"
                                    android:textSize="14sp"
                                    android:textStyle="bold"
                                    android:textColor="?attr/colorOnSurface" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Predicted Yield"
                                    style="@style/Text.Caption"
                                    android:textSize="10sp"
                                    android:textColor="?attr/colorOnSurface"
                                    android:alpha="0.7" />

                            </LinearLayout>

                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:layout_marginBottom="8dp"
                            android:weightSum="2">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical"
                                android:gravity="center">

                                <TextView
                                    android:id="@+id/tvConfidence"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="75%"
                                    style="@style/Text.H5"
                                    android:textSize="14sp"
                                    android:textColor="?attr/colorSecondary" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Confidence"
                                    style="@style/Text.Caption"
                                    android:textSize="10sp"
                                    android:textColor="?attr/colorOnSurface"
                                    android:alpha="0.7" />

                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical"
                                android:gravity="center">

                                <TextView
                                    android:id="@+id/tvRiskLevel"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Medium"
                                    style="@style/Text.H5"
                                    android:textSize="14sp"
                                    android:textColor="?attr/colorSecondary" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Risk"
                                    style="@style/Text.Caption"
                                    android:textSize="10sp"
                                    android:textColor="?attr/colorOnSurface"
                                    android:alpha="0.7" />

                            </LinearLayout>

                        </LinearLayout>

                        <TextView
                            android:id="@+id/tvRecommendation"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Consider increasing irrigation"
                            style="@style/Text.Caption"
                            android:textSize="11sp"
                            android:background="?attr/cardBackgroundPrimary"
                            android:padding="8dp"
                            android:maxLines="1"
                            android:ellipsize="end"
                            android:textColor="?attr/colorOnSurface" />

                    </LinearLayout>

                </androidx.cardview.widget.CardView>

                <!-- Yearly Yield Chart Card - Compact -->
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    style="@style/Widget.AfriNuts.CardView"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="2dp"
                    android:background="?attr/cardBackgroundPrimary">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="12dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Yearly Yield"
                            style="@style/Text.Caption"
                            android:textSize="12sp"
                            android:textColor="?attr/colorPrimary"
                            android:layout_marginBottom="12dp" />

                        <com.github.mikephil.charting.charts.BarChart
                            android:id="@+id/barChartYearlyYield"
                            android:layout_width="match_parent"
                            android:layout_height="160dp" />

                    </LinearLayout>

                </androidx.cardview.widget.CardView>

                <!-- Yield Factors Chart Card - Compact -->
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    style="@style/Widget.AfriNuts.CardView"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="2dp"
                    android:background="?attr/cardBackgroundSecondary">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="12dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Yield Factors"
                            style="@style/Text.Caption"
                            android:textSize="12sp"
                            android:textColor="?attr/colorPrimary"
                            android:layout_marginBottom="12dp" />

                        <com.github.mikephil.charting.charts.PieChart
                            android:id="@+id/pieChartYieldFactors"
                            android:layout_width="match_parent"
                            android:layout_height="160dp" />

                    </LinearLayout>

                </androidx.cardview.widget.CardView>

            </LinearLayout>

            <!-- Trends Tab Content -->
            <LinearLayout
                android:id="@+id/contentTrends"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <!-- Revenue Trend Card - Compact -->
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    style="@style/Widget.AfriNuts.CardView"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="2dp"
                    android:background="?attr/cardBackgroundAccent">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="12dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginBottom="12dp">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Revenue"
                                style="@style/Text.Caption"
                                android:textSize="12sp"
                                android:textColor="?attr/colorSecondary" />

                            <TextView
                                android:id="@+id/tvRevenueTrend"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="+15%"
                                style="@style/Text.Caption"
                                android:textSize="12sp"
                                android:textColor="@android:color/holo_green_dark" />

                        </LinearLayout>

                        <com.github.mikephil.charting.charts.LineChart
                            android:id="@+id/lineChartRevenue"
                            android:layout_width="match_parent"
                            android:layout_height="160dp" />

                    </LinearLayout>

                </androidx.cardview.widget.CardView>

                <!-- Expense Trend Card - Compact -->
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    style="@style/Widget.AfriNuts.CardView"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="2dp"
                    android:background="?attr/cardBackgroundPrimary">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="12dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginBottom="12dp">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Expenses"
                                style="@style/Text.Caption"
                                android:textSize="12sp"
                                android:textColor="?attr/colorPrimary" />

                            <TextView
                                android:id="@+id/tvExpenseTrend"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="+5%"
                                style="@style/Text.Caption"
                                android:textSize="12sp"
                                android:textColor="@android:color/holo_red_dark" />

                        </LinearLayout>

                        <com.github.mikephil.charting.charts.LineChart
                            android:id="@+id/lineChartExpenses"
                            android:layout_width="match_parent"
                            android:layout_height="160dp" />

                    </LinearLayout>

                </androidx.cardview.widget.CardView>

            </LinearLayout>

            <!-- Blocks Tab Content - Standalone List -->
            <LinearLayout
                android:id="@+id/contentBlocks"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <!-- Section Title -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Block Rankings"
                    style="@style/Text.H5"
                    android:textColor="?attr/colorPrimary"
                    android:layout_marginBottom="12dp" />

                <!-- RecyclerView for Block Performance - Standalone -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recyclerBlockPerformance"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false" />

            </LinearLayout>

            <!-- Forecast Tab Content - Compact -->
            <LinearLayout
                android:id="@+id/contentForecast"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <!-- 3-Year Forecast Cards - Compact -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/cardForecast1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    style="@style/Widget.AfriNuts.CardView"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="1dp"
                    android:background="?attr/cardBackgroundPrimary">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:padding="12dp"
                        android:gravity="center_vertical">

                        <FrameLayout
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:background="?attr/iconBackgroundGlass"
                            android:layout_marginEnd="8dp">

                            <TextView
                                android:id="@+id/tvForecastYear1"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center"
                                android:text="2026"
                                style="@style/Text.H5"
                                android:textSize="16sp"
                                android:textColor="?attr/colorPrimary" />

                        </FrameLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:layout_marginHorizontal="8dp">

                            <TextView
                                android:id="@+id/tvForecastYield1"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="45,000 kg"
                                style="@style/Text.Caption"
                                android:textSize="12sp"
                                android:textStyle="bold"
                                android:textColor="?attr/colorOnSurface" />

                            <TextView
                                android:id="@+id/tvForecastRevenue1"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="27.0M XAF"
                                style="@style/Text.Caption"
                                android:textSize="10sp"
                                android:textColor="?attr/colorOnSurface"
                                android:alpha="0.7" />

                        </LinearLayout>

                        <TextView
                            android:id="@+id/tvForecastGrowth1"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="+15%"
                            style="@style/Text.Caption"
                            android:textSize="12sp"
                            android:textColor="@android:color/holo_green_dark" />

                    </LinearLayout>

                </androidx.cardview.widget.CardView>

                <androidx.cardview.widget.CardView
                    android:id="@+id/cardForecast2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    style="@style/Widget.AfriNuts.CardView"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="1dp"
                    android:background="?attr/cardBackgroundSecondary">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:padding="12dp"
                        android:gravity="center_vertical">

                        <FrameLayout
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:background="?attr/iconBackgroundGlass"
                            android:layout_marginEnd="8dp">

                            <TextView
                                android:id="@+id/tvForecastYear2"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center"
                                android:text="2027"
                                style="@style/Text.H5"
                                android:textSize="16sp"
                                android:textColor="?attr/colorPrimary" />

                        </FrameLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:layout_marginHorizontal="8dp">

                            <TextView
                                android:id="@+id/tvForecastYield2"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="52,000 kg"
                                style="@style/Text.Caption"
                                android:textSize="12sp"
                                android:textStyle="bold"
                                android:textColor="?attr/colorOnSurface" />

                            <TextView
                                android:id="@+id/tvForecastRevenue2"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="31.2M XAF"
                                style="@style/Text.Caption"
                                android:textSize="10sp"
                                android:textColor="?attr/colorOnSurface"
                                android:alpha="0.7" />

                        </LinearLayout>

                        <TextView
                            android:id="@+id/tvForecastGrowth2"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="+20%"
                            style="@style/Text.Caption"
                            android:textSize="12sp"
                            android:textColor="@android:color/holo_green_dark" />

                    </LinearLayout>

                </androidx.cardview.widget.CardView>

                <androidx.cardview.widget.CardView
                    android:id="@+id/cardForecast3"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    style="@style/Widget.AfriNuts.CardView"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="1dp"
                    android:background="?attr/cardBackgroundAccent">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:padding="12dp"
                        android:gravity="center_vertical">

                        <FrameLayout
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:background="?attr/iconBackgroundGlass"
                            android:layout_marginEnd="8dp">

                            <TextView
                                android:id="@+id/tvForecastYear3"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center"
                                android:text="2028"
                                style="@style/Text.H5"
                                android:textSize="16sp"
                                android:textColor="?attr/colorSecondary" />

                        </FrameLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:layout_marginHorizontal="8dp">

                            <TextView
                                android:id="@+id/tvForecastYield3"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="60,000 kg"
                                style="@style/Text.Caption"
                                android:textSize="12sp"
                                android:textStyle="bold"
                                android:textColor="?attr/colorOnSurface" />

                            <TextView
                                android:id="@+id/tvForecastRevenue3"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="36.0M XAF"
                                style="@style/Text.Caption"
                                android:textSize="10sp"
                                android:textColor="?attr/colorOnSurface"
                                android:alpha="0.7" />

                        </LinearLayout>

                        <TextView
                            android:id="@+id/tvForecastGrowth3"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="+25%"
                            style="@style/Text.Caption"
                            android:textSize="12sp"
                            android:textColor="@android:color/holo_green_dark" />

                    </LinearLayout>

                </androidx.cardview.widget.CardView>

            </LinearLayout>

        </LinearLayout>

    </ScrollView>

</LinearLayout>