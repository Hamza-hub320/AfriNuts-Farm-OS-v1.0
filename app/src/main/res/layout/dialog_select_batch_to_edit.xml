<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="?android:attr/colorBackground">

    <!-- Empty State -->
    <LinearLayout
        android:id="@+id/layoutEmpty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="32dp"
        android:visibility="gone">

        <FrameLayout
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:background="?attr/iconBackgroundGlass"
            android:layout_marginBottom="16dp">

            <ImageView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_grade"
                app:tint="?attr/colorOnSurface"
                android:alpha="0.5" />

        </FrameLayout>

        <TextView
            android:id="@+id/tvEmpty"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="No batches found for this supplier"
            android:textAlignment="center"
            android:textColor="?attr/colorOnSurface"
            android:alpha="0.6"
            android:textSize="16sp"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Record a delivery first"
            android:textAlignment="center"
            android:textColor="?attr/colorOnSurface"
            android:alpha="0.4"
            android:textSize="14sp" />

    </LinearLayout>

    <!-- Batch List -->
    <ListView
        android:id="@+id/listViewBatches"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:divider="?attr/colorOnSurface"
        android:dividerHeight="1dp"
        android:padding="4dp"
        android:visibility="visible" />

</LinearLayout>