<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?android:attr/colorBackground">

    <!-- Modern Glass Morphism Toolbar -->
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/surface"
        android:theme="@style/ThemeOverlay.AppCompat.Dark.ActionBar"
        android:elevation="0dp"
        android:translationZ="0dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="16dp"
        android:layout_gravity="center_horizontal"
        android:outlineProvider="background"
        android:foreground="?android:attr/selectableItemBackgroundBorderless">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">

            <ImageView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/ic_afrinuts_foreground"
                android:alpha="0.95"
                android:layout_marginEnd="12dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Worker Details"
                android:textColor="?attr/colorOnSurface"
                android:textSize="18sp"
                android:textStyle="bold"
                android:letterSpacing="0.01" />

        </LinearLayout>

    </androidx.appcompat.widget.Toolbar>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Worker Header Card - Modern Glass -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                style="@style/Widget.AfriNuts.CardView"
                app:cardCornerRadius="20dp"
                app:cardElevation="2dp"
                android:background="@color/surface">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="20dp"
                    android:background="@color/surface">

                    <FrameLayout
                        android:layout_width="64dp"
                        android:layout_height="64dp"
                        android:textColor="?attr/colorOnSurface"
                        android:layout_marginEnd="16dp">

                        <ImageView
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_people"
                            app:tint="?attr/colorPrimary"
                            android:contentDescription="Worker icon" />

                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/workerNameText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="John Doe"
                            style="@style/Text.H2"
                            android:textColor="?attr/colorPrimary" />

                        <TextView
                            android:id="@+id/workerStatsText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="15 total tasks • 12 completed"
                            style="@style/Text.Body.Small"
                            android:textColor="?attr/colorOnSurface"
                            android:alpha="0.7"
                            android:layout_marginTop="4dp" />

                    </LinearLayout>

                    <TextView
                        android:id="@+id/completionRateBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="80%"
                        style="@style/Widget.AfriNuts.StatusBadge"
                        android:backgroundTint="?attr/colorSecondary"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="6dp"
                        app:cornerRadius="20dp" />

                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <!-- Performance Stats Grid -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="16dp"
                android:weightSum="3">

                <!-- Total Tasks Card -->
                <androidx.cardview.widget.CardView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="4dp"
                    style="@style/Widget.AfriNuts.CardView"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="2dp"
                    android:background="@color/surface"
                    android:outlineProvider="background"
                    android:foreground="?android:attr/selectableItemBackgroundBorderless">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:padding="12dp"
                        android:background="@color/surface">

                        <FrameLayout
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:background="@drawable/bg_icon_sand"
                            android:layout_marginBottom="8dp">

                            <ImageView
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_assignment"
                                app:tint="?attr/colorSecondary" />

                        </FrameLayout>

                        <TextView
                            android:id="@+id/totalTasksValue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0"
                            style="@style/Text.Stat"
                            android:textColor="?attr/colorSecondary" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Total Tasks"
                            style="@style/Text.Caption.Small"
                            android:textColor="?attr/colorOnSurface"
                            android:alpha="0.7" />

                    </LinearLayout>

                </androidx.cardview.widget.CardView>

                <!-- Completed Tasks Card -->
                <androidx.cardview.widget.CardView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="4dp"
                    android:layout_marginEnd="4dp"
                    style="@style/Widget.AfriNuts.CardView"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="2dp"
                    android:background="@color/surface"
                    android:outlineProvider="background"
                    android:foreground="?android:attr/selectableItemBackgroundBorderless">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:padding="12dp"
                        android:background="@color/surface">

                        <FrameLayout
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:background="@drawable/bg_icon_sand"
                            android:layout_marginBottom="8dp">

                            <ImageView
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_check_circle"
                                app:tint="?attr/colorPrimary" />

                        </FrameLayout>

                        <TextView
                            android:id="@+id/completedTasksValue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0"
                            style="@style/Text.Stat"
                            android:textColor="?attr/colorPrimary" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Completed"
                            style="@style/Text.Caption.Small"
                            android:textColor="?attr/colorOnSurface"
                            android:alpha="0.7" />

                    </LinearLayout>

                </androidx.cardview.widget.CardView>

                <!-- Completion Rate Card -->
                <androidx.cardview.widget.CardView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="4dp"
                    style="@style/Widget.AfriNuts.CardView"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="2dp"
                    android:background="@color/surface"
                    android:outlineProvider="background"
                    android:foreground="?android:attr/selectableItemBackgroundBorderless">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:padding="12dp"
                        android:background="@color/surface">

                        <FrameLayout
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:background="@drawable/bg_icon_sand"
                            android:layout_marginBottom="8dp">

                            <ImageView
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_percent"
                                app:tint="?attr/colorSecondary" />

                        </FrameLayout>

                        <TextView
                            android:id="@+id/completionRateValue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0%"
                            style="@style/Text.Stat"
                            android:textColor="?attr/colorSecondary" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Success Rate"
                            style="@style/Text.Caption.Small"
                            android:textColor="?attr/colorOnSurface"
                            android:alpha="0.7" />

                    </LinearLayout>

                </androidx.cardview.widget.CardView>

            </LinearLayout>

            <!-- Time Stats Card -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                style="@style/Widget.AfriNuts.CardView"
                app:cardCornerRadius="20dp"
                app:cardElevation="2dp"
                android:background="@color/surface"
                android:outlineProvider="background"
                android:foreground="?android:attr/selectableItemBackgroundBorderless">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp"
                    android:background="@color/surface">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Time Analysis"
                        style="@style/Text.H5"
                        android:textColor="?attr/colorSecondary"
                        android:layout_marginBottom="16dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="12dp">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/ic_timer"
                            app:tint="?attr/colorPrimary"
                            android:layout_marginEnd="8dp" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Total Time Worked"
                            style="@style/Text.Body.Small"
                            android:textColor="?attr/colorOnSurface"
                            android:alpha="0.7" />

                        <TextView
                            android:id="@+id/totalTimeValue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0h"
                            style="@style/Text.Label"
                            android:textColor="?attr/colorPrimary" />

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/ic_timer_off"
                            app:tint="?attr/colorPrimary"
                            android:layout_marginEnd="8dp" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Average Time per Task"
                            style="@style/Text.Body.Small"
                            android:textColor="?attr/colorOnSurface"
                            android:alpha="0.7" />

                        <TextView
                            android:id="@+id/avgTimeValue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0h"
                            style="@style/Text.Label"
                            android:textColor="?attr/colorPrimary" />

                    </LinearLayout>

                    <ProgressBar
                        android:id="@+id/efficiencyProgress"
                        style="@style/Widget.AfriNuts.ProgressBar"
                        android:layout_width="match_parent"
                        android:layout_height="6dp"
                        android:progress="0"
                        android:max="100"
                        android:progressTint="?attr/colorSecondary"
                        android:layout_marginTop="8dp" />

                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <!-- Task Type Distribution Card -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                style="@style/Widget.AfriNuts.CardView"
                app:cardCornerRadius="20dp"
                app:cardElevation="2dp"
                android:background="@color/surface">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp"
                    android:background="@color/surface">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Task Types"
                        style="@style/Text.H5"
                        android:textColor="?attr/colorPrimary"
                        android:layout_marginBottom="16dp" />

                    <LinearLayout
                        android:id="@+id/taskTypesContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />

                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <!-- Recent Tasks Card -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                style="@style/Widget.AfriNuts.CardView"
                app:cardCornerRadius="20dp"
                app:cardElevation="2dp"
                android:background="@color/surface">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp"
                    android:background="@color/surface">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Recent Tasks"
                        style="@style/Text.H5"
                        android:textColor="?attr/colorSecondary"
                        android:layout_marginBottom="16dp" />

                    <LinearLayout
                        android:id="@+id/recentTasksContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />

                    <TextView
                        android:id="@+id/noTasksText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="No tasks assigned yet"
                        style="@style/Text.Body.Small"
                        android:textColor="?attr/colorOnSurface"
                        android:alpha="0.7"
                        android:gravity="center"
                        android:padding="16dp"
                        android:visibility="gone" />

                </LinearLayout>

            </androidx.cardview.widget.CardView>

        </LinearLayout>

    </ScrollView>

</LinearLayout>