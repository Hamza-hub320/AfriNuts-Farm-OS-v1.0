<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background">

    <include layout="@layout/view_farm_detail_header" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="18dp"
            android:paddingEnd="16dp"
            android:paddingBottom="40dp">

            <androidx.cardview.widget.CardView
                android:id="@+id/workerHeroCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="28dp"
                app:cardElevation="0dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">
                        <TextView
                            android:id="@+id/workerAvatar"
                            android:layout_width="54dp"
                            android:layout_height="54dp"
                            android:layout_marginEnd="14dp"
                            android:background="@drawable/bg_supplier_avatar_sand"
                            android:gravity="center"
                            android:textColor="#7A5F22"
                            android:textSize="16sp"
                            android:fontFamily="@font/manrope_extrabold"
                            android:contentDescription="Worker initials" />
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">
                            <TextView
                                android:id="@+id/workerNameText"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="Worker name"
                                android:textColor="#1C1B1A"
                                android:textSize="21sp"
                                android:fontFamily="@font/manrope_extrabold"
                                android:lineSpacingExtra="0dp" />
                            <TextView
                                android:id="@+id/workerStatsText"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="3dp"
                                android:text="Worker · Joined date"
                                android:textColor="#59544C"
                                android:textSize="13.5sp"
                                android:fontFamily="@font/manrope_medium" />
                        </LinearLayout>
                    </LinearLayout>
                    <TextView
                        android:id="@+id/completionRateBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:background="@drawable/bg_status_document_valid"
                        android:gravity="center_vertical"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="6dp"
                        android:text="100% completion"
                        android:textColor="#0A5530"
                        android:textSize="12.5sp"
                        android:fontFamily="@font/manrope_extrabold"
                        android:visibility="visible" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <LinearLayout
                android:id="@+id/workerDetailStatsRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:orientation="horizontal">
                <androidx.cardview.widget.CardView
                    android:layout_width="0dp"
                    android:layout_height="96dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="5dp"
                    app:cardBackgroundColor="#0E6B3C"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="0dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center_vertical" android:orientation="vertical" android:paddingHorizontal="8dp" android:paddingVertical="14dp" android:background="@drawable/bg_task_stat_primary">
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:singleLine="true" android:ellipsize="end" android:includeFontPadding="false" android:text="Total Tasks" android:textColor="#DCEDE3" android:textSize="10sp" android:fontFamily="@font/manrope_bold" />
                        <TextView android:id="@+id/totalTasksValue" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:includeFontPadding="false" android:text="0" android:textColor="#FFFFFF" android:textSize="22sp" android:fontFamily="@font/manrope_extrabold" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>
                <androidx.cardview.widget.CardView
                    android:layout_width="0dp"
                    android:layout_height="96dp"
                    android:layout_weight="1"
                    android:layout_marginHorizontal="5dp"
                    app:cardBackgroundColor="#FFFFFF"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="0dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center_vertical" android:orientation="vertical" android:paddingHorizontal="8dp" android:paddingVertical="14dp">
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:singleLine="true" android:ellipsize="end" android:includeFontPadding="false" android:text="Completed" android:textColor="#59544C" android:textSize="10sp" android:fontFamily="@font/manrope_bold" />
                        <TextView android:id="@+id/completedTasksValue" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:includeFontPadding="false" android:text="0" android:textColor="#1C1B1A" android:textSize="22sp" android:fontFamily="@font/manrope_extrabold" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>
                <androidx.cardview.widget.CardView
                    android:layout_width="0dp"
                    android:layout_height="96dp"
                    android:layout_weight="1"
                    android:layout_marginStart="5dp"
                    app:cardBackgroundColor="#FFFFFF"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="0dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center_vertical" android:orientation="vertical" android:paddingHorizontal="8dp" android:paddingVertical="14dp">
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:singleLine="true" android:ellipsize="end" android:includeFontPadding="false" android:text="Success Rate" android:textColor="#59544C" android:textSize="10sp" android:fontFamily="@font/manrope_bold" />
                        <TextView android:id="@+id/completionRateValue" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:includeFontPadding="false" android:text="0%" android:textColor="#1C1B1A" android:textSize="22sp" android:fontFamily="@font/manrope_extrabold" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>
            </LinearLayout>

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="24dp"
                app:cardElevation="0dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingHorizontal="20dp" android:paddingVertical="18dp">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Time Analysis" android:textColor="#0E6B3C" android:textSize="16sp" android:fontFamily="@font/manrope_extrabold" android:layout_marginBottom="8dp" />
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal" android:paddingVertical="11dp">
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Total Time Worked" android:textColor="#59544C" android:textSize="13sp" android:fontFamily="@font/manrope_bold" />
                        <TextView android:id="@+id/totalTimeValue" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0 days" android:textColor="#1C1B1A" android:textSize="14.5sp" android:fontFamily="@font/manrope_bold" />
                    </LinearLayout>
                    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#E9E1CF" />
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal" android:paddingVertical="11dp">
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Average Time per Task" android:textColor="#59544C" android:textSize="13sp" android:fontFamily="@font/manrope_bold" />
                        <TextView android:id="@+id/avgTimeValue" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0 days" android:textColor="#1C1B1A" android:textSize="14.5sp" android:fontFamily="@font/manrope_bold" />
                    </LinearLayout>
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:layout_marginTop="8dp" android:orientation="horizontal">
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Efficiency" android:textColor="#59544C" android:textSize="13sp" android:fontFamily="@font/manrope_bold" />
                        <TextView android:id="@+id/efficiencyValue" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0%" android:textColor="#0A5530" android:textSize="14sp" android:fontFamily="@font/manrope_extrabold" />
                    </LinearLayout>
                    <ProgressBar android:id="@+id/efficiencyProgress" style="@android:style/Widget.ProgressBar.Horizontal" android:layout_width="match_parent" android:layout_height="10dp" android:layout_marginTop="8dp" android:max="100" android:progress="0" android:progressTint="#0E6B3C" android:progressBackgroundTint="#F3EAD8" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="24dp"
                app:cardElevation="0dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingHorizontal="20dp" android:paddingVertical="18dp">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Task Types" android:textColor="#0E6B3C" android:textSize="16sp" android:fontFamily="@font/manrope_extrabold" android:layout_marginBottom="4dp" />
                    <LinearLayout android:id="@+id/taskTypesContainer" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="24dp"
                app:cardElevation="0dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingHorizontal="20dp" android:paddingVertical="18dp">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Recent Tasks" android:textColor="#0E6B3C" android:textSize="16sp" android:fontFamily="@font/manrope_extrabold" android:layout_marginBottom="4dp" />
                    <LinearLayout android:id="@+id/recentTasksContainer" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" />
                    <TextView android:id="@+id/noTasksText" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="No tasks assigned yet" android:textColor="#59544C" android:textSize="14sp" android:fontFamily="@font/manrope_medium" android:paddingVertical="11dp" android:visibility="gone" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
