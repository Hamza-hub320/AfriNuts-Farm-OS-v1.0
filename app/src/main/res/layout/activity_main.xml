<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <!-- Main Scrollable Content (Home Screen) -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:paddingBottom="0dp"
        android:scrollbars="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- ========== TOOLBAR ========== -->
            <include layout="@layout/toolbar_main" />

            <!-- ========== OVERVIEW HEADER ========== -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="16dp">

                <TextView
                    android:id="@+id/overviewDateText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Today"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/greetingText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Good morning,"
                    android:textColor="@color/text_secondary"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/welcomeUserName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Farmer"
                    android:textColor="@color/text_primary"
                    android:textSize="28sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/locationText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Odienné, Côte d'Ivoire"
                    android:drawableStart="@drawable/ic_location"
                    android:drawablePadding="4dp"
                    android:drawableTint="@color/text_secondary"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp" />
            </LinearLayout>

            <!-- RCN received this season -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginBottom="12dp" app:cardBackgroundColor="@color/primary"
                app:cardCornerRadius="20dp" app:cardElevation="2dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:padding="18dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="RCN received this season" android:textColor="#CCFFFFFF" android:textSize="13sp" />
                    <TextView android:id="@+id/homeRcnValue" android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="0 kg" android:textColor="@android:color/white" android:textSize="32sp" android:textStyle="bold" />
                    <com.afrinuts.farmos.ui.theme.HomeChartView android:id="@+id/homeRcnChart"
                        android:layout_width="match_parent" android:layout_height="78dp" android:layout_marginTop="8dp" />
                    <TextView android:id="@+id/homeSeasonText" android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Season to date" android:textColor="#CCFFFFFF" android:textSize="11sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Grade share and graded batches -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:layout_marginBottom="12dp">
                <com.google.android.material.card.MaterialCardView android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:layout_marginEnd="6dp" app:cardBackgroundColor="@color/surface"
                    app:cardCornerRadius="20dp" app:cardElevation="2dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="vertical" android:padding="14dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Premium share" android:textColor="@color/text_secondary" android:textSize="13sp" />
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:gravity="center_vertical" android:orientation="horizontal" android:layout_marginTop="8dp">
                            <com.afrinuts.farmos.ui.theme.HomeChartView android:id="@+id/homeGradeDonut"
                                android:layout_width="74dp" android:layout_height="74dp" />
                            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                                android:orientation="vertical" android:layout_marginStart="8dp">
                                <TextView android:id="@+id/homePremiumShare" android:layout_width="wrap_content" android:layout_height="wrap_content"
                                    android:text="0%" android:textColor="@color/text_primary" android:textSize="23sp" android:textStyle="bold" />
                                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                    android:text="Premium" android:textColor="@color/text_secondary" android:textSize="11sp" />
                            </LinearLayout>
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
                <com.google.android.material.card.MaterialCardView android:layout_width="0dp" android:layout_height="match_parent"
                    android:layout_weight="1" android:layout_marginStart="6dp" app:cardBackgroundColor="@color/surface"
                    app:cardCornerRadius="20dp" app:cardElevation="2dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
                        android:orientation="vertical" android:padding="14dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Batches graded" android:textColor="@color/text_secondary" android:textSize="13sp" />
                        <TextView android:id="@+id/homeGradedCount" android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="0" android:textColor="@color/text_primary" android:textSize="25sp" android:textStyle="bold" />
                        <com.afrinuts.farmos.ui.theme.HomeChartView android:id="@+id/homeGradeBars"
                            android:layout_width="match_parent" android:layout_height="54dp" android:layout_marginTop="4dp" />
                        <TextView android:id="@+id/homeGradeBreakdown" android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:text="Premium 0 · Standard 0 · Reject 0" android:textColor="@color/text_secondary" android:textSize="9sp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <!-- Supplier onboarding progress; denominator is the real supplier count. -->
            <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginBottom="20dp" app:cardBackgroundColor="@color/surface"
                app:cardCornerRadius="20dp" app:cardElevation="2dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:padding="16dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Suppliers onboarded" android:textColor="@color/text_secondary" android:textSize="13sp" />
                    <TextView android:id="@+id/homeSupplierCount" android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="0 / 0" android:textColor="@color/text_primary" android:textSize="25sp" android:textStyle="bold" />
                    <ProgressBar android:id="@+id/homeSupplierProgress" style="@style/Widget.AfriNuts.ProgressBar"
                        android:layout_width="match_parent" android:layout_height="8dp" android:layout_marginTop="8dp"
                        android:max="100" android:progress="0" android:progressTint="@color/primary" android:progressBackgroundTint="@color/primary_light" />
                    <TextView android:id="@+id/homeSupplierProgressText" android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:gravity="end" android:text="0%" android:textColor="@color/text_secondary" android:textSize="11sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ========== FINANCIAL SNAPSHOT ========== -->
            <androidx.cardview.widget.CardView
                android:id="@+id/financialCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                app:cardCornerRadius="20dp"
                app:cardElevation="2dp"
                style="@style/Widget.AfriNuts.CardView"
                android:clickable="true"
                android:focusable="true"
                android:clipChildren="false"
                android:outlineProvider="background"
                android:foreground="?android:attr/selectableItemBackgroundBorderless"
                android:background="@drawable/bg_card_selector_accent">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp"
                    android:background="@color/surface"
                    android:outlineProvider="background"
                    android:foreground="?android:attr/selectableItemBackgroundBorderless">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Financial Snapshot"
                        style="@style/Text.H5"
                        android:textColor="?attr/colorPrimary"
                        android:layout_marginBottom="4dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Year to Date"
                        style="@style/Text.Caption"
                        android:textColor="?attr/colorOnSurface"
                        android:layout_marginBottom="16dp" />

                    <!-- Revenue Row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="12dp">

                        <ImageView
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:src="@drawable/ic_attach_money"
                            app:tint="?attr/colorPrimary"
                            android:background="@drawable/bg_icon_sand"
                            android:padding="6dp"
                            android:layout_marginEnd="12dp" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Revenue"
                                style="@style/Text.Caption"
                                android:textColor="?attr/colorOnSurface" />

                            <TextView
                                android:id="@+id/monthlyRevenueText"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="0 XAF"
                                style="@style/Text.H4"
                                android:textColor="?attr/colorPrimary" />

                        </LinearLayout>

                        <TextView
                            android:id="@+id/revenueTrend"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="+0%"
                            style="@style/Text.Body"
                            android:textColor="@android:color/holo_green_dark" />

                    </LinearLayout>

                    <!-- Expenses Row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="12dp">

                        <ImageView
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:src="@drawable/ic_money_off"
                            app:tint="?attr/colorSecondary"
                            android:background="@drawable/bg_icon_sand"
                            android:padding="6dp"
                            android:layout_marginEnd="12dp" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Expenses"
                                style="@style/Text.Caption"
                                android:textColor="?attr/colorOnSurface" />

                            <TextView
                                android:id="@+id/monthlyExpensesText"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="0 XAF"
                                style="@style/Text.H4"
                                android:textColor="?attr/colorSecondary" />

                        </LinearLayout>

                        <TextView
                            android:id="@+id/expenseTrend"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="+0%"
                            style="@style/Text.Body"
                            android:textColor="@android:color/holo_orange_dark" />

                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginVertical="12dp"
                        android:background="?attr/colorSurfaceVariant" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Net Profit"
                                style="@style/Text.H5"
                                android:textColor="?attr/colorPrimary" />

                            <TextView
                                android:id="@+id/netProfitText"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="0 XAF"
                                style="@style/Text.H3"
                                android:textColor="?attr/colorSecondary" />

                        </LinearLayout>

                    </LinearLayout>

                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <!-- ========== RECENT ACTIVITY ========== -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Recent Activity"
                style="@style/Text.H5"
                android:textColor="?attr/colorPrimary"
                android:layout_marginBottom="12dp" />

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="20dp"
                style="@style/Widget.AfriNuts.CardView"
                app:cardElevation="2dp"
                android:clipChildren="false"
                android:outlineProvider="background"
                android:foreground="?android:attr/selectableItemBackgroundBorderless"
                android:background="@drawable/bg_card_selector_secondary">

                <LinearLayout
                    android:id="@+id/recentActivityContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="8dp"
                    android:background="@color/surface"
                    android:outlineProvider="background"
                    android:foreground="?android:attr/selectableItemBackgroundBorderless"/>

            </androidx.cardview.widget.CardView>

            <!-- ========== WEATHER CARD ========== -->
            <androidx.cardview.widget.CardView
                android:id="@+id/weatherCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="80dp"
                app:cardCornerRadius="20dp"
                app:cardElevation="2dp"
                style="@style/Widget.AfriNuts.CardView"
                android:clickable="true"
                android:focusable="true"
                android:clipChildren="false"
                android:outlineProvider="background"
                android:foreground="?android:attr/selectableItemBackgroundBorderless"
                android:background="@drawable/bg_card_selector_accent">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp"
                    android:background="@color/surface"
                    android:outlineProvider="background"
                    android:foreground="?android:attr/selectableItemBackgroundBorderless">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="12dp">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Odienné"
                                style="@style/Text.H4"
                                android:textColor="?attr/colorPrimary"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/weatherLocationDetail"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Côte d'Ivoire"
                                style="@style/Text.Caption.Small"
                                android:textColor="?attr/colorOnSurface" />

                        </LinearLayout>

                        <TextView
                            android:id="@+id/weatherUpdateTime"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Updated just now"
                            style="@style/Text.Caption.Small"
                            android:textColor="?attr/colorOnSurface" />

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="20dp">

                        <FrameLayout
                            android:layout_width="72dp"
                            android:layout_height="72dp"
                            android:layout_marginEnd="16dp"
                            android:background="@drawable/bg_icon_sand">

                            <ImageView
                                android:id="@+id/weatherIcon"
                                android:layout_width="48dp"
                                android:layout_height="48dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_wb_sunny"
                                app:tint="?attr/colorSecondary" />

                        </FrameLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/weatherTemp"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="32°C"
                                style="@style/Text.Display.Small"
                                android:textColor="?attr/colorPrimary" />

                            <TextView
                                android:id="@+id/weatherCondition"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Partly Cloudy"
                                style="@style/Text.Body"
                                android:textColor="?attr/colorOnSurface"
                                android:textStyle="bold" />

                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:gravity="end">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Feels like"
                                style="@style/Text.Caption.Small"
                                android:textColor="?attr/colorOnSurface" />

                            <TextView
                                android:id="@+id/weatherFeelsLike"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="31°C"
                                style="@style/Text.H4"
                                android:textColor="?attr/colorSecondary" />

                        </LinearLayout>

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:weightSum="2">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginEnd="8dp"
                            android:padding="12dp"
                            app:cornerRadius="12dp">

                            <ImageView
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:src="@drawable/ic_water_drop"
                                app:tint="?attr/colorPrimary"
                                android:layout_marginEnd="12dp" />

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:id="@+id/weatherHumidity"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="45%"
                                    style="@style/Text.H5"
                                    android:textColor="?attr/colorPrimary" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Humidity"
                                    style="@style/Text.Caption.Small"
                                    android:textColor="?attr/colorOnSurface" />

                            </LinearLayout>

                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginStart="8dp"
                            android:padding="12dp"
                            app:cornerRadius="12dp">

                            <ImageView
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:src="@drawable/ic_air"
                                app:tint="?attr/colorPrimary"
                                android:layout_marginEnd="12dp" />

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:id="@+id/weatherWind"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="12 km/h"
                                    style="@style/Text.H5"
                                    android:textColor="?attr/colorPrimary" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Wind"
                                    style="@style/Text.Caption.Small"
                                    android:textColor="?attr/colorOnSurface" />

                            </LinearLayout>

                        </LinearLayout>

                    </LinearLayout>

                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <!-- Offline Banner -->
            <LinearLayout
                android:id="@+id/offlineBanner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:background="?attr/colorSurfaceVariant"
                android:padding="8dp"
                android:visibility="gone"
                android:layout_marginBottom="8dp"
                app:cornerRadius="8dp">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_warning"
                    app:tint="?attr/colorOnSurface"
                    android:layout_marginEnd="8dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Offline mode. Changes will sync when online."
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="12sp" />

            </LinearLayout>

            <!-- Spacer for bottom navigation -->
            <View
                android:layout_width="match_parent"
                android:layout_height="40dp" />

        </LinearLayout>

    </ScrollView>

    <!-- Compact dark pill navigation -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/bottomNavCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="20dp"
        app:cardBackgroundColor="@color/nav_pill_bg"
        app:cardCornerRadius="999dp"
        app:cardElevation="2dp"
        android:elevation="8dp"
        app:cardPreventCornerOverlap="false"
        app:cardUseCompatPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingVertical="4dp"
            android:paddingHorizontal="8dp"
            android:weightSum="5"
            android:background="@color/nav_pill_bg"
            >

            <!-- Home -->
            <LinearLayout
                android:id="@+id/navHome"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="8dp"
                android:clickable="true"
                android:focusable="true"
                android:background="?android:attr/selectableItemBackgroundBorderless">

                <FrameLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">

                    <ImageView
                        android:id="@+id/navHomeIcon"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_home"
                        android:textStyle="bold"
                        app:tint="?attr/navbarIconColor"  />

                    <!-- Active indicator dot -->
                    <View
                        android:layout_width="8dp"
                        android:layout_height="8dp"
                        android:background="@drawable/circle_green"
                        android:layout_gravity="top|end"
                        android:layout_marginTop="-2dp"
                        android:layout_marginEnd="-4dp"
                        android:visibility="gone" />

                </FrameLayout>

                <TextView
                    android:id="@+id/navHomeText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Home"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="?attr/navbarTextColor"
