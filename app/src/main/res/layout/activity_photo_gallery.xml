<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <include layout="@layout/view_farm_detail_header" />

        <!-- Empty State (shown when no photos) - Modern Design -->
        <LinearLayout
            android:id="@+id/emptyView"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:visibility="gone">

            <!-- Glass Container for Icon -->
            <FrameLayout
                android:layout_width="96dp"
                android:layout_height="96dp"
                android:background="@drawable/bg_icon_sand">

                <ImageView
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_photo"
                    app:tint="?attr/colorOnSurface"
                    android:alpha="0.5" />

            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="No photos yet"
                style="@style/Text.H3"
                android:textColor="?attr/colorOnSurface"
                android:layout_marginTop="16dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tap + to add your first photo"
                style="@style/Text.Caption"
                android:textColor="?attr/colorOnSurface"
                android:alpha="0.7"
                android:layout_marginTop="8dp" />

        </LinearLayout>

        <!-- RecyclerView (shown when photos exist) -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerView"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:padding="8dp"
            android:clipToPadding="false"
            android:visibility="visible" />

    </LinearLayout>

    <!-- Floating Action Button - Modern Design -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabAddPhoto"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="16dp"
        android:src="@drawable/ic_add_photo"
        android:contentDescription="Add photo"
        app:backgroundTint="@color/primary"
        app:tint="@android:color/white"
        app:rippleColor="?attr/colorPrimary"
        app:elevation="8dp"
        app:pressedTranslationZ="4dp" />

</FrameLayout>
