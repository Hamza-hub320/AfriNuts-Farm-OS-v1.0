<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/headerLayout" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:paddingTop="16dp" android:paddingBottom="10dp">
    <TextView android:id="@+id/rowNameText" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="ROW A" android:textColor="#59544C" android:textSize="12.5sp" android:fontFamily="sans-serif-black" android:letterSpacing="0.1" />
    <TextView android:id="@+id/rowRangeText" android:visibility="gone" android:layout_width="wrap_content" android:layout_height="wrap_content" />
    <ImageView android:id="@+id/expandIcon" android:visibility="gone" android:layout_width="1dp" android:layout_height="1dp" />
    <TextView android:id="@+id/plantedCountText" android:visibility="gone" android:layout_width="wrap_content" android:layout_height="wrap_content" />
    <TextView android:id="@+id/survivalRateText" android:visibility="gone" android:layout_width="wrap_content" android:layout_height="wrap_content" />
    <TextView android:id="@+id/treesText" android:visibility="gone" android:layout_width="wrap_content" android:layout_height="wrap_content" />
    <ProgressBar android:id="@+id/rowProgressBar" android:visibility="gone" android:layout_width="1dp" android:layout_height="1dp" />
</LinearLayout>
