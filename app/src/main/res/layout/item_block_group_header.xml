<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    android:layout_marginBottom="4dp"
    style="@style/Widget.AfriNuts.CardView"
    app:cardCornerRadius="20dp"
    app:cardElevation="4dp"
    android:backgroundTint="@color/primary_light"
    android:foreground="?android:attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:id="@+id/headerLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true">

        <!-- Row Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="8dp">

            <TextView
                android:id="@+id/rowNameText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="BLOCK A"
                style="@style/Text.H4"
                android:textColor="@color/primary"
                android:textStyle="bold"
                android:layout_marginEnd="8dp" />

            <TextView
                android:id="@+id/rowRangeText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="(A1-A7)"
                style="@style/Text.Caption.Small"
                android:textColor="@color/navy"
                android:layout_weight="1" />

            <ImageView
                android:id="@+id/expandIcon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_expand_more"
                app:tint="@color/accent"
                android:contentDescription="Expand/Collapse" />

        </LinearLayout>

        <!-- Row Stats with Icons - Compact Layout -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="4dp"
            android:gravity="center_vertical"
            android:weightSum="3">

            <!-- Planted Count -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_card_secondary"
                android:paddingVertical="4dp"
                android:paddingHorizontal="8dp"
                app:cornerRadius="10dp">

                <FrameLayout
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:background="@drawable/bg_icon_container_small"
                    android:layout_marginEnd="6dp">

                    <ImageView
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_grass"
                        app:tint="@color/primary" />

                </FrameLayout>

                <TextView
                    android:id="@+id/plantedCountText"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="5/7"
                    style="@style/Text.Caption"
                    android:textColor="@color/primary"
                    android:textStyle="bold"
                    android:includeFontPadding="false"
                    android:lineSpacingExtra="0dp" />

            </LinearLayout>

            <!-- Survival Rate -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginHorizontal="3dp"
                android:background="@drawable/bg_card_secondary"
                android:paddingVertical="4dp"
                android:paddingHorizontal="8dp"
                app:cornerRadius="10dp">

                <FrameLayout
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:background="@drawable/bg_icon_container_small"
                    android:layout_marginEnd="6dp">

                    <ImageView
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_bar_chart"
                        app:tint="@color/accent" />

                </FrameLayout>

                <TextView
                    android:id="@+id/survivalRateText"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="91%"
                    style="@style/Text.Caption"
                    android:textColor="@color/accent"
                    android:textStyle="bold"
                    android:includeFontPadding="false"
                    android:lineSpacingExtra="0dp" />

            </LinearLayout>

            <!-- Trees Count -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_card_secondary"
                android:paddingVertical="4dp"
                android:paddingHorizontal="8dp"
                app:cornerRadius="10dp">

                <FrameLayout
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:background="@drawable/bg_icon_container_small"
                    android:layout_marginEnd="6dp">

                    <ImageView
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_park"
                        app:tint="@color/primary" />

                </FrameLayout>

                <TextView
                    android:id="@+id/treesText"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="500/700"
                    style="@style/Text.Caption"
                    android:textColor="@color/primary"
                    android:textStyle="bold"
                    android:includeFontPadding="false"
                    android:lineSpacingExtra="0dp" />

            </LinearLayout>

        </LinearLayout>

        <!-- Progress Bar -->
        <ProgressBar
            android:id="@+id/rowProgressBar"
            style="@style/Widget.AfriNuts.ProgressBar"
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:layout_marginTop="8dp"
            android:progress="71"
            android:max="100"
            android:progressTint="@color/primary"
            android:progressBackgroundTint="@color/warm_grey" />

    </LinearLayout>

</androidx.cardview.widget.CardView>