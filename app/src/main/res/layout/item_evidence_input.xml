<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="?attr/cardBackgroundSecondary"
    android:padding="8dp"
    android:layout_marginBottom="8dp"
    app:cornerRadius="8dp">

    <com.google.android.material.textfield.TextInputLayout
        style="@style/Widget.AfriNuts.EditText"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginEnd="8dp"
        app:boxBackgroundColor="?attr/colorSurface"
        app:boxCornerRadiusBottomEnd="12dp"
        app:boxCornerRadiusBottomStart="12dp"
        app:boxCornerRadiusTopEnd="12dp"
        app:boxCornerRadiusTopStart="12dp"
        app:boxStrokeColor="?attr/colorPrimary"
        android:hint="Evidence URL">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etEvidenceUrl"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textUri"
            android:textColor="?attr/colorOnSurface"
            android:textColorHint="?attr/colorOnSurface" />

    </com.google.android.material.textfield.TextInputLayout>

    <Button
        android:id="@+id/btnRemoveEvidence"
        android:layout_width="wrap_content"
        android:layout_height="42dp"
        android:text="Remove"
        style="@style/Widget.AfriNuts.Button.LiquidGlass.Accent"
        android:textSize="11sp"
        android:minHeight="28dp"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:textColor="?attr/colorError"
        app:icon="@drawable/ic_delete"
        app:iconGravity="textStart"
        app:iconSize="16dp"
        app:iconTint="?attr/colorError" />

</LinearLayout>