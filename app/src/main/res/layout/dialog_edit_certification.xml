<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true"
    android:background="@android:color/transparent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        android:background="@drawable/bg_traceability_dialog">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="18dp"
            android:text="Edit programme"
            android:textColor="@color/text_primary"
            android:textSize="22sp"
            android:fontFamily="@font/manrope_extrabold" />

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Programme name" android:textColor="@color/text_secondary" android:textSize="14sp" android:fontFamily="@font/manrope_bold" android:layout_marginBottom="6dp" />
        <com.google.android.material.textfield.TextInputLayout style="@style/Widget.AfriNuts.EditText" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp" app:boxBackgroundColor="@color/background" app:boxCornerRadiusBottomEnd="16dp" app:boxCornerRadiusBottomStart="16dp" app:boxCornerRadiusTopEnd="16dp" app:boxCornerRadiusTopStart="16dp" app:boxStrokeColor="#E9E1CF">
            <com.google.android.material.textfield.TextInputEditText android:id="@+id/etCertificationName" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Enter programme name" android:inputType="text" android:textColor="@color/text_primary" android:textColorHint="@color/text_secondary" />
        </com.google.android.material.textfield.TextInputLayout>

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Certification body" android:textColor="@color/text_secondary" android:textSize="14sp" android:fontFamily="@font/manrope_bold" android:layout_marginBottom="6dp" />
        <com.google.android.material.textfield.TextInputLayout style="@style/Widget.AfriNuts.EditText" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp" app:boxBackgroundColor="@color/background" app:boxCornerRadiusBottomEnd="16dp" app:boxCornerRadiusBottomStart="16dp" app:boxCornerRadiusTopEnd="16dp" app:boxCornerRadiusTopStart="16dp" app:boxStrokeColor="#E9E1CF">
            <com.google.android.material.textfield.TextInputEditText android:id="@+id/etCertificationBody" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="e.g. ECOCERT" android:inputType="text" android:textColor="@color/text_primary" android:textColorHint="@color/text_secondary" />
        </com.google.android.material.textfield.TextInputLayout>

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Scope" android:textColor="@color/text_secondary" android:textSize="14sp" android:fontFamily="@font/manrope_bold" android:layout_marginBottom="6dp" />
        <com.google.android.material.textfield.TextInputLayout style="@style/Widget.AfriNuts.EditText" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp" app:boxBackgroundColor="@color/background" app:boxCornerRadiusBottomEnd="16dp" app:boxCornerRadiusBottomStart="16dp" app:boxCornerRadiusTopEnd="16dp" app:boxCornerRadiusTopStart="16dp" app:boxStrokeColor="#E9E1CF">
            <com.google.android.material.textfield.TextInputEditText android:id="@+id/etScope" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="e.g. Farm operations" android:inputType="text" android:textColor="@color/text_primary" android:textColorHint="@color/text_secondary" />
        </com.google.android.material.textfield.TextInputLayout>

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Applicable standards" android:textColor="@color/text_secondary" android:textSize="14sp" android:fontFamily="@font/manrope_bold" android:layout_marginBottom="6dp" />
        <com.google.android.material.textfield.TextInputLayout style="@style/Widget.AfriNuts.EditText" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp" app:boxBackgroundColor="@color/background" app:boxCornerRadiusBottomEnd="16dp" app:boxCornerRadiusBottomStart="16dp" app:boxCornerRadiusTopEnd="16dp" app:boxCornerRadiusTopStart="16dp" app:boxStrokeColor="#E9E1CF">
            <com.google.android.material.textfield.TextInputEditText android:id="@+id/etStandards" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Comma separated" android:inputType="text" android:textColor="@color/text_primary" android:textColorHint="@color/text_secondary" />
        </com.google.android.material.textfield.TextInputLayout>

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Target date" android:textColor="@color/text_secondary" android:textSize="14sp" android:fontFamily="@font/manrope_bold" android:layout_marginBottom="6dp" />
        <com.google.android.material.textfield.TextInputLayout style="@style/Widget.AfriNuts.EditText" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp" app:endIconMode="custom" app:endIconDrawable="@drawable/ic_today" app:endIconTint="@color/accent_ink" app:boxBackgroundColor="@color/background" app:boxCornerRadiusBottomEnd="16dp" app:boxCornerRadiusBottomStart="16dp" app:boxCornerRadiusTopEnd="16dp" app:boxCornerRadiusTopStart="16dp" app:boxStrokeColor="#E9E1CF">
            <com.google.android.material.textfield.TextInputEditText android:id="@+id/etTargetDate" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Select date" android:focusable="false" android:clickable="true" android:textColor="@color/text_primary" android:textColorHint="@color/text_secondary" />
        </com.google.android.material.textfield.TextInputLayout>

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Approval date" android:textColor="@color/text_secondary" android:textSize="14sp" android:fontFamily="@font/manrope_bold" android:layout_marginBottom="6dp" />
        <com.google.android.material.textfield.TextInputLayout style="@style/Widget.AfriNuts.EditText" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp" app:endIconMode="custom" app:endIconDrawable="@drawable/ic_today" app:endIconTint="@color/accent_ink" app:boxBackgroundColor="@color/background" app:boxCornerRadiusBottomEnd="16dp" app:boxCornerRadiusBottomStart="16dp" app:boxCornerRadiusTopEnd="16dp" app:boxCornerRadiusTopStart="16dp" app:boxStrokeColor="#E9E1CF">
            <com.google.android.material.textfield.TextInputEditText android:id="@+id/etApprovalDate" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Optional" android:focusable="false" android:clickable="true" android:textColor="@color/text_primary" android:textColorHint="@color/text_secondary" />
        </com.google.android.material.textfield.TextInputLayout>

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Expiry date" android:textColor="@color/text_secondary" android:textSize="14sp" android:fontFamily="@font/manrope_bold" android:layout_marginBottom="6dp" />
        <com.google.android.material.textfield.TextInputLayout style="@style/Widget.AfriNuts.EditText" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="18dp" app:endIconMode="custom" app:endIconDrawable="@drawable/ic_today" app:endIconTint="@color/accent_ink" app:boxBackgroundColor="@color/background" app:boxCornerRadiusBottomEnd="16dp" app:boxCornerRadiusBottomStart="16dp" app:boxCornerRadiusTopEnd="16dp" app:boxCornerRadiusTopStart="16dp" app:boxStrokeColor="#E9E1CF">
            <com.google.android.material.textfield.TextInputEditText android:id="@+id/etExpiryDate" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Optional" android:focusable="false" android:clickable="true" android:textColor="@color/text_primary" android:textColorHint="@color/text_secondary" />
        </com.google.android.material.textfield.TextInputLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
            <com.google.android.material.button.MaterialButton android:id="@+id/btnCancel" style="@style/Widget.AfriNuts.Button.Secondary" android:layout_width="0dp" android:layout_height="52dp" android:layout_marginEnd="6dp" android:layout_weight="1" android:text="Cancel" app:cornerRadius="999dp" />
            <com.google.android.material.button.MaterialButton android:id="@+id/btnSave" style="@style/Widget.AfriNuts.Button" android:layout_width="0dp" android:layout_height="52dp" android:layout_marginStart="6dp" android:layout_weight="1" android:text="Save" app:cornerRadius="999dp" app:icon="@drawable/ic_save" app:iconGravity="textStart" app:iconPadding="8dp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
