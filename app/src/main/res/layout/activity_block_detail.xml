<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F6F1E7">

    <include layout="@layout/view_farm_detail_header" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="16dp"
        android:fillViewport="true"
        android:clipToPadding="false"
        android:paddingBottom="80dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Header Card - Modern Glass Morphism -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                style="@style/Widget.AfriNuts.CardView"
                app:cardBackgroundColor="@android:color/transparent"
                app:cardCornerRadius="24dp"
                app:cardElevation="2dp"
                android:background="@color/surface">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp"
                    android:background="@color/surface">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/blockNameText"
                            style="@style/Text.H3"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Block A1"
                            android:textColor="?attr/colorPrimary"/>

                        <TextView
                            android:id="@+id/statusBadge"
                            style="@style/Widget.AfriNuts.StatusBadge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Planted"
                            android:maxLines="1"
                            android:layout_marginStart="8dp" />

                    </LinearLayout>

                    <TextView
                        android:id="@+id/farmInfoText"
                        style="@style/Text.Body.Small"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Farm: AfriNuts Odienné | Size: 1.0 ha"
                        android:textColor="?attr/colorOnSurface" />

                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <!-- Timeline Card - Modern Glass Morphism -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                style="@style/Widget.AfriNuts.CardView"
                app:cardCornerRadius="24dp"
                app:cardElevation="2dp"
                android:background="@color/surface">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp"
                    android:background="@color/surface">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="16dp">

                        <FrameLayout
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:background="@drawable/bg_icon_sand"
                            android:layout_marginEnd="12dp">

                            <ImageView
                                android:layout_width="18dp"
                                android:layout_height="18dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_today"
                                app:tint="?attr/colorPrimary" />

                        </FrameLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Timeline"
                            style="@style/Text.H4"
                            android:textColor="?attr/colorPrimary" />

                    </LinearLayout>

                    <!-- Cleared Section -->
                    <LinearLayout
                        android:id="@+id/clearedSection"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="12dp"
                        android:visibility="gone"
                        android:background="@color/surface"
                        android:padding="12dp"
                        app:cornerRadius="12dp">

                        <TextView
                            android:layout_width="80dp"
                            android:layout_height="wrap_content"
                            android:text="Cleared:"
                            style="@style/Text.Label"
                            android:textColor="?attr/colorOnSurface" />

                        <TextView
                            android:id="@+id/clearedDateText"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Mar 15, 2024"
                            style="@style/Text.Body"
                            android:textColor="?attr/colorPrimary" />

                    </LinearLayout>

                    <!-- Plowed Section -->
                    <LinearLayout
                        android:id="@+id/plowedSection"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="12dp"
                        android:visibility="gone"
                        android:background="@color/surface"
                        android:padding="12dp"
                        app:cornerRadius="12dp">

                        <TextView
                            android:layout_width="80dp"
                            android:layout_height="wrap_content"
                            android:text="Plowed:"
                            style="@style/Text.Label"
                            android:textColor="?attr/colorOnSurface" />

                        <TextView
                            android:id="@+id/plowedDateText"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Mar 20, 2024"
                            style="@style/Text.Body"
                            android:textColor="?attr/colorPrimary" />

                    </LinearLayout>

                    <!-- Planted Section -->
                    <LinearLayout
                        android:id="@+id/plantedSection"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:visibility="gone"
                        android:background="@color/surface"
                        android:padding="12dp"
                        app:cornerRadius="12dp">

                        <TextView
                            android:layout_width="80dp"
                            android:layout_height="wrap_content"
                            android:text="Planted:"
                            style="@style/Text.Label"
                            android:textColor="?attr/colorOnSurface" />

                        <TextView
                            android:id="@+id/plantedDateText"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Mar 25, 2024"
                            style="@style/Text.Body"
                            android:textColor="?attr/colorPrimary" />

                    </LinearLayout>

                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <!-- Harvest Section -->
            <androidx.cardview.widget.CardView
                android:id="@+id/harvestSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="16dp"
                android:visibility="gone"
                app:cardCornerRadius="24dp"
                app:cardElevation="2dp"
                style="@style/Widget.AfriNuts.CardView">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:background="@color/surface">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Harvest Information"
                        style="@style/Text.H5"
                        android:textColor="?attr/colorPrimary"
                        android:layout_marginBottom="12dp" />

                    <!-- Harvest Stats Grid -->
                    <GridLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:columnCount="2"
                        android:rowCount="3"
                        android:layout_marginBottom="12dp">

                        <!-- Total Harvest -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_columnWeight="1"
                            android:orientation="vertical"
                            android:padding="8dp"
                            android:background="@color/surface"
                            app:cornerRadius="12dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Total Harvest"
                                style="@style/Text.Caption.Small"
                                android:textColor="?attr/colorOnSurface"
                                android:alpha="0.6" />

                            <TextView
                                android:id="@+id/tvTotalHarvest"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="0 kg"
                                style="@style/Text.H6"
                                android:textColor="?attr/colorPrimary" />

                        </LinearLayout>

                        <!-- Harvest Count -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_columnWeight="1"
                            android:orientation="vertical"
                            android:padding="8dp"
                            android:background="@color/surface"
                            app:cornerRadius="12dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Harvests"
                                style="@style/Text.Caption.Small"
                                android:textColor="?attr/colorOnSurface"
                                android:alpha="0.6" />

                            <TextView
                                android:id="@+id/tvHarvestCount"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="0"
                                style="@style/Text.H6"
                                android:textColor="?attr/colorPrimary" />

                        </LinearLayout>

                        <!-- Last Harvest Date -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_columnWeight="1"
                            android:orientation="vertical"
                            android:padding="8dp"
                            android:background="@color/surface"
                            app:cornerRadius="12dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Last Harvest"
                                style="@style/Text.Caption.Small"
                                android:textColor="?attr/colorOnSurface"
                                android:alpha="0.6" />

                            <TextView
                                android:id="@+id/tvLastHarvestDate"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="—"
                                style="@style/Text.H6"
                                android:textColor="?attr/colorPrimary" />

                        </LinearLayout>

                        <!-- Last Harvest Quantity -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_columnWeight="1"
                            android:orientation="vertical"
                            android:padding="8dp"
                            android:background="@color/surface"
                            app:cornerRadius="12dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Last Quantity"
                                style="@style/Text.Caption.Small"
                                android:textColor="?attr/colorOnSurface"
                                android:alpha="0.6" />

                            <TextView
                                android:id="@+id/tvLastHarvestQuantity"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="—"
                                style="@style/Text.H6"
                                android:textColor="?attr/colorPrimary" />

                        </LinearLayout>

                    </GridLayout>

                    <!-- Yield per Hectare -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:background="@color/surface"
                        android:padding="12dp"
                        app:cornerRadius="12dp">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/ic_grain"
                            app:tint="@color/accent_ink"
                            android:layout_marginEnd="12dp" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Yield per Hectare"
                            style="@style/Text.Caption"
                            android:textColor="?attr/colorOnSurface" />

                        <TextView
                            android:id="@+id/tvYieldPerHectare"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="—"
                            style="@style/Text.H6"
                            android:textColor="?attr/colorPrimary" />

                    </LinearLayout>

                    <!-- Record Harvest Button -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnRecordHarvest"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="Record Harvest"
                        style="@style/Widget.AfriNuts.Button"
                        app:icon="@drawable/ic_add"
                        app:iconGravity="textStart"
                        app:iconTint="@android:color/white" />

                    <!-- Harvest History -->
                    <LinearLayout
                        android:id="@+id/harvestHistoryContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginTop="12dp" />

                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <!-- Photo Gallery Card -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                style="@style/Widget.AfriNuts.CardView"
                app:cardCornerRadius="24dp"
                app:cardElevation="2dp"
                android:background="@color/surface"
                android:foreground="?android:attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="16dp"
                    android:id="@+id/btnPhotoGallery"
                    android:background="@color/surface">

                    <FrameLayout
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:background="@drawable/bg_icon_sand"
                        android:layout_marginEnd="16dp">

                        <ImageView
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_photo"
                            app:tint="@color/accent_ink" />

                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Photos"
                            style="@style/Text.H5"
                            android:textColor="@color/accent_ink" />

                        <TextView
                            android:id="@+id/tvPhotoCount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0 photos"
                            style="@style/Text.Caption"
                            android:textColor="?attr/colorOnSurface" />

                    </LinearLayout>

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_arrow_forward"
                        app:tint="@color/accent_ink" />

                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <!-- Planting Details Card -->
            <androidx.cardview.widget.CardView
                android:id="@+id/plantingDetailsSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:visibility="gone"
                style="@style/Widget.AfriNuts.CardView"
                app:cardCornerRadius="24dp"
                app:cardElevation="2dp"
                android:background="@color/surface">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp"
                    android:background="@color/surface">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="16dp">

                        <FrameLayout
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:background="@drawable/bg_icon_sand"
                            android:layout_marginEnd="12dp">

                            <ImageView
                                android:layout_width="18dp"
                                android:layout_height="18dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_grass"
                                app:tint="?attr/colorPrimary" />

                        </FrameLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Planting Details"
                            style="@style/Text.H4"
                            android:textColor="?attr/colorPrimary" />

                    </LinearLayout>

                    <!-- Survival Rate -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        style="@style/Widget.AfriNuts.EditText">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etSurvivalRate"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="Survival Rate (%)"
                            android:inputType="numberDecimal"
                            android:enabled="false"
                            android:textColor="?attr/colorOnSurface"
                            android:textColorHint="?attr/colorOnSurface" />

                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Survival Progress -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginBottom="16dp">

                        <ProgressBar
                            android:id="@+id/survivalProgress"
                            style="@style/Widget.AfriNuts.ProgressBar"
                            android:layout_width="match_parent"
                            android:layout_height="8dp"
                            android:progress="95"
                            android:max="100" />

                    </LinearLayout>

                    <!-- Replacement Count -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp"
                        style="@style/Widget.AfriNuts.EditText">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etReplacementCount"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="Replacement Count"
                            android:inputType="number"
                            android:enabled="false"
                            android:textColor="?attr/colorOnSurface"
                            android:textColorHint="?attr/colorOnSurface" />

                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Tree Stats -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:background="@color/surface"
                            android:padding="12dp"
                            app:cornerRadius="12dp">

                            <FrameLayout
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:background="@drawable/bg_icon_sand"
                                android:layout_marginEnd="8dp">

                                <ImageView
                                    android:layout_width="14dp"
                                    android:layout_height="14dp"
                                    android:layout_gravity="center"
                                    android:src="@drawable/ic_park"
                                    app:tint="?attr/colorPrimary" />

                            </FrameLayout>

                            <TextView
                                android:id="@+id/aliveTreesText"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Alive: 95 trees"
                                style="@style/Text.Body"
                                android:textColor="?attr/colorPrimary" />

                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="horizontal"
                            android:gravity="end"
                            android:background="@color/surface"
                            android:padding="12dp"
                            android:layout_marginStart="12dp"
                            app:cornerRadius="12dp">

                            <FrameLayout
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:background="@drawable/bg_icon_sand"
                                android:layout_marginEnd="8dp">

                                <ImageView
                                    android:layout_width="14dp"
                                    android:layout_height="14dp"
                                    android:layout_gravity="center"
                                    android:src="@drawable/ic_heart_broken"
                                    app:tint="@color/accent_ink" />

                            </FrameLayout>

                            <TextView
                                android:id="@+id/deadTreesText"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Dead: 5 trees"
                                style="@style/Text.Body"
                                android:textColor="@color/accent_ink" />

                        </LinearLayout>

                    </LinearLayout>

                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <!-- Notes Card -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                style="@style/Widget.AfriNuts.CardView"
                app:cardCornerRadius="24dp"
                app:cardElevation="2dp"
                android:background="@color/surface">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp"
                    android:background="@color/surface">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="12dp">

                        <FrameLayout
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:background="@drawable/bg_icon_sand"
                            android:layout_marginEnd="12dp">

                            <ImageView
                                android:layout_width="18dp"
                                android:layout_height="18dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_note"
                                app:tint="?attr/colorPrimary" />

                        </FrameLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Notes"
                            style="@style/Text.H4"
                            android:textColor="?attr/colorPrimary" />

                    </LinearLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        style="@style/Widget.AfriNuts.EditText">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etNotes"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="Add notes here..."
                            android:inputType="textMultiLine"
                            android:minLines="3"
                            android:background="@drawable/bg_rounded_description"
                            android:enabled="false"
                            android:textColor="?attr/colorOnSurface"
                            android:textColorHint="?attr/colorOnSurface" />

                    </com.google.android.material.textfield.TextInputLayout>

                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <!-- Action Buttons - Liquid Glass Style -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_horizontal"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="24dp">

                <!-- Edit Button - Accent -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnEdit"
                    android:layout_width="0dp"
                    android:layout_height="46dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    android:text="Edit"
                    style="@style/Widget.AfriNuts.Button"
                    app:icon="@drawable/ic_edit"
                    app:iconGravity="textStart" />

                <!-- Save Button - Primary -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSave"
                    android:layout_width="0dp"
                    android:layout_height="46dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    android:text="Save"
                    style="@style/Widget.AfriNuts.Button"
                    app:icon="@drawable/ic_save"
                    app:iconGravity="textStart"
                    android:visibility="gone" />

                <!-- Delete Button - Danger (Fixed: Use MaterialButton) -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnDelete"
                    android:layout_width="0dp"
                    android:layout_height="46dp"
                    android:layout_weight="1"
                    android:text="Delete"
                    style="@style/Widget.AfriNuts.Button.Secondary"
                    app:icon="@drawable/ic_delete"
                    app:iconGravity="textStart"
                    app:iconTint="@color/accent_ink" />

            </LinearLayout>
        </LinearLayout>

    </ScrollView>

</LinearLayout>