<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F6F1E7">

    <include layout="@layout/view_farm_detail_header" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="16dp"
        android:fillViewport="true"
        android:clipToPadding="false"
        android:paddingBottom="32dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Header Card - Modern Glass Morphism -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                style="@style/Widget.AfriNuts.CardView"
                app:cardBackgroundColor="@android:color/transparent"
                app:cardCornerRadius="24dp"
                app:cardElevation="2dp"
                android:background="@color/surface">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp"
                    android:background="@color/surface">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/blockNameText"
                            style="@style/Text.H3"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Block A1"
                            android:textColor="?attr/colorPrimary"/>

                        <TextView
                            android:id="@+id/statusBadge"
                            style="@style/Widget.AfriNuts.StatusBadge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Planted"
                            android:maxLines="1"
                            android:layout_marginStart="8dp" />

                    </LinearLayout>

                    <TextView
                        android:id="@+id/farmInfoText"
                        style="@style/Text.Body.Small"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Farm: AfriNuts Odienné | Size: 1.0 ha"
                        android:textColor="?attr/colorOnSurface" />

                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <!-- Timeline Card - Modern Glass Morphism -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                style="@style/Widget.AfriNuts.CardView"
                app:cardCornerRadius="24dp"
                app:cardElevation="2dp"
                android:background="@color/surface">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp"
                    android:paddingTop="18dp"
                    android:paddingBottom="18dp"
                    android:background="@color/surface">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="16dp">

                        <FrameLayout
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:background="@drawable/bg_icon_sand"
                            android:layout_marginEnd="12dp">

                            <ImageView
                                android:layout_width="18dp"
                                android:layout_height="18dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_today"
                                app:tint="?attr/colorPrimary" />

                        </FrameLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Timeline"
                            style="@style/Text.H4"
                            android:textColor="?attr/colorPrimary" />

                    </LinearLayout>

                    <!-- Cleared Section -->
                    <LinearLayout
                        android:id="@+id/clearedSection"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:visibility="gone"
                        android:gravity="center_vertical"
                        android:paddingTop="11dp"
                        android:paddingBottom="11dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Cleared"
                            android:textSize="13sp"
                            android:fontFamily="@font/manrope_bold"
                            android:textColor="#59544C" />

                        <TextView
                            android:id="@+id/clearedDateText"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Mar 15, 2024"
                            android:gravity="end"
                            android:textSize="14.5sp"
                            android:fontFamily="@font/manrope_bold"
                            android:textColor="#1C1B1A" />

                    </LinearLayout>

                    <View
                        android:id="@+id/timelineDividerCleared"
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#E9E1CF" />

                    <!-- Plowed Section -->
                    <LinearLayout
                        android:id="@+id/plowedSection"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:visibility="gone"
                        android:gravity="center_vertical"
                        android:paddingTop="11dp"
                        android:paddingBottom="11dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Plowed"
                            android:textSize="13sp"
                            android:fontFamily="@font/manrope_bold"
                            android:textColor="#59544C" />

                        <TextView
                            android:id="@+id/plowedDateText"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Mar 20, 2024"
                            android:gravity="end"
                            android:textSize="14.5sp"
                            android:fontFamily="@font/manrope_bold"
                            android:textColor="#1C1B1A" />

                    </LinearLayout>

                    <View
                        android:id="@+id/timelineDividerPlowed"
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#E9E1CF" />

                    <!-- Planted Section -->
                    <LinearLayout
                        android:id="@+id/plantedSection"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:visibility="gone"
                        android:gravity="center_vertical"
                        android:paddingTop="11dp"
                        android:paddingBottom="11dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Planted"
                            android:textSize="13sp"
                            android:fontFamily="@font/manrope_bold"
                            android:textColor="#59544C" />

                        <TextView
                            android:id="@+id/plantedDateText"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Mar 25, 2024"
                            android:gravity="end"
                            android:textSize="14.5sp"
                            android:fontFamily="@font/manrope_bold"
                            android:textColor="#1C1B1A" />

                    </LinearLayout>

                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <!-- Harvest Section -->
            <androidx.cardview.widget.CardView
                android:id="@+id/harvestSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:visibility="gone"
                app:cardCornerRadius="24dp"
                app:cardElevation="2dp"
                style="@style/Widget.AfriNuts.CardView">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp"
                    android:paddingTop="18dp"
                    android:paddingBottom="18dp"
                    android:background="@color/surface">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Harvest Information"
                        android:textSize="16sp"
                        android:fontFamily="@font/manrope_extrabold"
                        android:textColor="#1C1B1A"
                        android:layout_marginBottom="4dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:paddingVertical="11dp">
                            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Total Harvest" android:textSize="13sp" android:fontFamily="@font/manrope_bold" android:textColor="#59544C" />
                            <TextView android:id="@+id/tvTotalHarvest" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0 kg" android:textSize="14.5sp" android:fontFamily="@font/manrope_bold" android:textColor="#1C1B1A" />
                        </LinearLayout>
                        <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#E9E1CF" />
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:paddingVertical="11dp">
                            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Harvests" android:textSize="13sp" android:fontFamily="@font/manrope_bold" android:textColor="#59544C" />
                            <TextView android:id="@+id/tvHarvestCount" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0" android:textSize="14.5sp" android:fontFamily="@font/manrope_bold" android:textColor="#1C1B1A" />
                        </LinearLayout>
                        <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#E9E1CF" />
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:paddingVertical="11dp">
                            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Last Harvest" android:textSize="13sp" android:fontFamily="@font/manrope_bold" android:textColor="#59544C" />
                            <TextView android:id="@+id/tvLastHarvestDate" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="—" android:textSize="14.5sp" android:fontFamily="@font/manrope_bold" android:textColor="#1C1B1A" />
                        </LinearLayout>
                        <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#E9E1CF" />
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:paddingVertical="11dp">
                            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Last Quantity" android:textSize="13sp" android:fontFamily="@font/manrope_bold" android:textColor="#59544C" />
                            <TextView android:id="@+id/tvLastHarvestQuantity" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="—" android:textSize="14.5sp" android:fontFamily="@font/manrope_bold" android:textColor="#1C1B1A" />
                        </LinearLayout>
                        <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#E9E1CF" />
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:paddingVertical="11dp">
                            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Yield per Hectare" android:textSize="13sp" android:fontFamily="@font/manrope_bold" android:textColor="#59544C" />
                            <TextView android:id="@+id/tvYieldPerHectare" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="—" android:textSize="14.5sp" android:fontFamily="@font/manrope_bold" android:textColor="#1C1B1A" />
                        </LinearLayout>

                    </LinearLayout>

                    <!-- Record Harvest Button -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnRecordHarvest"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="14dp"
                        android:text="Record Harvest"
                        android:textAllCaps="false"
                        android:textSize="14.5sp"
                        android:fontFamily="@font/manrope_extrabold"
                        android:textColor="#FFFFFF"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        app:backgroundTint="#0E6B3C"
                        app:cornerRadius="999dp" />

                    <LinearLayout
                        android:id="@+id/harvestHistoryContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="gone" />

                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <!-- Photo Gallery Card -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                style="@style/Widget.AfriNuts.CardView"
                app:cardCornerRadius="24dp"
                app:cardElevation="2dp"
                android:background="@color/surface"
                android:foreground="?android:attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp"
                    android:background="@color/surface">

                    <LinearLayout
                        android:id="@+id/btnPhotoGallery"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Photos"
                            android:textSize="16sp"
                            android:fontFamily="@font/manrope_extrabold"
                            android:textColor="#1C1B1A" />

                        <TextView
                            android:id="@+id/tvPhotoCount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0 photos"
                            android:textSize="13sp"
                            android:fontFamily="@font/manrope_bold"
                            android:textColor="#59544C" />

                    </LinearLayout>

                    <HorizontalScrollView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:scrollbars="none"
                        android:clipToPadding="false">

                        <LinearLayout
                            android:id="@+id/photoThumbnailStrip"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal" />

                    </HorizontalScrollView>

                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <!-- Planting Details Card -->
            <androidx.cardview.widget.CardView
                android:id="@+id/plantingDetailsSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:visibility="gone"
                style="@style/Widget.AfriNuts.CardView"
                app:cardCornerRadius="24dp"
                app:cardElevation="2dp"
                android:background="@color/surface">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp"
                    android:background="@color/surface">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Planting Details"
                        android:textSize="16sp"
                        android:fontFamily="@font/manrope_extrabold"
                        android:textColor="#1C1B1A"
                        android:layout_marginBottom="4dp" />

                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:paddingVertical="11dp">
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Survival rate" android:textSize="13sp" android:fontFamily="@font/manrope_bold" android:textColor="#59544C" />
                        <com.google.android.material.textfield.TextInputEditText android:id="@+id/etSurvivalRate" android:layout_width="wrap_content" android:layout_height="wrap_content" android:minWidth="72dp" android:hint="—" android:inputType="numberDecimal" android:gravity="end" android:padding="0dp" android:enabled="false" android:textColor="#1C1B1A" android:textColorHint="#1C1B1A" android:textSize="14.5sp" android:fontFamily="@font/manrope_bold" />
                    </LinearLayout>
                    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#E9E1CF" />
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:paddingVertical="11dp">
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Replacements" android:textSize="13sp" android:fontFamily="@font/manrope_bold" android:textColor="#59544C" />
                        <com.google.android.material.textfield.TextInputEditText android:id="@+id/etReplacementCount" android:layout_width="wrap_content" android:layout_height="wrap_content" android:minWidth="72dp" android:hint="—" android:inputType="number" android:gravity="end" android:padding="0dp" android:enabled="false" android:textColor="#1C1B1A" android:textColorHint="#1C1B1A" android:textSize="14.5sp" android:fontFamily="@font/manrope_bold" />
                    </LinearLayout>
                    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#E9E1CF" />
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:paddingVertical="11dp">
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Alive trees" android:textSize="13sp" android:fontFamily="@font/manrope_bold" android:textColor="#59544C" />
                        <TextView android:id="@+id/aliveTreesText" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="—" android:textSize="14.5sp" android:fontFamily="@font/manrope_bold" android:textColor="#1C1B1A" />
                    </LinearLayout>
                    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#E9E1CF" />
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:paddingVertical="11dp">
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Dead trees" android:textSize="13sp" android:fontFamily="@font/manrope_bold" android:textColor="#59544C" />
                        <TextView android:id="@+id/deadTreesText" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="—" android:textSize="14.5sp" android:fontFamily="@font/manrope_bold" android:textColor="#1C1B1A" />
                    </LinearLayout>

                    <ProgressBar
                        android:id="@+id/survivalProgress"
                        style="@style/Widget.AfriNuts.ProgressBar"
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:visibility="gone"
                        android:max="100" />

                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <!-- Notes Card -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                style="@style/Widget.AfriNuts.CardView"
                app:cardCornerRadius="24dp"
                app:cardElevation="2dp"
                android:background="@color/surface">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp"
                    android:paddingTop="18dp"
                    android:paddingBottom="18dp"
                    android:background="@color/surface">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:text="Notes"
                        android:textSize="16sp"
                        android:fontFamily="@font/manrope_extrabold"
                        android:textColor="#1C1B1A" />

                    <TextView
                        android:id="@+id/tvNotesDisplay"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="No notes yet."
                        android:textSize="14sp"
                        android:fontFamily="@font/manrope_semibold"
                        android:textColor="#3D3A35"
                        android:lineSpacingExtra="2dp" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/notesInputLayout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:visibility="gone"
                        style="@style/Widget.AfriNuts.EditText">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etNotes"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="Add notes here..."
                            android:inputType="textMultiLine"
                            android:minLines="3"
                            android:background="@drawable/bg_rounded_description"
                            android:enabled="false"
                            android:textColor="?attr/colorOnSurface"
                            android:textColorHint="?attr/colorOnSurface" />

                    </com.google.android.material.textfield.TextInputLayout>

                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <!-- Actions stay at the end of the scrollable block record. -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:orientation="horizontal">

                    <FrameLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:layout_marginEnd="6dp">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnEdit"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:text="Edit"
                            android:textAllCaps="false"
                            android:textSize="15sp"
                            android:fontFamily="@font/manrope_extrabold"
                            android:textColor="#1C1B1A"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            app:backgroundTint="#F3EAD8"
                            app:cornerRadius="999dp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnSave"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:text="Save"
                            android:textAllCaps="false"
                            android:textSize="15sp"
                            android:fontFamily="@font/manrope_extrabold"
                            android:textColor="#FFFFFF"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:visibility="gone"
                            app:backgroundTint="#0E6B3C"
                            app:cornerRadius="999dp" />
                    </FrameLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnRecordHarvestBottom"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:layout_marginStart="6dp"
                        android:text="Record Harvest"
                        android:textAllCaps="false"
                        android:textSize="15sp"
                        android:fontFamily="@font/manrope_extrabold"
                        android:textColor="#FFFFFF"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        app:backgroundTint="#0E6B3C"
                        app:cornerRadius="999dp" />
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnDelete"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="12dp"
                    android:text="Delete"
                    android:textAllCaps="false"
                    android:textSize="15sp"
                    android:fontFamily="@font/manrope_extrabold"
                    android:textColor="#B3402A"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    app:backgroundTint="#F8E4DD"
                    app:cornerRadius="999dp" />

            </LinearLayout>
        </LinearLayout>

    </ScrollView>

</LinearLayout>
