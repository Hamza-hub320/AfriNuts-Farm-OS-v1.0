<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background">

    <!-- Summary Cards Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp"
        android:weightSum="4">

        <!-- Total Suppliers -->
        <androidx.cardview.widget.CardView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="2dp"
            app:cardCornerRadius="24dp"
            app:cardElevation="1dp"
            style="@style/Widget.AfriNuts.CardView">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="8dp"
                android:background="?attr/cardBackgroundPrimary">

                <FrameLayout
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:background="?attr/iconBackgroundGlass">

                    <ImageView
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_people"
                        app:tint="?attr/colorPrimary" />

                </FrameLayout>

                <TextView
                    android:id="@+id/tvTotalSuppliers"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    style="@style/Text.Stat"
                    android:textSize="16sp"
                    android:textColor="?attr/colorPrimary"
                    android:layout_marginTop="2dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Total"
                    style="@style/Text.Caption.Small"
                    android:textSize="11sp"
                    android:textColor="?attr/colorOnSurface"
                    android:alpha="0.7" />

            </LinearLayout>

        </androidx.cardview.widget.CardView>

        <!-- Active Suppliers -->
        <androidx.cardview.widget.CardView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="2dp"
            android:layout_marginEnd="2dp"
            app:cardCornerRadius="24dp"
            app:cardElevation="1dp"
            style="@style/Widget.AfriNuts.CardView">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="8dp"
                android:background="?attr/cardBackgroundPrimary">

                <FrameLayout
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:background="?attr/iconBackgroundGlass">

                    <ImageView
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_check_circle"
                        app:tint="?attr/colorSecondary" />

                </FrameLayout>

                <TextView
                    android:id="@+id/tvActiveSuppliers"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    style="@style/Text.Stat"
                    android:textSize="16sp"
                    android:textColor="?attr/colorSecondary"
                    android:layout_marginTop="2dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Active"
                    style="@style/Text.Caption.Small"
                    android:textSize="11sp"
                    android:textColor="?attr/colorOnSurface"
                    android:alpha="0.7" />

            </LinearLayout>

        </androidx.cardview.widget.CardView>

        <!-- Certified Suppliers -->
        <androidx.cardview.widget.CardView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="2dp"
            android:layout_marginEnd="2dp"
            app:cardCornerRadius="24dp"
            app:cardElevation="1dp"
            style="@style/Widget.AfriNuts.CardView">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="8dp"
                android:background="?attr/cardBackgroundPrimary">

                <FrameLayout
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:background="?attr/iconBackgroundGlass">

                    <ImageView
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_star"
                        app:tint="?attr/colorPrimary" />

                </FrameLayout>

                <TextView
                    android:id="@+id/tvCertifiedSuppliers"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    style="@style/Text.Stat"
                    android:textSize="16sp"
                    android:textColor="?attr/colorPrimary"
                    android:layout_marginTop="2dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Certified"
                    style="@style/Text.Caption.Small"
                    android:textSize="11sp"
                    android:textColor="?attr/colorOnSurface"
                    android:alpha="0.7" />

            </LinearLayout>

        </androidx.cardview.widget.CardView>

        <!-- Avg Rating -->
        <androidx.cardview.widget.CardView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="2dp"
            app:cardCornerRadius="24dp"
            app:cardElevation="1dp"
            style="@style/Widget.AfriNuts.CardView">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="8dp"
                android:background="?attr/cardBackgroundPrimary">

                <FrameLayout
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:background="?attr/iconBackgroundGlass">

                    <ImageView
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_star"
                        app:tint="?attr/colorSecondary" />

                </FrameLayout>

                <TextView
                    android:id="@+id/tvAvgRating"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0 ★"
                    style="@style/Text.Stat"
                    android:textSize="16sp"
                    android:textColor="?attr/colorSecondary"
                    android:layout_marginTop="2dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Avg Rating"
                    style="@style/Text.Caption.Small"
                    android:textSize="11sp"
                    android:textColor="?attr/colorOnSurface"
                    android:alpha="0.7" />

            </LinearLayout>

        </androidx.cardview.widget.CardView>

    </LinearLayout>

    <!-- Filter Chips -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp"
        android:fillViewport="true"
        android:scrollbars="none"
        android:paddingVertical="2dp">

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/filterChipGroup"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            app:selectionRequired="true"
            app:singleSelection="true">

            <com.google.android.material.chip.Chip
                android:id="@+id/chipAll"
                style="@style/Widget.AfriNuts.Chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="All"
                android:textSize="13sp"
                app:chipIcon="@drawable/ic_view_list"
                app:chipIconTint="?attr/colorPrimary" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipActive"
                style="@style/Widget.AfriNuts.Chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Active"
                android:textSize="13sp"
                app:chipIcon="@drawable/ic_check_circle"
                app:chipIconTint="?attr/colorSecondary" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipCertified"
                style="@style/Widget.AfriNuts.Chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Certified"
                android:textSize="13sp"
                app:chipIcon="@drawable/ic_star"
                app:chipIconTint="?attr/colorPrimary" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipCooperative"
                style="@style/Widget.AfriNuts.Chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Cooperatives"
                android:textSize="13sp"
                app:chipIcon="@drawable/ic_people"
                app:chipIconTint="?attr/colorPrimary" />

        </com.google.android.material.chip.ChipGroup>

    </HorizontalScrollView>

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/layoutSearch"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginBottom="12dp"
        style="@style/Widget.AfriNuts.EditText"
        android:hint="       Search suppliers"
        app:startIconDrawable="@drawable/ic_search"
        app:startIconTint="?attr/colorOnSurface"
        app:endIconMode="clear_text"
        app:endIconTint="?attr/colorOnSurface"
        app:boxBackgroundColor="@color/surface"
        app:boxCornerRadiusBottomEnd="12dp"
        app:boxCornerRadiusBottomStart="12dp"
        app:boxCornerRadiusTopEnd="12dp"
        app:boxCornerRadiusTopStart="12dp"
        app:boxStrokeColor="?attr/colorPrimary">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etSearch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_rounded_description"
            android:inputType="text"
            android:imeOptions="actionSearch"
            android:maxLines="1" />
    </com.google.android.material.textfield.TextInputLayout>

    <!-- Progress Bar -->
    <ProgressBar
        android:id="@+id/progressBar"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_gravity="center"
        android:layout_marginTop="24dp"
        style="@style/Widget.AfriNuts.ProgressBar"
        android:indeterminateTint="?attr/colorPrimary"
        android:visibility="gone" />

    <!-- Empty State -->
    <LinearLayout
        android:id="@+id/emptyView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:layout_marginTop="48dp"
        android:visibility="gone">

        <FrameLayout
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:background="?attr/iconBackgroundGlass"
            android:padding="8dp">

            <ImageView
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_people"
                app:tint="?attr/colorOnSurface"
                android:alpha="0.5" />

        </FrameLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="No suppliers"
            style="@style/Text.H4"
            android:textSize="18sp"
            android:textColor="?attr/colorOnSurface"
            android:layout_marginTop="12dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Add your first supplier"
            style="@style/Text.Caption"
            android:textSize="13sp"
            android:textColor="?attr/colorOnSurface"
            android:alpha="0.7"
            android:layout_marginTop="4dp" />

    </LinearLayout>

    <!-- RecyclerView -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="6dp"
        android:clipToPadding="false"
        android:visibility="gone"
        android:background="@color/background" />

</LinearLayout>