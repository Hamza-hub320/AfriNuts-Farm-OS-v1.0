<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    app:cardCornerRadius="20dp"
    app:cardElevation="2dp"
    android:foreground="?android:attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true"
    android:background="@color/surface"
    style="@style/Widget.AfriNuts.CardView">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        android:background="@color/surface">

        <!-- Top Row: Icon + Category + Amount -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="12dp">

            <!-- Icon with Glass Container -->
            <FrameLayout
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_icon_sand"
                android:layout_marginEnd="12dp">

                <ImageView
                    android:id="@+id/ivCategoryIcon"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_attach_money"
                    app:tint="?attr/colorPrimary"
                    android:contentDescription="Category icon" />

            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvCategory"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Land Clearing"
                    style="@style/Text.H5"
                    android:textColor="?attr/colorPrimary" />

                <!-- ✅ Source Info: Farm-Wide, Block, or Procurement -->
                <TextView
                    android:id="@+id/tvSourceInfo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Farm-Wide"
                    style="@style/Text.Caption"
                    android:textColor="?attr/colorOnSurface"
                    android:alpha="0.7" />

                <!-- ✅ Batch/Supplier Info for Procurement -->
                <TextView
                    android:id="@+id/tvProcurementInfo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Batch: BATCH-001 | Supplier: ABC Ltd"
                    style="@style/Text.Caption.Small"
                    android:textColor="@color/accent_ink"
                    android:alpha="0.8"
                    android:visibility="gone"
                    android:layout_marginTop="2dp" />

            </LinearLayout>

            <TextView
                android:id="@+id/tvAmount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="5,250,000 XAF"
                style="@style/Text.Stat.Small"
                android:textColor="@color/accent_ink" />

        </LinearLayout>

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            style="@style/Widget.AfriNuts.Divider"
            android:layout_marginBottom="12dp" />

        <!-- Bottom Row: Date + Description -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginEnd="16dp">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_today"
                    app:tint="?attr/colorOnSurface"
                    android:alpha="0.6"
                    android:layout_marginEnd="4dp"
                    android:contentDescription="Date" />

                <TextView
                    android:id="@+id/tvDate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Jan 15, 2024"
                    style="@style/Text.Caption"
                    android:textColor="?attr/colorOnSurface"
                    android:alpha="0.7" />

            </LinearLayout>

            <TextView
                android:id="@+id/tvDescription"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Land clearing for 35-hectare plantation"
                style="@style/Text.Caption"
                android:textColor="?attr/colorOnSurface"
                android:alpha="0.8"
                android:maxLines="2"
                android:ellipsize="end" />

            <!-- ✅ Procurement Badge -->
            <LinearLayout
                android:id="@+id/layoutProcurementBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_icon_sand"
                android:paddingHorizontal="8dp"
                android:paddingVertical="4dp"
                android:layout_marginStart="8dp"
                android:visibility="gone"
                app:cardCornerRadius="12dp">

                <ImageView
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:src="@drawable/ic_shopping_cart"
                    app:tint="@color/accent_ink"
                    android:layout_marginEnd="4dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Procurement"
                    style="@style/Text.Caption.Small"
                    android:textSize="10sp"
                    android:textColor="@color/accent_ink"
                    android:textStyle="bold" />

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</androidx.cardview.widget.CardView>