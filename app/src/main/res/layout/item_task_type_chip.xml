<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingVertical="12dp"
    android:paddingHorizontal="8dp"
    android:background="@drawable/bg_rounded_transparent"
    android:layout_marginVertical="2dp">

    <!-- Icon Container with Gradient Background -->
    <FrameLayout
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_marginEnd="12dp"
        android:background="@drawable/bg_icon_container_small">

        <ImageView
            android:id="@+id/taskTypeIcon"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_task"
            app:tint="@color/primary"
            android:contentDescription="Task type icon" />

    </FrameLayout>

    <!-- Task Type Name -->
    <TextView
        android:id="@+id/taskTypeName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:text="Clearing"
        style="@style/Text.Body"
        android:textColor="@color/text_dark"
        android:maxLines="1"
        android:ellipsize="end" />

    <!-- Count Badge -->
    <FrameLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="12dp"
        android:background="@drawable/bg_count_badge">

        <TextView
            android:id="@+id/taskTypeCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="5"
            style="@style/Text.Label"
            android:textColor="@color/primary"
            android:paddingHorizontal="8dp"
            android:paddingVertical="2dp" />

    </FrameLayout>

    <!-- Progress Bar Container -->
    <FrameLayout
        android:layout_width="80dp"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_progress_container"
        android:padding="4dp">

        <ProgressBar
            android:id="@+id/taskTypeProgress"
            style="@style/Widget.AfriNuts.ProgressBar"
            android:layout_width="match_parent"
            android:layout_height="6dp"
            android:progress="0"
            android:max="100"
            android:progressTint="@color/primary"
            android:progressBackgroundTint="@color/warm_grey" />

    </FrameLayout>

</LinearLayout>