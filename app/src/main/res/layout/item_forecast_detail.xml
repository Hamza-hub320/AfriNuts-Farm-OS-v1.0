<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    style="@style/Widget.AfriNuts.CardView"
    app:cardElevation="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/forecastDay"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="2"
            style="@style/Text.Body"
            android:text="Monday, Mar 10" />

        <ImageView
            android:id="@+id/forecastIcon"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/ic_wb_sunny"
            app:tint="@color/accent"
            android:layout_marginEnd="16dp" />

        <TextView
            android:id="@+id/forecastHighLow"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="2"
            style="@style/Text.Body"
            android:text="H:32° L:24°" />

        <TextView
            android:id="@+id/forecastRain"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            style="@style/Text.Caption.Small"
            android:text="20%"
            android:gravity="end" />

    </LinearLayout>

</androidx.cardview.widget.CardView>