<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="2dp"
    android:background="@drawable/bg_card_primary"
    style="@style/Widget.AfriNuts.CardView">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="16dp"
        android:background="@drawable/bg_card_secondary">

        <!-- Day -->
        <TextView
            android:id="@+id/forecastDay"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="2"
            style="@style/Text.Body"
            android:text="Monday, Mar 10"
            android:textColor="@color/text_dark" />

        <!-- Weather Icon -->
        <FrameLayout
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_icon_glass"
            android:layout_marginEnd="12dp">

            <ImageView
                android:id="@+id/forecastIcon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_wb_sunny"
                app:tint="@color/accent" />

        </FrameLayout>

        <!-- High/Low Temperature -->
        <TextView
            android:id="@+id/forecastHighLow"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="2"
            style="@style/Text.Body"
            android:text="H:32° L:24°"
            android:textColor="@color/primary" />

        <!-- Rain Probability -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="end"
            android:alignmentMode="alignMargins">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_water_drop"
                app:tint="@color/navy"
                android:layout_marginEnd="4dp" />

            <TextView
                android:id="@+id/forecastRain"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/Text.Caption.Small"
                android:text="20%"
                android:textColor="@color/navy" />

        </LinearLayout>

    </LinearLayout>

</androidx.cardview.widget.CardView>