<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    app:cardCornerRadius="20dp"
    app:cardElevation="2dp"
    android:background="@color/surface"
    style="@style/Widget.AfriNuts.CardView"
    android:clipChildren="false"
    android:outlineProvider="background"
    android:foreground="?android:attr/selectableItemBackgroundBorderless">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="16dp"
        android:background="@color/surface"
        android:outlineProvider="background"
        android:foreground="?android:attr/selectableItemBackgroundBorderless">

        <!-- Day -->
        <TextView
            android:id="@+id/forecastDay"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="2"
            style="@style/Text.Body"
            android:text="Monday, Mar 10"
            android:textColor="?attr/colorOnSurface" />

        <!-- Weather Icon -->
        <FrameLayout
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_icon_sand"
            android:layout_marginEnd="12dp">

            <ImageView
                android:id="@+id/forecastIcon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_wb_sunny"
                app:tint="?attr/colorSecondary" />

        </FrameLayout>

        <!-- High/Low Temperature -->
        <TextView
            android:id="@+id/forecastHighLow"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="2"
            style="@style/Text.Body"
            android:text="H:32° L:24°"
            android:textColor="?attr/colorPrimary" />

        <!-- Rain Probability -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="end"
            android:alignmentMode="alignMargins">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_water_drop"
                app:tint="?attr/colorOnSurface"
                android:layout_marginEnd="4dp" />

            <TextView
                android:id="@+id/forecastRain"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/Text.Caption.Small"
                android:text="20%"
                android:textColor="?attr/colorOnSurface" />

        </LinearLayout>

    </LinearLayout>

</androidx.cardview.widget.CardView>