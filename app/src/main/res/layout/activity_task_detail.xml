<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F6F1E7">

    <!-- Modern Glass Morphism Toolbar -->
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginTop="12dp"
        android:background="@android:color/transparent"
        android:elevation="0dp"
        app:contentInsetStartWithNavigation="0dp">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="Task details"
            android:textColor="#1C1B1A"
            android:textSize="17sp"
            android:fontFamily="sans-serif-black" />
    </androidx.appcompat.widget.Toolbar>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Header Card with Task Icon and Title - Modern Gradient Card -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                app:cardCornerRadius="24dp"
                app:cardElevation="2dp"
                style="@style/Widget.AfriNuts.CardView"
                android:background="@color/surface">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="20dp"
                    android:gravity="center_vertical"
                    android:background="@color/surface">

                    <!-- Icon Container with Gradient Background -->
                    <FrameLayout
                        android:layout_width="64dp"
                        android:layout_height="64dp"
                        android:layout_marginEnd="16dp"
                        android:background="@drawable/bg_icon_sand">

                        <ImageView
                            android:id="@+id/tvTaskIcon"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_tractor"
                            app:tint="?attr/colorPrimary"
                            android:contentDescription="Task icon" />

                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvTaskTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Clear Block A1"
                            style="@style/Text.H3"
                            android:textColor="?attr/colorPrimary" />

                        <TextView
                            android:id="@+id/tvTaskType"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Land Clearing"
                            style="@style/Text.Caption"
                            android:textColor="?attr/colorOnSurface"
                            android:alpha="0.7"
                            android:layout_marginTop="4dp" />

                    </LinearLayout>

                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <EditText
                android:id="@+id/etTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone"
                android:background="@drawable/edit_mode_background"
                android:hint="Task title"
                android:inputType="text"
                android:textColor="?attr/colorOnSurface"
                android:textColorHint="?attr/colorOnSurface"
                android:padding="12dp"
                style="@style/Text.H3" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/layoutTaskType"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:visibility="gone"
                style="@style/Widget.AfriNuts.EditText"
                app:boxBackgroundColor="?attr/colorSurface"
                app:endIconMode="dropdown_menu"
                app:endIconDrawable="@drawable/ic_arrow_drop_down">

                <com.google.android.material.textfield.MaterialAutoCompleteTextView
                    android:id="@+id/actvTaskType"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Type"
                    android:inputType="none" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Status Card - Modern with Gradient -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="24dp"
                app:cardElevation="2dp"
                style="@style/Widget.AfriNuts.CardView"
                android:background="@color/surface">

                <!-- Edge Effect -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_edge_effect"
                    android:alpha="0.3" />

                <!-- Glassy Overlay -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@color/surface"
                    android:alpha="0.4" />

                <!-- Inner Shadow -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_inner_shadow" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp"
                    android:background="@color/surface">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Current Status"
                        style="@style/Text.Label.Small"
                        android:textColor="?attr/colorOnSurface"
                        android:alpha="0.7"
                        android:layout_marginBottom="12dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="16dp">

                        <TextView
                            android:id="@+id/tvCurrentStatus"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="PENDING"
                            style="@style/Text.H4"
                            android:textColor="?attr/colorPrimary" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnUpdateStatus"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Update"
                            style="@style/Widget.AfriNuts.Button.Secondary"
                            app:icon="@drawable/ic_sync"
                            app:iconTint="?attr/colorAccent"
                            app:cornerRadius="20dp" />

                    </LinearLayout>

                    <!-- Status Timeline with Modern Design -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center"
                        android:layout_marginTop="8dp">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:gravity="center">

                            <TextView
                                android:id="@+id/tvPendingDot"
                                android:layout_width="12dp"
                                android:layout_height="12dp"
                                android:background="@drawable/circle_green"
                                android:layout_marginBottom="4dp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Pending"
                                style="@style/Text.Caption.Small"
                                android:textColor="?attr/colorOnSurface"
                                android:alpha="0.7" />

                        </LinearLayout>

                        <View
                            android:layout_width="0dp"
                            android:layout_height="2dp"
                            android:layout_weight="2"
                            android:background="?attr/colorSurfaceVariant"
                            android:layout_marginHorizontal="4dp" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:gravity="center">

                            <TextView
                                android:id="@+id/tvInProgressDot"
                                android:layout_width="12dp"
                                android:layout_height="12dp"
                                android:background="@drawable/circle_grey"
                                android:layout_marginBottom="4dp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="In Prog."
                                style="@style/Text.Caption.Small"
                                android:textColor="?attr/colorOnSurface"
                                android:alpha="0.7"
                                android:maxLines="1"
                                android:ellipsize="end" />

                        </LinearLayout>

                        <View
                            android:layout_width="0dp"
                            android:layout_height="2dp"
                            android:layout_weight="2"
                            android:background="?attr/colorSurfaceVariant"
                            android:layout_marginHorizontal="4dp" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:gravity="center">

                            <TextView
                                android:id="@+id/tvCompletedDot"
                                android:layout_width="12dp"
                                android:layout_height="12dp"
                                android:background="@drawable/circle_grey"
                                android:layout_marginBottom="4dp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Done"
                                style="@style/Text.Caption.Small"
                                android:textColor="?attr/colorOnSurface"
                                android:alpha="0.7"
                                android:maxLines="1"
                                android:ellipsize="end" />

                        </LinearLayout>

                    </LinearLayout>

                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <!-- Details Card -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="24dp"
                app:cardElevation="2dp"
                style="@style/Widget.AfriNuts.CardView"
                android:background="@color/surface">

                <!-- Edge Effect -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_edge_effect"
                    android:alpha="0.3" />

                <!-- Glassy Overlay -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@color/surface"
                    android:alpha="0.4" />

                <!-- Inner Shadow -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_inner_shadow" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp"
                    android:background="@color/surface">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Task Details"
                        style="@style/Text.H5"
                        android:textColor="?attr/colorPrimary"
                        android:layout_marginBottom="16dp" />

                    <!-- Block Row with Icon -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="12dp"
                        android:gravity="center_vertical">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/ic_inventory"
                            app:tint="?attr/colorOnSurface"
                            android:alpha="0.7"
                            android:layout_marginEnd="12dp" />

                        <TextView
                            android:layout_width="100dp"
                            android:layout_height="wrap_content"
                            android:text="Block:"
                            style="@style/Text.Label" />

                        <TextView
                            android:id="@+id/tvBlockName"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Block A1"
                            style="@style/Text.Body.Small" />

                    </LinearLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/layoutBlock"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:visibility="gone"
                        style="@style/Widget.AfriNuts.EditText"
                        app:boxBackgroundColor="?attr/colorSurface"
                        app:endIconMode="dropdown_menu"
                        app:endIconDrawable="@drawable/ic_arrow_drop_down">

                        <com.google.android.material.textfield.MaterialAutoCompleteTextView
                            android:id="@+id/actvBlock"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="Block"
                            android:inputType="none" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Due Date Row with Icon -->
                    <LinearLayout
                        android:id="@+id/layoutDueDate"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="12dp"
                        android:gravity="center_vertical"
                        android:clickable="true"
                        android:focusable="true">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/ic_today"
                            app:tint="?attr/colorOnSurface"
                            android:alpha="0.7"
                            android:layout_marginEnd="12dp" />

                        <TextView
                            android:layout_width="100dp"
                            android:layout_height="wrap_content"
                            android:text="Due Date:"
                            style="@style/Text.Label" />

                        <TextView
                            android:id="@+id/tvDueDate"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Mar 15, 2024"
                            style="@style/Text.Body.Small" />

                    </LinearLayout>

                    <!-- Completed Date Row (if completed) -->
                    <LinearLayout
                        android:id="@+id/layoutCompletedDate"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="12dp"
                        android:visibility="gone"
                        android:gravity="center_vertical">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/ic_check_circle"
                            app:tint="?attr/colorPrimary"
                            android:layout_marginEnd="12dp" />

                        <TextView
                            android:layout_width="100dp"
                            android:layout_height="wrap_content"
                            android:text="Completed:"
                            style="@style/Text.Label" />

                        <TextView
                            android:id="@+id/tvCompletedDate"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text=""
                            style="@style/Text.Body.Small"
                            android:textColor="?attr/colorPrimary" />

                    </LinearLayout>

                    <!-- Description Section with Icon -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginTop="8dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginBottom="8dp">

                            <ImageView
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:src="@drawable/ic_note"
                                app:tint="?attr/colorOnSurface"
                                android:alpha="0.7"
                                android:layout_marginEnd="12dp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Description:"
                                style="@style/Text.Label" />

                        </LinearLayout>

                        <TextView
                            android:id="@+id/tvDescription"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_rounded_description"
                            android:text="Clear land for planting cashew trees"
                            style="@style/Text.Body.Small"
                            android:padding="12dp"
                            android:minLines="3"
                            android:enabled="false"
                            android:textColor="?attr/colorOnSurface"
                            android:textColorHint="?attr/colorOnSurface"/>

                        <EditText
                            android:id="@+id/etDescription"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:visibility="gone"
                            android:background="@drawable/edit_mode_background"
                            android:hint="Description"
                            android:inputType="textMultiLine"
                            android:minLines="3"
                            android:gravity="top|start"
                            android:padding="12dp"
                            style="@style/Text.Body.Small"
                            android:textColor="?attr/colorOnSurface"
                            android:textColorHint="?attr/colorOnSurface" />

                    </LinearLayout>

                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <!-- 42: work window start. Only visible when the task carries a startDate
            (backdated work). Normal plan-then-do tasks don't show it. -->
            <LinearLayout
                android:id="@+id/layoutStartDate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="12dp"
                android:visibility="gone"
                android:background="@color/surface"
                app:cornerRadius="12dp">

                <TextView
                    android:layout_width="100dp"
                    android:layout_height="wrap_content"
                    android:text="Started:"
                    style="@style/Text.Label"
                    android:textColor="?attr/colorOnSurface"
                    android:alpha="0.7" />

                <TextView
                    android:id="@+id/tvStartDate"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    style="@style/Text.Body"
                    android:textColor="?attr/colorOnSurface" />
            </LinearLayout>

            <!-- Photo Gallery Card -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                style="@style/Widget.AfriNuts.CardView"
                app:cardCornerRadius="24dp"
                app:cardElevation="2dp"
                android:background="@color/surface"
                android:foreground="?android:attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="16dp"
                    android:id="@+id/btnPhotoGallery"
                    android:background="@color/surface">

                    <FrameLayout
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:background="@drawable/bg_icon_sand"
                        android:layout_marginEnd="16dp">

                        <ImageView
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_photo"
                            app:tint="?attr/colorSecondary" />

                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Photos"
                            style="@style/Text.H5"
                            android:textColor="?attr/colorSecondary" />

                        <TextView
                            android:id="@+id/tvPhotoCount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0 photos"
                            style="@style/Text.Caption"
                            android:textColor="?attr/colorOnSurface" />

                    </LinearLayout>

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_arrow_forward"
                        app:tint="?attr/colorSecondary" />

                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <!-- Assignment Card -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="24dp"
                app:cardElevation="2dp"
                style="@style/Widget.AfriNuts.CardView"
                android:background="@color/surface">

                <!-- Edge Effect -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_edge_effect"
                    android:alpha="0.3" />

                <!-- Glassy Overlay -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@color/surface"
                    android:alpha="0.4" />

                <!-- Inner Shadow -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_inner_shadow" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp"
                    android:background="@color/surface">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="16dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Worker Assignment"
                            style="@style/Text.H5"
                            android:textColor="?attr/colorPrimary" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnAssignWorker"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Assign"
                            style="@style/Widget.AfriNuts.Button"
                            app:icon="@drawable/ic_add"
                            app:cornerRadius="20dp" />

                    </LinearLayout>

                    <!-- Current Assignment Card -->
                    <LinearLayout
                        android:id="@+id/layoutCurrentAssignment"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="12dp"
                        android:layout_marginBottom="16dp"
                        android:visibility="gone"
                        app:cardCornerRadius="12dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Currently Assigned To:"
                            style="@style/Text.Caption.Small"
                            android:textColor="?attr/colorOnSurface"
                            android:alpha="0.7"
                            android:layout_marginBottom="4dp" />

                        <TextView
                            android:id="@+id/tvCurrentWorker"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="John Doe"
                            style="@style/Text.H6"
                            android:textColor="?attr/colorPrimary"
                            android:layout_marginBottom="4dp" />

                        <TextView
                            android:id="@+id/tvAssignedSince"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Assigned: Mar 10, 2024"
                            style="@style/Text.Caption.Small"
                            android:textColor="?attr/colorOnSurface"
                            android:alpha="0.7" />

                    </LinearLayout>

                    <!-- Assignment History -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Assignment History"
                        style="@style/Text.Label"
                        android:textColor="?attr/colorOnSurface"
                        android:alpha="0.7"
                        android:layout_marginBottom="12dp" />

                    <LinearLayout
                        android:id="@+id/assignmentHistoryContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"/>

                    <TextView
                        android:id="@+id/tvNoAssignments"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="No assignment history"
                        style="@style/Text.Body.Small"
                        android:textColor="?attr/colorOnSurface"
                        android:alpha="0.7"
                        android:gravity="center"
                        android:padding="16dp"
                        android:visibility="gone" />

                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <!-- Action Buttons - Liquid Glass Style -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_horizontal"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="24dp">

                <!-- Edit Button - Accent -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnEdit"
                    android:layout_width="0dp"
                    android:layout_height="46dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    android:text="Edit"
                    style="@style/Widget.AfriNuts.Button"
                    app:icon="@drawable/ic_edit"
                    app:iconGravity="textStart" />

                <!-- Save Button - Primary -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSave"
                    android:layout_width="0dp"
                    android:layout_height="46dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    android:text="Save"
                    style="@style/Widget.AfriNuts.Button"
                    app:icon="@drawable/ic_save"
                    app:iconGravity="textStart"
                    android:visibility="gone" />

                <!-- Delete Button - Danger (Fixed: Use MaterialButton) -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnDelete"
                    android:layout_width="0dp"
                    android:layout_height="46dp"
                    android:layout_weight="1"
                    android:text="Delete"
                    style="@style/Widget.AfriNuts.Button.Danger"
                    app:icon="@drawable/ic_delete"
                    app:iconGravity="textStart"
                    app:iconTint="@color/error" />

            </LinearLayout>

        </LinearLayout>

    </ScrollView>

    <!-- Floating Action Button for quick status update -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="16dp"
        android:src="@drawable/ic_sync"
        android:contentDescription="Update status"
        app:backgroundTint="@color/primary"
        app:tint="@android:color/white"
        app:fabSize="normal" />

</LinearLayout>