<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Header with Icon -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="24dp">

            <FrameLayout
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:background="?attr/iconBackgroundGlass"
                android:layout_marginEnd="16dp">

                <ImageView
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_add"
                    app:tint="?attr/colorPrimary" />

            </FrameLayout>

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Create New Task"
                style="@style/Text.H2"
                android:textColor="?attr/colorPrimary" />

        </LinearLayout>

        <!-- Task Details Card -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            style="@style/Widget.AfriNuts.CardView"
            app:cardCornerRadius="20dp"
            app:cardElevation="4dp"
            android:background="?attr/cardBackgroundPrimary">

            <!-- Edge Effect (3D border) -->
            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_edge_effect"
                android:alpha="0.3" />

            <!-- Glassy Overlay -->
            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_glassy_overlay"
                android:alpha="0.4" />

            <!-- Inner Shadow -->
            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_inner_shadow" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Task Details"
                    style="@style/Text.H5"
                    android:textColor="?attr/colorPrimary"
                    android:layout_marginBottom="16dp" />

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    style="@style/Widget.AfriNuts.EditText"
                    app:boxBackgroundColor="?attr/colorSurface"
                    app:boxCornerRadiusBottomEnd="12dp"
                    app:boxCornerRadiusBottomStart="12dp"
                    app:boxCornerRadiusTopEnd="12dp"
                    app:boxCornerRadiusTopStart="12dp"
                    app:boxStrokeColor="?attr/colorPrimary">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etTaskTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Task Title"
                        android:inputType="text" />

                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    style="@style/Widget.AfriNuts.EditText"
                    app:boxBackgroundColor="?attr/colorSurface"
                    app:boxCornerRadiusBottomEnd="12dp"
                    app:boxCornerRadiusBottomStart="12dp"
                    app:boxCornerRadiusTopEnd="12dp"
                    app:boxCornerRadiusTopStart="12dp"
                    app:boxStrokeColor="?attr/colorPrimary">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etTaskDescription"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Description"
                        android:inputType="textMultiLine"
                        android:minLines="3" />

                </com.google.android.material.textfield.TextInputLayout>

            </LinearLayout>

        </androidx.cardview.widget.CardView>

        <!-- Task Type Card -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            style="@style/Widget.AfriNuts.CardView"
            app:cardCornerRadius="20dp"
            app:cardElevation="4dp"
            android:background="?attr/cardBackgroundSecondary">

            <!-- Edge Effect (3D border) -->
            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_edge_effect"
                android:alpha="0.3" />

            <!-- Glassy Overlay -->
            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_glassy_overlay"
                android:alpha="0.4" />

            <!-- Inner Shadow -->
            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_inner_shadow" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Task Type"
                    style="@style/Text.H5"
                    android:textColor="?attr/colorPrimaryVariant"
                    android:layout_marginBottom="16dp" />

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    style="@style/Widget.AfriNuts.EditText"
                    app:boxBackgroundColor="?attr/colorSurface"
                    app:endIconMode="dropdown_menu"
                    app:endIconDrawable="@drawable/ic_arrow_drop_down"
                    app:boxCornerRadiusBottomEnd="12dp"
                    app:boxCornerRadiusBottomStart="12dp"
                    app:boxCornerRadiusTopEnd="12dp"
                    app:boxCornerRadiusTopStart="12dp"
                    app:boxStrokeColor="?attr/colorPrimaryVariant">

                    <com.google.android.material.textfield.MaterialAutoCompleteTextView
                        android:id="@+id/etTaskType"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Select Task Type"
                        android:inputType="none" />

                </com.google.android.material.textfield.TextInputLayout>

            </LinearLayout>

        </androidx.cardview.widget.CardView>

        <!-- Task Scope Card -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            style="@style/Widget.AfriNuts.CardView"
            app:cardCornerRadius="20dp"
            app:cardElevation="4dp"
            android:background="?attr/cardBackgroundAccent">

            <!-- Edge Effect (3D border) -->
            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_edge_effect"
                android:alpha="0.3" />

            <!-- Glassy Overlay -->
            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_glassy_overlay"
                android:alpha="0.4" />

            <!-- Inner Shadow -->
            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_inner_shadow" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Task Scope"
                    style="@style/Text.H5"
                    android:textColor="?attr/colorSecondary"
                    android:layout_marginBottom="16dp" />

                <com.google.android.material.button.MaterialButtonToggleGroup
                    android:id="@+id/toggleTaskScope"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    app:singleSelection="true">

                    <Button
                        android:id="@+id/btnFarmWide"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Farm-Wide"
                        style="@style/Widget.AfriNuts.Button.Outlined"
                        app:iconGravity="textStart" />

                    <Button
                        android:id="@+id/btnPerBlock"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Per Block"
                        style="@style/Widget.AfriNuts.Button.Outlined"
                        app:iconGravity="textStart" />

                </com.google.android.material.button.MaterialButtonToggleGroup>

                <!-- Block Selector (visible only when "Per Block" is selected) -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/layoutBlockSelector"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:visibility="gone"
                    style="@style/Widget.AfriNuts.EditText"
                    android:hint="Select Block"
                    app:endIconMode="dropdown_menu"
                    app:endIconDrawable="@drawable/ic_arrow_drop_down"
                    app:boxBackgroundColor="?attr/colorSurface"
                    app:boxCornerRadiusBottomEnd="12dp"
                    app:boxCornerRadiusBottomStart="12dp"
                    app:boxCornerRadiusTopEnd="12dp"
                    app:boxCornerRadiusTopStart="12dp"
                    app:boxStrokeColor="?attr/colorSecondary">

                    <com.google.android.material.textfield.MaterialAutoCompleteTextView
                        android:id="@+id/etBlock"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="none" />

                </com.google.android.material.textfield.TextInputLayout>

            </LinearLayout>

        </androidx.cardview.widget.CardView>

        <!-- Due Date Card -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            style="@style/Widget.AfriNuts.CardView"
            app:cardCornerRadius="20dp"
            app:cardElevation="4dp"
            android:background="?attr/cardBackgroundPrimary">

            <!-- Edge Effect (3D border) -->
            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_edge_effect"
                android:alpha="0.3" />

            <!-- Glassy Overlay -->
            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_glassy_overlay"
                android:alpha="0.4" />

            <!-- Inner Shadow -->
            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_inner_shadow" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Due Date"
                    style="@style/Text.H5"
                    android:textColor="?attr/colorPrimary"
                    android:layout_marginBottom="16dp" />

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    style="@style/Widget.AfriNuts.EditText"
                    app:endIconMode="clear_text"
                    app:endIconDrawable="@drawable/ic_today"
                    app:boxBackgroundColor="?attr/colorSurface"
                    app:boxCornerRadiusBottomEnd="12dp"
                    app:boxCornerRadiusBottomStart="12dp"
                    app:boxCornerRadiusTopEnd="12dp"
                    app:boxCornerRadiusTopStart="12dp"
                    app:boxStrokeColor="?attr/colorPrimary">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etDueDate"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Select Due Date"
                        android:focusable="false"
                        android:clickable="true" />

                </com.google.android.material.textfield.TextInputLayout>

            </LinearLayout>

        </androidx.cardview.widget.CardView>

        <!-- Status Card (Read-only) -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            style="@style/Widget.AfriNuts.CardView"
            app:cardCornerRadius="20dp"
            app:cardElevation="4dp"
            android:background="?attr/cardBackgroundSecondary">

            <!-- Edge Effect (3D border) -->
            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_edge_effect"
                android:alpha="0.3" />

            <!-- Glassy Overlay -->
            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_glassy_overlay"
                android:alpha="0.4" />

            <!-- Inner Shadow -->
            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_inner_shadow" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Status"
                    style="@style/Text.H5"
                    android:textColor="?attr/colorPrimaryVariant"
                    android:layout_marginBottom="16dp" />

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    style="@style/Widget.AfriNuts.EditText"
                    app:boxBackgroundColor="?attr/colorSurface"
                    app:boxCornerRadiusBottomEnd="12dp"
                    app:boxCornerRadiusBottomStart="12dp"
                    app:boxCornerRadiusTopEnd="12dp"
                    app:boxCornerRadiusTopStart="12dp"
                    app:boxStrokeColor="?attr/colorPrimaryVariant">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etStatus"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Status"
                        android:text="PENDING"
                        android:enabled="false" />

                </com.google.android.material.textfield.TextInputLayout>

            </LinearLayout>

        </androidx.cardview.widget.CardView>

        <!-- Action Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="end"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp">

            <Button
                android:id="@+id/btnCancel"
                android:layout_width="wrap_content"
                android:layout_height="56dp"
                android:text="Cancel"
                style="@style/Widget.AfriNuts.Button.Outlined"
                android:layout_marginEnd="12dp"
                android:minWidth="100dp"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                app:iconGravity="textStart"
                app:cornerRadius="28dp" />

            <Button
                android:id="@+id/btnSave"
                android:layout_width="wrap_content"
                android:layout_height="56dp"
                android:text="Create Task"
                style="@style/Widget.AfriNuts.Button"
                android:backgroundTint="?attr/colorPrimary"
                app:icon="@drawable/ic_add"
                app:iconGravity="textStart"
                app:iconPadding="12dp"
                android:minWidth="140dp"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                app:cornerRadius="28dp" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>