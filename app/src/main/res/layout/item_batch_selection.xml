<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardView"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="4dp"
    app:cardCornerRadius="20dp"
    app:cardElevation="2dp"
    style="@style/Widget.AfriNuts.CardView"
    android:foreground="?android:attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:gravity="center_vertical"
        android:background="@color/surface">

        <!-- Grade Icon -->
        <FrameLayout
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_icon_sand"
            android:layout_marginEnd="12dp">

            <ImageView
                android:id="@+id/ivGradeIcon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_star"
                app:tint="@color/accent_ink" />

        </FrameLayout>

        <!-- Batch Info -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvBatchInfo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="#AFN-260625-001"
                style="@style/Text.H6"
                android:textColor="?attr/colorPrimary" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvBatchDate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Jun 25, 2026"
                    style="@style/Text.Caption.Small"
                    android:textColor="?attr/colorOnSurface"
                    android:alpha="0.6"
                    android:layout_marginEnd="12dp" />

                <TextView
                    android:id="@+id/tvBatchWeight"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="40,000 kg"
                    style="@style/Text.Caption.Small"
                    android:textColor="?attr/colorPrimary" />

            </LinearLayout>

        </LinearLayout>

        <!-- Grade Badge -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@color/surface"
            android:paddingHorizontal="12dp"
            android:paddingVertical="4dp"
            app:cornerRadius="12dp">

            <TextView
                android:id="@+id/tvBatchGrade"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Premium"
                style="@style/Text.Caption.Small"
                android:textColor="@color/accent_ink" />

        </LinearLayout>

    </LinearLayout>

</androidx.cardview.widget.CardView>