<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardView"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="6dp"
    app:cardCornerRadius="24dp"
    app:cardElevation="4dp"
    style="@style/Widget.AfriNuts.CardView"
    android:foreground="?android:attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true"
    android:background="?attr/cardBackgroundPrimary">


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp"
        android:background="?attr/cardBackgroundPrimary">

        <!-- Top Row: Supplier Name + Source Type -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="4dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:id="@+id/ivSupplierIcon"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:src="@drawable/ic_person"
                    app:tint="?attr/colorOnSurface"
                    android:alpha="0.5"
                    android:layout_marginEnd="4dp" />

                <TextView
                    android:id="@+id/tvSupplierName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Supplier Name"
                    style="@style/Text.Caption"
                    android:textSize="12sp"
                    android:textColor="?attr/colorOnSurface"
                    android:alpha="0.7" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="?attr/cardBackgroundSecondary"
                android:paddingHorizontal="8dp"
                android:paddingVertical="2dp"
                app:cornerRadius="12dp">

                <ImageView
                    android:id="@+id/ivSourceIcon"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:src="@drawable/ic_handshake"
                    app:tint="?attr/colorPrimary"
                    android:layout_marginEnd="4dp" />

                <TextView
                    android:id="@+id/tvSourceType"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Cooperative"
                    style="@style/Text.Caption.Small"
                    android:textSize="11sp"
                    android:textColor="?attr/colorPrimary" />

            </LinearLayout>

        </LinearLayout>

        <!-- Batch Number + Grade + Score -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="8dp">

            <TextView
                android:id="@+id/tvBatchNumber"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="#BATCH-001"
                style="@style/Text.H5"
                android:textColor="?attr/colorPrimary"
                android:textSize="15sp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/status_background"
                android:paddingHorizontal="8dp"
                android:paddingVertical="2dp"
                app:cornerRadius="12dp">

                <ImageView
                    android:id="@+id/ivGradeIcon"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:src="@drawable/ic_star"
                    app:tint="@android:color/white"
                    android:layout_marginEnd="4dp" />

                <TextView
                    android:id="@+id/tvGrade"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Premium"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="@android:color/white" />

            </LinearLayout>

            <FrameLayout
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/circle_quality_score"
                android:padding="4dp"
                android:layout_marginStart="8dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:gravity="center">

                    <TextView
                        android:id="@+id/tvQualityScore"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="85"
                        style="@style/Text.Stat"
                        android:textSize="14sp"
                        android:textColor="@android:color/white"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="score"
                        android:textSize="8sp"
                        android:textColor="@android:color/white"
                        android:alpha="0.8" />

                </LinearLayout>

            </FrameLayout>

        </LinearLayout>

        <!-- Metrics Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="?attr/cardBackgroundSecondary"
            android:padding="8dp"
            android:layout_marginBottom="8dp"
            app:cornerRadius="16dp">

            <!-- Moisture -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">

                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:src="@drawable/ic_water_drop"
                    app:tint="?attr/colorOnSurface"
                    android:alpha="0.6" />

                <TextView
                    android:id="@+id/tvMoisture"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="6.5%"
                    style="@style/Text.Caption.Small"
                    android:textSize="11sp"
                    android:textColor="?attr/colorOnSurface" />

            </LinearLayout>

            <!-- Defective Rate -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">

                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:src="@drawable/ic_cancel"
                    app:tint="?attr/colorOnSurface"
                    android:alpha="0.6" />

                <TextView
                    android:id="@+id/tvDefectiveRate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="3.2%"
                    style="@style/Text.Caption.Small"
                    android:textSize="11sp"
                    android:textColor="?attr/colorOnSurface" />

            </LinearLayout>

            <!-- Kernel Ratio -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">

                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:src="@drawable/ic_grain"
                    app:tint="?attr/colorOnSurface"
                    android:alpha="0.6" />

                <TextView
                    android:id="@+id/tvKernelRatio"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="88%"
                    style="@style/Text.Caption.Small"
                    android:textSize="11sp"
                    android:textColor="?attr/colorOnSurface" />

            </LinearLayout>

            <!-- Weight -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">

                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:src="@drawable/ic_weight"
                    app:tint="?attr/colorOnSurface"
                    android:alpha="0.6" />

                <TextView
                    android:id="@+id/tvWeight"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="100 kg"
                    style="@style/Text.Caption.Small"
                    android:textSize="11sp"
                    android:textColor="?attr/colorOnSurface" />

            </LinearLayout>

        </LinearLayout>

        <!-- Bottom Row: Date -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:src="@drawable/ic_today"
                app:tint="?attr/colorOnSurface"
                android:alpha="0.6"
                android:layout_marginEnd="4dp" />

            <TextView
                android:id="@+id/tvDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Jun 20, 2024"
                style="@style/Text.Caption.Small"
                android:textSize="11sp"
                android:textColor="?attr/colorOnSurface" />

        </LinearLayout>

    </LinearLayout>

</androidx.cardview.widget.CardView>