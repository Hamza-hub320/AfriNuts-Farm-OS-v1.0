<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background">

    <!-- Modern Glass Morphism Toolbar -->
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/surface"
        android:theme="@style/ThemeOverlay.AppCompat.Dark.ActionBar"
        android:elevation="0dp"
        android:translationZ="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">

            <ImageView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/ic_afrinuts_foreground"
                android:alpha="0.95"
                android:layout_marginEnd="12dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Analytics Dashboard"
                android:textColor="@color/text_dark"
                android:textSize="18sp"
                android:textStyle="bold"
                android:letterSpacing="0.01" />

        </LinearLayout>

    </androidx.appcompat.widget.Toolbar>

    <!-- Modern Tab Layout -->
    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tabLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/background"
        app:tabIndicatorColor="@color/primary"
        app:tabSelectedTextColor="@color/primary"
        app:tabTextColor="@color/navy"
        app:tabMode="fixed"
        app:tabGravity="fill"
        app:tabRippleColor="@color/primary_light"
        android:elevation="0dp">

        <com.google.android.material.tabs.TabItem
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Yield" />

        <com.google.android.material.tabs.TabItem
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Trends" />

        <com.google.android.material.tabs.TabItem
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Blocks" />

        <com.google.android.material.tabs.TabItem
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Forecast" />

    </com.google.android.material.tabs.TabLayout>

    <!-- Progress Bar -->
    <ProgressBar
        android:id="@+id/progressBar"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="center"
        android:layout_marginTop="32dp"
        style="@style/Widget.AfriNuts.ProgressBar"
        android:indeterminate="true"
        android:visibility="gone" />

    <!-- Empty State -->
    <LinearLayout
        android:id="@+id/emptyView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:visibility="gone"
        android:layout_marginTop="64dp">

        <FrameLayout
            android:layout_width="96dp"
            android:layout_height="96dp"
            android:background="@drawable/bg_icon_sand"
            android:layout_marginBottom="16dp">

            <ImageView
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_trending_up"
                app:tint="@color/warm_grey" />

        </FrameLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="No analytics data"
            style="@style/Text.H3"
            android:textColor="@color/navy"
            android:layout_marginTop="16dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Add blocks and harvest data to see analytics"
            style="@style/Text.Caption"
            android:textColor="@color/navy"
            android:layout_marginTop="8dp" />

    </LinearLayout>

    <!-- Content Container -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="16dp"
        android:paddingTop="0dp"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Yield Tab Content -->
            <LinearLayout
                android:id="@+id/contentYield"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="visible">

                <!-- Current Year Prediction Card - Modern Glass -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/cardCurrentYear"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    style="@style/Widget.AfriNuts.CardView"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="2dp"
                    android:background="@drawable/bg_card_accent">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="20dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Current Year Prediction"
                            style="@style/Text.H5"
                            android:textColor="@color/accent"
                            android:layout_marginBottom="16dp" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginBottom="16dp">

                            <FrameLayout
                                android:layout_width="56dp"
                                android:layout_height="56dp"
                                android:background="@drawable/bg_icon_sand"
                                android:layout_marginEnd="16dp">

                                <TextView
                                    android:id="@+id/tvCurrentYear"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_gravity="center"
                                    android:text="2026"
                                    style="@style/Text.H2"
                                    android:textColor="@color/accent" />

                            </FrameLayout>

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:id="@+id/tvPredictedYield"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="45,000 kg"
                                    style="@style/Text.H3"
                                    android:textColor="@color/text_dark" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Predicted Yield"
                                    style="@style/Text.Caption"
                                    android:textColor="@color/navy" />

                            </LinearLayout>

                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:layout_marginBottom="12dp"
                            android:weightSum="2">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical"
                                android:gravity="center">

                                <TextView
                                    android:id="@+id/tvConfidence"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="75%"
                                    style="@style/Text.H4"
                                    android:textColor="@color/accent" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Confidence"
                                    style="@style/Text.Caption"
                                    android:textColor="@color/navy" />

                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical"
                                android:gravity="center">

                                <TextView
                                    android:id="@+id/tvRiskLevel"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Medium"
                                    style="@style/Text.H4"
                                    android:textColor="@color/accent" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Risk Level"
                                    style="@style/Text.Caption"
                                    android:textColor="@color/navy" />

                            </LinearLayout>

                        </LinearLayout>

                        <TextView
                            android:id="@+id/tvRecommendation"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Consider increasing irrigation during dry months to improve yield."
                            style="@style/Text.Body"
                            android:background="@color/warm_grey"
                            android:padding="12dp"
                            android:layout_marginTop="8dp" />

                    </LinearLayout>

                </androidx.cardview.widget.CardView>

                <!-- Yearly Yield Chart Card -->
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    style="@style/Widget.AfriNuts.CardView"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="2dp"
                    android:background="@drawable/bg_card_primary">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="20dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Yearly Yield History"
                            style="@style/Text.H5"
                            android:textColor="@color/primary"
                            android:layout_marginBottom="16dp" />

                        <com.github.mikephil.charting.charts.BarChart
                            android:id="@+id/barChartYearlyYield"
                            android:layout_width="match_parent"
                            android:layout_height="200dp" />

                    </LinearLayout>

                </androidx.cardview.widget.CardView>

                <!-- Yield Factors Chart Card -->
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    style="@style/Widget.AfriNuts.CardView"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="2dp"
                    android:background="@drawable/bg_card_secondary">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="20dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Yield Factors"
                            style="@style/Text.H5"
                            android:textColor="@color/olive"
                            android:layout_marginBottom="16dp" />

                        <com.github.mikephil.charting.charts.PieChart
                            android:id="@+id/pieChartYieldFactors"
                            android:layout_width="match_parent"
                            android:layout_height="200dp" />

                    </LinearLayout>

                </androidx.cardview.widget.CardView>

            </LinearLayout>

            <!-- Trends Tab Content -->
            <LinearLayout
                android:id="@+id/contentTrends"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <!-- Revenue Trend Card -->
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    style="@style/Widget.AfriNuts.CardView"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="2dp"
                    android:background="@drawable/bg_card_accent">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="20dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginBottom="16dp">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Revenue Trend"
                                style="@style/Text.H5"
                                android:textColor="@color/accent" />

                            <TextView
                                android:id="@+id/tvRevenueTrend"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="+15%"
                                style="@style/Text.H5"
                                android:textColor="@android:color/holo_green_dark" />

                        </LinearLayout>

                        <com.github.mikephil.charting.charts.LineChart
                            android:id="@+id/lineChartRevenue"
                            android:layout_width="match_parent"
                            android:layout_height="200dp" />

                    </LinearLayout>

                </androidx.cardview.widget.CardView>

                <!-- Expense Trend Card -->
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    style="@style/Widget.AfriNuts.CardView"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="2dp"
                    android:background="@drawable/bg_card_primary">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="20dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginBottom="16dp">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Expense Trend"
                                style="@style/Text.H5"
                                android:textColor="@color/primary" />

                            <TextView
                                android:id="@+id/tvExpenseTrend"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="+5%"
                                style="@style/Text.H5"
                                android:textColor="@android:color/holo_red_dark" />

                        </LinearLayout>

                        <com.github.mikephil.charting.charts.LineChart
                            android:id="@+id/lineChartExpenses"
                            android:layout_width="match_parent"
                            android:layout_height="200dp" />

                    </LinearLayout>

                </androidx.cardview.widget.CardView>

            </LinearLayout>

            <!-- Blocks Tab Content -->
            <LinearLayout
                android:id="@+id/contentBlocks"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <!-- Block Performance List Card -->
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    style="@style/Widget.AfriNuts.CardView"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="2dp"
                    android:background="@drawable/bg_card_secondary">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="20dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Block Performance Ranking"
                            style="@style/Text.H5"
                            android:textColor="@color/olive"
                            android:layout_marginBottom="16dp" />

                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/recyclerBlockPerformance"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:nestedScrollingEnabled="false" />

                    </LinearLayout>

                </androidx.cardview.widget.CardView>

            </LinearLayout>

            <!-- Forecast Tab Content -->
            <LinearLayout
                android:id="@+id/contentForecast"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <!-- 3-Year Forecast Cards -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/cardForecast1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    style="@style/Widget.AfriNuts.CardView"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="2dp"
                    android:background="@drawable/bg_card_primary">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:padding="16dp"
                        android:gravity="center_vertical">

                        <FrameLayout
                            android:layout_width="56dp"
                            android:layout_height="56dp"
                            android:background="@drawable/bg_icon_sand"
                            android:layout_marginEnd="12dp">

                            <TextView
                                android:id="@+id/tvForecastYear1"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center"
                                android:text="2026"
                                style="@style/Text.H3"
                                android:textColor="@color/primary" />

                        </FrameLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:layout_marginHorizontal="12dp">

                            <TextView
                                android:id="@+id/tvForecastYield1"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="45,000 kg"
                                style="@style/Text.Body"
                                android:textStyle="bold"
                                android:textColor="@color/text_dark" />

                            <TextView
                                android:id="@+id/tvForecastRevenue1"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="27,000,000 XAF"
                                style="@style/Text.Caption"
                                android:textColor="@color/navy" />

                        </LinearLayout>

                        <TextView
                            android:id="@+id/tvForecastGrowth1"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="+15%"
                            style="@style/Text.H5"
                            android:textColor="@android:color/holo_green_dark" />

                    </LinearLayout>

                </androidx.cardview.widget.CardView>

                <!-- Forecast Card 2 -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/cardForecast2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    style="@style/Widget.AfriNuts.CardView"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="2dp"
                    android:background="@drawable/bg_card_secondary">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:padding="16dp"
                        android:gravity="center_vertical">

                        <FrameLayout
                            android:layout_width="56dp"
                            android:layout_height="56dp"
                            android:background="@drawable/bg_icon_sand"
                            android:layout_marginEnd="12dp">

                            <TextView
                                android:id="@+id/tvForecastYear2"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center"
                                android:text="2027"
                                style="@style/Text.H3"
                                android:textColor="@color/olive" />

                        </FrameLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:layout_marginHorizontal="12dp">

                            <TextView
                                android:id="@+id/tvForecastYield2"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="52,000 kg"
                                style="@style/Text.Body"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tvForecastRevenue2"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="31,200,000 XAF"
                                style="@style/Text.Caption" />

                        </LinearLayout>

                        <TextView
                            android:id="@+id/tvForecastGrowth2"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="+20%"
                            style="@style/Text.H5"
                            android:textColor="@android:color/holo_green_dark" />

                    </LinearLayout>

                </androidx.cardview.widget.CardView>

                <!-- Forecast Card 3 -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/cardForecast3"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    style="@style/Widget.AfriNuts.CardView"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="2dp"
                    android:background="@drawable/bg_card_accent">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:padding="16dp"
                        android:gravity="center_vertical">

                        <FrameLayout
                            android:layout_width="56dp"
                            android:layout_height="56dp"
                            android:background="@drawable/bg_icon_sand"
                            android:layout_marginEnd="12dp">

                            <TextView
                                android:id="@+id/tvForecastYear3"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center"
                                android:text="2028"
                                style="@style/Text.H3"
                                android:textColor="@color/accent" />

                        </FrameLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:layout_marginHorizontal="12dp">

                            <TextView
                                android:id="@+id/tvForecastYield3"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="60,000 kg"
                                style="@style/Text.Body"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tvForecastRevenue3"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="36,000,000 XAF"
                                style="@style/Text.Caption" />

                        </LinearLayout>

                        <TextView
                            android:id="@+id/tvForecastGrowth3"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="+25%"
                            style="@style/Text.H5"
                            android:textColor="@android:color/holo_green_dark" />

                    </LinearLayout>

                </androidx.cardview.widget.CardView>

            </LinearLayout>

        </LinearLayout>

    </ScrollView>

</LinearLayout>