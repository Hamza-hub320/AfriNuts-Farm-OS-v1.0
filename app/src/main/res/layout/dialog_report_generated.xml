<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="@drawable/bg_report_dialog_sheet">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Report Generated"
        android:textColor="#1C1B1A"
        android:textSize="20sp"
        android:fontFamily="@font/manrope_extrabold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Your PDF report has been created successfully."
        android:textColor="#59544C"
        android:textSize="14sp"
        android:fontFamily="@font/manrope_medium" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnShareReport"
            style="@style/Widget.AfriNuts.Button"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:text="Share"
            android:textAllCaps="false"
            android:textSize="14sp"
            android:fontFamily="@font/manrope_extrabold" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnOpenReport"
            style="@style/Widget.AfriNuts.Button.Secondary"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:backgroundTint="#F3EAD8"
            android:text="Open"
            android:textColor="#1C1B1A"
            android:textAllCaps="false"
            android:textSize="14sp"
            android:fontFamily="@font/manrope_extrabold" />
    </LinearLayout>

    <TextView
        android:id="@+id/btnCloseReport"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:layout_gravity="end"
        android:layout_marginTop="4dp"
        android:gravity="center"
        android:minWidth="64dp"
        android:paddingHorizontal="12dp"
        android:text="Close"
        android:textColor="#59544C"
        android:textSize="14sp"
        android:fontFamily="@font/manrope_bold" />
</LinearLayout>
