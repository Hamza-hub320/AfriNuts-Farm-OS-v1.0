<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardView"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="6dp"
    app:cardCornerRadius="24dp"
    app:cardElevation="2dp"
    style="@style/Widget.AfriNuts.CardView"
    android:foreground="?android:attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp"
        android:background="?attr/cardBackgroundPrimary">

        <!-- Top Row: Master Batch Number + Date -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="4dp">

            <TextView
                android:id="@+id/tvMasterBatchNumber"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="#MB-20260709-614"
                style="@style/Text.H6"
                android:textColor="?attr/colorPrimary"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tvDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Jul 09, 2026"
                style="@style/Text.Caption.Small"
                android:textColor="?attr/colorOnSurface"
                android:textSize="11sp" />

        </LinearLayout>

        <!-- Shipment Name -->
        <TextView
            android:id="@+id/tvShipmentName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Omani Nuts Bulk"
            android:textSize="13sp"
            android:textColor="?attr/colorSecondary"
            android:textStyle="bold"
            android:layout_marginBottom="4dp" />

        <!-- Bottom Row: Buyer + Weight + Batches -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tvBuyer"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Omani Nuts"
                style="@style/Text.Caption.Small"
                android:textColor="?attr/colorOnSurface"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/tvWeight"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="65,000 kg"
                style="@style/Text.Caption.Small"
                android:textColor="?attr/colorPrimary"
                android:textSize="11sp"
                android:layout_marginEnd="12dp" />

            <TextView
                android:id="@+id/tvBatches"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="3 batches"
                style="@style/Text.Caption.Small"
                android:textColor="?attr/colorOnSurface"
                android:textSize="11sp"
                android:alpha="0.7" />

        </LinearLayout>

    </LinearLayout>

</androidx.cardview.widget.CardView>