<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardView"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="6dp"
    app:cardCornerRadius="20dp"
    app:cardElevation="0dp"
    style="@style/Widget.AfriNuts.CardView"
    android:foreground="?android:attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:id="@+id/masterTraceabilityItemContent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp"
        android:background="@color/surface">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tvMasterBatchNumber"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="#MB-20260709-614"
                android:textColor="#1C1B1A"
                android:textSize="15sp"
                android:fontFamily="@font/manrope_extrabold" />

            <TextView
                android:id="@+id/tvDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Jul 09, 2026"
                android:textAllCaps="true"
                android:textColor="#59544C"
                android:textSize="10sp"
                android:fontFamily="@font/manrope_bold"
                android:paddingHorizontal="8dp"
                android:paddingVertical="4dp"
                android:background="@drawable/bg_revenue_standard_badge" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvShipmentName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Omani Nuts Bulk"
            android:textColor="#1C1B1A"
            android:textSize="16sp"
            android:fontFamily="@font/manrope_extrabold"
            android:maxLines="2"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/tvBuyer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Omani Nuts"
            android:textColor="#59544C"
            android:textSize="14sp"
            android:fontFamily="@font/manrope_medium"
            android:maxLines="1"
            android:ellipsize="end" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="10dp"
            android:background="#E9E1CF" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Total weight "
                android:textColor="#59544C"
                android:textSize="12sp"
                android:fontFamily="@font/manrope_bold" />

            <TextView
                android:id="@+id/tvWeight"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="65,000 kg"
                android:textColor="#1C1B1A"
                android:textSize="12sp"
                android:fontFamily="@font/manrope_extrabold"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/tvBatches"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="3 batches"
                android:textColor="#59544C"
                android:textSize="12sp"
                android:fontFamily="@font/manrope_bold"
                android:maxLines="1" />
        </LinearLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView>
