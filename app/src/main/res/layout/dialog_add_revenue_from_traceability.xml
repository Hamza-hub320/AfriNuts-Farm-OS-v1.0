<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Add Revenue for Invoice"
        style="@style/Text.H5"
        android:textColor="?attr/colorPrimary"
        android:layout_marginBottom="8dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Revenue data is required to generate a Commercial Invoice."
        style="@style/Text.Caption"
        android:textColor="?attr/colorOnSurface"
        android:alpha="0.7"
        android:layout_marginBottom="16dp" />

    <!-- Quantity (pre-filled from batch) -->
    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        style="@style/Widget.AfriNuts.EditText"
        app:boxBackgroundColor="?attr/colorSurface">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etQuantity"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Quantity (kg)"
            android:inputType="numberDecimal"
            android:enabled="false" />

    </com.google.android.material.textfield.TextInputLayout>

    <!-- Price per kg -->
    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        style="@style/Widget.AfriNuts.EditText"
        app:boxBackgroundColor="?attr/colorSurface">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etPricePerKg"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Price per kg (XAF) *"
            android:inputType="numberDecimal" />

    </com.google.android.material.textfield.TextInputLayout>

    <!-- Buyer -->
    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        style="@style/Widget.AfriNuts.EditText"
        app:boxBackgroundColor="?attr/colorSurface">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etBuyer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Buyer *"
            android:inputType="text" />

    </com.google.android.material.textfield.TextInputLayout>

    <!-- Harvest Date -->
    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        style="@style/Widget.AfriNuts.EditText"
        app:endIconMode="custom"
        app:endIconDrawable="@drawable/ic_today"
        app:boxBackgroundColor="?attr/colorSurface">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etHarvestDate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Harvest Date"
            android:focusable="false"
            android:clickable="true" />

    </com.google.android.material.textfield.TextInputLayout>

    <!-- Notes -->
    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        style="@style/Widget.AfriNuts.EditText"
        app:boxBackgroundColor="?attr/colorSurface">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etNotes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Notes (optional)"
            android:inputType="textMultiLine"
            android:minLines="2" />

    </com.google.android.material.textfield.TextInputLayout>

    <!-- Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="end">

        <Button
            android:id="@+id/btnCancel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Cancel"
            style="@style/Widget.AfriNuts.Button.Outlined"
            android:layout_marginEnd="8dp" />

        <Button
            android:id="@+id/btnSave"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Save Revenue"
            style="@style/Widget.AfriNuts.Button"
            app:icon="@drawable/ic_save"
            app:iconGravity="textStart"
            app:iconTint="@android:color/white" />

    </LinearLayout>

</LinearLayout>