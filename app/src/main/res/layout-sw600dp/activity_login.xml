<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F6F1E7">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:clipToPadding="false"
        android:paddingStart="24dp"
        android:paddingTop="24dp"
        android:paddingEnd="24dp"
        android:paddingBottom="24dp">

        <LinearLayout
            android:id="@+id/contentColumn"
            android:layout_width="480dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingTop="12dp"
            android:paddingBottom="24dp">

            <ImageView
                android:id="@+id/logoImage"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:layout_marginBottom="16dp"
                android:contentDescription="AfriNuts logo"
                android:src="@drawable/ic_logo_afrinuts_round"
                android:scaleType="fitCenter" />

            <TextView
                android:id="@+id/appNameText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/manrope_extrabold"
                android:gravity="center"
                android:text="AfriNuts Farm OS"
                android:textColor="#1C1B1A"
                android:textSize="24sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="@font/manrope_semibold"
                android:gravity="center"
                android:text="Secure Farm Management"
                android:textColor="#59544C"
                android:textSize="14sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="22dp"
                android:fontFamily="@font/manrope_semibold"
                android:gravity="center"
                android:text="Farm owners, managers, and field officers only"
                android:textColor="#59544C"
                android:textSize="12.5sp" />

            <androidx.cardview.widget.CardView
                android:id="@+id/loginCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="28dp"
                app:cardElevation="0dp"
                app:cardUseCompatPadding="false">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="20dp"
                    android:paddingTop="26dp"
                    android:paddingEnd="20dp"
                    android:paddingBottom="24dp">

                    <TextView
                        android:id="@+id/tvSelectUser"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:fontFamily="@font/manrope_bold"
                        android:text="Select User"
                        android:textColor="#3D3A35"
                        android:textSize="15.5sp"
                        android:visibility="gone" />

                    <HorizontalScrollView
                        android:id="@+id/userScrollView"
                        android:layout_width="match_parent"
                        android:layout_height="68dp"
                        android:layout_marginBottom="22dp"
                        android:clipChildren="false"
                        android:clipToPadding="false"
                        android:fillViewport="false"
                        android:paddingTop="3dp"
                        android:paddingBottom="3dp"
                        android:scrollbars="none"
                        android:visibility="gone">

                        <LinearLayout
                            android:id="@+id/userChipsContainer"
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:gravity="center_vertical"
                            android:clipChildren="false"
                            android:clipToPadding="false"
                            android:orientation="horizontal" />
                    </HorizontalScrollView>

                    <TextView
                        android:id="@+id/tvEmailLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="6dp"
                        android:fontFamily="@font/manrope_bold"
                        android:text="Email"
                        android:textColor="#3D3A35"
                        android:textSize="15.5sp" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/layoutEmailPin"
                        android:layout_width="match_parent"
                        android:layout_height="60dp"
                        android:layout_marginBottom="16dp"
                        app:boxBackgroundMode="filled"
                        app:boxBackgroundColor="#F6F1E7"
                        app:boxCornerRadiusTopStart="16dp"
                        app:boxCornerRadiusTopEnd="16dp"
                        app:boxCornerRadiusBottomStart="16dp"
                        app:boxCornerRadiusBottomEnd="16dp"
                        app:boxStrokeWidth="0dp"
                        app:boxStrokeWidthFocused="0dp"
                        app:hintEnabled="false"
                        app:endIconMode="clear_text">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etEmailPin"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:hint="Email"
                            android:inputType="textEmailAddress"
                            android:minHeight="60dp"
                            android:paddingStart="16dp"
                            android:paddingTop="0dp"
                            android:paddingBottom="0dp"
                            android:paddingEnd="16dp"
                            android:gravity="center_vertical|start"
                            android:includeFontPadding="false"
                            android:textColor="#1C1B1A"
                            android:textColorHint="#8C877E"
                            android:textSize="18sp" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <LinearLayout
                        android:id="@+id/passwordFieldGroup"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="6dp"
                            android:fontFamily="@font/manrope_bold"
                            android:text="Password"
                            android:textColor="#3D3A35"
                            android:textSize="15.5sp" />

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/layoutPassword"
                            android:layout_width="match_parent"
                            android:layout_height="60dp"
                            android:layout_marginBottom="20dp"
                            app:boxBackgroundMode="filled"
                            app:boxBackgroundColor="#F6F1E7"
                            app:boxCornerRadiusTopStart="16dp"
                            app:boxCornerRadiusTopEnd="16dp"
                            app:boxCornerRadiusBottomStart="16dp"
                            app:boxCornerRadiusBottomEnd="16dp"
                            app:boxStrokeWidth="0dp"
                            app:boxStrokeWidthFocused="0dp"
                            app:hintEnabled="false"
                            app:endIconMode="password_toggle"
                            app:endIconTint="#59544C">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etPassword"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:hint="Password"
                                android:inputType="textPassword"
                                android:minHeight="60dp"
                                android:paddingStart="16dp"
                                android:paddingTop="0dp"
                                android:paddingBottom="0dp"
                                android:paddingEnd="16dp"
                                android:gravity="center_vertical|start"
                                android:includeFontPadding="false"
                                android:textColor="#1C1B1A"
                                android:textColorHint="#8C877E"
                                android:textSize="18sp" />
                        </com.google.android.material.textfield.TextInputLayout>
                    </LinearLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnLogin"
                        style="@style/Widget.AfriNuts.Button"
                        android:layout_width="match_parent"
                        android:layout_height="58dp"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:elevation="0dp"
                        android:stateListAnimator="@null"
                        android:fontFamily="@font/manrope_extrabold"
                        android:text="Login"
                        android:textSize="17sp"
                        android:textColor="#FFFFFF"
                        app:icon="@null" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginTop="12dp"
                        android:fontFamily="@font/manrope_semibold"
                        android:gravity="center"
                        android:lineSpacingExtra="2dp"
                        android:paddingStart="4dp"
                        android:paddingEnd="4dp"
                        android:text="Need an account or forgot your credentials? Contact the farm owner."
                        android:textColor="#3D3A35"
                        android:textSize="15sp" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>
        </LinearLayout>
    </ScrollView>
</FrameLayout>
