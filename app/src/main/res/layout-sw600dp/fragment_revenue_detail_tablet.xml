<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_finance_tablet_panel"
    android:clipToOutline="true">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:clipToPadding="false"
        android:padding="22dp">

        <LinearLayout
            android:id="@+id/revenueTabletContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <ImageView
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:padding="14dp"
                    android:background="@drawable/bg_revenue_premium_badge"
                    android:src="@drawable/ic_medal"
                    app:tint="#075C37" />
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        android:id="@+id/tvBatchNumber"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="#1C1B1A"
                        android:textSize="25sp"
                        android:fontFamily="@font/manrope_extrabold"
                        android:maxLines="1"
                        android:ellipsize="end" />
                    <TextView
                        android:id="@+id/tvSource"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:textColor="#59544C"
                        android:textSize="15sp"
                        android:fontFamily="@font/manrope_semibold"
                        android:maxLines="1"
                        android:ellipsize="end" />
                </LinearLayout>
                <TextView
                    android:id="@+id/tvQualityGrade"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:background="@drawable/bg_finance_summary_green"
                    android:paddingStart="12dp"
                    android:paddingTop="6dp"
                    android:paddingEnd="12dp"
                    android:paddingBottom="6dp"
                    android:textColor="#075C37"
                    android:textSize="13sp"
                    android:fontFamily="@font/manrope_extrabold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:orientation="horizontal">
                <androidx.cardview.widget.CardView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    app:cardBackgroundColor="#0E6B3C"
                    app:cardCornerRadius="24dp"
                    app:cardElevation="0dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="18dp">
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Quantity" android:textColor="#D7E9DD" android:textSize="13sp" android:fontFamily="@font/manrope_bold" />
                        <TextView android:id="@+id/tvQuantity" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:textColor="@android:color/white" android:textSize="22sp" android:fontFamily="@font/manrope_extrabold" android:maxLines="1" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="13sp" android:autoSizeMaxTextSize="22sp" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>
                <androidx.cardview.widget.CardView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="4dp"
                    android:layout_marginEnd="4dp"
                    app:cardBackgroundColor="#F5F0E6"
                    app:cardCornerRadius="24dp"
                    app:cardElevation="0dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="18dp">
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Price / kg" android:textColor="#59544C" android:textSize="13sp" android:fontFamily="@font/manrope_bold" />
                        <TextView android:id="@+id/tvPricePerKg" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:textColor="#1C1B1A" android:textSize="22sp" android:fontFamily="@font/manrope_extrabold" android:maxLines="1" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="13sp" android:autoSizeMaxTextSize="22sp" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>
                <androidx.cardview.widget.CardView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    app:cardBackgroundColor="#F5F0E6"
                    app:cardCornerRadius="24dp"
                    app:cardElevation="0dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="18dp">
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Total" android:textColor="#59544C" android:textSize="13sp" android:fontFamily="@font/manrope_bold" />
                        <TextView android:id="@+id/tvTotalAmount" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:textColor="#1C1B1A" android:textSize="22sp" android:fontFamily="@font/manrope_extrabold" android:maxLines="1" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="13sp" android:autoSizeMaxTextSize="22sp" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>
            </LinearLayout>

            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:text="Details" android:textColor="#1C1B1A" android:textSize="17sp" android:fontFamily="@font/manrope_extrabold" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginTop="4dp">
                <include layout="@layout/finance_detail_row" android:id="@+id/rowRevenueGrade" />
                <include layout="@layout/finance_detail_row" android:id="@+id/rowRevenueSaleSource" />
                <include layout="@layout/finance_detail_row" android:id="@+id/rowRevenueHarvestDate" />
                <include layout="@layout/finance_detail_row" android:id="@+id/rowRevenueBuyer" />
            </LinearLayout>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:text="Invoice" android:textColor="#1C1B1A" android:textSize="17sp" android:fontFamily="@font/manrope_extrabold" />
            <include layout="@layout/finance_detail_row" android:id="@+id/rowRevenueInvoice" />

            <LinearLayout
                android:id="@+id/layoutProcurementInfo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:orientation="vertical">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Procurement" android:textColor="#1C1B1A" android:textSize="17sp" android:fontFamily="@font/manrope_extrabold" />
                <include layout="@layout/finance_detail_row" android:id="@+id/rowRevenueBatch" />
                <include layout="@layout/finance_detail_row" android:id="@+id/rowRevenueKor" />
                <include layout="@layout/finance_detail_row" android:id="@+id/rowRevenueReceived" />
                <com.google.android.material.button.MaterialButton android:id="@+id/btnViewBatch" android:layout_width="wrap_content" android:layout_height="46dp" android:layout_gravity="end" android:layout_marginTop="4dp" android:layout_marginBottom="4dp" android:insetTop="0dp" android:insetBottom="0dp" android:text="View Batch" android:textColor="#075C37" app:backgroundTint="#E2F1E8" app:cornerRadius="999dp" />
                <include layout="@layout/finance_detail_row" android:id="@+id/rowRevenueSupplier" />
                <include layout="@layout/finance_detail_row" android:id="@+id/rowRevenueVillage" />
                <include layout="@layout/finance_detail_row" android:id="@+id/rowRevenueBatchesSupplied" />
                <com.google.android.material.button.MaterialButton android:id="@+id/btnViewSupplier" android:layout_width="wrap_content" android:layout_height="46dp" android:layout_gravity="end" android:layout_marginTop="4dp" android:layout_marginBottom="4dp" android:insetTop="0dp" android:insetBottom="0dp" android:text="View Supplier" android:textColor="#075C37" app:backgroundTint="#E2F1E8" app:cornerRadius="999dp" />
            </LinearLayout>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:text="Notes" android:textColor="#59544C" android:textSize="14sp" android:fontFamily="@font/manrope_bold" />
            <TextView android:id="@+id/tvNotes" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:textColor="#393632" android:textSize="15sp" android:fontFamily="@font/manrope_medium" />
            <LinearLayout android:id="@+id/layoutEditFields" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginTop="20dp">
                <com.google.android.material.button.MaterialButton android:id="@+id/btnEdit" android:layout_width="match_parent" android:layout_height="58dp" android:insetTop="0dp" android:insetBottom="0dp" android:text="Edit" android:textColor="#1C1B1A" app:backgroundTint="#F1E8D7" app:cornerRadius="999dp" />
                <com.google.android.material.button.MaterialButton android:id="@+id/btnDelete" android:layout_width="match_parent" android:layout_height="58dp" android:layout_marginTop="10dp" android:insetTop="0dp" android:insetBottom="0dp" android:text="Delete" android:textColor="#B3402A" app:backgroundTint="#F9E4DE" app:cornerRadius="999dp" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</FrameLayout>
