<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- ======================================== -->
    <!-- Dark Mode Theme Overrides -->
    <!-- ======================================== -->
    <style name="Theme.AfriNutsFarmOS" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Primary brand colors - brighter for dark mode -->
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryVariant">@color/olive</item>
        <item name="colorOnPrimary">@android:color/white</item>

        <!-- Secondary brand colors - brighter for dark mode -->
        <item name="colorSecondary">@color/accent</item>
        <item name="colorSecondaryVariant">@color/dark_orange</item>
        <item name="colorOnSecondary">@android:color/white</item>

        <!-- Background colors - dark mode -->
        <item name="android:colorBackground">@color/background</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorSurfaceVariant">@color/warm_grey</item>

        <!-- Status bar -->
        <item name="android:statusBarColor">#F6F1E7</item>
        <item name="android:windowLightStatusBar">true</item>

        <!-- Text colors - light for dark mode -->
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>

        <!-- Custom theme flag -->
        <item name="isLightTheme">false</item>
            <!-- These same names now resolve to drawable-night/ folder (dark version) -->

        <!-- ======================================== -->
        <!-- CARD BACKGROUND ATTRIBUTES (DARK MODE) -->
        <!-- ======================================== -->
        <item name="cardBackgroundPrimary">@drawable/bg_card_primary</item>
        <item name="cardBackgroundAccent">@drawable/bg_card_primary</item>
        <item name="cardBackgroundSecondary">@drawable/bg_card_primary</item>
        <item name="iconBackgroundGlass">@drawable/bg_icon_sand</item>
        <item name="tabBackground">@drawable/tab_selector_pill</item>
        <item name="navbarIconColor">@color/text_tertiary</item>
        <item name="navbarTextColor">@color/text_tertiary</item>
        <item name="navbarBackground">@color/nav_pill_bg</item>
    </style>

    <!-- ======================================== -->
    <!-- Base Text Overrides for Dark Mode -->
    <!-- ======================================== -->
    <style name="Text">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">16sp</item>
        <item name="android:lineSpacingExtra">4sp</item>
        <item name="android:fontFamily">@font/manrope</item>
    </style>

    <!-- Body text overrides -->
    <style name="Text.Body.Small">
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <!-- Caption overrides -->
    <style name="Text.Caption">
        <item name="android:textColor">@color/text_tertiary</item>
    </style>

    <!-- Label overrides -->
    <style name="Text.Label">
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <!-- ======================================== -->
    <!-- Dark Mode CardView Style -->
    <!-- ======================================== -->
    <style name="Widget.AfriNuts.CardView" parent="Widget.MaterialComponents.CardView">
        <item name="cardCornerRadius">20dp</item>
        <item name="cardElevation">2dp</item>
        <item name="cardBackgroundColor">@color/surface</item>
        <item name="cardUseCompatPadding">true</item>
    </style>

    <!-- ======================================== -->
    <!-- Dark Mode Widget Overrides -->
    <!-- ======================================== -->

    <!-- Button Style -->
    <style name="Widget.AfriNuts.Button" parent="Widget.MaterialComponents.Button">
        <item name="android:textAppearance">@style/Text.Button</item>
        <item name="backgroundTint">@color/primary</item>
        <item name="android:textColor">@android:color/white</item>
        <item name="rippleColor">@color/primary_light</item>
        <item name="cornerRadius">999dp</item>
        <item name="android:paddingLeft">12dp</item>
        <item name="android:paddingRight">12dp</item>
        <item name="android:paddingTop">8dp</item>
        <item name="android:paddingBottom">8dp</item>
        <item name="android:minHeight">40dp</item>
    </style>

    <!-- Outlined Button for dark mode -->
    <style name="Widget.AfriNuts.Button.Outlined" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:textAppearance">@style/Text.Button</item>
        <item name="strokeColor">@color/primary</item>
        <item name="strokeWidth">1dp</item>
        <item name="rippleColor">@color/accent</item>
        <item name="cornerRadius">999dp</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:paddingLeft">12dp</item>
        <item name="android:paddingRight">12dp</item>
        <item name="android:paddingTop">8dp</item>
        <item name="android:paddingBottom">8dp</item>
        <item name="android:minHeight">40dp</item>
    </style>

    <!-- Flat pill buttons in dark mode -->
    <style name="Widget.AfriNuts.Button.Secondary" parent="Widget.AfriNuts.Button">
        <item name="backgroundTint">@color/accent</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>
    <style name="Widget.AfriNuts.Button.Danger" parent="Widget.AfriNuts.Button">
        <item name="backgroundTint">@color/error</item>
        <item name="android:textColor">@android:color/white</item>
    </style>

    <!-- Chip for dark mode -->
    <style name="Widget.AfriNuts.Chip" parent="Widget.MaterialComponents.Chip.Filter">
        <item name="android:textAppearance">@style/Text.Caption.Small</item>
        <item name="chipBackgroundColor">@color/warm_grey</item>
        <item name="chipStrokeColor">@color/primary</item>
        <item name="chipStrokeWidth">0dp</item>
        <item name="rippleColor">@color/accent</item>
        <item name="chipCornerRadius">11dp</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <!-- Progress Bar for dark mode -->
    <style name="Widget.AfriNuts.ProgressBar" parent="Widget.AppCompat.ProgressBar.Horizontal">
        <item name="android:progressTint">@color/primary</item>
        <item name="android:progressBackgroundTint">@color/warm_grey</item>
        <item name="android:minHeight">6dp</item>
        <item name="android:maxHeight">6dp</item>
    </style>

    <!-- Divider for dark mode -->
    <style name="Widget.AfriNuts.Divider">
        <item name="android:background">@color/warm_grey</item>
    </style>

    <!-- EditText for dark mode -->
    <style name="Widget.AfriNuts.EditText" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="boxStrokeColor">@color/primary</item>
        <item name="boxStrokeWidth">1dp</item>
        <item name="boxStrokeWidthFocused">2dp</item>
        <item name="hintTextColor">@color/text_tertiary</item>
        <item name="android:textColorHint">@color/text_tertiary</item>
        <item name="colorControlActivated">@color/primary</item>
        <item name="colorControlHighlight">@color/accent</item>
    </style>

</resources>