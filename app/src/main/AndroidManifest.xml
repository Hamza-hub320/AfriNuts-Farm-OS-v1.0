<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Add these permissions -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_logo_afrinuts"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_logo_afrinuts"
        android:supportsRtl="true"
        android:theme="@style/Theme.AfriNutsFarmOS"
        android:usesCleartextTraffic="true">

        <activity
            android:name=".ui.auth.LoginActivity"
            android:exported="true"
            android:theme="@style/Theme.AfriNutsFarmOS">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.blocks.BlocksActivity"
            android:parentActivityName=".MainActivity" />

        <activity
            android:name=".ui.blocks.BlockDetailActivity"
            android:parentActivityName=".ui.blocks.BlocksActivity" />

        <activity
            android:name=".ui.expenses.ExpensesListActivity"
            android:parentActivityName=".MainActivity" />

        <activity
            android:name=".ui.expenses.ExpenseDetailActivity"
            android:parentActivityName=".ui.expenses.ExpensesListActivity" />

        <activity
            android:name=".ui.expenses.ExpenseChartsActivity"
            android:parentActivityName=".MainActivity" />

        <activity
            android:name=".ui.revenue.RevenuesListActivity"
            android:parentActivityName=".MainActivity" />

        <activity
            android:name=".ui.tasks.TasksListActivity"
            android:parentActivityName=".MainActivity" />

        <activity
            android:name=".ui.profit.ProfitDashboardActivity"
            android:parentActivityName=".MainActivity" />

        <activity
            android:name=".ui.tasks.TaskDetailActivity"
            android:parentActivityName=".ui.tasks.TasksListActivity"
            android:exported="false" />

        <activity
            android:name=".ui.workers.WorkerDashboardActivity"
            android:parentActivityName=".MainActivity" />

        <activity
            android:name=".ui.revenue.RevenueDetailActivity"
            android:parentActivityName=".ui.revenue.RevenuesListActivity" />

        <activity
            android:name=".ui.weather.WeatherActivity"
            android:parentActivityName=".MainActivity" />

        <activity
            android:name=".ui.workers.WorkerDetailActivity"
            android:parentActivityName=".ui.workers.WorkerDashboardActivity" />

        <activity
            android:name=".ui.users.UsersListActivity"
            android:parentActivityName=".MainActivity" />
        <activity
            android:name=".ui.users.UserDetailActivity"
            android:parentActivityName=".ui.users.UsersListActivity" />

        <!-- Add file provider for camera photos -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- Add photo activities -->
        <activity
            android:name=".ui.photos.PhotoGalleryActivity"
            android:parentActivityName=".MainActivity" />

        <activity
            android:name=".ui.photos.PhotoDetailActivity"
            android:parentActivityName=".ui.photos.PhotoGalleryActivity" />

        <activity
            android:name=".ui.reports.ReportsActivity"
            android:parentActivityName=".MainActivity"
            android:exported="false" />

    </application>

</manifest>