<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- ALL PERMISSIONS MUST BE HERE - DIRECT CHILDREN OF MANIFEST -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.autofocus" android:required="false" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />

    <application
        android:name=".FarmApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher_foreground"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_foreground"
        android:supportsRtl="true"
        android:theme="@style/Theme.AfriNutsFarmOS"
        android:usesCleartextTraffic="true">

        <!-- Login Activity (Launcher) -->
        <activity
            android:name=".ui.auth.LoginActivity"
            android:exported="true"
            android:theme="@style/Theme.AfriNutsFarmOS">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Main Activity -->
        <activity
            android:name=".MainActivity"
            android:exported="true">
        </activity>

        <!-- Blocks -->
        <activity
            android:name=".ui.blocks.BlocksActivity"
            android:parentActivityName=".MainActivity" />

        <activity
            android:name=".ui.blocks.BlockDetailActivity"
            android:parentActivityName=".ui.blocks.BlocksActivity" />

        <!-- Expenses -->
        <activity
            android:name=".ui.expenses.ExpensesListActivity"
            android:parentActivityName=".MainActivity" />

        <activity
            android:name=".ui.expenses.ExpenseDetailActivity"
            android:parentActivityName=".ui.expenses.ExpensesListActivity" />

        <activity
            android:name=".ui.expenses.ExpenseChartsActivity"
            android:parentActivityName=".MainActivity" />

        <!-- Revenue -->
        <activity
            android:name=".ui.revenue.RevenuesListActivity"
            android:parentActivityName=".MainActivity" />

        <activity
            android:name=".ui.revenue.RevenueDetailActivity"
            android:parentActivityName=".ui.revenue.RevenuesListActivity" />

        <!-- Tasks -->
        <activity
            android:name=".ui.tasks.TasksListActivity"
            android:parentActivityName=".MainActivity" />

        <activity
            android:name=".ui.tasks.TaskDetailActivity"
            android:parentActivityName=".ui.tasks.TasksListActivity"
            android:exported="false" />

        <!-- Workers -->
        <activity
            android:name=".ui.workers.WorkerDashboardActivity"
            android:parentActivityName=".MainActivity" />

        <activity
            android:name=".ui.workers.WorkerDetailActivity"
            android:parentActivityName=".ui.workers.WorkerDashboardActivity" />

        <!-- Users -->
        <activity
            android:name=".ui.users.UsersListActivity"
            android:parentActivityName=".MainActivity" />

        <activity
            android:name=".ui.users.UserDetailActivity"
            android:parentActivityName=".ui.users.UsersListActivity" />

        <!-- Hubs -->
        <activity
            android:name=".ui.farm.FarmHubActivity"
            android:parentActivityName=".MainActivity" />

        <activity
            android:name=".ui.finance.FinanceHubActivity"
            android:parentActivityName=".MainActivity" />

        <activity
            android:name=".ui.analytics.AnalyticsHubActivity"
            android:parentActivityName=".MainActivity" />

        <activity
            android:name=".ui.compliance.ComplianceHubActivity"
            android:parentActivityName=".MainActivity" />

        <activity
            android:name=".ui.compliance.CertificationDetailActivity"
            android:parentActivityName=".MainActivity" />

        <!-- Photos -->
        <activity
            android:name=".ui.photos.PhotoGalleryActivity"
            android:parentActivityName=".MainActivity" />

        <activity
            android:name=".ui.photos.PhotoDetailActivity"
            android:parentActivityName=".ui.photos.PhotoGalleryActivity" />

        <!-- Reports -->
        <activity
            android:name=".ui.reports.ReportsActivity"
            android:parentActivityName=".MainActivity"
            android:exported="false" />

        <!-- <activity
            android:name=".ui.analytics.AnalyticsDashboardActivity"
            android:parentActivityName=".MainActivity" /> -->

        <!-- Settings -->
        <activity
            android:name=".ui.settings.SettingsActivity"
            android:parentActivityName=".MainActivity" />

        <!-- Weather -->
        <activity
            android:name=".ui.weather.WeatherActivity"
            android:parentActivityName=".MainActivity" />

        <!-- Quality -->
        <activity
            android:name=".ui.quality.QualityBatchDetailActivity"
            android:parentActivityName=".MainActivity" />

        <!-- Suppliers -->
        <activity
            android:name=".ui.suppliers.SupplierDetailActivity"
            android:parentActivityName=".MainActivity"
            android:exported="false" />

        <!-- ✅ Traceability Activities (Fixed) -->
        <activity
            android:name=".ui.traceability.TraceabilityDetailActivity"
            android:parentActivityName=".MainActivity"
            android:theme="@style/Theme.AfriNutsFarmOS" />

        <activity
            android:name=".ui.traceability.QRScannerActivity"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.AfriNutsFarmOS" />

        <activity
            android:name=".ui.traceability.MasterTraceabilityDetailActivity"
            android:parentActivityName=".MainActivity"
            android:theme="@style/Theme.AfriNutsFarmOS" />

        <!-- File Provider -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- Sync Service -->
        <service
            android:name=".data.sync.SyncService"
            android:exported="false" />

        <!-- Firebase Messaging Service -->
        <service
            android:name=".data.notifications.FarmMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <!-- Notification Meta Data -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_notification" />

        <meta-data
            android:name="com.google.firebase.messaging.default_notification_color"
            android:resource="@color/primary" />

        <activity
            android:name=".ui.compliance.AuditDetailActivity"
            android:parentActivityName=".ui.compliance.ComplianceHubActivity" />

        <activity
            android:name=".ui.compliance.InspectionDetailActivity"
            android:parentActivityName=".ui.compliance.ComplianceHubActivity" />

        <activity
            android:name=".ui.compliance.VerificationDetailActivity"
            android:parentActivityName=".ui.compliance.ComplianceHubActivity" />

        <activity
            android:name=".ui.compliance.DocumentDetailActivity"
            android:parentActivityName=".ui.compliance.ComplianceHubActivity" />

    </application>

</manifest>